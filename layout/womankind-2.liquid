  *{box-sizing:border-box;}
  body{margin:0;background:#EFDFD0;}
  ::selection{background:#C9653F;color:#F5E6D8;}
  @keyframes wk-marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}


/* scoped reset — mirrors the original standalone's * reset; inline styles still win */
.wk-root *,
.wk-root *::before,
.wk-root *::after { margin:0; padding:0; box-sizing:border-box; }
.wk-root button { font-family:inherit; }

@keyframes wk-marquee { from { transform:translateX(0); } to { transform:translateX(-50%); } }

/* pragmatic mobile layer — desktop is left pixel-faithful */
@media (max-width:749px) {
  .wk-root [style*="grid-template-columns:1.02fr 0.98fr"],
  .wk-root [style*="grid-template-columns:1fr 1fr"],
  .wk-root [style*="grid-template-columns:repeat(3,1fr)"],
  .wk-root [style*="grid-template-columns:0.85fr 1.15fr"],
  .wk-root [style*="grid-template-columns:1.15fr 0.85fr"],
  .wk-root [style*="grid-template-columns:repeat(5,1fr)"],
  .wk-root [style*="grid-template-columns:0.9fr 1.1fr"],
  .wk-root [style*="grid-template-columns:0.82fr 1.18fr"] { grid-template-columns:1fr !important; }
  .wk-root [style*="grid-template-columns:1.02fr 0.98fr"] { gap:28px !important; padding:28px 20px 14px !important; }
  .wk-root [style*="grid-template-columns:repeat(6,1fr)"] { grid-template-columns:repeat(3,1fr) !important; }
  .wk-root [style*="grid-template-columns:1.4fr 1fr 1fr 1fr"] { grid-template-columns:1fr 1fr !important; }
  .wk-root header nav { display:none !important; }
  .wk-root h1 { font-size:34px !important; }
  .wk-root .wk-gallery { position:static !important; top:auto !important; }
  .wk-root .wk-team-photo { min-height:0 !important; height:auto !important; aspect-ratio:1/1; }
  .wk-root .wk-thumbs > div { flex:0 0 calc((100% - 27px) / 3.5) !important; }
  .wk-root [data-wk-card] { flex-basis:84% !important; }
  .wk-root .wk-experts-grid { display:flex !important; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none; }
  .wk-root .wk-experts-grid > div { flex:0 0 78%; scroll-snap-align:start; }
  .wk-root .wk-experts-grid::-webkit-scrollbar { display:none; }
  .wk-root .wk-experts-dots { display:flex !important; }
  .wk-root [data-wk-ing-card] { flex-basis:84% !important; }
  .wk-root .wk-ugc-track { justify-content:flex-start; padding:8px 20px 16px !important; gap:14px !important; scroll-padding-left:20px; }
  .wk-root .wk-ugc-track > div { flex:0 0 46% !important; }
  .wk-root .wk-ugc-track > div > div:first-child { aspect-ratio:9/16 !important; margin-bottom:12px !important; }
  .wk-root .wk-xt-tabs { gap:4px !important; }
  .wk-root .wk-xtab { font-size:12.5px !important; padding:14px 6px !important; letter-spacing:0 !important; }
  .wk-root .wk-xt-body { padding:32px 22px !important; border-radius:0 0 16px 16px !important; }
  .wk-root .wk-xpanel.is-active { grid-template-columns:1fr !important; gap:30px !important; }
}
.wk-root [data-wk-track] { scrollbar-width:none; }
.wk-root [data-wk-track]::-webkit-scrollbar { display:none; }
.wk-root [data-wk-ing-track] { scrollbar-width:none; }
.wk-root [data-wk-ing-track]::-webkit-scrollbar { display:none; }
/* UGC testimonials carousel: center the row when it fits, scroll (no scrollbar) when it doesn't */
.wk-root .wk-ugc-track { justify-content:safe center; scrollbar-width:none; scroll-padding-left:28px; }
.wk-root .wk-ugc-track::-webkit-scrollbar { display:none; }
/* What to expect / how to use / shipping tabs */
.wk-root .wk-xt-tabs { display:flex; gap:6px; }
.wk-root .wk-xtab { flex:1; cursor:pointer; font-family:inherit; border:none; background:#E7D2C1; color:rgba(107,61,66,0.62); font-size:15px; font-weight:600; letter-spacing:0.01em; padding:17px 18px; border-radius:14px 14px 0 0; transition:background .2s ease, color .2s ease; }
.wk-root .wk-xtab:hover { color:#6B3D42; }
.wk-root .wk-xtab.is-active { background:#6B3D42; color:#F5E6D8; cursor:default; }
.wk-root .wk-xt-body { background:#6B3D42; border-radius:0 0 20px 20px; padding:52px 48px; }
.wk-root .wk-xpanel { display:none; }
.wk-root .wk-xpanel.is-active { display:grid; grid-template-columns:repeat(3,1fr); gap:44px; }
/* hero gallery: thumbnail carousel */
.wk-root .wk-thumbs { flex:1; display:flex; gap:10px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
.wk-root .wk-thumbs::-webkit-scrollbar { display:none; }
.wk-root .wk-thumbs > div { flex:0 0 calc((100% - 30px) / 4); scroll-snap-align:start; }
.wk-root .wk-thumb-arrow { flex:0 0 auto; cursor:pointer; font-family:inherit; width:26px; height:26px; border-radius:50%; border:none; background:#6B3D42; color:#F5E6D8; font-size:13px; line-height:1; display:inline-flex; align-items:center; justify-content:center; }
.wk-root .wk-experts-dots { display:none; justify-content:center; gap:8px; margin-top:28px; }
.wk-root .wk-experts-dots span { width:7px; height:7px; border-radius:999px; background:rgba(107,61,66,0.28); cursor:pointer; transition:width .25s ease, background .25s ease; }
.wk-root .wk-experts-dots span.is-active { width:22px; background:#6B3D42; }
    </style>
