{%- comment -%}
  WK - Slide-out cart drawer.
  Self-contained. Rendered once from the header sections (one header per page).
  Opens on click of any [data-wk-cart-open]. Reads /cart.js, edits via /cart/change.js.
  Also intercepts add-to-cart forms so adding a product opens the drawer.
{%- endcomment -%}
{% render 'wk-fonts' %}
<style>
  #wk-cart-drawer{position:fixed;inset:0;z-index:1000;visibility:hidden;pointer-events:none;font-family:'Hanken Grotesk',sans-serif;-webkit-font-smoothing:antialiased;}
  #wk-cart-drawer.wk-cd-open{visibility:visible;pointer-events:auto;}
  #wk-cart-drawer .wk-cd-overlay{position:absolute;inset:0;background:rgba(58,42,32,0.5);opacity:0;transition:opacity .3s ease;}
  #wk-cart-drawer.wk-cd-open .wk-cd-overlay{opacity:1;}
  #wk-cart-drawer .wk-cd-panel{position:absolute;top:0;right:0;height:100%;width:100%;max-width:420px;background:#F5E6D8;color:#3A2A20;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .32s cubic-bezier(.4,0,.2,1);box-shadow:-4px 0 30px rgba(58,42,32,0.22);}
  #wk-cart-drawer.wk-cd-open .wk-cd-panel{transform:translateX(0);}
  #wk-cart-drawer .wk-cd-head{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid rgba(107,61,66,0.16);}
  #wk-cart-drawer .wk-cd-title{font-family:'Fraunces',serif;font-weight:400;font-size:23px;color:#6B3D42;letter-spacing:-0.01em;}
  #wk-cart-drawer .wk-cd-title span{color:#C9653F;}
  #wk-cart-drawer .wk-cd-x{background:none;border:none;cursor:pointer;font-size:30px;line-height:1;color:#6B3D42;padding:0 4px;font-family:inherit;}
  #wk-cart-drawer .wk-cd-body{flex:1 1 auto;overflow-y:auto;padding:8px 24px;}
  #wk-cart-drawer .wk-cd-item{display:grid;grid-template-columns:66px 1fr auto;gap:14px;padding:20px 0;border-bottom:1px solid rgba(107,61,66,0.12);}
  #wk-cart-drawer .wk-cd-item-img{width:66px;height:66px;border-radius:10px;object-fit:cover;background:#E7D3C4;display:block;}
  #wk-cart-drawer .wk-cd-item-title{font-size:14.5px;font-weight:600;color:#6B3D42;line-height:1.3;margin:0 0 3px;}
  #wk-cart-drawer .wk-cd-item-meta{font-size:12px;color:#7A6258;line-height:1.4;margin:0 0 10px;}
  #wk-cart-drawer .wk-cd-item-plan{display:inline-block;font-size:10.5px;letter-spacing:0.05em;text-transform:uppercase;color:#C9653F;font-weight:600;margin-top:4px;}
  #wk-cart-drawer .wk-cd-qty{display:inline-flex;align-items:center;border:1px solid rgba(107,61,66,0.35);border-radius:999px;overflow:hidden;}
  #wk-cart-drawer .wk-cd-qty button{width:30px;height:30px;background:none;border:none;cursor:pointer;font-size:16px;line-height:1;color:#6B3D42;font-family:inherit;}
  #wk-cart-drawer .wk-cd-qty button:disabled{opacity:0.4;cursor:default;}
  #wk-cart-drawer .wk-cd-qty span{min-width:26px;text-align:center;font-size:13.5px;font-weight:600;color:#3A2A20;}
  #wk-cart-drawer .wk-cd-item-right{display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between;gap:10px;}
  #wk-cart-drawer .wk-cd-item-price{font-size:14.5px;font-weight:700;color:#C9653F;white-space:nowrap;}
  #wk-cart-drawer .wk-cd-item-compare{font-size:11.5px;text-decoration:line-through;color:#A07E81;margin-right:6px;font-weight:500;}
  #wk-cart-drawer .wk-cd-item-saved{display:block;font-size:11px;font-weight:600;color:#C9653F;white-space:nowrap;margin-top:3px;}
  #wk-cart-drawer .wk-cd-remove{background:none;border:none;cursor:pointer;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#7A6258;text-decoration:underline;padding:0;font-family:inherit;}
  #wk-cart-drawer .wk-cd-empty{text-align:center;padding:64px 20px;color:#7A6258;}
  #wk-cart-drawer .wk-cd-empty-title{font-family:'Fraunces',serif;font-size:22px;color:#6B3D42;margin:0 0 8px;}
  #wk-cart-drawer .wk-cd-empty a{display:inline-block;margin-top:22px;background:#C9653F;color:#F5E6D8;text-decoration:none;border-radius:999px;padding:14px 30px;font-size:13px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;}
  #wk-cart-drawer .wk-cd-foot{flex:0 0 auto;padding:20px 24px 24px;border-top:1px solid rgba(107,61,66,0.16);background:#FBF1E6;}
  #wk-cart-drawer .wk-cd-sub{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:4px;}
  #wk-cart-drawer .wk-cd-sub-label{font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;}
  #wk-cart-drawer .wk-cd-sub-value{font-family:'Fraunces',serif;font-size:24px;color:#6B3D42;}
  #wk-cart-drawer .wk-cd-note{font-size:11.5px;color:#7A6258;margin:0 0 16px;}
  #wk-cart-drawer .wk-cd-checkout{display:block;width:100%;box-sizing:border-box;text-align:center;background:#C9653F;color:#F5E6D8;text-decoration:none;border:none;cursor:pointer;border-radius:999px;padding:17px;font-size:14px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;font-family:inherit;}
  #wk-cart-drawer .wk-cd-rating{display:flex;align-items:center;justify-content:center;gap:8px;font-size:13px;color:#6B3D42;margin-top:15px;}
  #wk-cart-drawer .wk-cd-rating .wk-cd-stars{color:#C9653F;letter-spacing:1.5px;font-size:14px;}
  #wk-cart-drawer .wk-cd-badges{display:flex;justify-content:space-between;gap:10px;margin-top:15px;padding-top:15px;border-top:1px solid rgba(107,61,66,0.14);}
  #wk-cart-drawer .wk-cd-badge{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;}
  #wk-cart-drawer .wk-cd-badge svg{width:19px;height:19px;color:#C9653F;}
  #wk-cart-drawer .wk-cd-badge span{font-size:11px;color:#6B3D42;line-height:1.3;font-weight:500;}
  #wk-cart-drawer.wk-cd-busy .wk-cd-body{opacity:0.55;transition:opacity .15s ease;pointer-events:none;}
</style>

<div id="wk-cart-drawer" aria-hidden="true" data-currency="{{ cart.currency.iso_code | default: shop.currency }}" data-checkout-url="{{ routes.cart_url }}">
  <div class="wk-cd-overlay" data-wk-cart-close></div>
  <aside class="wk-cd-panel" role="dialog" aria-modal="true" aria-label="Your cart">
    <div class="wk-cd-head">
      <div class="wk-cd-title">Your cart <span data-wk-cd-count></span></div>
      <button type="button" class="wk-cd-x" data-wk-cart-close aria-label="Close cart">&times;</button>
    </div>
    <div class="wk-cd-body" data-wk-cd-body></div>
    <div class="wk-cd-foot" data-wk-cd-foot hidden>
      <div class="wk-cd-sub">
        <span class="wk-cd-sub-label">Subtotal</span>
        <span class="wk-cd-sub-value" data-wk-cd-subtotal></span>
      </div>
      <p class="wk-cd-note">Shipping &amp; discounts calculated at checkout.</p>
      <a class="wk-cd-checkout" href="{{ routes.cart_url }}" data-wk-cd-checkout>Checkout</a>
      <div class="wk-cd-rating"><span class="wk-cd-stars">★★★★★</span> <span>4.6 · Trusted by 12,000+ women</span></div>
      <div class="wk-cd-badges">
        <div class="wk-cd-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
          <span>90-day<br>guarantee</span>
        </div>
        <div class="wk-cd-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v5L5 18.5A1.5 1.5 0 0 0 6.4 21h11.2a1.5 1.5 0 0 0 1.4-2.5L14 8V3"/><path d="M7.5 15h9"/></svg>
          <span>Third-party<br>tested</span>
        </div>
        <div class="wk-cd-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.3-7-11a7 7 0 0 1 14 0c0 4.7-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span>Made in<br>USA</span>
        </div>
      </div>
    </div>
  </aside>
</div>

<script>
(function(){
  if (window.__wkCartDrawer) return;
  window.__wkCartDrawer = true;
  var root = document.getElementById('wk-cart-drawer');
  if (!root) return;
  var body = root.querySelector('[data-wk-cd-body]');
  var foot = root.querySelector('[data-wk-cd-foot]');
  var countEl = root.querySelector('[data-wk-cd-count]');
  var subtotalEl = root.querySelector('[data-wk-cd-subtotal]');
  var checkoutBtn = root.querySelector('[data-wk-cd-checkout]');
  var CUR = root.getAttribute('data-currency') || 'USD';
  var CART_URL = root.getAttribute('data-checkout-url') || '/cart';
  var fmt;
  try { fmt = new Intl.NumberFormat(undefined, { style:'currency', currency: CUR }); } catch(e){ fmt = null; }
  function money(cents){
    var v = (cents || 0) / 100;
    if (fmt) return fmt.format(v);
    return '$' + v.toFixed(2);
  }
  function esc(s){ return (s || '').replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

  function setBadges(count){
    document.querySelectorAll('[data-wk-cart-count]').forEach(function(el){ el.textContent = count; });
  }

  function render(cart){
    setBadges(cart.item_count);
    if (countEl) countEl.textContent = cart.item_count ? '(' + cart.item_count + ')' : '';
    if (!cart.items || cart.items.length === 0){
      foot.hidden = true;
      body.innerHTML = '<div class="wk-cd-empty"><div class="wk-cd-empty-title">Your cart is empty</div><div>Relief is one daily gummy away.</div><a href="https://trywomankind.com/products/hormonal-support-gummies">Shop now</a></div>';
      return;
    }
    foot.hidden = false;
    var html = '';
    cart.items.forEach(function(item, i){
      var line = i + 1;
      var meta = [];
      if (item.variant_title && item.variant_title !== 'Default Title') meta.push(esc(item.variant_title));
      var plan = (item.selling_plan_allocation && item.selling_plan_allocation.selling_plan && item.selling_plan_allocation.selling_plan.name) ? item.selling_plan_allocation.selling_plan.name : '';
      var img = item.image ? item.image.replace(/(\.[a-zA-Z]+)(\?.*)?$/, '_120x120$1$2') : '';
      var discounted = item.original_line_price > item.final_line_price;
      html += '<div class="wk-cd-item" data-line="'+line+'">';
      html += img ? '<img class="wk-cd-item-img" src="'+img+'" alt="'+esc(item.product_title)+'" loading="lazy">' : '<span class="wk-cd-item-img"></span>';
      html += '<div>';
      html += '<p class="wk-cd-item-title">'+esc(item.product_title)+'</p>';
      if (meta.length) html += '<p class="wk-cd-item-meta">'+meta.join(' · ')+'</p>';
      html += '<div class="wk-cd-qty">';
      html += '<button type="button" data-wk-dec aria-label="Decrease quantity">&minus;</button>';
      html += '<span>'+item.quantity+'</span>';
      html += '<button type="button" data-wk-inc aria-label="Increase quantity">+</button>';
      html += '</div>';
      if (plan) html += '<span class="wk-cd-item-plan">'+esc(plan)+'</span>';
      html += '</div>';
      html += '<div class="wk-cd-item-right">';
      html += '<div>';
      html += '<div class="wk-cd-item-price">';
      if (discounted) html += '<span class="wk-cd-item-compare">'+money(item.original_line_price)+'</span>';
      html += money(item.final_line_price)+'</div>';
      if (discounted) html += '<span class="wk-cd-item-saved">You save '+money(item.original_line_price - item.final_line_price)+'</span>';
      html += '</div>';
      html += '<button type="button" class="wk-cd-remove" data-wk-remove>Remove</button>';
      html += '</div>';
      html += '</div>';
    });
    body.innerHTML = html;
    if (subtotalEl) subtotalEl.textContent = money(cart.total_price);
    if (checkoutBtn) checkoutBtn.setAttribute('href', '/checkout');
  }

  function fetchCart(){
    return fetch('/cart.js', { headers:{ 'Accept':'application/json' } }).then(function(r){ return r.json(); });
  }
  function changeLine(line, qty){
    root.classList.add('wk-cd-busy');
    return fetch('/cart/change.js', {
      method:'POST',
      headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
      body: JSON.stringify({ line: line, quantity: qty })
    }).then(function(r){ return r.json(); }).then(function(cart){
      render(cart);
    }).catch(function(){}).then(function(){ root.classList.remove('wk-cd-busy'); });
  }

  var scrollY = 0;
  function open(){
    scrollY = window.scrollY || 0;
    root.classList.add('wk-cd-open');
    root.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    fetchCart().then(render);
  }
  function close(){
    root.classList.remove('wk-cd-open');
    root.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  window.wkOpenCart = open;

  // Open triggers (cart buttons in both headers)
  document.addEventListener('click', function(e){
    var opener = e.target.closest('[data-wk-cart-open]');
    if (opener){ e.preventDefault(); open(); return; }
    var closer = e.target.closest('[data-wk-cart-close]');
    if (closer && root.contains(closer)){ e.preventDefault(); close(); return; }
  });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && root.classList.contains('wk-cd-open')) close(); });

  // Line item controls (delegated within the drawer)
  body.addEventListener('click', function(e){
    var itemEl = e.target.closest('.wk-cd-item');
    if (!itemEl) return;
    var line = parseInt(itemEl.getAttribute('data-line'), 10);
    var qtyEl = itemEl.querySelector('.wk-cd-qty span');
    var qty = qtyEl ? parseInt(qtyEl.textContent, 10) : 1;
    if (e.target.closest('[data-wk-remove]')){ changeLine(line, 0); }
    else if (e.target.closest('[data-wk-inc]')){ changeLine(line, qty + 1); }
    else if (e.target.closest('[data-wk-dec]')){ changeLine(line, Math.max(0, qty - 1)); }
  });

  // Intercept add-to-cart forms so the drawer opens after adding
  document.addEventListener('submit', function(e){
    var form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    var action = form.getAttribute('action') || '';
    var isAdd = /\/cart\/add/.test(action) || form.querySelector('input[name="form_type"][value="product"]');
    if (!isAdd) return;
    e.preventDefault();
    var btn = form.querySelector('[type="submit"]');
    var btnHTML = btn ? btn.innerHTML : '';
    if (btn){ btn.disabled = true; btn.style.opacity = '0.7'; btn.innerHTML = 'Adding…'; }
    fetch('/cart/add.js', { method:'POST', headers:{ 'Accept':'application/json' }, body: new FormData(form) })
      .then(function(r){ if (!r.ok) throw new Error('add failed'); return r.json(); })
      .then(function(){ return fetchCart(); })
      .then(function(cart){
        render(cart);
        root.classList.add('wk-cd-open');
        root.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        if (btn){ btn.disabled = false; btn.style.opacity = ''; btn.innerHTML = btnHTML; }
      })
      .catch(function(){
        // Fallback: normal navigation if AJAX add fails
        if (btn){ btn.disabled = false; btn.style.opacity = ''; btn.innerHTML = btnHTML; }
        form.submit();
      });
  }, true);
})();
</script>
