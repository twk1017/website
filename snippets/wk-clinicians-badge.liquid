{%- comment -%}
  Clinicians' Choice badge overlay for the buy-box hero image.
  Params: text (label), image (image_picker object — overrides the inline emblem for a pixel-exact match).
{%- endcomment -%}
{%- if image -%}
  {%- assign wk_badge_src = image | image_url: width: 460 -%}
  <img src="{{ wk_badge_src }}" alt="{{ text | default: 'Clinicians Choice' }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy" style="position:absolute;top:16px;left:16px;z-index:2;width:auto;max-width:58%;height:auto;display:block;">
{%- elsif text != blank -%}
  {%- assign wk_words = text | split: ' ' -%}
  {%- assign wk_line1 = wk_words[0] -%}
  {%- assign wk_line2 = text | remove_first: wk_line1 | strip -%}
  {%- capture wk_laurel -%}<svg width="19" height="38" viewBox="0 0 24 46" fill="#2b2622" aria-hidden="true" style="flex:0 0 auto;"><path d="M18.5 3 C6.5 9 2.5 23 9 43" fill="none" stroke="#2b2622" stroke-width="1.3" stroke-linecap="round"/><ellipse cx="9.4" cy="9" rx="3.4" ry="1.5" transform="rotate(52 9.4 9)"/><ellipse cx="5.7" cy="15.5" rx="3.7" ry="1.6" transform="rotate(32 5.7 15.5)"/><ellipse cx="4" cy="23" rx="3.9" ry="1.65" transform="rotate(12 4 23)"/><ellipse cx="4.4" cy="30.5" rx="3.7" ry="1.6" transform="rotate(-9 4.4 30.5)"/><ellipse cx="6.4" cy="37.5" rx="3.3" ry="1.5" transform="rotate(-30 6.4 37.5)"/><ellipse cx="14.3" cy="11.5" rx="3" ry="1.4" transform="rotate(-52 14.3 11.5)"/><ellipse cx="11.7" cy="18.5" rx="3.4" ry="1.5" transform="rotate(-33 11.7 18.5)"/><ellipse cx="10.7" cy="26" rx="3.5" ry="1.55" transform="rotate(-14 10.7 26)"/><ellipse cx="11.8" cy="33.5" rx="3.2" ry="1.5" transform="rotate(10 11.8 33.5)"/><ellipse cx="14.6" cy="39.5" rx="2.9" ry="1.4" transform="rotate(30 14.6 39.5)"/></svg>{%- endcapture -%}
  <span style="position:absolute;top:16px;left:16px;z-index:2;display:inline-flex;align-items:center;gap:8px;background:#FBF7F2;border:1.5px solid #2b2622;color:#2b2622;padding:6px 13px;border-radius:11px;box-shadow:0 6px 18px rgba(0,0,0,0.22);">
    {{ wk_laurel }}
    <span style="display:flex;flex-direction:column;align-items:center;line-height:0.9;font-family:'Cormorant Garamond',serif;color:#2b2622;white-space:nowrap;">
      <span style="font-size:16px;font-weight:600;">{{ wk_line1 }}</span>
      {%- if wk_line2 != blank -%}<span style="font-size:14px;font-weight:600;letter-spacing:0.02em;">{{ wk_line2 }}</span>{%- endif -%}
    </span>
    <span style="transform:scaleX(-1);display:inline-flex;">{{ wk_laurel }}</span>
  </span>
{%- endif -%}
