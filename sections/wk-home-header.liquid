  <!-- HEADER -->
  <style>
    .wkhh-cb{position:absolute;opacity:0;pointer-events:none;width:0;height:0;}
    .wkhh-burger{display:none;}
    .wkhh-overlay{display:none;}
    .wkhh-drawer{position:fixed;top:0;left:0;height:100%;width:80%;max-width:330px;background:#F5E6D8;z-index:80;transform:translateX(-100%);transition:transform .3s ease;padding:78px 32px 32px;box-shadow:2px 0 26px rgba(58,42,32,0.2);display:flex;flex-direction:column;gap:28px;}
    .wkhh-drawer a{font-family:'Hanken Grotesk',sans-serif;font-size:19px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;text-decoration:none;font-weight:500;}
    .wkhh-drawer-close{position:absolute;top:24px;right:26px;cursor:pointer;font-size:30px;line-height:1;color:#6B3D42;}
    .wkhh-cb:checked ~ .wkhh-drawer{transform:translateX(0);}
    .wkhh-cb:checked ~ .wkhh-overlay{display:block;position:fixed;inset:0;background:rgba(58,42,32,0.44);z-index:70;}
    @media(max-width:989px){
      .wkhh-inner{display:grid !important;grid-template-columns:1fr auto 1fr !important;}
      .wkhh-links{display:none !important;}
      .wkhh-burger{display:inline-flex !important;align-items:center;}
      .wkhh-right{justify-content:flex-end !important;}
    }
  </style>
  <input type="checkbox" id="wkhh-cb-{{ section.id }}" class="wkhh-cb" aria-hidden="true">
  <header style="position:sticky;top:0;z-index:40;background:#6B3D42;color:#F5E6D8;">
    <div class="wkhh-inner" style="max-width:1240px;margin:0 auto;padding:0 28px;height:70px;display:flex;align-items:center;justify-content:space-between;gap:24px;">
      <nav class="wkhh-nav" style="display:flex;align-items:center;gap:24px;flex:1;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;font-weight:500;">
        <label class="wkhh-burger" for="wkhh-cb-{{ section.id }}" aria-label="Open menu" style="cursor:pointer;">
          <svg width="24" height="16" viewBox="0 0 24 16" fill="none"><path d="M0 1h24M0 8h24M0 15h24" stroke="#F5E6D8" stroke-width="1.6"/></svg>
        </label>
        <span class="wkhh-links" style="display:flex;align-items:center;gap:24px;">
          {%- if section.settings.nav1_label != blank -%}<a href="{{ section.settings.nav1_url | default: '#' }}" style="color:#F5E6D8;text-decoration:none;">{{ section.settings.nav1_label }}</a>{%- endif -%}
          {%- if section.settings.nav2_label != blank -%}<a href="{{ section.settings.nav2_url | default: '#' }}" style="color:#F5E6D8;text-decoration:none;">{{ section.settings.nav2_label }}</a>{%- endif -%}
        </span>
      </nav>
      <a href="{{ section.settings.logo_url | default: '/' }}" style="font-family:'Cormorant Garamond',serif;font-size:33px;line-height:1;color:#F5E6D8;text-decoration:none;letter-spacing:0.01em;flex:0 0 auto;">{{ section.settings.wordmark }}</a>
      <div class="wkhh-right" style="display:flex;align-items:center;gap:20px;flex:1;justify-content:flex-end;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;font-weight:500;">
        <a href="{{ routes.cart_url | default: '/cart' }}" style="color:#F5E6D8;text-decoration:none;display:inline-flex;align-items:center;gap:7px;">{{ section.settings.bag_label }} <span style="background:#C9653F;color:#F5E6D8;border-radius:999px;min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;letter-spacing:0;">{{ cart.item_count | default: 0 }}</span></a>
      </div>
    </div>
  </header>
  <label class="wkhh-overlay" for="wkhh-cb-{{ section.id }}" aria-hidden="true"></label>
  <aside class="wkhh-drawer" role="dialog" aria-label="Menu">
    <label class="wkhh-drawer-close" for="wkhh-cb-{{ section.id }}" aria-label="Close menu">&times;</label>
    {%- if section.settings.nav1_label != blank -%}<a href="{{ section.settings.nav1_url | default: '#' }}">{{ section.settings.nav1_label }}</a>{%- endif -%}
    {%- if section.settings.nav2_label != blank -%}<a href="{{ section.settings.nav2_url | default: '#' }}">{{ section.settings.nav2_label }}</a>{%- endif -%}
  </aside>

{% schema %}
{
  "name": "Home · Header",
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "womankind" },
    { "type": "url", "id": "logo_url", "label": "Logo link" },
    { "type": "header", "content": "Nav links" },
    { "type": "text", "id": "nav1_label", "label": "Link 1", "default": "Shop" },
    { "type": "url", "id": "nav1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "nav2_label", "label": "Link 2", "default": "Contact us" },
    { "type": "url", "id": "nav2_url", "label": "Link 2 URL" },
    { "type": "header", "content": "Right side" },
    { "type": "text", "id": "search_label", "label": "Search label", "default": "Search" },
    { "type": "text", "id": "bag_label", "label": "Cart label", "default": "Cart" }
  ]
}
{% endschema %}
