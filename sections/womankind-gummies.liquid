  <!-- FOOTER -->
  <footer style="background:#6B3D42;color:#F5E6D8;padding:72px 28px 40px;">
    <div style="max-width:1180px;margin:0 auto;">
      <div style="display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;padding-bottom:48px;border-bottom:1px solid rgba(245,230,216,0.2);">
        <div>
          <div style="font-family:'Cormorant Garamond',serif;font-size:38px;line-height:1;margin-bottom:8px;">womankind</div>
          <div style="font-family:'Fraunces',serif;font-style:italic;font-size:15px;color:rgba(245,230,216,0.78);">for perimenopause &amp; beyond</div>
        </div>
        <div>
          <div style="font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:#E2A24C;font-weight:600;margin-bottom:16px;">Shop</div>
          <div style="display:flex;flex-direction:column;gap:11px;font-size:13.5px;color:rgba(245,230,216,0.82);">
            <span style="cursor:pointer;">Hormonal support gummies</span>
            <span style="cursor:pointer;">Deep sleep magnesium</span>
            <span style="cursor:pointer;">Daily omega-3</span>
            <span style="cursor:pointer;">The transition trio</span>
          </div>
        </div>
        <div>
          <div style="font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:#E2A24C;font-weight:600;margin-bottom:16px;">Learn</div>
          <div style="display:flex;flex-direction:column;gap:11px;font-size:13.5px;color:rgba(245,230,216,0.82);">
            <span style="cursor:pointer;">The science</span>
            <span style="cursor:pointer;">The estrobolome</span>
            <span style="cursor:pointer;">Journal</span>
            <span style="cursor:pointer;">Our story</span>
          </div>
        </div>
        <div>
          <div style="font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:#E2A24C;font-weight:600;margin-bottom:16px;">Support</div>
          <div style="display:flex;flex-direction:column;gap:11px;font-size:13.5px;color:rgba(245,230,216,0.82);">
            <span style="cursor:pointer;">Account &amp; orders</span>
            <span style="cursor:pointer;">Manage subscription</span>
            <span style="cursor:pointer;">Shipping &amp; returns</span>
            <span style="cursor:pointer;">Contact</span>
          </div>
        </div>
      </div>
      <p style="font-size:11.5px;line-height:1.6;color:rgba(245,230,216,0.6);margin:28px 0 0;max-width:90ch;">*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Consult your healthcare provider before beginning any supplement, particularly if you are pregnant, nursing, or taking medication.</p>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-top:24px;font-size:12px;color:rgba(245,230,216,0.6);">
        <span>© 2026 Womankind. All rights reserved.</span>
        <span style="display:flex;gap:20px;"><span style="cursor:pointer;">Privacy</span><span style="cursor:pointer;">Terms</span><span style="cursor:pointer;">Accessibility</span></span>
      </div>
    </div>
  </footer>

  <!-- STICKY BUY BAR (optional via tweak) -->
  {% if section.settings.sticky_bar %}
  <div style="position:sticky;bottom:0;z-index:50;background:#3A2A20;color:#F5E6D8;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;gap:20px;box-shadow:0 -6px 24px rgba(58,42,32,0.28);">
    <div style="display:flex;align-items:center;gap:14px;">
      <div style="width:44px;height:44px;background:#C9A89F;border-radius:8px;flex:0 0 auto;"></div>
      <div><div style="font-family:'Fraunces',serif;font-size:16px;">hormonal support gummies</div><div style="font-size:12px;color:rgba(245,230,216,0.7);">3-month supply · $35/mo</div></div>
    </div>
    {%- if wk_product != blank -%}
      <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" enctype="multipart/form-data" style="flex:0 0 auto;" data-wk-form>
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="id" value="{{ wk_variant.id }}">
        <input type="hidden" name="quantity" value="3" data-wk-qty>
        <button type="submit"{% unless wk_variant.available %} disabled{% endunless %} style="cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:13px 32px;font-size:12.5px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;flex:0 0 auto;{% unless wk_variant.available %}opacity:0.55;cursor:not-allowed;{% endunless %}">
          {%- if wk_variant.available -%}
            Add to bag — <span data-wk-price="1" hidden>{{ wk_variant.price | times: 1 | money }}</span><span data-wk-price="3">{{ wk_variant.price | times: 3 | money }}</span><span data-wk-price="6" hidden>{{ wk_variant.price | times: 6 | money }}</span>
          {%- else -%}
            Sold out
          {%- endif -%}
        </button>
      </form>
    {%- else -%}
      <button style="cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:13px 32px;font-size:12.5px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;flex:0 0 auto;">Add to bag — $105</button>
    {%- endif -%}
