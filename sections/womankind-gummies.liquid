  *{box-sizing:border-box;}
  body{margin:0;background:#EFDFD0;}
  ::selection{background:#C9653F;color:#F5E6D8;}
  @keyframes wk-marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}


/* scoped reset — mirrors the original standalone's * reset; inline styles still win */
#wk-{{ section.id }} *,
#wk-{{ section.id }} *::before,
#wk-{{ section.id }} *::after { margin:0; padding:0; box-sizing:border-box; }
#wk-{{ section.id }} button { font-family:inherit; }

@keyframes wk-marquee { from { transform:translateX(0); } to { transform:translateX(-50%); } }

/* pragmatic mobile layer — desktop is left pixel-faithful */
@media (max-width:749px) {
  #wk-{{ section.id }} [style*="grid-template-columns:1.02fr 0.98fr"],
  #wk-{{ section.id }} [style*="grid-template-columns:1fr 1fr"],
  #wk-{{ section.id }} [style*="grid-template-columns:repeat(3,1fr)"],
  #wk-{{ section.id }} [style*="grid-template-columns:0.85fr 1.15fr"],
  #wk-{{ section.id }} [style*="grid-template-columns:1.15fr 0.85fr"],
  #wk-{{ section.id }} [style*="grid-template-columns:repeat(5,1fr)"],
  #wk-{{ section.id }} [style*="grid-template-columns:0.9fr 1.1fr"],
  #wk-{{ section.id }} [style*="grid-template-columns:0.82fr 1.18fr"] { grid-template-columns:1fr !important; }
  #wk-{{ section.id }} [style*="grid-template-columns:1.02fr 0.98fr"] { gap:28px !important; padding:28px 20px 14px !important; }
  #wk-{{ section.id }} [style*="grid-template-columns:repeat(6,1fr)"] { grid-template-columns:repeat(3,1fr) !important; }
  #wk-{{ section.id }} [style*="grid-template-columns:1.4fr 1fr 1fr 1fr"] { grid-template-columns:1fr 1fr !important; }
  #wk-{{ section.id }} header nav { display:none !important; }
  #wk-{{ section.id }} h1 { font-size:34px !important; }
  #wk-{{ section.id }} .wk-gallery { position:static !important; top:auto !important; }
  #wk-{{ section.id }} .wk-thumbs > div { flex:0 0 calc((100% - 27px) / 3.5) !important; }
  #wk-{{ section.id }} [data-wk-card] { flex-basis:84% !important; }
  #wk-{{ section.id }} .wk-experts-grid { display:flex !important; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none; }
  #wk-{{ section.id }} .wk-experts-grid > div { flex:0 0 78%; scroll-snap-align:start; }
  #wk-{{ section.id }} .wk-experts-grid::-webkit-scrollbar { display:none; }
  #wk-{{ section.id }} .wk-experts-dots { display:flex !important; }
  #wk-{{ section.id }} [data-wk-ing-card] { flex-basis:84% !important; }
  #wk-{{ section.id }} .wk-ugc-track { justify-content:flex-start; padding:8px 20px 16px !important; gap:14px !important; scroll-padding-left:20px; }
  #wk-{{ section.id }} .wk-ugc-track > div { flex:0 0 78% !important; }
  #wk-{{ section.id }} .wk-xt-tabs { gap:4px !important; }
  #wk-{{ section.id }} .wk-xtab { font-size:12.5px !important; padding:14px 6px !important; letter-spacing:0 !important; }
  #wk-{{ section.id }} .wk-xt-body { padding:32px 22px !important; border-radius:0 0 16px 16px !important; }
  #wk-{{ section.id }} .wk-xpanel.is-active { grid-template-columns:1fr !important; gap:30px !important; }
}
#wk-{{ section.id }} [data-wk-track] { scrollbar-width:none; }
#wk-{{ section.id }} [data-wk-track]::-webkit-scrollbar { display:none; }
#wk-{{ section.id }} [data-wk-ing-track] { scrollbar-width:none; }
#wk-{{ section.id }} [data-wk-ing-track]::-webkit-scrollbar { display:none; }
/* UGC testimonials carousel: center the row when it fits, scroll (no scrollbar) when it doesn't */
#wk-{{ section.id }} .wk-ugc-track { justify-content:safe center; scrollbar-width:none; scroll-padding-left:28px; }
#wk-{{ section.id }} .wk-ugc-track::-webkit-scrollbar { display:none; }
/* What to expect / how to use / shipping tabs */
#wk-{{ section.id }} .wk-xt-tabs { display:flex; gap:6px; }
#wk-{{ section.id }} .wk-xtab { flex:1; cursor:pointer; font-family:inherit; border:none; background:#E7D2C1; color:rgba(107,61,66,0.62); font-size:15px; font-weight:600; letter-spacing:0.01em; padding:17px 18px; border-radius:14px 14px 0 0; transition:background .2s ease, color .2s ease; }
#wk-{{ section.id }} .wk-xtab:hover { color:#6B3D42; }
