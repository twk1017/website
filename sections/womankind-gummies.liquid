      <div style="display:flex;gap:10px;max-width:420px;margin:0 auto;">
        <input type="email" placeholder="Your email" style="flex:1;font-family:inherit;border:1.5px solid #6B3D42;background:#F5E6D8;border-radius:999px;padding:14px 20px;font-size:14px;color:#3A2A20;">
        <button style="cursor:pointer;font-family:inherit;background:#6B3D42;color:#F5E6D8;border:none;border-radius:999px;padding:14px 26px;font-size:12px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;flex:0 0 auto;">Join</button>
