  @keyframes wk-marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}


/* scoped reset — mirrors the original standalone's * reset; inline styles still win */
#wk-{{ section.id }} *,
#wk-{{ section.id }} *::before,
#wk-{{ section.id }} *::after { margin:0; padding:0; box-sizing:border-box; }
#wk-{{ section.id }} button { font-family:inherit; }

@keyframes wk-marquee { from { transform:translateX(0); } to { transform:translateX(-50%); } }

/* pragmatic mobile layer — desktop is left pixel-faithful */
@media (max-width:749px) {
  #wk-{{ section.id }} [style*="grid-template-columns:1.02fr 0.98fr"],
  #wk-{{ section.id }} [style*="grid-template-columns:1fr 1fr"],
  #wk-{{ section.id }} [style*="grid-template-columns:repeat(3,1fr)"],
  #wk-{{ section.id }} [style*="grid-template-columns:0.85fr 1.15fr"],
  #wk-{{ section.id }} [style*="grid-template-columns:1.15fr 0.85fr"],
  #wk-{{ section.id }} [style*="grid-template-columns:repeat(5,1fr)"],
