/* hero gallery: thumbnail carousel */
#wk-{{ section.id }} .wk-thumbs { flex:1; display:flex; gap:10px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
#wk-{{ section.id }} .wk-thumbs::-webkit-scrollbar { display:none; }
#wk-{{ section.id }} .wk-thumbs > div { flex:0 0 calc((100% - 30px) / 4); scroll-snap-align:start; }
#wk-{{ section.id }} .wk-thumb-arrow { flex:0 0 auto; cursor:pointer; font-family:inherit; width:26px; height:26px; border-radius:50%; border:none; background:#6B3D42; color:#F5E6D8; font-size:13px; line-height:1; display:inline-flex; align-items:center; justify-content:center; }
#wk-{{ section.id }} .wk-experts-dots { display:none; justify-content:center; gap:8px; margin-top:28px; }
#wk-{{ section.id }} .wk-experts-dots span { width:7px; height:7px; border-radius:999px; background:rgba(107,61,66,0.28); cursor:pointer; transition:width .25s ease, background .25s ease; }
#wk-{{ section.id }} .wk-experts-dots span.is-active { width:22px; background:#6B3D42; }
