  "name": "WK - Timeline",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<strong>Two gummies daily</strong>, with or without food — at a time you'll remember" },
    { "type": "header", "content": "Step 1" },
    { "type": "text", "id": "node_1_label", "label": "Label", "default": "Week 2+" },
    { "type": "inline_richtext", "id": "node_1_b1", "label": "Bullet 1", "default": "Steadier sleep — fewer 2am wake-ups*" },
    { "type": "inline_richtext", "id": "node_1_b2", "label": "Bullet 2", "default": "A calmer response to everyday stress*" },
    { "type": "inline_richtext", "id": "node_1_b3", "label": "Bullet 3", "default": "Easier, less foggy mornings*" },
    { "type": "header", "content": "Step 2" },
