  <!-- ANNOUNCEMENT BAR -->
  <div style="background:#3A2A20;color:#F5E6D8;text-align:center;padding:9px 16px;font-size:12.5px;letter-spacing:0.06em;font-weight:500;">
    {{ section.settings.text }} &nbsp;·&nbsp; <a href="{{ section.settings.link_url }}" style="color:#F5E6D8;text-decoration:underline;text-underline-offset:3px;font-weight:600;">{{ section.settings.link_label }}</a>
  </div>

{% schema %}
{
  "name": "Home · Announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Save up to 25% on a 6-month supply" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ]
}
{% endschema %}
