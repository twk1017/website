  <!-- UGC TESTIMONIALS -->
  {%- assign ugc_defaults = 'wk-ugc-6.jpg,wk-ugc-2.jpg,wk-ugc-3.jpg,wk-ugc-4.jpg,wk-ugc-5.jpg,wk-ugc-1.jpg' | split: ',' -%}
  <section style="background:#D8C2BA;padding:84px 0;">
    <div style="max-width:1240px;margin:0 auto;padding:0 28px 38px;text-align:center;">
      <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-bottom:14px;">{{ section.settings.eyebrow }}</div>
      <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:40px;margin:0 0 12px;color:#6B3D42;">{{ section.settings.heading }}</h2>
      <p style="font-size:14.5px;color:#5a4636;margin:0;">{{ section.settings.subhead }}</p>
    </div>
    <div class="wk-ugc-track" style="display:flex;gap:18px;overflow-x:auto;padding:8px 28px 14px;scroll-snap-type:x mandatory;">
      {%- for i in (1..6) -%}
        {%- assign ik = 'card' | append: i | append: '_image' -%}
        {%- assign tk = 'card' | append: i | append: '_title' -%}
        {%- assign bk = 'card' | append: i | append: '_body' -%}
        {%- assign ck = 'card' | append: i | append: '_cite' -%}
        {%- assign title = section.settings[tk] -%}
        {%- if title != blank -%}
          {%- assign img = section.settings[ik] -%}
          {%- if img -%}{%- assign src = img | image_url: width: 400 -%}{%- else -%}{%- assign fname = ugc_defaults[forloop.index0] -%}{%- assign src = fname | asset_url -%}{%- endif -%}
          <div style="flex:0 0 200px;scroll-snap-align:start;display:flex;flex-direction:column;"><div style="aspect-ratio:9/16;background:#C9A89F;border-radius:12px;overflow:hidden;margin-bottom:16px;"><img src="{{ src }}" alt="{{ title }}" width="307" height="550" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;"></div><h3 style="font-family:'Fraunces',serif;font-weight:500;font-size:19px;line-height:1.18;color:#6B3D42;margin:0 0 10px;">{{ title }}</h3><p style="font-size:13px;line-height:1.5;color:#4a3a30;margin:0 0 10px;">{{ section.settings[bk] }}</p><cite style="font-style:normal;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#A07E81;font-weight:600;">{{ section.settings[ck] }}</cite></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <p style="text-align:center;font-size:11.5px;letter-spacing:0.14em;text-transform:uppercase;color:#8a6f6a;margin:18px 0 0;">{{ section.settings.footer_text }}</p>
  </section>

{% schema %}
{
  "name": "WK - UGC",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real Womankind customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real women. Real changes. In their own words." },
    { "type": "text", "id": "subhead", "label": "Subheading", "default": "No scripts. No stock photos. Just women sharing what changed after making Womankind part of their daily routine." },
    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "Scroll to see more →" },
    { "type": "header", "content": "Card 1" },
    { "type": "image_picker", "id": "card1_image", "label": "Photo", "info": "Defaults to wk-ugc-6.jpg" },
    { "type": "text", "id": "card1_title", "label": "Headline", "default": "“Cooler nights at last”" },
    { "type": "textarea", "id": "card1_body", "label": "Quote", "default": "“By week three, the night sweats were less frequent and I was sleeping more deeply. I started waking up feeling like myself again.”" },
    { "type": "text", "id": "card1_cite", "label": "Name", "default": "— Renée, 45" },
    { "type": "header", "content": "Card 2" },
    { "type": "image_picker", "id": "card2_image", "label": "Photo", "info": "Defaults to wk-ugc-2.jpg" },
    { "type": "text", "id": "card2_title", "label": "Headline", "default": "“I stopped planning around hot flashes”" },
    { "type": "textarea", "id": "card2_body", "label": "Quote", "default": "“I carried a fan everywhere and always knew the coolest seat in the room. A month in, the flushes started spacing out—and I stopped planning my day around them.”" },
    { "type": "text", "id": "card2_cite", "label": "Name", "default": "— Dani, 49" },
    { "type": "header", "content": "Card 3" },
    { "type": "image_picker", "id": "card3_image", "label": "Photo", "info": "Defaults to wk-ugc-3.jpg" },
    { "type": "text", "id": "card3_title", "label": "Headline", "default": "“The bloating finally calmed down”" },
    { "type": "textarea", "id": "card3_body", "label": "Quote", "default": "“Three weeks in, my stomach felt settled for the first time in a year. I didn’t expect that to be one of the first changes I noticed.”" },
    { "type": "text", "id": "card3_cite", "label": "Name", "default": "— Grace L., 47" },
    { "type": "header", "content": "Card 4" },
    { "type": "image_picker", "id": "card4_image", "label": "Photo", "info": "Defaults to wk-ugc-4.jpg" },
    { "type": "text", "id": "card4_title", "label": "Headline", "default": "“My afternoon fog lifted”" },
    { "type": "textarea", "id": "card4_body", "label": "Quote", "default": "“The afternoon haze is gone. I can follow a thought through a whole meeting without losing the thread.”" },
    { "type": "text", "id": "card4_cite", "label": "Name", "default": "— Cass, 51" },
    { "type": "header", "content": "Card 5" },
    { "type": "image_picker", "id": "card5_image", "label": "Photo", "info": "Defaults to wk-ugc-5.jpg" },
    { "type": "text", "id": "card5_title", "label": "Headline", "default": "“The little things stay little now”" },
    { "type": "textarea", "id": "card5_body", "label": "Quote", "default": "“I don’t feel as reactive or overwhelmed. My family noticed the difference before I did, honestly.”" },
    { "type": "text", "id": "card5_cite", "label": "Name", "default": "— Lauren, 47" },
    { "type": "header", "content": "Card 6" },
    { "type": "image_picker", "id": "card6_image", "label": "Photo", "info": "Defaults to wk-ugc-1.jpg" },
    { "type": "text", "id": "card6_title", "label": "Headline", "default": "“I feel like myself again”" },
    { "type": "textarea", "id": "card6_body", "label": "Quote", "default": "“First the 2am wake-ups eased. Then, sometime in month two, I caught myself feeling like me again.”" },
    { "type": "text", "id": "card6_cite", "label": "Name", "default": "— Rowan, 46" }
  ]
}
{% endschema %}
