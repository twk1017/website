{%- assign wk_product = section.settings.product -%}
{%- if wk_product != blank -%}{%- assign wk_variant = wk_product.selected_or_first_available_variant -%}{%- assign wk_selling_plan = wk_product.selling_plan_groups.first.selling_plans.first -%}{%- endif -%}

  <!-- BUY BOX — exact duplicate of the PDP wk-hero buy-box -->
  <style>
    #wk-{{ section.id }}-buy .wk-thumbs { flex:1; display:flex; gap:10px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
    #wk-{{ section.id }}-buy .wk-thumbs::-webkit-scrollbar { display:none; }
    #wk-{{ section.id }}-buy .wk-thumbs > button { flex:0 0 calc((100% - 30px) / 4); scroll-snap-align:start; }
    #wk-{{ section.id }}-buy .wk-thumb-arrow { flex:0 0 auto; cursor:pointer; font-family:inherit; width:26px; height:26px; border-radius:50%; border:none; background:#6B3D42; color:#F5E6D8; font-size:13px; line-height:1; display:inline-flex; align-items:center; justify-content:center; }
    @media (max-width:749px){
      #wk-{{ section.id }}-buy .wk-buy-grid { grid-template-columns:1fr !important; gap:30px !important; padding:36px 22px !important; }
      #wk-{{ section.id }}-buy .wk-gallery { position:static !important; top:auto !important; }
      #wk-{{ section.id }}-buy .wk-thumbs > button { flex:0 0 calc((100% - 27px) / 3.5) !important; }
      #wk-{{ section.id }}-buy .wk-buy-title { font-size:34px !important; }
    }
  </style>
  <section id="wk-{{ section.id }}-buy" style="background:#F5E6D8;">
    <div class="wk-buy-grid" style="max-width:1240px;margin:0 auto;padding:64px 28px;display:grid;grid-template-columns:1.02fr 0.98fr;gap:54px;align-items:start;">

      <!-- GALLERY -->
      <div class="wk-gallery" style="position:sticky;top:96px;">
        {%- comment -%} Build the gallery: image_picker override if set, else fall back to assets/wk-buybox-N.jpg {%- endcomment -%}
        {%- assign wk_first_full = '' -%}{%- assign wk_first_alt = '' -%}
        {%- for i in (1..8) -%}
          {%- assign gik = 'gallery_' | append: i | append: '_image' -%}
          {%- assign gimg = section.settings[gik] -%}
          {%- if gimg -%}{%- assign wk_full = gimg | image_url: width: 1200 -%}{%- assign wk_galt = gimg.alt | default: 'Womankind Hormonal Support Gummies' -%}
          {%- else -%}{%- assign gfname = 'wk-buybox-' | append: i | append: '.jpg' -%}{%- assign wk_full = gfname | asset_url -%}{%- assign wk_galt = 'Womankind Hormonal Support Gummies' -%}{%- endif -%}
          {%- if forloop.first -%}{%- assign wk_first_full = wk_full -%}{%- assign wk_first_alt = wk_galt -%}{%- endif -%}
        {%- endfor -%}
        <div class="wk-hero-img" style="position:relative;aspect-ratio:1/1;border-radius:18px;overflow:hidden;background:radial-gradient(120% 92% at 50% 16%, #ECDBCC 0%, #D8BFB4 52%, #C2A099 100%);">
          <img data-wk-hero-img src="{{ wk_first_full }}" alt="{{ wk_first_alt }}" width="1200" height="1200" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;">
          <span data-wk-badge>{% render 'wk-clinicians-badge', text: section.settings.badge, image: section.settings.badge_image %}</span>
        </div>
        <div style="display:flex;align-items:center;gap:10px;margin-top:14px;">
          <button type="button" class="wk-thumb-arrow" data-wk-thumb-prev aria-label="Previous image">&lsaquo;</button>
          <div class="wk-thumbs" data-wk-thumb-track>
            {%- for i in (1..8) -%}
              {%- assign gik = 'gallery_' | append: i | append: '_image' -%}
              {%- assign gimg = section.settings[gik] -%}
              {%- if gimg -%}{%- assign tsrc = gimg | image_url: width: 240 -%}{%- assign tfull = gimg | image_url: width: 1200 -%}{%- assign talt = gimg.alt | default: 'Womankind Hormonal Support Gummies' -%}
              {%- else -%}{%- assign gfname = 'wk-buybox-' | append: i | append: '.jpg' -%}{%- assign tsrc = gfname | asset_img_url: '240x240' -%}{%- assign tfull = gfname | asset_url -%}{%- assign talt = 'Womankind Hormonal Support Gummies' -%}{%- endif -%}
              <button type="button" data-wk-thumb data-wk-full="{{ tfull }}" aria-label="View image {{ i }}" style="cursor:pointer;padding:0;aspect-ratio:1/1;background:#D8C2BA;border-radius:9px;overflow:hidden;{% if forloop.first %}border:2px solid #6B3D42;{% else %}border:2px solid transparent;{% endif %}display:flex;align-items:center;justify-content:center;">
                <img src="{{ tsrc }}" alt="{{ talt }}" width="240" height="240" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
              </button>
            {%- endfor -%}
          </div>
          <button type="button" class="wk-thumb-arrow" data-wk-thumb-next aria-label="Next image">&rsaquo;</button>
        </div>
      </div>

      <!-- BUY BOX -->
      <div>
        <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#C9653F;font-weight:600;margin-bottom:14px;">{{ section.settings.eyebrow }}</div>
        <h2 class="wk-buy-title" style="font-family:'Fraunces',serif;font-weight:400;font-size:48px;line-height:1.02;margin:0 0 14px;color:#6B3D42;letter-spacing:-0.01em;">{{ section.settings.heading }}</h2>

        {%- assign oke_product = wk_product | default: all_products['hormonal-support-gummies'] -%}
        <div data-oke-star-rating data-oke-reviews-product-id="shopify-{{ oke_product.id }}" style="margin-bottom:16px;">{{ oke_product.metafields.okendo.StarRatingSnippet }}</div>

        <p style="font-size:15px;line-height:1.6;color:#4a3a30;margin:0 0 18px;max-width:30em;">{{ section.settings.description }}</p>

        <div style="display:flex;flex-direction:column;gap:11px;margin-bottom:22px;">
          {%- for i in (1..4) -%}{%- assign bk = 'benefit_' | append: i -%}{%- assign bt = section.settings[bk] -%}{%- if bt != blank -%}<div style="display:flex;align-items:flex-start;gap:11px;font-size:14.5px;color:#3A2A20;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span><span>{{ bt }}</span></div>{%- endif -%}{%- endfor -%}
        </div>

        <!-- FLAVOR -->
        <div style="font-size:11.5px;letter-spacing:0.22em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-bottom:10px;">{{ section.settings.flavor_label }}</div>
        <div style="display:flex;gap:10px;margin-bottom:26px;flex-wrap:wrap;">
          <button type="button" data-wk="flavor" data-wk-val="cranberry" style="position:relative;cursor:pointer;font-family:inherit;background:#F5E6D8;border:1.5px solid #6B3D42;color:#6B3D42;border-radius:999px;padding:9px 18px;font-size:13px;letter-spacing:0.04em;">{{ section.settings.flavor_pill }}<span data-wk-ring="flavor:cranberry" style="box-shadow:0 0 0 2px #6B3D42;position:absolute;inset:-1.5px;border-radius:999px;pointer-events:none;"></span></button>
        </div>

        <!-- SUPPLY TIERS -->
        <div style="display:flex;flex-direction:column;gap:11px;margin-bottom:22px;">
          <button type="button" data-wk="supply" data-wk-val="6" style="position:relative;cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.35);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;">
            <span data-wk-ring="supply:6" style="box-shadow:0 0 0 0 transparent;position:absolute;inset:-1.5px;border-radius:12px;pointer-events:none;"></span>
            <span style="position:absolute;top:-10px;left:18px;background:#6B3D42;color:#F5E6D8;font-size:10px;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;padding:3px 10px;border-radius:999px;">{{ section.settings.tier6_badge }}</span>
            <span><span style="display:block;font-size:15.5px;font-weight:600;color:#6B3D42;">{{ section.settings.tier6_name }}</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">{{ section.settings.tier6_sub }}</span></span>
            <span style="text-align:right;flex:0 0 auto;"><span style="display:flex;align-items:baseline;justify-content:flex-end;gap:7px;"><span data-wk-compare="6" style="font-size:11px;text-decoration:line-through;color:#A07E81;">$252</span><span data-wk-total="6" style="font-size:19px;font-weight:700;color:#C9653F;">$122.85</span></span><span data-wk-permo-line="6" style="display:block;font-size:12.5px;color:#7a6258;font-weight:600;margin-top:1px;"><span data-wk-permo="6">$20.48</span><span data-wk-mo style="font-size:11px;font-weight:500;">/mo</span></span><span data-wk-save="6" style="display:block;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-top:2px;">Save 51%</span></span>
          </button>

          <button type="button" data-wk="supply" data-wk-val="3" style="position:relative;cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.35);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;">
            <span data-wk-ring="supply:3" style="box-shadow:0 0 0 2px #6B3D42;position:absolute;inset:-1.5px;border-radius:12px;pointer-events:none;"></span>
            <span style="position:absolute;top:-10px;left:18px;background:#C9653F;color:#F5E6D8;font-size:10px;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;padding:3px 10px;border-radius:999px;">{{ section.settings.tier3_badge }}</span>
            <span><span style="display:block;font-size:15.5px;font-weight:600;color:#6B3D42;">{{ section.settings.tier3_name }}</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">{{ section.settings.tier3_sub }}</span></span>
            <span style="text-align:right;flex:0 0 auto;"><span style="display:flex;align-items:baseline;justify-content:flex-end;gap:7px;"><span data-wk-compare="3" style="font-size:11px;text-decoration:line-through;color:#A07E81;">$126</span><span data-wk-total="3" style="font-size:19px;font-weight:700;color:#C9653F;">$70.88</span></span><span data-wk-permo-line="3" style="display:block;font-size:12.5px;color:#7a6258;font-weight:600;margin-top:1px;"><span data-wk-permo="3">$23.63</span><span data-wk-mo style="font-size:11px;font-weight:500;">/mo</span></span><span data-wk-save="3" style="display:block;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-top:2px;">Save 44%</span></span>
          </button>

          <button type="button" data-wk="supply" data-wk-val="1" style="position:relative;cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.35);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;">
            <span data-wk-ring="supply:1" style="box-shadow:0 0 0 0 transparent;position:absolute;inset:-1.5px;border-radius:12px;pointer-events:none;"></span>
            <span><span style="display:block;font-size:15.5px;font-weight:600;color:#6B3D42;">{{ section.settings.tier1_name }}</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">{{ section.settings.tier1_sub }}<span data-wk-ship1> · free shipping</span></span></span>
            <span style="text-align:right;flex:0 0 auto;"><span style="display:flex;align-items:baseline;justify-content:flex-end;gap:7px;"><span data-wk-compare="1" style="font-size:11px;text-decoration:line-through;color:#A07E81;">$42</span><span data-wk-total="1" style="font-size:19px;font-weight:700;color:#C9653F;">$31.50</span></span><span data-wk-permo-line="1" style="display:block;font-size:12.5px;color:#7a6258;font-weight:600;margin-top:1px;"><span data-wk-permo="1">$31.50</span><span data-wk-mo style="font-size:11px;font-weight:500;">/mo</span></span><span data-wk-save="1" style="display:block;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-top:2px;">Save 25%</span></span>
          </button>
        </div>

        <!-- AUTO REFILLS -->
        <div data-wk-refill role="checkbox" aria-checked="true" tabindex="0" style="display:flex;align-items:center;gap:14px;border:1.5px dashed rgba(107,61,66,0.45);border-radius:12px;padding:16px 18px;cursor:pointer;margin-bottom:14px;">
          <span data-wk-refill-box style="width:24px;height:24px;flex:0 0 auto;border:1.5px solid #6B3D42;border-radius:6px;display:flex;align-items:center;justify-content:center;background:#6B3D42;"><span data-wk-refill-check style="color:#F5E6D8;font-size:14px;font-weight:700;line-height:1;display:block;">&check;</span></span>
          <span style="flex:1;"><span style="display:block;font-size:15px;font-weight:700;color:#6B3D42;">{{ section.settings.refill_title }}</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">{{ section.settings.refill_subtitle }}</span></span>
        </div>

        <!-- ADD TO CART -->
        {%- if wk_product != blank -%}
          <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" enctype="multipart/form-data" data-wk-form>
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" value="{{ wk_variant.id }}">
            <input type="hidden" name="quantity" value="3" data-wk-qty>
            <input type="hidden" name="selling_plan" value="{{ wk_selling_plan.id }}" data-wk-selling-plan disabled>
            <button type="submit"{% unless wk_variant.available %} disabled{% endunless %} style="width:100%;cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:18px;font-size:15px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:12px;{% unless wk_variant.available %}opacity:0.55;cursor:not-allowed;{% endunless %}">
              {%- if wk_variant.available -%}
                {{ section.settings.atc_label }} <span style="opacity:0.85;">— <span data-wk-atc-total>{{ wk_variant.price | times: 3 | money }}</span></span>
              {%- else -%}
                Sold out
              {%- endif -%}
            </button>
          </form>
        {%- else -%}
          <button type="button" style="width:100%;cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:18px;font-size:15px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:12px;">Select a product</button>
        {%- endif -%}
        <div style="display:flex;align-items:center;justify-content:center;gap:11px;margin:16px 0 0;">
          <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;border:1.5px solid #C9653F;color:#C9653F;font-size:11px;font-weight:700;flex:0 0 auto;line-height:1;">{{ section.settings.guarantee_badge }}</span>
          <span style="font-size:12.5px;color:#6B3D42;font-weight:600;letter-spacing:0.02em;">{{ section.settings.guarantee_text }}</span>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function(){
      function init(){
        var root = document.getElementById('wk-{{ section.id }}-buy');
        if (!root || root.dataset.wkBuyInit) return;
        root.dataset.wkBuyInit = '1';
        var RING = '0 0 0 2px #6B3D42', NONE = '0 0 0 0 transparent';
        var state = { flavor:'cranberry', supply:'3' };
        function applySelection(group){
          var val = state[group];
          root.querySelectorAll('[data-wk-ring]').forEach(function(el){
            var parts = el.getAttribute('data-wk-ring').split(':');
            if (parts[0] !== group) return;
            el.style.boxShadow = (parts[1] === val) ? RING : NONE;
          });
        }
        var BOTTLE = {{ wk_variant.price | default: 4200 }};
        var SELLING_PLANS = [
          {%- assign wk_sp_first = true -%}
          {%- for grp in wk_product.selling_plan_groups -%}{%- for sp in grp.selling_plans -%}
            {%- unless wk_sp_first %},{% endunless %}{ id: {{ sp.id }}, name: {{ sp.name | json }} }{%- assign wk_sp_first = false -%}
          {%- endfor -%}{%- endfor -%}
        ];
        var PLAN_OVERRIDES = { '1': {{ section.settings.plan_1_id | default: 'null' }}, '3': {{ section.settings.plan_3_id | default: 'null' }}, '6': {{ section.settings.plan_6_id | default: 'null' }} };
        function wkParseInterval(name){
          name = (name || '').toLowerCase();
          if (/quarter/.test(name)) return 3;
          var m = name.match(/(\d+)\s*-?\s*month/); if (m) return parseInt(m[1], 10);
          if (/month/.test(name)) return 1;
          if (/annual|year/.test(name)) return 12;
          return 0;
        }
        function planForTier(tier){
          if (PLAN_OVERRIDES[tier]) return PLAN_OVERRIDES[tier];
          var want = { '1':1, '3':3, '6':6 }[tier];
          for (var i=0;i<SELLING_PLANS.length;i++){ if (wkParseInterval(SELLING_PLANS[i].name) === want) return SELLING_PLANS[i].id; }
          return SELLING_PLANS.length ? SELLING_PLANS[0].id : null;
        }
        var TIERS = { '1': { m:1, off:0 }, '3': { m:3, off:0.25 }, '6': { m:6, off:0.35 } };
        var SUB_OFF = 0.25;
        var wkRefillEl = root.querySelector('[data-wk-refill]');
        function wkMoney(c){ return '$' + (c/100).toFixed(2).replace(/\.00$/, ''); }
        function refillIsOn(){ return !!(wkRefillEl && wkRefillEl.getAttribute('aria-checked') === 'true'); }
        function wkQuote(tier, on){
          var t = TIERS[tier], full = BOTTLE * t.m;
          // Shopify rounds the discounted price per bottle, then multiplies — mirror that so the buy-box matches the cart/checkout exactly.
          var perUnit = on ? Math.round(BOTTLE * (1 - t.off) * (1 - SUB_OFF)) : Math.round(BOTTLE * (1 - t.off));
          var total = perUnit * t.m;
          return { full: full, total: total, perMo: perUnit, save: Math.round((1 - total/full) * 100) };
        }
        function applyPricing(){
          var on = refillIsOn();
          ['1','3','6'].forEach(function(k){
            var q = wkQuote(k, on);
            root.querySelectorAll('[data-wk-total="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.total); });
            root.querySelectorAll('[data-wk-permo="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.perMo); });
            root.querySelectorAll('[data-wk-permo-line="'+k+'"]').forEach(function(e){ e.style.display = on ? '' : 'none'; });
            root.querySelectorAll('[data-wk-compare="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.full); e.style.visibility = q.save > 0 ? 'visible' : 'hidden'; });
            root.querySelectorAll('[data-wk-save="'+k+'"]').forEach(function(e){ e.textContent = 'Save ' + q.save + '%'; e.style.visibility = q.save > 0 ? 'visible' : 'hidden'; });
          });
          root.querySelectorAll('[data-wk-atc-total]').forEach(function(e){ e.textContent = wkMoney(wkQuote(state.supply, on).total); });
          root.querySelectorAll('[data-wk-ship1]').forEach(function(e){ e.style.display = on ? '' : 'none'; });
        }
        function applyCart(){
          var planId = planForTier(state.supply);
          var sub = refillIsOn() && planId;
          root.querySelectorAll('[data-wk-qty]').forEach(function(i){ i.value = state.supply; });
          root.querySelectorAll('[data-wk-selling-plan]').forEach(function(i){ if (planId) i.value = planId; i.disabled = !sub; });
        }
        function applySupply(){ applyCart(); applyPricing(); }
        root.querySelectorAll('[data-wk]').forEach(function(el){
          el.addEventListener('click', function(){
            var g = el.getAttribute('data-wk');
            state[g] = el.getAttribute('data-wk-val');
            applySelection(g);
            if (g === 'supply') applySupply();
          });
        });
        applySelection('flavor'); applySelection('supply'); applySupply();
        if (wkRefillEl){
          var box = wkRefillEl.querySelector('[data-wk-refill-box]');
          var chk = wkRefillEl.querySelector('[data-wk-refill-check]');
          function toggleRefill(){
            var on = wkRefillEl.getAttribute('aria-checked') === 'true';
            wkRefillEl.setAttribute('aria-checked', on ? 'false' : 'true');
            if (box) box.style.background = on ? 'transparent' : '#6B3D42';
            if (chk) chk.style.display = on ? 'none' : 'block';
            applyPricing(); applyCart();
          }
          wkRefillEl.addEventListener('click', toggleRefill);
          wkRefillEl.addEventListener('keydown', function(e){ if (e.key === ' ' || e.key === 'Enter'){ e.preventDefault(); toggleRefill(); } });
        }
        var thumbTrack = root.querySelector('[data-wk-thumb-track]');
        if (thumbTrack){
          var tp = root.querySelector('[data-wk-thumb-prev]'), tn = root.querySelector('[data-wk-thumb-next]');
          function tstep(){ var c = thumbTrack.querySelector('button'); return c ? c.getBoundingClientRect().width + 10 : thumbTrack.clientWidth; }
          if (tp) tp.addEventListener('click', function(){ thumbTrack.scrollBy({ left: -tstep()*2, behavior:'smooth' }); });
          if (tn) tn.addEventListener('click', function(){ thumbTrack.scrollBy({ left: tstep()*2, behavior:'smooth' }); });
        }
        var heroImg = root.querySelector('[data-wk-hero-img]');
        var badge = root.querySelector('[data-wk-badge]');
        var thumbs = root.querySelectorAll('[data-wk-thumb]');
        thumbs.forEach(function(btn, idx){
          btn.addEventListener('click', function(){
            var full = btn.getAttribute('data-wk-full');
            if (heroImg && full){ heroImg.src = full; }
            thumbs.forEach(function(b){ b.style.borderColor = 'transparent'; });
            btn.style.borderColor = '#6B3D42';
            if (badge){ badge.style.display = (idx === 0) ? '' : 'none'; }
          });
        });
      }
      if (document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', init); } else { init(); }
    })();
  </script>

{% schema %}
{
  "name": "Home · Buy box",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Select the gummies product. Required for add-to-cart and pricing." },
    { "type": "header", "content": "Gallery", "info": "8 images. Defaults to assets/wk-buybox-1…8.jpg. Image 1 is the main view; all 8 show as clickable thumbnails." },
    { "type": "text", "id": "badge", "label": "Badge label", "default": "Clinicians' Choice", "info": "Laurel emblem overlaid on the top-left of the main image. Leave blank to hide." },
    { "type": "image_picker", "id": "badge_image", "label": "Badge image (optional)", "info": "Upload your Clinicians' Choice award graphic to replace the built-in laurel emblem." },
