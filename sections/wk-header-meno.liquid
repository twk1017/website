{%- comment -%} Menopause landing page (page.gummies-meno) — distraction-free header: logo (not linked) + cart icon (opens the on-page drawer). No nav, no links off the page. {%- endcomment -%}
  <!-- HEADER (meno LP) -->
  <header style="position:sticky;top:0;z-index:40;background:#F5E6D8;border-bottom:1px solid rgba(107,61,66,0.16);">
    <div style="max-width:1240px;margin:0 auto;padding:0 28px;height:74px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px;">
      <span aria-hidden="true"></span>
      <span style="font-family:'Cormorant Garamond',serif;font-size:34px;line-height:1;color:#6B3D42;letter-spacing:0.01em;">{{ section.settings.logo_text }}</span>
      <div style="display:flex;align-items:center;justify-content:flex-end;font-size:13.5px;letter-spacing:0.16em;text-transform:uppercase;color:#6B3D42;font-weight:500;">
        <a href="{{ routes.cart_url }}" data-wk-cart-open aria-label="Cart" style="text-decoration:none;color:inherit;cursor:pointer;display:inline-flex;align-items:center;gap:7px;"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg><span data-wk-cart-count style="background:#6B3D42;color:#F5E6D8;border-radius:999px;min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;letter-spacing:0;">{{ cart.item_count }}</span></a>
      </div>
    </div>
  </header>
  {% render 'wk-cart-drawer' %}

{% schema %}
{
  "name": "WK - Header (meno)",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "womankind" }
  ]
}
{% endschema %}
