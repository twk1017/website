  <!-- FINAL CTA / GUARANTEE -->
  <section id="wk-guar-{{ section.id }}" style="background:#6B3D42;padding:92px 28px;">
    <style>
      #wk-guar-{{ section.id }} .wk-guar-steps { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin:44px 0 0; }
      #wk-guar-{{ section.id }} .wk-guar-step { background:rgba(245,230,216,0.05); border:1px solid rgba(245,230,216,0.12); border-radius:16px; padding:26px 24px; }
      #wk-guar-{{ section.id }} .wk-guar-num { display:inline-flex; align-items:center; justify-content:center; width:38px; height:38px; border-radius:50%; border:1.5px solid #E2A24C; color:#E2A24C; font-family:'Fraunces',serif; font-size:17px; font-weight:500; margin-bottom:16px; }
      #wk-guar-{{ section.id }} .wk-guar-step h3 { font-size:13px; letter-spacing:0.1em; text-transform:uppercase; font-weight:700; color:#F5E6D8; margin:0 0 9px; }
      #wk-guar-{{ section.id }} .wk-guar-step p { font-size:14.5px; line-height:1.55; color:rgba(245,230,216,0.78); margin:0; }
      @media (max-width:720px){ #wk-guar-{{ section.id }} .wk-guar-steps { grid-template-columns:1fr; gap:14px; } }
    </style>
    <div style="max-width:820px;margin:0 auto;text-align:center;">
      <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#E2A24C;font-weight:600;margin-bottom:20px;">{{ section.settings.eyebrow }}</div>
      <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:40px;line-height:1.12;margin:0 auto 20px;max-width:22ch;color:#F5E6D8;">{{ section.settings.heading_line1 }}<br><span style="color:#E2A24C;">{{ section.settings.heading_line2 }}</span></h2>
      <p style="font-size:16px;line-height:1.62;color:rgba(245,230,216,0.82);max-width:60ch;margin:0 auto;">{{ section.settings.body }}</p>

      <div class="wk-guar-steps">
        {%- for i in (1..3) -%}
          {%- assign tk = 'p' | append: i | append: '_title' -%}
          {%- assign bk = 'p' | append: i | append: '_text' -%}
          <div class="wk-guar-step">
            <span class="wk-guar-num">{{ i }}</span>
            <h3>{{ section.settings[tk] }}</h3>
            <p>{{ section.settings[bk] }}</p>
          </div>
        {%- endfor -%}
      </div>

      <div style="margin:44px 0 0;">
        <button type="button" data-wk-guar-cta style="cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:18px 46px;font-size:14px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;">{{ section.settings.cta_label }}</button>
        <div style="margin:16px 0 0;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(245,230,216,0.72);font-weight:600;">{{ section.settings.trust_text }}</div>
      </div>
    </div>
    <script>
      (function(){
        var root = document.getElementById('wk-guar-{{ section.id }}');
        if(!root) return;
        var cta = root.querySelector('[data-wk-guar-cta]');
        if(cta) cta.addEventListener('click', function(){ window.scrollTo({ top:0, behavior:'smooth' }); });
      })();
    </script>

{% schema %}
{
  "name": "WK Guarantee",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The 90-day feel-the-difference guarantee" },
    { "type": "text", "id": "heading_line1", "label": "Heading line 1", "default": "Give Womankind 90 days." },
    { "type": "text", "id": "heading_line2", "label": "Heading line 2 (accent)", "default": "If you don’t feel the difference, it’s on us." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Take two gummies daily and give your body the consistency it deserves. If you don’t feel a meaningful difference within 90 days, let us know and we’ll refund your purchase. No hoops. No hard feelings." },
    { "type": "header", "content": "Reassurance point 1" },
    { "type": "text", "id": "p1_title", "label": "Title", "default": "Start your daily routine" },
    { "type": "textarea", "id": "p1_text", "label": "Text", "default": "Take two zero-sugar gummies every day." },
    { "type": "header", "content": "Reassurance point 2" },
    { "type": "text", "id": "p2_title", "label": "Title", "default": "Give it time to build" },
    { "type": "textarea", "id": "p2_text", "label": "Text", "default": "Some women notice early shifts within weeks. For the fullest picture, stay consistent for 90 days." },
    { "type": "header", "content": "Reassurance point 3" },
    { "type": "text", "id": "p3_title", "label": "Title", "default": "Feel the difference—or get refunded" },
    { "type": "textarea", "id": "p3_text", "label": "Text", "default": "If Womankind isn’t right for you, contact us within 90 days and get your money back." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Feel like yourself again" },
    { "type": "text", "id": "trust_text", "label": "Trust line", "default": "90-day money-back guarantee · Secure checkout" }
  ]
}
{% endschema %}
