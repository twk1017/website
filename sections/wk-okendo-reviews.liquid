{%- assign oke_product = section.settings.product | default: all_products['hormonal-support-gummies'] -%}

  <section id="reviews" style="max-width:1080px;margin:0 auto;padding:74px 28px;scroll-margin-top:80px;">
    {%- if section.settings.heading != blank -%}
      <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:38px;line-height:1.1;text-align:center;margin:0 0 8px;color:#6B3D42;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p style="max-width:560px;margin:0 auto 36px;text-align:center;font-size:16px;line-height:1.7;color:#5a4636;">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div data-oke-widget data-oke-reviews-product-id="shopify-{{ oke_product.id }}">{{ oke_product.metafields.okendo.ReviewsWidgetSnippet }}</div>
  </section>

{% schema %}
{
  "name": "WK - Okendo reviews",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Reviews are shown for this product. Leave empty to default to Hormonal Support Gummies." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What women are saying" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real reviews from women navigating perimenopause." }
  ]
}
{% endschema %}
