  <!-- MARQUEE -->
  {%- capture wk_marquee_items -%}
    {%- for i in (1..8) -%}
      {%- assign mk = 'item_' | append: i -%}
      {%- assign mv = section.settings[mk] -%}
      {%- if mv != blank -%}<span style="font-size:12.5px;letter-spacing:0.22em;text-transform:uppercase;font-weight:600;padding:0 26px;">{{ mv }}</span><span style="opacity:0.6;">✦</span>{%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  <div style="background:#C9653F;color:#F5E6D8;padding:15px 0;overflow:hidden;white-space:nowrap;">
    <div style="display:inline-flex;gap:0;animation:wk-marquee 28s linear infinite;will-change:transform;">
      <span style="display:inline-flex;align-items:center;">{{ wk_marquee_items }}</span>
      <span style="display:inline-flex;align-items:center;" aria-hidden="true">{{ wk_marquee_items }}</span>
    </div>
  </div>

{% schema %}
{
  "name": "WK - Marquee",
  "settings": [
    { "type": "text", "id": "item_1", "label": "Item 1", "default": "Gut–hormone delivery" },
    { "type": "text", "id": "item_2", "label": "Item 2", "default": "Third-party tested" },
    { "type": "text", "id": "item_3", "label": "Item 3", "default": "GMP & non-GMO" },
    { "type": "text", "id": "item_4", "label": "Item 4", "default": "No fillers or sugar" },
    { "type": "text", "id": "item_5", "label": "Item 5", "default": "Save 50% with a 3-month supply" },
    { "type": "text", "id": "item_6", "label": "Item 6", "default": "Clinically-backed ingredients" },
    { "type": "text", "id": "item_7", "label": "Item 7", "default": "Free carbon-neutral shipping on all subscriptions" },
    { "type": "text", "id": "item_8", "label": "Item 8", "default": "Made in Europe" }
  ]
}
{% endschema %}
