{%- assign wk_product = section.settings.product -%}
{%- if wk_product != blank -%}{%- assign wk_variant = wk_product.selected_or_first_available_variant -%}{%- assign wk_selling_plan = wk_product.selling_plan_groups.first.selling_plans.first -%}{%- endif -%}

  <!-- HERO / PDP -->
  <section style="max-width:1240px;margin:0 auto;padding:40px 28px 18px;display:grid;grid-template-columns:1.02fr 0.98fr;gap:54px;align-items:start;">

    <!-- GALLERY -->
    <div class="wk-gallery" style="position:sticky;top:96px;">
      <div class="wk-hero-img" style="position:relative;aspect-ratio:1/1;border-radius:18px;overflow:hidden;background:radial-gradient(120% 92% at 50% 16%, #ECDBCC 0%, #D8BFB4 52%, #C2A099 100%);">

        <!-- product placeholder (swap for real bottle image) -->
        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:rgba(107,61,66,0.62);text-align:center;padding:0 28px;">
          <span style="font-size:11px;letter-spacing:0.22em;text-transform:uppercase;font-weight:600;">Product · hero</span>
          <span style="font-size:11px;letter-spacing:0.16em;text-transform:uppercase;opacity:0.7;">1200 × 1200</span>
        </div>
      </div>

      <!-- thumbnail carousel -->
      <div style="display:flex;align-items:center;gap:10px;margin-top:14px;">
        <button type="button" class="wk-thumb-arrow" data-wk-thumb-prev aria-label="Previous image">&lsaquo;</button>
        <div class="wk-thumbs" data-wk-thumb-track>
          <div style="aspect-ratio:1/1;background:#D8C2BA;border-radius:9px;border:2px solid #6B3D42;display:flex;align-items:center;justify-content:center;font-size:9.5px;letter-spacing:0.12em;text-transform:uppercase;color:#6B3D42;text-align:center;font-weight:600;">Front</div>
          <div style="aspect-ratio:1/1;background:#D8C2BA;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:9.5px;letter-spacing:0.12em;text-transform:uppercase;color:#6B3D42;text-align:center;font-weight:600;">Detail</div>
          <div style="aspect-ratio:1/1;background:#D8C2BA;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:9.5px;letter-spacing:0.12em;text-transform:uppercase;color:#6B3D42;text-align:center;font-weight:600;">Formula</div>
          <div style="aspect-ratio:1/1;background:#D8C2BA;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:9.5px;letter-spacing:0.12em;text-transform:uppercase;color:#6B3D42;text-align:center;font-weight:600;">In&nbsp;hand</div>
          <div style="aspect-ratio:1/1;background:#D8C2BA;border-radius:9px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:9.5px;letter-spacing:0.12em;text-transform:uppercase;color:#6B3D42;text-align:center;font-weight:600;gap:3px;"><span style="font-size:15px;">&#9654;</span>Video</div>
        </div>
        <button type="button" class="wk-thumb-arrow" data-wk-thumb-next aria-label="Next image">&rsaquo;</button>
      </div>
    </div>

    <!-- BUY BOX -->
    <div>
      <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#C9653F;font-weight:600;margin-bottom:14px;">Daily · for perimenopause &amp; beyond</div>
      <h1 style="font-family:'Fraunces',serif;font-weight:400;font-size:48px;line-height:1.02;margin:0 0 14px;color:#6B3D42;letter-spacing:-0.01em;">hormonal support gummies</h1>

      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
        <span style="color:#C9653F;font-size:17px;letter-spacing:2px;">★★★★★</span>
        <span style="font-size:13.5px;color:#3A2A20;">4.8 &nbsp;·&nbsp; 1,200+ reviews</span>
      </div>

      <p style="font-size:15px;line-height:1.6;color:#4a3a30;margin:0 0 18px;max-width:30em;">A daily multi-symptom gummy for the four things that shift first — made with clinically-backed ingredients and a probiotic blend for the estrobolome. No hormones, no sugar.</p>

      <div style="display:flex;flex-direction:column;gap:11px;margin-bottom:22px;">
        <div style="display:flex;align-items:flex-start;gap:11px;font-size:14.5px;color:#3A2A20;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span><span>Eases hot flashes &amp; night sweats*</span></div>
        <div style="display:flex;align-items:flex-start;gap:11px;font-size:14.5px;color:#3A2A20;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span><span>Steadies mood &amp; the stress response*</span></div>
        <div style="display:flex;align-items:flex-start;gap:11px;font-size:14.5px;color:#3A2A20;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span><span>Calms bloating &amp; supports the gut*</span></div>
        <div style="display:flex;align-items:flex-start;gap:11px;font-size:14.5px;color:#3A2A20;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span><span>Supports hormonal balance through the transition*</span></div>
      </div>

      <blockquote style="border-left:2px solid #C9653F;margin:0 0 24px;padding:4px 0 4px 18px;">
        <p style="font-family:'Fraunces',serif;font-style:italic;font-size:17px;line-height:1.45;color:#6B3D42;margin:0 0 8px;">"Three weeks in and the 2am wake-ups have eased. I finally feel like myself in my own body again."</p>
        <cite style="font-style:normal;font-size:11.5px;letter-spacing:0.16em;text-transform:uppercase;color:#A07E81;font-weight:600;">— Margaret R., 47 · Verified, 3+ months</cite>
      </blockquote>

      <!-- FLAVOR -->
      <div style="font-size:11.5px;letter-spacing:0.22em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-bottom:10px;">Flavor</div>
      <div style="display:flex;gap:10px;margin-bottom:26px;flex-wrap:wrap;">
        <button data-wk="flavor" data-wk-val="cranberry" style="position:relative;cursor:pointer;font-family:inherit;background:#F5E6D8;border:1.5px solid #6B3D42;color:#6B3D42;border-radius:999px;padding:9px 18px;font-size:13px;letter-spacing:0.04em;">Deep-red cranberry<span data-wk-ring="flavor:cranberry" style="box-shadow:0 0 0 2px #6B3D42;position:absolute;inset:-1.5px;border-radius:999px;pointer-events:none;"></span></button>
      </div>

      <!-- SUPPLY TIERS -->
      <div style="display:flex;flex-direction:column;gap:11px;margin-bottom:22px;">
        <button data-wk="supply" data-wk-val="6" style="position:relative;cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.35);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;">
          <span data-wk-ring="supply:6" style="box-shadow:0 0 0 0 transparent;position:absolute;inset:-1.5px;border-radius:12px;pointer-events:none;"></span>
          <span style="position:absolute;top:-10px;left:18px;background:#6B3D42;color:#F5E6D8;font-size:10px;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;padding:3px 10px;border-radius:999px;">Best value</span>
          <span><span style="display:block;font-size:15.5px;font-weight:600;color:#6B3D42;">6-month supply</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">6 bottles · 180 servings · free shipping</span></span>
          <span style="text-align:right;flex:0 0 auto;"><span style="display:flex;align-items:baseline;justify-content:flex-end;gap:7px;"><span data-wk-compare="6" style="font-size:11px;text-decoration:line-through;color:#A07E81;">$252</span><span data-wk-total="6" style="font-size:19px;font-weight:700;color:#C9653F;">$113.40</span></span><span data-wk-permo-line="6" style="display:block;font-size:12.5px;color:#7a6258;font-weight:600;margin-top:1px;"><span data-wk-permo="6">$18.90</span><span data-wk-mo style="font-size:11px;font-weight:500;">/mo</span></span><span data-wk-save="6" style="display:block;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-top:2px;">Save 55%</span></span>
        </button>

        <button data-wk="supply" data-wk-val="3" style="position:relative;cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.35);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;">
          <span data-wk-ring="supply:3" style="box-shadow:0 0 0 2px #6B3D42;position:absolute;inset:-1.5px;border-radius:12px;pointer-events:none;"></span>
          <span style="position:absolute;top:-10px;left:18px;background:#C9653F;color:#F5E6D8;font-size:10px;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;padding:3px 10px;border-radius:999px;">Most popular</span>
          <span><span style="display:block;font-size:15.5px;font-weight:600;color:#6B3D42;">3-month supply</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">3 bottles · 90 servings · free shipping</span></span>
          <span style="text-align:right;flex:0 0 auto;"><span style="display:flex;align-items:baseline;justify-content:flex-end;gap:7px;"><span data-wk-compare="3" style="font-size:11px;text-decoration:line-through;color:#A07E81;">$126</span><span data-wk-total="3" style="font-size:19px;font-weight:700;color:#C9653F;">$66.15</span></span><span data-wk-permo-line="3" style="display:block;font-size:12.5px;color:#7a6258;font-weight:600;margin-top:1px;"><span data-wk-permo="3">$22.05</span><span data-wk-mo style="font-size:11px;font-weight:500;">/mo</span></span><span data-wk-save="3" style="display:block;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-top:2px;">Save 48%</span></span>
        </button>

        <button data-wk="supply" data-wk-val="1" style="position:relative;cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.35);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;">
          <span data-wk-ring="supply:1" style="box-shadow:0 0 0 0 transparent;position:absolute;inset:-1.5px;border-radius:12px;pointer-events:none;"></span>
          <span><span style="display:block;font-size:15.5px;font-weight:600;color:#6B3D42;">1-month supply</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">1 bottle · 30 servings · free shipping</span></span>
          <span style="text-align:right;flex:0 0 auto;"><span style="display:flex;align-items:baseline;justify-content:flex-end;gap:7px;"><span data-wk-compare="1" style="font-size:11px;text-decoration:line-through;color:#A07E81;">$42</span><span data-wk-total="1" style="font-size:19px;font-weight:700;color:#C9653F;">$31.50</span></span><span data-wk-permo-line="1" style="display:block;font-size:12.5px;color:#7a6258;font-weight:600;margin-top:1px;"><span data-wk-permo="1">$31.50</span><span data-wk-mo style="font-size:11px;font-weight:500;">/mo</span></span><span data-wk-save="1" style="display:block;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-top:2px;">Save 25%</span></span>
        </button>
      </div>

      <!-- AUTO REFILLS -->
      <div data-wk-refill role="checkbox" aria-checked="true" tabindex="0" style="display:flex;align-items:center;gap:14px;border:1.5px dashed rgba(107,61,66,0.45);border-radius:12px;padding:16px 18px;cursor:pointer;margin-bottom:14px;">
        <span data-wk-refill-box style="width:24px;height:24px;flex:0 0 auto;border:1.5px solid #6B3D42;border-radius:6px;display:flex;align-items:center;justify-content:center;background:#6B3D42;"><span data-wk-refill-check style="color:#F5E6D8;font-size:14px;font-weight:700;line-height:1;display:block;">&check;</span></span>
        <span style="flex:1;"><span style="display:block;font-size:15px;font-weight:700;color:#6B3D42;">Save 25% with automatic refills</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">Zero commitment &mdash; pause, skip, or cancel anytime</span></span>
      </div>

      <!-- ADD TO CART -->
      {%- if wk_product != blank -%}
        <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" enctype="multipart/form-data" data-wk-form>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ wk_variant.id }}">
          <input type="hidden" name="quantity" value="3" data-wk-qty>
          <input type="hidden" name="selling_plan" value="{{ wk_selling_plan.id }}" data-wk-selling-plan disabled>
          <button type="submit"{% unless wk_variant.available %} disabled{% endunless %} style="width:100%;cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:18px;font-size:15px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:12px;{% unless wk_variant.available %}opacity:0.55;cursor:not-allowed;{% endunless %}">
            {%- if wk_variant.available -%}
              Add to bag <span style="opacity:0.85;">— <span data-wk-atc-total>{{ wk_variant.price | times: 3 | money }}</span></span>
            {%- else -%}
              Sold out
            {%- endif -%}
          </button>
        </form>
      {%- else -%}
        <button style="width:100%;cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:18px;font-size:15px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:12px;">Select a product</button>
      {%- endif -%}
      <div style="display:flex;align-items:center;justify-content:center;gap:11px;margin:16px 0 0;">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;border:1.5px solid #C9653F;color:#C9653F;font-size:11px;font-weight:700;flex:0 0 auto;line-height:1;">90</span>
        <span style="font-size:12.5px;color:#6B3D42;font-weight:600;letter-spacing:0.02em;">Try it for a full 90 days — love it or your money back</span>
      </div>
      <p style="text-align:center;font-size:12px;color:#7a6258;margin:11px 0 0;letter-spacing:0.04em;">Pause, skip, or cancel anytime</p>
    </div>
  </section>


<script>

(function(){
  var root = document.querySelector('.wk-root');
  if (!root || root.dataset.wkInit) return;
  root.dataset.wkInit = '1';
  var RING = '0 0 0 2px #6B3D42', NONE = '0 0 0 0 transparent';
  var state = { flavor:'cranberry', supply:'3' };

  function applySelection(group){
    var val = state[group];
    root.querySelectorAll('[data-wk-ring]').forEach(function(el){
      var parts = el.getAttribute('data-wk-ring').split(':');
      if (parts[0] !== group) return;
      el.style.boxShadow = (parts[1] === val) ? RING : NONE;
    });
  }
  // --- pricing model: $42/bottle base; tier % is applied by Shopify automatic discounts, +25% by the subscribe & save selling plan ---
  var BOTTLE = {{ wk_variant.price | default: 4200 }};          // cents, read live from the variant price
  var SELLING_PLAN = {{ wk_selling_plan.id | default: 'null' }}; // subscription selling plan, auto-detected off the product
  var TIERS = { '1': { m: 1, off: 0 }, '3': { m: 3, off: 0.30 }, '6': { m: 6, off: 0.40 } };
  var SUB_OFF = 0.25;
  var wkRefillEl = root.querySelector('[data-wk-refill]');

  function wkMoney(cents){ return '$' + (cents / 100).toFixed(2).replace(/\.00$/, ''); }
  function refillIsOn(){ return !!(wkRefillEl && wkRefillEl.getAttribute('aria-checked') === 'true'); }
  function wkQuote(tier, on){
    var t = TIERS[tier];
    var full = BOTTLE * t.m;
    var afterTier = Math.round(full * (1 - t.off));
    var total = on ? Math.round(afterTier * (1 - SUB_OFF)) : afterTier;
    return { full: full, total: total, perMo: Math.round(total / t.m), save: Math.round((1 - total / full) * 100) };
  }

  // recompute every displayed price from the selected tier + refill state.
  // line 1 always shows the full pack total beside the struck-through compare price.
  // the "$X/mo" line only appears when refills (subscription) are ON.
  function applyPricing(){
    var on = refillIsOn();
    ['1','3','6'].forEach(function(k){
      var q = wkQuote(k, on);
      root.querySelectorAll('[data-wk-total="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.total); });
      root.querySelectorAll('[data-wk-permo="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.perMo); });
      root.querySelectorAll('[data-wk-permo-line="'+k+'"]').forEach(function(e){ e.style.display = on ? '' : 'none'; });
      root.querySelectorAll('[data-wk-compare="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.full); e.style.visibility = q.save > 0 ? 'visible' : 'hidden'; });
      root.querySelectorAll('[data-wk-save="'+k+'"]').forEach(function(e){ e.textContent = 'Save ' + q.save + '%'; e.style.visibility = q.save > 0 ? 'visible' : 'hidden'; });
    });
    root.querySelectorAll('[data-wk-atc-total]').forEach(function(e){ e.textContent = wkMoney(wkQuote(state.supply, on).total); });
  }

  // sync cart quantity + attach the subscription selling plan only when refills are on (and one exists)
  function applyCart(){
    var sub = refillIsOn() && SELLING_PLAN;
    root.querySelectorAll('[data-wk-qty]').forEach(function(i){ i.value = state.supply; });
    root.querySelectorAll('[data-wk-selling-plan]').forEach(function(i){ i.disabled = !sub; });
  }

  function applySupply(){ applyCart(); applyPricing(); }

  root.querySelectorAll('[data-wk]').forEach(function(el){
    el.addEventListener('click', function(){
      var g = el.getAttribute('data-wk');
      state[g] = el.getAttribute('data-wk-val');
      applySelection(g);
      if (g === 'supply') applySupply();
    });
  });
  applySupply();

  function bindAccordion(btnAttr, panelAttr){
    root.querySelectorAll('['+btnAttr+']').forEach(function(btn){
      btn.addEventListener('click', function(){
        var id = btn.getAttribute(btnAttr);
        var panel = root.querySelector('['+panelAttr+'="'+id+'"]');
        var isOpen = panel && panel.style.display !== 'none';
        root.querySelectorAll('['+panelAttr+']').forEach(function(p){ p.style.display = 'none'; });
        if (!isOpen && panel) panel.style.display = 'block';
      });
    });
  }
  bindAccordion('data-wk-faq', 'data-wk-faq-panel');

  // testimonial carousel: arrows scroll by one card, progress bar tracks position
  var track = root.querySelector('[data-wk-track]');
  if (track) {
    var prevBtn = root.querySelector('[data-wk-prev]');
    var nextBtn = root.querySelector('[data-wk-next]');
    var bar = root.querySelector('[data-wk-bar]');
    function cardStep() {
      var card = track.querySelector('[data-wk-card]');
      return card ? card.getBoundingClientRect().width + 22 : track.clientWidth;
    }
    if (prevBtn) prevBtn.addEventListener('click', function(){ track.scrollBy({ left: -cardStep(), behavior: 'smooth' }); });
    if (nextBtn) nextBtn.addEventListener('click', function(){ track.scrollBy({ left: cardStep(), behavior: 'smooth' }); });
    function updateBar() {
      if (!bar) return;
      var max = track.scrollWidth - track.clientWidth;
      var ratio = max > 0 ? track.scrollLeft / max : 0;
      bar.style.width = (33 + ratio * 67) + '%';
    }
    track.addEventListener('scroll', updateBar, { passive: true });
    window.addEventListener('resize', updateBar);
    updateBar();
  }

  // experts carousel: dot indicator (mobile) reflects + drives the scroll position
  var eg = root.querySelector('.wk-experts-grid');
  var dotsWrap = root.querySelector('.wk-experts-dots');
  if (eg && dotsWrap) {
    var dots = dotsWrap.querySelectorAll('span');
    var cards = eg.children;
    function egStep() {
      return (cards.length > 1)
        ? (cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left)
        : eg.clientWidth;
    }
    function egUpdate() {
      var step = egStep() || eg.clientWidth;
      var idx = Math.round(eg.scrollLeft / step);
      idx = Math.max(0, Math.min(dots.length - 1, idx));
      for (var i = 0; i < dots.length; i++) dots[i].classList.toggle('is-active', i === idx);
    }
    eg.addEventListener('scroll', egUpdate, { passive: true });
    window.addEventListener('resize', egUpdate);
    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        if (!cards[i]) return;
        var target = eg.scrollLeft + (cards[i].getBoundingClientRect().left - eg.getBoundingClientRect().left);
        eg.scrollTo({ left: target, behavior: 'smooth' });
      });
    });
    egUpdate();
  }
  // auto-refill checkbox (current buy-box) — visual toggle
  var wkRefill = root.querySelector('[data-wk-refill]');
  if (wkRefill) {
    var wkRefillBox = wkRefill.querySelector('[data-wk-refill-box]');
    var wkRefillCheck = wkRefill.querySelector('[data-wk-refill-check]');
    function wkToggleRefill() {
      var on = wkRefill.getAttribute('aria-checked') === 'true';
      wkRefill.setAttribute('aria-checked', on ? 'false' : 'true');
      if (wkRefillBox) wkRefillBox.style.background = on ? 'transparent' : '#6B3D42';
      if (wkRefillCheck) wkRefillCheck.style.display = on ? 'none' : 'block';
      applyPricing();
      applyCart();
    }
    wkRefill.addEventListener('click', wkToggleRefill);
    wkRefill.addEventListener('keydown', function (e) { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); wkToggleRefill(); } });
  }

  // ingredient carousel: arrows scroll by one card, progress bar tracks position
  var ingTrack = root.querySelector('[data-wk-ing-track]');
  if (ingTrack) {
    var ingPrev = root.querySelector('[data-wk-ing-prev]');
    var ingNext = root.querySelector('[data-wk-ing-next]');
    var ingBar = root.querySelector('[data-wk-ing-bar]');
    function ingStep() {
      var c = ingTrack.querySelector('[data-wk-ing-card]');
      return c ? c.getBoundingClientRect().width + 18 : ingTrack.clientWidth;
    }
    if (ingPrev) ingPrev.addEventListener('click', function () { ingTrack.scrollBy({ left: -ingStep(), behavior: 'smooth' }); });
    if (ingNext) ingNext.addEventListener('click', function () { ingTrack.scrollBy({ left: ingStep(), behavior: 'smooth' }); });
    function ingBarUpdate() {
      if (!ingBar) return;
      var max = ingTrack.scrollWidth - ingTrack.clientWidth;
      var ratio = max > 0 ? ingTrack.scrollLeft / max : 0;
      ingBar.style.width = (33 + ratio * 67) + '%';
    }
    ingTrack.addEventListener('scroll', ingBarUpdate, { passive: true });
    window.addEventListener('resize', ingBarUpdate);
    ingBarUpdate();
  }

  // supplement facts lightbox: open on button, close via X / overlay click / Esc
  var sfOverlay = root.querySelector('[data-wk-suppfacts-overlay]');
  if (sfOverlay) {
    var sfDialog = sfOverlay.querySelector('[data-wk-suppfacts-dialog]');
    function sfOpen() {
      sfOverlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    function sfClose() {
      sfOverlay.style.display = 'none';
      document.body.style.overflow = '';
    }
    root.querySelectorAll('[data-wk-suppfacts-open]').forEach(function (btn) {
      btn.addEventListener('click', sfOpen);
    });
    root.querySelectorAll('[data-wk-suppfacts-close]').forEach(function (btn) {
      btn.addEventListener('click', sfClose);
    });
    sfOverlay.addEventListener('click', function (e) {
      if (sfDialog && !sfDialog.contains(e.target)) sfClose();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && sfOverlay.style.display === 'flex') sfClose();
    });
  }

  // hero thumbnail carousel: arrows scroll the thumbnail strip
  var thumbTrack = root.querySelector('[data-wk-thumb-track]');
  if (thumbTrack) {
    var thumbPrev = root.querySelector('[data-wk-thumb-prev]');
    var thumbNext = root.querySelector('[data-wk-thumb-next]');
    function thumbStep() {
      var c = thumbTrack.querySelector('div');
      return c ? c.getBoundingClientRect().width + 10 : thumbTrack.clientWidth;
    }
    if (thumbPrev) thumbPrev.addEventListener('click', function () { thumbTrack.scrollBy({ left: -thumbStep() * 2, behavior: 'smooth' }); });
    if (thumbNext) thumbNext.addEventListener('click', function () { thumbTrack.scrollBy({ left: thumbStep() * 2, behavior: 'smooth' }); });
  }

  // expect / use / shipping tabs: one panel visible at a time
  var xtabs = root.querySelectorAll('[data-wk-xtab]');
  if (xtabs.length) {
    xtabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-wk-xtab');
        xtabs.forEach(function (b) {
          var on = b.getAttribute('data-wk-xtab') === id;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        root.querySelectorAll('[data-wk-xpanel]').forEach(function (p) {
          p.classList.toggle('is-active', p.getAttribute('data-wk-xpanel') === id);
        });
      });
    });
  }
})();
</script>

