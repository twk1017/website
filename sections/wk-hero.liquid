{%- assign wk_product = section.settings.product -%}
{%- if wk_product != blank -%}{%- assign wk_variant = wk_product.selected_or_first_available_variant -%}{%- assign wk_selling_plan = wk_product.selling_plan_groups.first.selling_plans.first -%}{%- endif -%}

  <!-- HERO / PDP -->
  <section style="max-width:1240px;margin:0 auto;padding:40px 28px 18px;display:grid;grid-template-columns:1.02fr 0.98fr;gap:54px;align-items:start;">

    <!-- GALLERY -->
    <div class="wk-gallery" style="position:sticky;top:96px;">
      {%- comment -%} Build the gallery: image_picker override if set, else fall back to assets/wk-buybox-N.jpg {%- endcomment -%}
      {%- assign wk_first_full = '' -%}{%- assign wk_first_alt = '' -%}
      {%- for i in (1..8) -%}
        {%- assign gik = 'gallery_' | append: i | append: '_image' -%}
        {%- assign gimg = section.settings[gik] -%}
        {%- if gimg -%}{%- assign wk_full = gimg | image_url: width: 1200 -%}{%- assign wk_galt = gimg.alt | default: 'Womankind Hormonal Support Gummies' -%}
        {%- else -%}{%- assign gfname = 'wk-buybox-' | append: i | append: '.jpg' -%}{%- assign wk_full = gfname | asset_url -%}{%- assign wk_galt = 'Womankind Hormonal Support Gummies' -%}{%- endif -%}
        {%- if forloop.first -%}{%- assign wk_first_full = wk_full -%}{%- assign wk_first_alt = wk_galt -%}{%- endif -%}
      {%- endfor -%}
      <div class="wk-hero-img" style="position:relative;aspect-ratio:1/1;border-radius:18px;overflow:hidden;background:radial-gradient(120% 92% at 50% 16%, #ECDBCC 0%, #D8BFB4 52%, #C2A099 100%);">
        <img data-wk-hero-img src="{{ wk_first_full }}" alt="{{ wk_first_alt }}" width="1200" height="1200" loading="eager" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;">
        <span data-wk-badge>{% render 'wk-clinicians-badge', text: section.settings.badge, image: section.settings.badge_image %}</span>
      </div>

      <!-- thumbnail carousel -->
      <div style="display:flex;align-items:center;gap:10px;margin-top:14px;">
        <button type="button" class="wk-thumb-arrow" data-wk-thumb-prev aria-label="Previous image">&lsaquo;</button>
        <div class="wk-thumbs" data-wk-thumb-track>
          {%- for i in (1..8) -%}
            {%- assign gik = 'gallery_' | append: i | append: '_image' -%}
            {%- assign gimg = section.settings[gik] -%}
            {%- if gimg -%}{%- assign tsrc = gimg | image_url: width: 240 -%}{%- assign tfull = gimg | image_url: width: 1200 -%}{%- assign talt = gimg.alt | default: 'Womankind Hormonal Support Gummies' -%}
            {%- else -%}{%- assign gfname = 'wk-buybox-' | append: i | append: '.jpg' -%}{%- assign tsrc = gfname | asset_img_url: '240x240' -%}{%- assign tfull = gfname | asset_url -%}{%- assign talt = 'Womankind Hormonal Support Gummies' -%}{%- endif -%}
            <button type="button" data-wk-thumb data-wk-full="{{ tfull }}" aria-label="View image {{ i }}" style="cursor:pointer;padding:0;aspect-ratio:1/1;background:#D8C2BA;border-radius:9px;overflow:hidden;{% if forloop.first %}border:2px solid #6B3D42;{% else %}border:2px solid transparent;{% endif %}display:flex;align-items:center;justify-content:center;">
              <img src="{{ tsrc }}" alt="{{ talt }}" width="240" height="240" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
            </button>
          {%- endfor -%}
        </div>
        <button type="button" class="wk-thumb-arrow" data-wk-thumb-next aria-label="Next image">&rsaquo;</button>
      </div>
    </div>

    <!-- BUY BOX -->
    <div>
      <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#C9653F;font-weight:600;margin-bottom:14px;">{{ section.settings.eyebrow }}</div>
      <h1 style="font-family:'Fraunces',serif;font-weight:400;font-size:48px;line-height:1.02;margin:0 0 14px;color:#6B3D42;letter-spacing:-0.01em;">{{ section.settings.heading }}</h1>

      {%- assign oke_product = wk_product | default: all_products['hormonal-support-gummies'] -%}
      <div data-oke-star-rating data-oke-reviews-product-id="shopify-{{ oke_product.id }}" style="margin-bottom:16px;">{{ oke_product.metafields.okendo.StarRatingSnippet }}</div>

      <p style="font-size:15px;line-height:1.6;color:#4a3a30;margin:0 0 18px;max-width:30em;">{{ section.settings.description }}</p>

      <div style="display:flex;flex-direction:column;gap:11px;margin-bottom:22px;">
        {%- for i in (1..4) -%}{%- assign bk = 'benefit_' | append: i -%}{%- assign bt = section.settings[bk] -%}{%- if bt != blank -%}<div style="display:flex;align-items:flex-start;gap:11px;font-size:14.5px;color:#3A2A20;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span><span>{{ bt }}</span></div>{%- endif -%}{%- endfor -%}
      </div>

      <!-- FLAVOR -->
      <div style="font-size:11.5px;letter-spacing:0.22em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-bottom:10px;">{{ section.settings.flavor_label }}</div>
      <div style="display:flex;gap:10px;margin-bottom:26px;flex-wrap:wrap;">
        <button data-wk="flavor" data-wk-val="cranberry" style="position:relative;cursor:pointer;font-family:inherit;background:#F5E6D8;border:1.5px solid #6B3D42;color:#6B3D42;border-radius:999px;padding:9px 18px;font-size:13px;letter-spacing:0.04em;">{{ section.settings.flavor_pill }}<span data-wk-ring="flavor:cranberry" style="box-shadow:0 0 0 2px #6B3D42;position:absolute;inset:-1.5px;border-radius:999px;pointer-events:none;"></span></button>
      </div>

      <!-- SUPPLY TIERS -->
      <div style="display:flex;flex-direction:column;gap:11px;margin-bottom:22px;">
        <button data-wk="supply" data-wk-val="6" style="position:relative;cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.35);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;">
          <span data-wk-ring="supply:6" style="box-shadow:0 0 0 0 transparent;position:absolute;inset:-1.5px;border-radius:12px;pointer-events:none;"></span>
          <span style="position:absolute;top:-10px;left:18px;background:#6B3D42;color:#F5E6D8;font-size:10px;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;padding:3px 10px;border-radius:999px;">{{ section.settings.tier6_badge }}</span>
          <span><span style="display:block;font-size:15.5px;font-weight:600;color:#6B3D42;">{{ section.settings.tier6_name }}</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">{{ section.settings.tier6_sub }}</span></span>
          <span style="text-align:right;flex:0 0 auto;"><span style="display:flex;align-items:baseline;justify-content:flex-end;gap:7px;"><span data-wk-compare="6" style="font-size:11px;text-decoration:line-through;color:#A07E81;">$252</span><span data-wk-total="6" style="font-size:19px;font-weight:700;color:#C9653F;">$122.85</span></span><span data-wk-permo-line="6" style="display:block;font-size:12.5px;color:#7a6258;font-weight:600;margin-top:1px;"><span data-wk-permo="6">$20.48</span><span data-wk-mo style="font-size:11px;font-weight:500;">/mo</span></span><span data-wk-save="6" style="display:block;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-top:2px;">Save 51%</span></span>
        </button>

        <button data-wk="supply" data-wk-val="3" style="position:relative;cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.35);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;">
          <span data-wk-ring="supply:3" style="box-shadow:0 0 0 2px #6B3D42;position:absolute;inset:-1.5px;border-radius:12px;pointer-events:none;"></span>
          <span style="position:absolute;top:-10px;left:18px;background:#C9653F;color:#F5E6D8;font-size:10px;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;padding:3px 10px;border-radius:999px;">{{ section.settings.tier3_badge }}</span>
          <span><span style="display:block;font-size:15.5px;font-weight:600;color:#6B3D42;">{{ section.settings.tier3_name }}</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">{{ section.settings.tier3_sub }}</span></span>
          <span style="text-align:right;flex:0 0 auto;"><span style="display:flex;align-items:baseline;justify-content:flex-end;gap:7px;"><span data-wk-compare="3" style="font-size:11px;text-decoration:line-through;color:#A07E81;">$126</span><span data-wk-total="3" style="font-size:19px;font-weight:700;color:#C9653F;">$70.88</span></span><span data-wk-permo-line="3" style="display:block;font-size:12.5px;color:#7a6258;font-weight:600;margin-top:1px;"><span data-wk-permo="3">$23.63</span><span data-wk-mo style="font-size:11px;font-weight:500;">/mo</span></span><span data-wk-save="3" style="display:block;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-top:2px;">Save 44%</span></span>
        </button>

        <button data-wk="supply" data-wk-val="1" style="position:relative;cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.35);border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;">
          <span data-wk-ring="supply:1" style="box-shadow:0 0 0 0 transparent;position:absolute;inset:-1.5px;border-radius:12px;pointer-events:none;"></span>
          <span><span style="display:block;font-size:15.5px;font-weight:600;color:#6B3D42;">{{ section.settings.tier1_name }}</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">{{ section.settings.tier1_sub }}<span data-wk-ship1> · free shipping</span></span></span>
          <span style="text-align:right;flex:0 0 auto;"><span style="display:flex;align-items:baseline;justify-content:flex-end;gap:7px;"><span data-wk-compare="1" style="font-size:11px;text-decoration:line-through;color:#A07E81;">$42</span><span data-wk-total="1" style="font-size:19px;font-weight:700;color:#C9653F;">$31.50</span></span><span data-wk-permo-line="1" style="display:block;font-size:12.5px;color:#7a6258;font-weight:600;margin-top:1px;"><span data-wk-permo="1">$31.50</span><span data-wk-mo style="font-size:11px;font-weight:500;">/mo</span></span><span data-wk-save="1" style="display:block;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-top:2px;">Save 25%</span></span>
        </button>
      </div>

      <!-- AUTO REFILLS -->
      <div data-wk-refill role="checkbox" aria-checked="true" tabindex="0" style="display:flex;align-items:center;gap:14px;border:1.5px dashed rgba(107,61,66,0.45);border-radius:12px;padding:16px 18px;cursor:pointer;margin-bottom:14px;">
        <span data-wk-refill-box style="width:24px;height:24px;flex:0 0 auto;border:1.5px solid #6B3D42;border-radius:6px;display:flex;align-items:center;justify-content:center;background:#6B3D42;"><span data-wk-refill-check style="color:#F5E6D8;font-size:14px;font-weight:700;line-height:1;display:block;">&check;</span></span>
        <span style="flex:1;"><span style="display:block;font-size:15px;font-weight:700;color:#6B3D42;">{{ section.settings.refill_title }}</span><span style="display:block;font-size:12.5px;color:#7a6258;margin-top:2px;">{{ section.settings.refill_subtitle }}</span></span>
      </div>

      <!-- ADD TO CART -->
      {%- if wk_product != blank -%}
        <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" enctype="multipart/form-data" data-wk-form>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ wk_variant.id }}">
          <input type="hidden" name="quantity" value="3" data-wk-qty>
          <input type="hidden" name="selling_plan" value="{{ wk_selling_plan.id }}" data-wk-selling-plan disabled>
          <button type="submit"{% unless wk_variant.available %} disabled{% endunless %} style="width:100%;cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:18px;font-size:15px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:12px;{% unless wk_variant.available %}opacity:0.55;cursor:not-allowed;{% endunless %}">
            {%- if wk_variant.available -%}
              {{ section.settings.atc_label }} <span style="opacity:0.85;">— <span data-wk-atc-total>{{ wk_variant.price | times: 3 | money }}</span></span>
            {%- else -%}
              Sold out
            {%- endif -%}
          </button>
        </form>
      {%- else -%}
        <button style="width:100%;cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:18px;font-size:15px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:12px;">Select a product</button>
      {%- endif -%}
      <div style="display:flex;align-items:center;justify-content:center;gap:11px;margin:16px 0 0;">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;border:1.5px solid #C9653F;color:#C9653F;font-size:11px;font-weight:700;flex:0 0 auto;line-height:1;">{{ section.settings.guarantee_badge }}</span>
        <span style="font-size:12.5px;color:#6B3D42;font-weight:600;letter-spacing:0.02em;">{{ section.settings.guarantee_text }}</span>
      </div>
      <div style="display:flex;align-items:center;justify-content:center;gap:7px;margin:11px 0 0;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#7a6258;font-weight:600;"><span aria-hidden="true" style="color:#C9653F;">★</span> Made in USA</div>

      <!-- WHAT TO EXPECT / HOW TO USE / SHIPPING TABS (part of the buy-box, so the sticky gallery pins past it) -->
      <style>
        #wk-{{ section.id }}-tabs { margin-top:30px; }
        #wk-{{ section.id }}-tabs [data-wk-xpanel="use"].is-active,
        #wk-{{ section.id }}-tabs [data-wk-xpanel="ship"].is-active { display:block; }
        #wk-{{ section.id }}-tabs .wk-xpanel.is-active { grid-template-columns:1fr; gap:30px; }
        #wk-{{ section.id }}-tabs .wk-xt-simple { max-width:none; color:#F5E6D8; }
        #wk-{{ section.id }}-tabs .wk-xt-simple ul { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr; gap:14px; }
        #wk-{{ section.id }}-tabs .wk-xt-simple li { position:relative; padding-left:20px; font-size:15px; line-height:1.5; color:rgba(245,230,216,0.9); }
        #wk-{{ section.id }}-tabs .wk-xt-simple li::before { content:'•'; position:absolute; left:0; color:#C9653F; }
        #wk-{{ section.id }}-tabs .wk-xt-simple p { margin:0 0 14px; font-size:15px; line-height:1.6; color:rgba(245,230,216,0.9); }
      </style>
      <div id="wk-{{ section.id }}-tabs">
        <div class="wk-xt">
          <div class="wk-xt-tabs" role="tablist">
            <button class="wk-xtab is-active" data-wk-xtab="expect" role="tab" aria-selected="true" type="button">{{ section.settings.tab1_label }}</button>
            <button class="wk-xtab" data-wk-xtab="use" role="tab" aria-selected="false" type="button">{{ section.settings.tab2_label }}</button>
            <button class="wk-xtab" data-wk-xtab="ship" role="tab" aria-selected="false" type="button">{{ section.settings.tab3_label }}</button>
          </div>
          <div class="wk-xt-body">

            <!-- WHAT TO EXPECT: 3-stage timeline with icons -->
            <div class="wk-xpanel is-active" data-wk-xpanel="expect" role="tabpanel">
              {%- for ci in (1..3) -%}
                {%- assign ek = 'c' | append: ci | append: '_eyebrow' -%}
                {%- assign tk = 'c' | append: ci | append: '_title' -%}
                <div>
                  <div style="display:flex;align-items:center;gap:13px;margin-bottom:18px;">
                    <span style="display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:11px;background:rgba(245,230,216,0.09);color:#E2A24C;flex:0 0 auto;">{%- case ci -%}{%- when 1 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12C12 8 9.5 5 5 5c0 4.5 2.5 7 7 7z"/><path d="M12 14c0-3 2.5-6 7-6 0 4-2.5 6-7 6z"/></svg>{%- when 2 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>{%- when 3 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>{%- endcase -%}</span>
                    <div><div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#E2A24C;font-weight:700;margin-bottom:3px;">{{ section.settings[ek] }}</div><h3 style="font-family:'Fraunces',serif;font-weight:500;font-size:20px;line-height:1.15;color:#F5E6D8;margin:0;">{{ section.settings[tk] }}</h3></div>
                  </div>
                  <ul style="list-style:none;display:flex;flex-direction:column;gap:11px;">
                    {%- for bi in (1..3) -%}
                      {%- assign bk = 'c' | append: ci | append: '_b' | append: bi -%}
                      {%- assign bt = section.settings[bk] -%}
                      {%- if bt != blank -%}<li style="display:flex;gap:11px;font-size:14px;line-height:1.5;color:rgba(245,230,216,0.82);"><span style="color:#C9653F;flex:0 0 auto;">&bull;</span><span>{{ bt }}</span></li>{%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endfor -%}
            </div>

            <!-- HOW TO USE: simple list -->
            <div class="wk-xpanel" data-wk-xpanel="use" role="tabpanel">
              <div class="wk-xt-simple">{{ section.settings.use_content }}</div>
            </div>

            <!-- SHIPPING: simple list -->
            <div class="wk-xpanel" data-wk-xpanel="ship" role="tabpanel">
              <div class="wk-xt-simple">{{ section.settings.ship_content }}</div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>


<script>

(function(){
  function wkInit(){
  var root = document.querySelector('.wk-root');
  if (!root || root.dataset.wkInit) return;
  root.dataset.wkInit = '1';
  var RING = '0 0 0 2px #6B3D42', NONE = '0 0 0 0 transparent';
  var state = { flavor:'cranberry', supply:'3' };

  function applySelection(group){
    var val = state[group];
    root.querySelectorAll('[data-wk-ring]').forEach(function(el){
      var parts = el.getAttribute('data-wk-ring').split(':');
      if (parts[0] !== group) return;
      el.style.boxShadow = (parts[1] === val) ? RING : NONE;
    });
  }
  // --- pricing model: $42/bottle base; tier % is applied by Shopify automatic discounts, +25% by the subscribe & save selling plan ---
  var BOTTLE = {{ wk_variant.price | default: 4200 }};          // cents, read live from the variant price
  // Every subscription selling plan on the product, emitted so we can match one to each tier by delivery frequency.
  var SELLING_PLANS = [
    {%- assign wk_sp_first = true -%}
    {%- for grp in wk_product.selling_plan_groups -%}{%- for sp in grp.selling_plans -%}
      {%- unless wk_sp_first %},{% endunless %}{ id: {{ sp.id }}, name: {{ sp.name | json }} }{%- assign wk_sp_first = false -%}
    {%- endfor -%}{%- endfor -%}
  ];
  // Optional manual overrides (Theme editor). Only used if auto-matching picks the wrong plan.
  var PLAN_OVERRIDES = { '1': {{ section.settings.plan_1_id | default: 'null' }}, '3': {{ section.settings.plan_3_id | default: 'null' }}, '6': {{ section.settings.plan_6_id | default: 'null' }} };
  function wkParseInterval(name){
    name = (name || '').toLowerCase();
    if (/quarter/.test(name)) return 3;
    var m = name.match(/(\d+)\s*-?\s*month/); if (m) return parseInt(m[1], 10);
    if (/month/.test(name)) return 1;
    if (/annual|year/.test(name)) return 12;
    return 0;
  }
  function planForTier(tier){
    if (PLAN_OVERRIDES[tier]) return PLAN_OVERRIDES[tier];
    var want = { '1':1, '3':3, '6':6 }[tier];
    for (var i=0;i<SELLING_PLANS.length;i++){ if (wkParseInterval(SELLING_PLANS[i].name) === want) return SELLING_PLANS[i].id; }
    return SELLING_PLANS.length ? SELLING_PLANS[0].id : null;
  }
  var TIERS = { '1': { m: 1, off: 0 }, '3': { m: 3, off: 0.25 }, '6': { m: 6, off: 0.35 } };
  var SUB_OFF = 0.25;
  var wkRefillEl = root.querySelector('[data-wk-refill]');

  function wkMoney(cents){ return '$' + (cents / 100).toFixed(2).replace(/\.00$/, ''); }
  function refillIsOn(){ return !!(wkRefillEl && wkRefillEl.getAttribute('aria-checked') === 'true'); }
  function wkQuote(tier, on){
    var t = TIERS[tier];
    var full = BOTTLE * t.m;
    // Shopify rounds the discounted price per bottle, then multiplies — mirror that so the buy-box matches the cart/checkout exactly.
    var perUnit = on ? Math.round(BOTTLE * (1 - t.off) * (1 - SUB_OFF)) : Math.round(BOTTLE * (1 - t.off));
    var total = perUnit * t.m;
    return { full: full, total: total, perMo: perUnit, save: Math.round((1 - total / full) * 100) };
  }

  // recompute every displayed price from the selected tier + refill state.
  // line 1 always shows the full pack total beside the struck-through compare price.
  // the "$X/mo" line only appears when refills (subscription) are ON.
  function applyPricing(){
    var on = refillIsOn();
    ['1','3','6'].forEach(function(k){
      var q = wkQuote(k, on);
      root.querySelectorAll('[data-wk-total="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.total); });
      root.querySelectorAll('[data-wk-permo="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.perMo); });
      root.querySelectorAll('[data-wk-permo-line="'+k+'"]').forEach(function(e){ e.style.display = on ? '' : 'none'; });
      root.querySelectorAll('[data-wk-compare="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.full); e.style.visibility = q.save > 0 ? 'visible' : 'hidden'; });
      root.querySelectorAll('[data-wk-save="'+k+'"]').forEach(function(e){ e.textContent = 'Save ' + q.save + '%'; e.style.visibility = q.save > 0 ? 'visible' : 'hidden'; });
    });
    root.querySelectorAll('[data-wk-atc-total]').forEach(function(e){ e.textContent = wkMoney(wkQuote(state.supply, on).total); });
    // 1-month supply only gets free shipping with a subscription (3 & 6 month are always free)
    root.querySelectorAll('[data-wk-ship1]').forEach(function(e){ e.style.display = on ? '' : 'none'; });
  }

  // sync cart quantity + attach the subscription selling plan only when refills are on (and one exists)
  function applyCart(){
    var planId = planForTier(state.supply);
    var sub = refillIsOn() && planId;
    root.querySelectorAll('[data-wk-qty]').forEach(function(i){ i.value = state.supply; });
    root.querySelectorAll('[data-wk-selling-plan]').forEach(function(i){ if (planId) i.value = planId; i.disabled = !sub; });
  }

  function applySupply(){ applyCart(); applyPricing(); }

  root.querySelectorAll('[data-wk]').forEach(function(el){
    el.addEventListener('click', function(){
      var g = el.getAttribute('data-wk');
      state[g] = el.getAttribute('data-wk-val');
      applySelection(g);
      if (g === 'supply') applySupply();
    });
  });
  applySupply();

  function bindAccordion(btnAttr, panelAttr){
    root.querySelectorAll('['+btnAttr+']').forEach(function(btn){
      btn.addEventListener('click', function(){
        var id = btn.getAttribute(btnAttr);
        var panel = root.querySelector('['+panelAttr+'="'+id+'"]');
        var isOpen = panel && panel.style.display !== 'none';
        root.querySelectorAll('['+panelAttr+']').forEach(function(p){ p.style.display = 'none'; });
        if (!isOpen && panel) panel.style.display = 'block';
      });
    });
  }
  bindAccordion('data-wk-faq', 'data-wk-faq-panel');

  // testimonial carousel: arrows scroll by one card, progress bar tracks position
  var track = root.querySelector('[data-wk-track]');
  if (track) {
    var prevBtn = root.querySelector('[data-wk-prev]');
    var nextBtn = root.querySelector('[data-wk-next]');
    var bar = root.querySelector('[data-wk-bar]');
    function cardStep() {
      var card = track.querySelector('[data-wk-card]');
      return card ? card.getBoundingClientRect().width + 22 : track.clientWidth;
    }
    if (prevBtn) prevBtn.addEventListener('click', function(){ track.scrollBy({ left: -cardStep(), behavior: 'smooth' }); });
    if (nextBtn) nextBtn.addEventListener('click', function(){ track.scrollBy({ left: cardStep(), behavior: 'smooth' }); });
    function updateBar() {
      if (!bar) return;
      var max = track.scrollWidth - track.clientWidth;
      var ratio = max > 0 ? track.scrollLeft / max : 0;
      bar.style.width = (33 + ratio * 67) + '%';
    }
    track.addEventListener('scroll', updateBar, { passive: true });
    window.addEventListener('resize', updateBar);
    updateBar();
  }

  // experts carousel: dot indicator (mobile) reflects + drives the scroll position
  var eg = root.querySelector('.wk-experts-grid');
  var dotsWrap = root.querySelector('.wk-experts-dots');
  if (eg && dotsWrap) {
    var dots = dotsWrap.querySelectorAll('span');
    var cards = eg.children;
    function egStep() {
      return (cards.length > 1)
        ? (cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left)
        : eg.clientWidth;
    }
    function egUpdate() {
      var step = egStep() || eg.clientWidth;
      var idx = Math.round(eg.scrollLeft / step);
      idx = Math.max(0, Math.min(dots.length - 1, idx));
      for (var i = 0; i < dots.length; i++) dots[i].classList.toggle('is-active', i === idx);
    }
    eg.addEventListener('scroll', egUpdate, { passive: true });
    window.addEventListener('resize', egUpdate);
    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        if (!cards[i]) return;
        var target = eg.scrollLeft + (cards[i].getBoundingClientRect().left - eg.getBoundingClientRect().left);
        eg.scrollTo({ left: target, behavior: 'smooth' });
      });
    });
    egUpdate();
  }
  // auto-refill checkbox (current buy-box) — visual toggle
  var wkRefill = root.querySelector('[data-wk-refill]');
  if (wkRefill) {
    var wkRefillBox = wkRefill.querySelector('[data-wk-refill-box]');
    var wkRefillCheck = wkRefill.querySelector('[data-wk-refill-check]');
    function wkToggleRefill() {
      var on = wkRefill.getAttribute('aria-checked') === 'true';
      wkRefill.setAttribute('aria-checked', on ? 'false' : 'true');
      if (wkRefillBox) wkRefillBox.style.background = on ? 'transparent' : '#6B3D42';
      if (wkRefillCheck) wkRefillCheck.style.display = on ? 'none' : 'block';
      applyPricing();
      applyCart();
    }
    wkRefill.addEventListener('click', wkToggleRefill);
    wkRefill.addEventListener('keydown', function (e) { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); wkToggleRefill(); } });
  }

  // ingredient carousel: arrows scroll by one card, progress bar tracks position
  var ingTrack = root.querySelector('[data-wk-ing-track]');
  if (ingTrack) {
    var ingPrev = root.querySelector('[data-wk-ing-prev]');
    var ingNext = root.querySelector('[data-wk-ing-next]');
    var ingBar = root.querySelector('[data-wk-ing-bar]');
    function ingStep() {
      var c = ingTrack.querySelector('[data-wk-ing-card]');
      return c ? c.getBoundingClientRect().width + 18 : ingTrack.clientWidth;
    }
    if (ingPrev) ingPrev.addEventListener('click', function () { ingTrack.scrollBy({ left: -ingStep(), behavior: 'smooth' }); });
    if (ingNext) ingNext.addEventListener('click', function () { ingTrack.scrollBy({ left: ingStep(), behavior: 'smooth' }); });
    function ingBarUpdate() {
      if (!ingBar) return;
      var max = ingTrack.scrollWidth - ingTrack.clientWidth;
      var ratio = max > 0 ? ingTrack.scrollLeft / max : 0;
      ingBar.style.width = (33 + ratio * 67) + '%';
    }
    ingTrack.addEventListener('scroll', ingBarUpdate, { passive: true });
    window.addEventListener('resize', ingBarUpdate);
    ingBarUpdate();
  }

  // supplement facts lightbox: open on button, close via X / overlay click / Esc
  var sfOverlay = root.querySelector('[data-wk-suppfacts-overlay]');
  if (sfOverlay) {
    var sfDialog = sfOverlay.querySelector('[data-wk-suppfacts-dialog]');
    function sfOpen() {
      sfOverlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    function sfClose() {
      sfOverlay.style.display = 'none';
      document.body.style.overflow = '';
    }
    root.querySelectorAll('[data-wk-suppfacts-open]').forEach(function (btn) {
      btn.addEventListener('click', sfOpen);
    });
    root.querySelectorAll('[data-wk-suppfacts-close]').forEach(function (btn) {
      btn.addEventListener('click', sfClose);
    });
    sfOverlay.addEventListener('click', function (e) {
      if (sfDialog && !sfDialog.contains(e.target)) sfClose();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && sfOverlay.style.display === 'flex') sfClose();
    });
  }

  // hero thumbnail carousel: arrows scroll the thumbnail strip
  var thumbTrack = root.querySelector('[data-wk-thumb-track]');
  if (thumbTrack) {
    var thumbPrev = root.querySelector('[data-wk-thumb-prev]');
    var thumbNext = root.querySelector('[data-wk-thumb-next]');
    function thumbStep() {
      var c = thumbTrack.querySelector('button');
      return c ? c.getBoundingClientRect().width + 10 : thumbTrack.clientWidth;
    }
    if (thumbPrev) thumbPrev.addEventListener('click', function () { thumbTrack.scrollBy({ left: -thumbStep() * 2, behavior: 'smooth' }); });
    if (thumbNext) thumbNext.addEventListener('click', function () { thumbTrack.scrollBy({ left: thumbStep() * 2, behavior: 'smooth' }); });
  }

  // hero gallery: clicking a thumbnail swaps the main image; badge shows only on image 1
  var heroImg = root.querySelector('[data-wk-hero-img]');
  var heroBadge = root.querySelector('[data-wk-badge]');
  var heroThumbs = root.querySelectorAll('[data-wk-thumb]');
  heroThumbs.forEach(function (btn, idx) {
    btn.addEventListener('click', function () {
      var full = btn.getAttribute('data-wk-full');
      if (heroImg && full) heroImg.src = full;
      heroThumbs.forEach(function (b) { b.style.borderColor = 'transparent'; });
      btn.style.borderColor = '#6B3D42';
      if (heroBadge) heroBadge.style.display = (idx === 0) ? '' : 'none';
    });
  });

  // expect / use / shipping tabs: one panel visible at a time
  var xtabs = root.querySelectorAll('[data-wk-xtab]');
  if (xtabs.length) {
    xtabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-wk-xtab');
        xtabs.forEach(function (b) {
          var on = b.getAttribute('data-wk-xtab') === id;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        root.querySelectorAll('[data-wk-xpanel]').forEach(function (p) {
          p.classList.toggle('is-active', p.getAttribute('data-wk-xpanel') === id);
        });
      });
    });
  }
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', wkInit); } else { wkInit(); }
})();
</script>

