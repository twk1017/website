  <!-- WHAT TO EXPECT / HOW TO USE / SHIPPING TABS -->
  {%- assign wk_panel_ids = 'expect,use,ship' | split: ',' -%}
  <section style="background:#F5E6D8;padding:80px 28px;">
    <div class="wk-xt" style="max-width:1180px;margin:0 auto;">
      <div class="wk-xt-tabs" role="tablist">
        <button class="wk-xtab is-active" data-wk-xtab="expect" role="tab" aria-selected="true" type="button">{{ section.settings.tab1_label }}</button>
        <button class="wk-xtab" data-wk-xtab="use" role="tab" aria-selected="false" type="button">{{ section.settings.tab2_label }}</button>
        <button class="wk-xtab" data-wk-xtab="ship" role="tab" aria-selected="false" type="button">{{ section.settings.tab3_label }}</button>
      </div>
      <div class="wk-xt-body">
        {%- for pid in wk_panel_ids -%}
          <div class="wk-xpanel{% if forloop.first %} is-active{% endif %}" data-wk-xpanel="{{ pid }}" role="tabpanel">
            {%- assign panel_base = forloop.index0 | times: 3 -%}
            {%- for ci in (1..3) -%}
              {%- assign gidx = panel_base | plus: ci -%}
              {%- assign ek = 'c' | append: gidx | append: '_eyebrow' -%}
              {%- assign tk = 'c' | append: gidx | append: '_title' -%}
              <div>
                <div style="display:flex;align-items:center;gap:13px;margin-bottom:18px;">
                  <span style="display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:11px;background:rgba(245,230,216,0.09);color:#E2A24C;flex:0 0 auto;">{%- case gidx -%}{%- when 1 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12C12 8 9.5 5 5 5c0 4.5 2.5 7 7 7z"/><path d="M12 14c0-3 2.5-6 7-6 0 4-2.5 6-7 6z"/></svg>{%- when 2 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>{%- when 3 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>{%- when 4 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.4 6 11a6 6 0 0 1-12 0c0-4.6 6-11 6-11z"/></svg>{%- when 5 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16.5" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4M8.5 14.5l2.5 2.5 4.5-5"/></svg>{%- when 6 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 4 13C4 7 11 4 20 4c0 9-3 16-9 16z"/><path d="M4 20c2-4.5 5.5-7.5 10-9.5"/></svg>{%- when 7 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5h11v9H3zM14 9.5h3.5l3 3v3H14z"/><circle cx="7" cy="18" r="1.7"/><circle cx="17.5" cy="18" r="1.7"/></svg>{%- when 8 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 4v4h-4"/></svg>{%- when 9 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4.5"/></svg>{%- endcase -%}</span>
                  <div><div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#E2A24C;font-weight:700;margin-bottom:3px;">{{ section.settings[ek] }}</div><h3 style="font-family:'Fraunces',serif;font-weight:500;font-size:20px;line-height:1.15;color:#F5E6D8;margin:0;">{{ section.settings[tk] }}</h3></div>
                </div>
                <ul style="list-style:none;display:flex;flex-direction:column;gap:11px;">
                  {%- for bi in (1..3) -%}
                    {%- assign bk = 'c' | append: gidx | append: '_b' | append: bi -%}
                    {%- assign bt = section.settings[bk] -%}
                    {%- if bt != blank -%}<li style="display:flex;gap:11px;font-size:14px;line-height:1.5;color:rgba(245,230,216,0.82);"><span style="color:#C9653F;flex:0 0 auto;">&bull;</span><span>{{ bt }}</span></li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

