  <!-- WHAT TO EXPECT / HOW TO USE / SHIPPING TABS -->
  <style>
    #wk-{{ section.id }}-tabs [data-wk-xpanel="use"].is-active,
    #wk-{{ section.id }}-tabs [data-wk-xpanel="ship"].is-active { display:block; }
    #wk-{{ section.id }}-tabs .wk-xt-simple { max-width:840px; margin:0 auto; color:#F5E6D8; }
    #wk-{{ section.id }}-tabs .wk-xt-simple ul { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:15px 48px; }
    #wk-{{ section.id }}-tabs .wk-xt-simple li { position:relative; padding-left:20px; font-size:15px; line-height:1.5; color:rgba(245,230,216,0.9); }
    #wk-{{ section.id }}-tabs .wk-xt-simple li::before { content:'•'; position:absolute; left:0; color:#C9653F; }
    #wk-{{ section.id }}-tabs .wk-xt-simple p { margin:0 0 14px; font-size:15px; line-height:1.6; color:rgba(245,230,216,0.9); }
    @media (max-width:749px){ #wk-{{ section.id }}-tabs .wk-xt-simple ul { grid-template-columns:1fr; } }
  </style>
  <section id="wk-{{ section.id }}-tabs" style="background:#F5E6D8;padding:80px 28px;">
    <div class="wk-xt" style="max-width:1180px;margin:0 auto;">
      <div class="wk-xt-tabs" role="tablist">
        <button class="wk-xtab is-active" data-wk-xtab="expect" role="tab" aria-selected="true" type="button">{{ section.settings.tab1_label }}</button>
        <button class="wk-xtab" data-wk-xtab="use" role="tab" aria-selected="false" type="button">{{ section.settings.tab2_label }}</button>
        <button class="wk-xtab" data-wk-xtab="ship" role="tab" aria-selected="false" type="button">{{ section.settings.tab3_label }}</button>
      </div>
      <div class="wk-xt-body">

        <!-- WHAT TO EXPECT: 3-stage timeline with icons -->
        <div class="wk-xpanel is-active" data-wk-xpanel="expect" role="tabpanel">
          {%- for ci in (1..3) -%}
            {%- assign ek = 'c' | append: ci | append: '_eyebrow' -%}
            {%- assign tk = 'c' | append: ci | append: '_title' -%}
            <div>
              <div style="display:flex;align-items:center;gap:13px;margin-bottom:18px;">
                <span style="display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:11px;background:rgba(245,230,216,0.09);color:#E2A24C;flex:0 0 auto;">{%- case ci -%}{%- when 1 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12C12 8 9.5 5 5 5c0 4.5 2.5 7 7 7z"/><path d="M12 14c0-3 2.5-6 7-6 0 4-2.5 6-7 6z"/></svg>{%- when 2 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>{%- when 3 -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>{%- endcase -%}</span>
                <div><div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#E2A24C;font-weight:700;margin-bottom:3px;">{{ section.settings[ek] }}</div><h3 style="font-family:'Fraunces',serif;font-weight:500;font-size:20px;line-height:1.15;color:#F5E6D8;margin:0;">{{ section.settings[tk] }}</h3></div>
              </div>
              <ul style="list-style:none;display:flex;flex-direction:column;gap:11px;">
                {%- for bi in (1..3) -%}
                  {%- assign bk = 'c' | append: ci | append: '_b' | append: bi -%}
                  {%- assign bt = section.settings[bk] -%}
                  {%- if bt != blank -%}<li style="display:flex;gap:11px;font-size:14px;line-height:1.5;color:rgba(245,230,216,0.82);"><span style="color:#C9653F;flex:0 0 auto;">&bull;</span><span>{{ bt }}</span></li>{%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
        </div>

        <!-- HOW TO USE: simple list -->
        <div class="wk-xpanel" data-wk-xpanel="use" role="tabpanel">
          <div class="wk-xt-simple">{{ section.settings.use_content }}</div>
        </div>

        <!-- SHIPPING: simple list -->
        <div class="wk-xpanel" data-wk-xpanel="ship" role="tabpanel">
          <div class="wk-xt-simple">{{ section.settings.ship_content }}</div>
        </div>

      </div>
    </div>
  </section>

{% schema %}
{
  "name": "WK - Tabs",
  "settings": [
    { "type": "text", "id": "tab1_label", "label": "Tab 1 label", "default": "What to expect" },
    { "type": "text", "id": "tab2_label", "label": "Tab 2 label", "default": "How to use" },
    { "type": "text", "id": "tab3_label", "label": "Tab 3 label", "default": "Shipping" },
    { "type": "header", "content": "What to expect · Column 1" },
    { "type": "text", "id": "c1_eyebrow", "label": "Eyebrow", "default": "Week 1" },
    { "type": "text", "id": "c1_title", "label": "Title", "default": "Settling in" },
    { "type": "text", "id": "c1_b1", "label": "Bullet 1", "default": "A gentler, more even daily energy" },
    { "type": "text", "id": "c1_b2", "label": "Bullet 2", "default": "Easier wind-down as evening comes" },
    { "type": "text", "id": "c1_b3", "label": "Bullet 3", "default": "A morning ritual you look forward to" },
    { "type": "header", "content": "What to expect · Column 2" },
    { "type": "text", "id": "c2_eyebrow", "label": "Eyebrow", "default": "Month 1" },
    { "type": "text", "id": "c2_title", "label": "Title", "default": "Finding your rhythm" },
    { "type": "text", "id": "c2_b1", "label": "Bullet 1", "default": "Fewer 2am wake-ups, deeper sleep*" },
    { "type": "text", "id": "c2_b2", "label": "Bullet 2", "default": "Steadier, less reactive moods*" },
    { "type": "text", "id": "c2_b3", "label": "Bullet 3", "default": "A calmer, less bloated middle*" },
    { "type": "header", "content": "What to expect · Column 3" },
    { "type": "text", "id": "c3_eyebrow", "label": "Eyebrow", "default": "Month 3+" },
    { "type": "text", "id": "c3_title", "label": "Title", "default": "Feeling like yourself" },
    { "type": "text", "id": "c3_b1", "label": "Bullet 1", "default": "Cooler nights, fewer hot flashes*" },
    { "type": "text", "id": "c3_b2", "label": "Bullet 2", "default": "More balanced hormonal support*" },
    { "type": "text", "id": "c3_b3", "label": "Bullet 3", "default": "Like yourself again, in your own body" },
    { "type": "header", "content": "How to use" },
    { "type": "richtext", "id": "use_content", "label": "Content", "default": "<ul><li>Take 2 gummies daily, with or without food</li><li>Pick a time you'll remember — consistency matters more than timing</li><li>For optimal results, use consistently for 30–90 days</li><li>No added sugar or sugar alcohols</li><li>Deep-red cranberry, lightly tart</li><li>Every active named and dosed on the label</li></ul>" },
    { "type": "header", "content": "Shipping" },
    { "type": "richtext", "id": "ship_content", "label": "Content", "default": "<ul><li>Free, carbon-neutral shipping on every subscription</li><li>Dispatched within 48 hours</li><li>Pause, skip, or cancel anytime — no emails, no hoops</li><li>90-day money-back guarantee — completely risk-free</li></ul>" }
  ]
}
{% endschema %}
