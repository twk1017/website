  <!-- CUSTOMER REVIEWS · THE DATA -->
  <style>
    #wk-{{ section.id }}-rev .wk-stat-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:52px 40px; max-width:1000px; margin:0 auto; }
    #wk-{{ section.id }}-rev .wk-stat { text-align:center; }
    #wk-{{ section.id }}-rev .wk-stat-num { font-family:'Fraunces',serif; font-weight:500; font-size:60px; line-height:1; color:#6B3D42; }
    #wk-{{ section.id }}-rev .wk-stat-rule { width:54px; height:2px; background:#C9653F; border-radius:999px; margin:18px auto 16px; }
    #wk-{{ section.id }}-rev .wk-stat-title { font-family:'Fraunces',serif; font-weight:500; font-size:23px; line-height:1.15; color:#6B3D42; margin:0 0 8px; }
    #wk-{{ section.id }}-rev .wk-stat-desc { font-size:15px; line-height:1.55; color:#7a6258; margin:0; max-width:300px; margin-left:auto; margin-right:auto; }
    @media (max-width:900px){
      #wk-{{ section.id }}-rev .wk-stat-grid { grid-template-columns:1fr 1fr; gap:40px 26px; }
      #wk-{{ section.id }}-rev .wk-stat-num { font-size:46px; }
      #wk-{{ section.id }}-rev .wk-stat-title { font-size:21px; }
    }
    @media (max-width:560px){
      #wk-{{ section.id }}-rev .wk-stat-grid { gap:34px 22px; }
      #wk-{{ section.id }}-rev .wk-stat-num { font-size:42px; }
      #wk-{{ section.id }}-rev .wk-stat-title { font-size:19px; }
    }
  </style>
  <section id="wk-{{ section.id }}-rev" style="background:#F5E6D8;padding:84px 28px;">
    <div style="max-width:1080px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:56px;">
        <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#C9653F;font-weight:600;margin-bottom:14px;">{{ section.settings.eyebrow }}</div>
        <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:38px;margin:0 0 16px;color:#6B3D42;">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
        <p style="font-size:15px;line-height:1.55;color:#7a6258;max-width:520px;margin:0 auto 18px;">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <div style="display:inline-flex;align-items:center;gap:18px;flex-wrap:wrap;justify-content:center;">
          <span style="color:#C9653F;font-size:22px;letter-spacing:3px;">★★★★★</span>
          <span style="font-family:'Fraunces',serif;font-size:26px;color:#6B3D42;">{{ section.settings.rating_number }}</span>
          <span style="font-size:13.5px;color:#7a6258;letter-spacing:0.04em;">{{ section.settings.rating_count }}</span>
        </div>
      </div>

      <!-- big-stat grid, count-up on scroll -->
      <div class="wk-stat-grid">
        {%- for i in (1..6) -%}
          {%- assign tk = 'attr' | append: i | append: '_title' -%}
          {%- assign pk = 'attr' | append: i | append: '_pct' -%}
          {%- assign dk = 'attr' | append: i | append: '_desc' -%}
          {%- assign t = section.settings[tk] -%}
          {%- if t != blank -%}
          {%- assign p = section.settings[pk] -%}
          <div class="wk-stat">
            <div class="wk-stat-num" data-wk-count data-target="{{ p }}">{{ p }}%</div>
            <div class="wk-stat-rule"></div>
            <h3 class="wk-stat-title">{{ t }}</h3>
            <p class="wk-stat-desc">{{ section.settings[dk] }}</p>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- featured quotes -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:60px;">
        {%- for i in (1..2) -%}
          {%- assign qk = 'quote' | append: i -%}
          {%- assign ck = 'cite' | append: i -%}
          {%- assign q = section.settings[qk] -%}
          {%- if q != blank -%}
          <div style="border:1px solid rgba(107,61,66,0.22);border-radius:12px;padding:30px 28px;">
            <span style="color:#C9653F;font-size:15px;letter-spacing:2px;">★★★★★</span>
            <p style="font-size:15px;line-height:1.62;color:#3A2A20;margin:14px 0 16px;">{{ q }}</p>
            <cite style="font-style:normal;font-size:11.5px;letter-spacing:0.14em;text-transform:uppercase;color:#A07E81;font-weight:600;">{{ section.settings[ck] }}</cite>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script>
    (function(){
      var root = document.getElementById('wk-{{ section.id }}-rev');
      if (!root) return;
      var nums = root.querySelectorAll('[data-wk-count]');
      if (!nums.length) return;
      nums.forEach(function(el){ el.textContent = '0%'; });
      var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function run(el){
        var target = parseInt(el.getAttribute('data-target'), 10) || 0;
        if (prefersReduced){ el.textContent = target + '%'; return; }
        var dur = 1500, start = null;
        function step(ts){
          if (start === null) start = ts;
          var prog = Math.min((ts - start) / dur, 1);
          var eased = 1 - Math.pow(1 - prog, 3);
          el.textContent = Math.round(eased * target) + '%';
          if (prog < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }
      if (!('IntersectionObserver' in window)){
        nums.forEach(run); return;
      }
      var grid = root.querySelector('.wk-stat-grid');
      var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if (entry.isIntersecting){
            nums.forEach(run);
            obs.disconnect();
          }
        });
      }, { threshold: 0.4 });
      obs.observe(grid);
    })();
  </script>

{% schema %}
{
