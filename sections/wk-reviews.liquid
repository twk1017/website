  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What women are telling us" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Self-reported improvements from women who made Womankind part of their daily routine." },
    { "type": "text", "id": "rating_number", "label": "Rating number", "default": "4.7" },
    { "type": "text", "id": "rating_count", "label": "Rating count", "default": "from 1,284 verified reviews" },
    { "type": "header", "content": "Stat 1" },
