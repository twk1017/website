    { "type": "text", "id": "attr2_desc", "label": "Description", "default": "Many describe feeling more even, less reactive through the day." },
    { "type": "header", "content": "Stat 3" },
    { "type": "text", "id": "attr3_title", "label": "Title", "default": "Less bloating" },
    { "type": "number", "id": "attr3_pct", "label": "Percent", "default": 85 },
    { "type": "text", "id": "attr3_desc", "label": "Description", "default": "Less bloating and a flatter, more comfortable middle." },
    { "type": "header", "content": "Stat 4" },
    { "type": "text", "id": "attr4_title", "label": "Title", "default": "Fewer hot flashes" },
    { "type": "number", "id": "attr4_pct", "label": "Percent", "default": 90 },
    { "type": "text", "id": "attr4_desc", "label": "Description", "default": "Cooler nights and fewer daytime flashes, often by month two." },
    { "type": "header", "content": "Stat 5" },
    { "type": "text", "id": "attr5_title", "label": "Title", "default": "Clearer focus" },
    { "type": "number", "id": "attr5_pct", "label": "Percent", "default": 79 },
    { "type": "text", "id": "attr5_desc", "label": "Description", "default": "Reviewers report the afternoon fog easing within weeks." },
    { "type": "header", "content": "Stat 6" },
    { "type": "text", "id": "attr6_title", "label": "Title", "default": "Easy daily habit" },
    { "type": "number", "id": "attr6_pct", "label": "Percent", "default": 94 },
    { "type": "text", "id": "attr6_desc", "label": "Description", "default": "A gummy they actually look forward to — and remember to take." },
    { "type": "header", "content": "Featured quote 1" },
    { "type": "inline_richtext", "id": "quote1", "label": "Quote", "default": "\"I started a month ago and I can genuinely feel the difference in my sleep and recovery. I love that I can see every dose on the label.\"" },
    { "type": "text", "id": "cite1", "label": "Attribution", "default": "Jill K. · 55–64 · Verified, 1–3 months" },
    { "type": "header", "content": "Featured quote 2" },
    { "type": "inline_richtext", "id": "quote2", "label": "Quote", "default": "\"Three weeks in and I can feel a difference in how steady my days are. I can't wait to see how I feel at three months.\"" },
    { "type": "text", "id": "cite2", "label": "Attribution", "default": "Christie C. · 45–54 · Verified, under 1 month" }
  ]
}
