{%- comment -%}
  Womankind — long-form advertorial page #2 (adv2 · focus: hot flashes, day & night).
  A/B variant of womankind-advertorial. Carl Weische 10-section framework, narrated
  first-person by Sarah Ellison, WHNP (a nurse-practitioner "skeptic who was converted").
  Self-contained: brand fonts via wk-fonts, scoped reset under #wk-{{ section.id }}, minimal
  'womankind' layout. The offer buy-box is a real add-to-cart form wired to the Product setting.
{%- endcomment -%}
{%- assign wk_star = '<span style="color:#C9653F;">*</span>' -%}
{%- assign wk_pdp = section.settings.cta_url | default: 'https://trywomankind.com/products/hormonal-support-gummies' -%}

{% render 'wk-fonts' %}

<style>
  #wk-{{ section.id }} * { box-sizing:border-box; }
  #wk-{{ section.id }} { background:#F5E6D8; color:#3A2A20; font-family:'Hanken Grotesk',sans-serif; overflow-x:clip; }
  #wk-{{ section.id }} ::selection { background:#C9653F; color:#F5E6D8; }
  #wk-{{ section.id }} img { max-width:100%; display:block; }
  #wk-{{ section.id }} .adv-ph { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; color:#6B3D42; text-align:center; }
  #wk-{{ section.id }} [data-adv-faq-panel] { display:none; }
  #wk-{{ section.id }} [data-adv-faq-panel].is-open { display:block; }
  #wk-{{ section.id }} .adv-scroll { scrollbar-width:none; -ms-overflow-style:none; }
  #wk-{{ section.id }} .adv-scroll::-webkit-scrollbar { display:none; height:0; width:0; }
  #wk-{{ section.id }} .adv-timeline { display:block; position:relative; max-width:660px; margin:0 auto; padding-left:34px; }
  #wk-{{ section.id }} .adv-timeline::before { content:""; position:absolute; left:9px; top:8px; bottom:8px; width:2px; background:rgba(201,101,63,0.3); }
  #wk-{{ section.id }} .adv-timeline > div { position:relative; margin-bottom:16px; padding:24px 24px; }
  #wk-{{ section.id }} .adv-timeline > div:last-child { margin-bottom:0; }
  #wk-{{ section.id }} .adv-timeline > div::before { content:""; position:absolute; left:-29px; top:27px; width:12px; height:12px; border-radius:50%; background:#C9653F; border:3px solid #EFDFD0; box-shadow:0 0 0 1px rgba(201,101,63,0.3); }
  #wk-{{ section.id }} .adv-timeline > div:last-child::before { background:#E2A24C; box-shadow:0 0 0 1px rgba(226,162,76,0.4); }

  @media (max-width:749px){
    #wk-{{ section.id }} .adv-h1 { font-size:33px !important; }
    #wk-{{ section.id }} .adv-h2 { font-size:29px !important; }
    #wk-{{ section.id }} .adv-grid3 { grid-template-columns:1fr !important; }
    #wk-{{ section.id }} .adv-grid4 { grid-template-columns:1fr 1fr !important; }
    #wk-{{ section.id }} .adv-prob .adv-prob-img { min-height:100% !important; }
    #wk-{{ section.id }} .adv-prob-txt { padding:20px 17px !important; }
    #wk-{{ section.id }} .adv-prob-txt h3 { font-size:18px !important; margin-bottom:8px !important; }
    #wk-{{ section.id }} .adv-prob-txt p { font-size:13px !important; line-height:1.55 !important; }
    #wk-{{ section.id }} .adv-offer { grid-template-columns:1fr !important; }
    #wk-{{ section.id }} .adv-sec { padding-left:20px !important; padding-right:20px !important; }
    #wk-{{ section.id }} .adv-lede { font-size:17px !important; }
    #wk-{{ section.id }} .adv-timeline { padding-left:30px; }
    #wk-{{ section.id }} .adv-timeline > div { padding:20px 20px; }
    #wk-{{ section.id }} .adv-timeline > div::before { left:-27px; top:24px; }
    #wk-{{ section.id }} .adv-grid2 { grid-template-columns:1fr !important; }
    #wk-{{ section.id }} .adv-story-h { font-size:26px !important; }
  }
</style>

<div id="wk-{{ section.id }}">

  <!-- ARTICLE HERO -->
  <article style="background:#F5E6D8;">
    <div class="adv-sec" style="max-width:760px;margin:0 auto;padding:56px 28px 0;">
      {%- if section.settings.hero_eyebrow != blank -%}<div style="font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;margin-bottom:18px;">{{ section.settings.hero_eyebrow }}</div>{%- endif -%}
      <h1 class="adv-h1" style="font-family:'Fraunces',serif;font-weight:400;font-size:46px;line-height:1.08;letter-spacing:-0.01em;margin:0 0 24px;color:#6B3D42;">{{ section.settings.hero_h1_lead }} <span style="font-style:italic;color:#C9653F;">{{ section.settings.hero_h1_accent }}</span> {{ section.settings.hero_h1_tail }}</h1>

      <!-- byline -->
      <div style="display:flex;align-items:center;gap:16px;padding:20px 0;border-top:1px solid rgba(107,61,66,0.18);border-bottom:1px solid rgba(107,61,66,0.18);">
        <div style="width:52px;height:52px;border-radius:50%;overflow:hidden;background:#C9A89F;flex:0 0 auto;display:flex;align-items:center;justify-content:center;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:#6B3D42;">{%- if section.settings.byline_image -%}<img src="{{ section.settings.byline_image | image_url: width: 120 }}" alt="{{ section.settings.byline_name }}" width="52" height="52" style="width:100%;height:100%;object-fit:cover;">{%- else -%}<img src="{{ 'wk-adv2-byline.jpg' | asset_url }}" alt="{{ section.settings.byline_name }}" width="52" height="52" style="width:100%;height:100%;object-fit:cover;">{%- endif -%}</div>
        <div style="flex:1;">
          <div style="font-family:'Fraunces',serif;font-size:16px;color:#6B3D42;">{{ section.settings.byline_name }}</div>
          <div style="font-size:12.5px;color:#7a6258;">{{ section.settings.byline_sub }}</div>
        </div>
        <div style="font-size:12.5px;color:#7a6258;letter-spacing:0.04em;flex:0 0 auto;">{{ section.settings.read_time }}</div>
      </div>
    </div>

    <!-- hero image -->
    <div class="adv-sec" style="max-width:1000px;margin:34px auto 0;padding:0 28px;">
      <div style="aspect-ratio:16/9;background:linear-gradient(150deg,#D8C2BA,#C9A89F);border-radius:16px;overflow:hidden;">
        {%- if section.settings.hero_image -%}
          <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" alt="{{ section.settings.hero_image.alt | default: 'Womankind' }}" width="1600" height="900" loading="eager" style="width:100%;height:100%;object-fit:cover;">
        {%- else -%}
          <img src="{{ 'wk-adv2-hero.jpg' | asset_url }}" alt="Womankind" width="1600" height="900" loading="eager" style="width:100%;height:100%;object-fit:cover;">
        {%- endif -%}
      </div>
    </div>

    <!-- LEDE -->
    <div class="adv-sec" style="max-width:720px;margin:0 auto;padding:44px 28px 0;">
      <p class="adv-lede" style="font-size:19px;line-height:1.7;color:#3A2A20;margin:0 0 26px;font-weight:500;">{{ section.settings.hero_p1 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.hero_p2 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.hero_p3 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.hero_p4 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.hero_p5 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.hero_p6 }}</p>

      {%- if section.settings.story1_head != blank -%}
      <h2 class="adv-story-h" style="font-family:'Fraunces',serif;font-weight:400;font-size:30px;line-height:1.18;color:#6B3D42;margin:42px 0 20px;">{{ section.settings.story1_head }}</h2>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.story1_p1 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.story1_p2 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.story1_p3 }}</p>
      <div style="aspect-ratio:4/3;background:linear-gradient(150deg,#D8C2BA,#C9A89F);border-radius:16px;overflow:hidden;margin:14px 0 28px;">{%- if section.settings.story1_image -%}<img src="{{ section.settings.story1_image | image_url: width: 1200 }}" alt="{{ section.settings.story1_image.alt }}" width="1200" height="900" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- else -%}<img src="{{ 'wk-adv2-story1.jpg' | asset_url }}" alt="" width="1200" height="900" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- endif -%}</div>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.story1_p4 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.story1_p5 }}</p>
      <p style="font-size:18px;line-height:1.7;color:#3A2A20;font-weight:600;margin:0 0 20px;">{{ section.settings.story1_p6 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 28px;">{{ section.settings.story1_p7 }}</p>
      {%- endif -%}

      <a href="#offer" style="display:inline-flex;align-items:center;gap:10px;background:#C9653F;color:#F5E6D8;text-decoration:none;border-radius:999px;padding:16px 38px;font-size:13px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;">{{ section.settings.hero_cta }}</a>

      {%- if section.settings.story2_head != blank -%}
      <h2 class="adv-story-h" style="font-family:'Fraunces',serif;font-weight:400;font-size:30px;line-height:1.18;color:#6B3D42;margin:46px 0 20px;">{{ section.settings.story2_head }}</h2>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.story2_p1 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.story2_p2 }}</p>
      <div style="aspect-ratio:16/9;background:linear-gradient(150deg,#D8C2BA,#C9A89F);border-radius:16px;overflow:hidden;margin:14px 0 28px;">{%- if section.settings.story2_image -%}<img src="{{ section.settings.story2_image | image_url: width: 1400 }}" alt="{{ section.settings.story2_image.alt }}" width="1400" height="788" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- else -%}<img src="{{ 'wk-adv2-story2.jpg' | asset_url }}" alt="" width="1400" height="788" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- endif -%}</div>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.story2_p3 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 6px;">{{ section.settings.story2_p4 }}</p>
      {%- endif -%}
    </div>
  </article>

  <!-- WHY IT FAILED -->
  <section class="adv-sec" style="background:#EFDFD0;padding:74px 28px;margin-top:64px;">
    <div style="max-width:900px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:12px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;">{{ section.settings.fail_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 auto 18px;color:#6B3D42;max-width:16ch;">{{ section.settings.fail_heading }}</h2>
      <p style="max-width:640px;margin:0 auto 52px;text-align:center;font-size:16px;line-height:1.7;color:#5a4636;">{{ section.settings.fail_intro }}</p>

      <div class="adv-prob-wrap" style="display:flex;flex-direction:column;gap:24px;">
        {%- for i in (1..4) -%}
          {%- assign pe = 'prob' | append: i | append: '_eyebrow' -%}
          {%- assign pt = 'prob' | append: i | append: '_title' -%}
          {%- assign pb = 'prob' | append: i | append: '_body' -%}
          {%- assign pim = 'prob' | append: i | append: '_image' -%}
          {%- assign p_img = section.settings[pim] -%}
          {%- assign img_left = false -%}{%- if i == 1 or i == 3 -%}{%- assign img_left = true -%}{%- endif -%}
          {%- if img_left -%}{%- assign cols = '0.9fr 1.1fr' -%}{%- else -%}{%- assign cols = '1.1fr 0.9fr' -%}{%- endif -%}
          {%- capture img_cell -%}<div class="adv-prob-img" style="background:#C9A89F;min-height:230px;overflow:hidden;">{%- if p_img -%}<img src="{{ p_img | image_url: width: 700 }}" alt="" width="700" height="500" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- else -%}<img src="{{ 'wk-adv2-prob' | append: i | append: '.jpg' | asset_url }}" alt="" width="700" height="500" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- endif -%}</div>{%- endcapture -%}
          {%- capture txt_cell -%}<div class="adv-prob-txt" style="padding:34px;"><div style="font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#C9653F;font-weight:700;margin-bottom:10px;">{{ section.settings[pe] }}</div><h3 style="font-family:'Fraunces',serif;font-weight:500;font-size:22px;line-height:1.2;margin:0 0 12px;color:#6B3D42;">{{ section.settings[pt] }}</h3><p style="font-size:15px;line-height:1.65;color:#4a3a30;margin:0;">{{ section.settings[pb] }}</p></div>{%- endcapture -%}
          <div class="adv-prob" style="background:#FBF1E6;border:1px solid rgba(107,61,66,0.14);border-radius:16px;overflow:hidden;display:grid;grid-template-columns:{{ cols }};">
            {%- if img_left -%}{{ img_cell }}{{ txt_cell }}{%- else -%}{{ txt_cell }}{{ img_cell }}{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="adv-sec" style="background:#F5E6D8;padding:74px 28px;">
    <div style="max-width:1140px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:12px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;">{{ section.settings.comp_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 auto 16px;color:#6B3D42;max-width:22ch;">{{ section.settings.comp_heading }}</h2>
      <p style="max-width:620px;margin:0 auto 48px;text-align:center;font-size:16px;line-height:1.7;color:#5a4636;">{{ section.settings.comp_intro }}</p>

      <div class="adv-scroll" style="overflow-x:auto;">
        <div style="min-width:820px;display:grid;grid-template-columns:1.1fr 1fr 1fr 1fr 1.1fr;background:#FBF1E6;border:1px solid rgba(107,61,66,0.16);border-radius:16px;overflow:hidden;">
          <div style="background:#3A2A20;color:rgba(245,230,216,0.65);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;font-weight:600;padding:18px;"></div>
          <div style="background:#3A2A20;color:#F5E6D8;font-family:'Fraunces',serif;font-size:15px;padding:18px;border-left:1px solid rgba(245,230,216,0.12);">{{ section.settings.comp_col1 }}</div>
          <div style="background:#3A2A20;color:#F5E6D8;font-family:'Fraunces',serif;font-size:15px;padding:18px;border-left:1px solid rgba(245,230,216,0.12);">{{ section.settings.comp_col2 }}</div>
          <div style="background:#3A2A20;color:#F5E6D8;font-family:'Fraunces',serif;font-size:15px;padding:18px;border-left:1px solid rgba(245,230,216,0.12);">{{ section.settings.comp_col3 }}</div>
          <div style="background:#6B3D42;color:#E2A24C;font-family:'Cormorant Garamond',serif;font-size:24px;padding:16px 18px;border-left:1px solid rgba(245,230,216,0.12);display:flex;align-items:center;">womankind</div>

          {%- for r in (1..4) -%}
            {%- assign lblk = 'comp_row' | append: r | append: '_label' -%}
            {%- assign c1k = 'comp_row' | append: r | append: '_c1' -%}
            {%- assign c2k = 'comp_row' | append: r | append: '_c2' -%}
            {%- assign c3k = 'comp_row' | append: r | append: '_c3' -%}
            {%- assign wink = 'comp_row' | append: r | append: '_win' -%}
            {%- if forloop.last -%}{%- assign tick = '<span style="color:#C9653F;font-weight:700;">✓</span> ' -%}{%- else -%}{%- assign tick = '' -%}{%- endif -%}
            <div style="padding:18px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#A07E81;font-weight:600;border-top:1px solid rgba(107,61,66,0.12);">{{ section.settings[lblk] }}</div>
            <div style="padding:18px;font-size:13.5px;line-height:1.5;color:#7a6258;border-top:1px solid rgba(107,61,66,0.12);border-left:1px solid rgba(107,61,66,0.12);">{{ tick }}{{ section.settings[c1k] }}</div>
            <div style="padding:18px;font-size:13.5px;line-height:1.5;color:#7a6258;border-top:1px solid rgba(107,61,66,0.12);border-left:1px solid rgba(107,61,66,0.12);">{{ tick }}{{ section.settings[c2k] }}</div>
            <div style="padding:18px;font-size:13.5px;line-height:1.5;color:#7a6258;border-top:1px solid rgba(107,61,66,0.12);border-left:1px solid rgba(107,61,66,0.12);">{{ tick }}{{ section.settings[c3k] }}</div>
            <div style="padding:18px;font-size:13.5px;line-height:1.5;color:#3A2A20;background:rgba(107,61,66,0.05);border-top:1px solid rgba(107,61,66,0.12);border-left:1px solid rgba(107,61,66,0.12);">{{ section.settings[wink] }}</div>
          {%- endfor -%}
        </div>
      </div>
      <p style="font-size:12px;color:#9a8578;margin:16px 0 0;text-align:center;">{{ section.settings.comp_note }}</p>
    </div>
  </section>

  <!-- DISCOVERY STORY -->
  <section class="adv-sec" style="background:#EFDFD0;padding:74px 28px;">
    <div style="max-width:900px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:12px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;">{{ section.settings.disc_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 auto 40px;color:#6B3D42;max-width:20ch;">{{ section.settings.disc_heading }}</h2>
      <div style="aspect-ratio:16/8;background:linear-gradient(150deg,#D8C2BA,#C9A89F);border-radius:16px;overflow:hidden;margin-bottom:40px;">{%- if section.settings.discovery_image -%}<img src="{{ section.settings.discovery_image | image_url: width: 1440 }}" alt="" width="1440" height="720" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- else -%}<img src="{{ 'wk-adv2-discovery.jpg' | asset_url }}" alt="" width="1440" height="720" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- endif -%}</div>
      <div style="max-width:700px;margin:0 auto;">
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">I couldn't sleep anyway, so at 2am I did what nurses do when they're desperate — I started reading the actual studies. And it stopped me cold. A hot flash isn't a heat event at all. It begins in the hypothalamus — the brain's thermostat — which turns hypersensitive as estrogen swings through perimenopause. A tiny temperature change it used to ignore now trips the full alarm: the flush, the sweat, the racing heart, the wave of crimson heat. My body wasn't failing. Its thermostat had lost its buffer.</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.disc_p2 }}</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">There's a community of gut microbes called the <em>estrobolome</em> that helps recycle and steady your estrogen from one day to the next. When it's healthy and diverse, it smooths out the fluctuations that trigger the hypothalamus. When it's depleted — by stress, by antibiotics, by the standard American diet, by age itself — the estrobolome can't do its job. Estrogen lurches. The thermostat misfires. And you're standing in the freezer aisle at 2pm with your face on fire, wondering what's wrong with you.</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.disc_p4 }}</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0;">{{ section.settings.disc_p5 }}</p>

        {%- if section.settings.disc2_head != blank -%}
        <h3 class="adv-story-h" style="font-family:'Fraunces',serif;font-weight:400;font-size:28px;line-height:1.2;color:#6B3D42;margin:44px 0 20px;">{{ section.settings.disc2_head }}</h3>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.disc2_p1 }}</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;padding:18px 22px;background:#FBF1E6;border-left:3px solid #C9653F;border-radius:0 10px 10px 0;">{{ section.settings.disc2_p2 }}</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.disc2_p3 }}</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0;">{{ section.settings.disc2_p4 }}{{ wk_star }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- WHY DIFFERENT — 3 PILLARS -->
  <section class="adv-sec" style="background:#F5E6D8;padding:74px 28px;">
    <div style="max-width:1140px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:12px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;">{{ section.settings.pillars_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 auto 16px;color:#6B3D42;max-width:20ch;">{{ section.settings.pillars_heading }}</h2>
      <p style="max-width:620px;margin:0 auto 50px;text-align:center;font-size:16px;line-height:1.7;color:#5a4636;">{{ section.settings.pillars_intro }}</p>
      <div class="adv-grid3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
