<script>
  (function(){
    function init(){
      var root = document.getElementById('wk-{{ section.id }}');
      if (!root || root.dataset.advInit) return;
      root.dataset.advInit = '1';

      // ---- FAQ accordion (single open) ----
      var faqBtns = root.querySelectorAll('[data-adv-faq]');
      faqBtns.forEach(function(btn){
        btn.addEventListener('click', function(){
          var id = btn.getAttribute('data-adv-faq');
          var panel = root.querySelector('[data-adv-faq-panel="'+id+'"]');
          var isOpen = panel && panel.classList.contains('is-open');
          root.querySelectorAll('[data-adv-faq-panel]').forEach(function(p){ p.classList.remove('is-open'); });
          faqBtns.forEach(function(b){
            b.setAttribute('aria-expanded','false');
            var ic = b.querySelector('[data-adv-faq-icon]'); if (ic) ic.textContent = '+';
          });
          if (!isOpen && panel){
            panel.classList.add('is-open');
            btn.setAttribute('aria-expanded','true');
            var ic = btn.querySelector('[data-adv-faq-icon]'); if (ic) ic.textContent = '–';
          }
        });
      });
    }
    if (document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', init); } else { init(); }
  })();
</script>

