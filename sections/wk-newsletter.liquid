  <!-- NEWSLETTER -->
  <section style="background:#C9A89F;padding:64px 28px;text-align:center;">
    <div style="max-width:560px;margin:0 auto;">
      <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:30px;margin:0 0 12px;color:#3A2A20;">{{ section.settings.heading }}</h2>
      <p style="font-size:14.5px;line-height:1.6;color:#5a4636;margin:0 0 26px;">{{ section.settings.body }}</p>
      <div style="display:flex;gap:10px;max-width:420px;margin:0 auto;">
        <input type="email" placeholder="{{ section.settings.placeholder | escape }}" style="flex:1;font-family:inherit;border:1.5px solid #6B3D42;background:#F5E6D8;border-radius:999px;padding:14px 20px;font-size:14px;color:#3A2A20;">
        <button style="cursor:pointer;font-family:inherit;background:#6B3D42;color:#F5E6D8;border:none;border-radius:999px;padding:14px 26px;font-size:12px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;flex:0 0 auto;">{{ section.settings.button_label }}</button>
      </div>
    </div>
  </section>

{% schema %}
{
  "name": "WK - Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The words, the science, the products" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join the letter. What's actually happening in your body, explained clearly and respectfully — no confetti." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join" }
  ]
}
{% endschema %}
