{%- comment -%} "DON'T WANT" page, gift-bundle test (template page.gummies-meno-hrt-gb) — clone of wk-hero-meno-hrt with the tier list + auto-refill checkbox swapped for a subscribe & save bundle picker {%- endcomment -%}
{%- comment -%} Three side-by-side bundles (1 / 2 / 3 bottles, each on its own Kaching plan) and a "Gifts unlocked" ladder: each gift unlocks at a bottle count, and only unlocked gifts are added to the cart. The save line above the button and the price on the button follow the bundle. Everything outside the buy box is identical to wk-hero-meno-hrt.
  Gift 4 (free shipping) is display-only: the actual free shipping comes from the store's shipping rates (free above $70 / €70 / £50), which the 2-bottle bundle clears and the 1-bottle bundle doesn't. {%- endcomment -%}
{%- assign wk_product = section.settings.product -%}
{%- if wk_product != blank -%}{%- assign wk_variant = wk_product.selected_or_first_available_variant -%}{%- endif -%}

<style>
  /* no overflow:hidden here — it would clip the badge that straddles the top edge; the head/body round their own corners instead */
  #wk-sub-{{ section.id }} .wk-hero-track{position:absolute;inset:0;display:flex;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;scrollbar-width:none;-ms-overflow-style:none;}
  #wk-sub-{{ section.id }} .wk-hero-track::-webkit-scrollbar{display:none;}
  #wk-sub-{{ section.id }} .wk-hero-slide{flex:0 0 100%;width:100%;height:100%;object-fit:cover;display:block;scroll-snap-align:center;scroll-snap-stop:always;user-select:none;-webkit-user-drag:none;}
  /* bundle picker (modelled on Everyday Dose): three cards, struck + bundle price on one row, square-ish pills */
  #wk-sub-{{ section.id }} .wk-bl-label{font-size:11.5px;letter-spacing:0.22em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-bottom:18px;}
  #wk-sub-{{ section.id }} .wk-bundles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px;}
  #wk-sub-{{ section.id }} .wk-bundle{position:relative;cursor:pointer;display:flex;flex-direction:column;align-items:center;text-align:center;padding:22px 6px 14px;background:#FFFBF6;border:1.5px solid #E3CCBC;border-radius:10px;transition:border-color .15s ease,background .15s ease;}
  #wk-sub-{{ section.id }} .wk-bundle:hover{border-color:#B98F86;}
  #wk-sub-{{ section.id }} .wk-bundle.is-sel{background:#F8E1D4;border-color:#6B3D42;box-shadow:0 0 0 1px #6B3D42;}
  #wk-sub-{{ section.id }} .wk-bundle-badge{position:absolute;top:-11px;left:50%;transform:translateX(-50%);z-index:2;background:#6B3D42;color:#FFF9F1;font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;font-weight:800;padding:4px 10px;border-radius:6px;white-space:nowrap;}
  #wk-sub-{{ section.id }} .wk-bundle-name{font-size:15px;font-weight:800;letter-spacing:0.04em;text-transform:uppercase;color:#3A2A20;line-height:1.2;}
  /* wraps onto two lines only if a long price can't fit the card */
  #wk-sub-{{ section.id }} .wk-bundle-price{display:flex;align-items:baseline;justify-content:center;flex-wrap:wrap;column-gap:6px;margin-top:7px;line-height:1.15;}
  #wk-sub-{{ section.id }} .wk-bundle-was{font-size:14px;font-weight:500;color:#9B8579;text-decoration:line-through;white-space:nowrap;}
  #wk-sub-{{ section.id }} .wk-bundle-now{font-size:22px;font-weight:800;color:#6B3D42;white-space:nowrap;}
  #wk-sub-{{ section.id }} .wk-bundle-per{font-size:12.6px;color:#3A2A20;line-height:1.3;margin-top:4px;}
  #wk-sub-{{ section.id }} .wk-bundle-off{margin-top:9px;background:#6B3D42;color:#FFF9F1;font-size:12.6px;font-weight:800;letter-spacing:0.02em;padding:4px 10px;border-radius:6px;white-space:nowrap;}
  /* gifts unlocked: a starter-kit panel, then one panel per gift, joined by bars that fill as gifts unlock */
  #wk-sub-{{ section.id }} .wk-gl{background:#FBEDE3;border:1.5px solid #E8CBB9;border-radius:12px;padding:14px 12px 12px;margin-bottom:16px;}
  #wk-sub-{{ section.id }} .wk-gl-h{font-size:18px;font-weight:800;letter-spacing:0.02em;text-transform:uppercase;color:#3A2A20;line-height:1.2;margin-bottom:11px;}
  #wk-sub-{{ section.id }} .wk-gl-track{display:flex;align-items:stretch;}
  #wk-sub-{{ section.id }} .wk-gl-grp{flex:1 1 0;min-width:0;display:flex;flex-direction:column;padding:8px 5px 9px;border-radius:8px;background:#F2E6DC;transition:background .25s ease;}
  #wk-sub-{{ section.id }} .wk-gl-grp.is-on{background:#F1D3C2;}
  #wk-sub-{{ section.id }} .wk-gl-tag{text-align:center;font-size:10px;letter-spacing:0.06em;text-transform:uppercase;font-weight:800;color:#3A2A20;margin-bottom:7px;white-space:nowrap;}
  #wk-sub-{{ section.id }} .wk-gl-grp:not(.is-on) .wk-gl-tag{color:#A8968B;}
  #wk-sub-{{ section.id }} .wk-gl-grp--kit .wk-gl-tag{text-align:left;font-size:11.5px;padding-left:2px;}
  #wk-sub-{{ section.id }} .wk-gl-items{display:flex;gap:6px;flex:1 1 auto;}
  #wk-sub-{{ section.id }} .wk-gl-item{flex:1 1 0;min-width:0;display:flex;flex-direction:column;align-items:center;text-align:center;}
  #wk-sub-{{ section.id }} .wk-gl-art{width:56px;height:56px;border-radius:8px;background:#FFFBF6;display:flex;align-items:center;justify-content:center;overflow:hidden;transition:opacity .25s ease,filter .25s ease;}
  #wk-sub-{{ section.id }} .wk-gl-art img{width:100%;height:100%;object-fit:cover;display:block;}
  #wk-sub-{{ section.id }} .wk-gl-icon{width:100%;height:100%;color:#6B3D42;display:flex;align-items:center;justify-content:center;}
  #wk-sub-{{ section.id }} .wk-gl-icon svg{width:60%;height:60%;display:block;}
  #wk-sub-{{ section.id }} .wk-gl-grp:not(.is-on) .wk-gl-art{opacity:0.45;filter:grayscale(1);}
  #wk-sub-{{ section.id }} .wk-gl-t{font-size:11.6px;font-weight:700;color:#3A2A20;line-height:1.2;margin-top:6px;}
  #wk-sub-{{ section.id }} .wk-gl-grp:not(.is-on) .wk-gl-t{color:#A8968B;}
  #wk-sub-{{ section.id }} .wk-gl-free{margin-top:auto;padding-top:4px;font-size:10.6px;font-weight:800;letter-spacing:0.04em;text-transform:uppercase;color:#6B3D42;white-space:nowrap;}
  #wk-sub-{{ section.id }} .wk-gl-free s{font-weight:600;letter-spacing:0;color:#A8968B;margin-right:3px;}
  #wk-sub-{{ section.id }} .wk-gl-grp:not(.is-on) .wk-gl-free{color:#A8968B;}
  #wk-sub-{{ section.id }} .wk-gl-link{position:relative;flex:0 0 12px;align-self:center;height:6px;background:#E8D7CB;overflow:hidden;}
  #wk-sub-{{ section.id }} .wk-gl-link::after{content:'';position:absolute;inset:0;background:#6B3D42;transform:scaleX(0);transform-origin:left center;transition:transform .3s ease;}
  #wk-sub-{{ section.id }} .wk-gl-link.is-on::after{transform:scaleX(1);}
  #wk-sub-{{ section.id }} .wk-gl-grp.is-pop{animation:wkGlPop .45s ease .1s;}
  @keyframes wkGlPop{0%{transform:scale(1);}40%{transform:scale(1.06);}100%{transform:scale(1);}}
  /* follows the bundle: "Subscribe & save · 15% off every order" */
  #wk-sub-{{ section.id }} .wk-saveline{text-align:center;font-size:12.4px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#3A2A20;line-height:1.4;margin:0 0 10px;}
  /* DON'T WANT bridge + founder lines under the description */
  #wk-sub-{{ section.id }} .wk-bridge{font-family:'Fraunces',serif;font-style:italic;font-size:16.5px;line-height:1.5;color:#6B3D42;margin:0 0 16px;max-width:30em;}
  #wk-sub-{{ section.id }} .wk-founder{display:flex;align-items:flex-start;gap:13px;margin:0 0 20px;padding:13px 15px;background:rgba(107,61,66,0.06);border-radius:14px;max-width:34em;}
  #wk-sub-{{ section.id }} .wk-founder img{width:46px;height:46px;flex:0 0 auto;border-radius:50%;object-fit:cover;object-position:top;display:block;background:#E8D5C6;}
  #wk-sub-{{ section.id }} .wk-founder p{font-size:13.8px;line-height:1.55;color:#4a3a30;}
  #wk-sub-{{ section.id }} .wk-founder strong{color:#6B3D42;}
  #wk-sub-{{ section.id }} .wk-trust-line strong{color:#6B3D42;font-weight:700;}
  /* social-proof row that replaces the guarantee block under the countdown */
  #wk-sub-{{ section.id }} .wk-trust{display:flex;align-items:center;gap:15px;margin:16px 0 0;padding:13px 20px 13px 16px;background:#FBF1E6;border:1.5px solid rgba(107,61,66,0.18);border-radius:999px;}
  #wk-sub-{{ section.id }} .wk-trust-av{display:flex;align-items:center;flex:0 0 auto;position:relative;}
  #wk-sub-{{ section.id }} .wk-trust-av img{width:46px;height:46px;border-radius:50%;object-fit:cover;border:2.5px solid #FFF9F1;margin-left:-13px;display:block;background:#E8D5C6;}
  #wk-sub-{{ section.id }} .wk-trust-av img:first-child{margin-left:0;}
  #wk-sub-{{ section.id }} .wk-trust-chk{position:absolute;right:-5px;bottom:-1px;width:21px;height:21px;border-radius:50%;background:#C9653F;color:#FFF9F1;font-size:11.5px;font-weight:700;line-height:1;display:flex;align-items:center;justify-content:center;border:2px solid #FFF9F1;}
  #wk-sub-{{ section.id }} .wk-trust-h{display:block;font-size:15.4px;font-weight:700;color:#6B3D42;line-height:1.3;}
  #wk-sub-{{ section.id }} .wk-trust-d{display:block;font-size:12.2px;color:#7a6258;line-height:1.4;margin-top:2px;}

  /* add-to-cart: one row — label left, struck + bundle price and arrow right */
  #wk-sub-{{ section.id }} .wk-atc{width:100%;cursor:pointer;font-family:inherit;background:#C9653F;color:#FFF9F1;border:2.5px solid #6B3D42;border-radius:12px;padding:0 22px;min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:12px;box-shadow:0 4px 0 #6B3D42;transition:transform .1s ease,box-shadow .1s ease;}
  #wk-sub-{{ section.id }} .wk-atc:active{transform:translateY(3px);box-shadow:0 1px 0 #6B3D42;}
  #wk-sub-{{ section.id }} .wk-atc[disabled]{opacity:0.55;cursor:not-allowed;justify-content:center;}
  #wk-sub-{{ section.id }} .wk-atc-label{font-size:20px;font-weight:800;letter-spacing:0.03em;text-transform:uppercase;white-space:nowrap;}
  #wk-sub-{{ section.id }} .wk-atc-price{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;}
  #wk-sub-{{ section.id }} .wk-atc-was{font-size:15px;font-weight:600;color:rgba(255,249,241,0.7);text-decoration:line-through;}
  #wk-sub-{{ section.id }} .wk-atc-now{font-size:20px;font-weight:800;}
  #wk-sub-{{ section.id }} .wk-atc-arrow{display:block;width:26px;height:14px;margin-left:4px;}
  #wk-sub-{{ section.id }} .wk-atc-gtee{display:flex;align-items:center;justify-content:center;gap:7px;margin-top:12px;font-size:12.4px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#6B3D42;}
  #wk-sub-{{ section.id }} .wk-atc-gtee svg{flex:0 0 auto;display:block;width:15px;height:15px;}

  /* urgency bar — classes rather than inline styles so the mobile block can scale it */
  #wk-sub-{{ section.id }} .wk-urg{margin:20px 0 0;}
  #wk-sub-{{ section.id }} .wk-urg-h{font-size:17.4px;font-weight:700;color:#6B3D42;line-height:1.3;}
  #wk-sub-{{ section.id }} .wk-urg-t{font-size:14.8px;color:#7a6258;line-height:1.45;margin-top:4px;}
  #wk-sub-{{ section.id }} .wk-urg-bar{height:13px;border-radius:999px;background:#E8D5C6;overflow:hidden;margin:13px 0 9px;}
  #wk-sub-{{ section.id }} .wk-urg-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#6B3D42,#C9653F);}
  #wk-sub-{{ section.id }} .wk-urg-row{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:14.8px;}
  #wk-sub-{{ section.id }} .wk-urg-sold{color:#7a6258;font-weight:600;}
  #wk-sub-{{ section.id }} .wk-urg-cd{color:#C9653F;font-weight:700;white-space:nowrap;}

  @media(max-width:749px){
    /* self-contained mobile layout — womankind-home has no .wk-root layer */
    #wk-sub-{{ section.id }}{grid-template-columns:1fr !important;gap:28px !important;padding:28px 20px 14px !important;}
    #wk-sub-{{ section.id }} h1{font-size:28px !important;}
    #wk-sub-{{ section.id }} .wk-gallery{position:static !important;top:auto !important;}
    #wk-sub-{{ section.id }} .wk-thumbs > button{flex:0 0 calc((100% - 27px) / 3.5) !important;}
    /* three bundles stay side by side down to 320px; prices scale with the screen so "$165 $123.75" stays on one row (measured at 320/360/375) */
    #wk-sub-{{ section.id }} .wk-bundles{gap:6px;}
    #wk-sub-{{ section.id }} .wk-bundle{padding:20px 2px 12px;}
    #wk-sub-{{ section.id }} .wk-bundle-badge{font-size:9.2px;letter-spacing:0.06em;padding:4px 7px;}
    #wk-sub-{{ section.id }} .wk-bundle-name{font-size:13.6px;letter-spacing:0.03em;}
    #wk-sub-{{ section.id }} .wk-bundle-price{column-gap:3px;margin-top:6px;}
    #wk-sub-{{ section.id }} .wk-bundle-was{font-size:min(12.4px, 3vw);}
    #wk-sub-{{ section.id }} .wk-bundle-now{font-size:min(19px, 4.6vw);letter-spacing:-0.01em;}
    #wk-sub-{{ section.id }} .wk-bundle-per{font-size:11.6px;margin-top:3px;}
    #wk-sub-{{ section.id }} .wk-bundle-off{font-size:11.6px;padding:4px 8px;margin-top:8px;}
    #wk-sub-{{ section.id }} .wk-gl{padding:12px 9px 10px;}
    #wk-sub-{{ section.id }} .wk-gl-h{font-size:16px;margin-bottom:10px;}
    /* four gift panels across a ~315px box: ~68px each */
    #wk-sub-{{ section.id }} .wk-gl-grp{padding:7px 3px 8px;}
    #wk-sub-{{ section.id }} .wk-gl-tag{font-size:8.8px;letter-spacing:0.01em;margin-bottom:6px;}
    #wk-sub-{{ section.id }} .wk-gl-grp--kit .wk-gl-tag{font-size:8.8px;text-align:center;padding-left:0;}
    #wk-sub-{{ section.id }} .wk-gl-art{width:42px;height:42px;}
    #wk-sub-{{ section.id }} .wk-gl-t{font-size:10.4px;margin-top:5px;}
    #wk-sub-{{ section.id }} .wk-gl-free{font-size:9.6px;letter-spacing:0.02em;}
    #wk-sub-{{ section.id }} .wk-gl-link{flex-basis:8px;height:5px;}
    #wk-sub-{{ section.id }} .wk-saveline{font-size:11.4px;letter-spacing:0.04em;}
    #wk-sub-{{ section.id }} .wk-bridge{font-size:15.5px;}
    #wk-sub-{{ section.id }} .wk-founder{padding:12px 13px;gap:11px;}
    #wk-sub-{{ section.id }} .wk-founder img{width:40px;height:40px;}
    #wk-sub-{{ section.id }} .wk-founder p{font-size:13.2px;}
    #wk-sub-{{ section.id }} .wk-atc{padding:0 16px;min-height:58px;gap:8px;}
    #wk-sub-{{ section.id }} .wk-atc-label{font-size:min(17px, 4.5vw);}
    #wk-sub-{{ section.id }} .wk-atc-was{font-size:min(13px, 3.4vw);}
    #wk-sub-{{ section.id }} .wk-atc-now{font-size:min(17px, 4.5vw);}
    #wk-sub-{{ section.id }} .wk-atc-arrow{width:20px;}
    #wk-sub-{{ section.id }} .wk-atc-gtee{font-size:11.4px;letter-spacing:0.04em;}
    #wk-sub-{{ section.id }} .wk-urg-h{font-size:16px;}
    #wk-sub-{{ section.id }} .wk-urg-t{font-size:13.8px;}
    #wk-sub-{{ section.id }} .wk-urg-bar{height:12px;}
    #wk-sub-{{ section.id }} .wk-urg-row{font-size:13.8px;gap:10px;}
    #wk-sub-{{ section.id }} .wk-trust{gap:12px;padding:12px 16px 12px 14px;}
    /* avatars give up 4px so the copy can grow — measured: at 335px the heading only holds
       one line up to 13.8px once the faces are 28px */
    #wk-sub-{{ section.id }} .wk-trust-av img{width:28px;height:28px;margin-left:-11px;border-width:2px;}
    #wk-sub-{{ section.id }} .wk-trust-chk{right:-4px;bottom:-1px;width:16px;height:16px;font-size:9px;border-width:1.5px;}
    #wk-sub-{{ section.id }} .wk-trust-h{font-size:13.8px;}
    #wk-sub-{{ section.id }} .wk-trust-d{font-size:13px;}
  }
</style>

  <!-- HERO / SUBSCRIPTION LP -->
  <section id="wk-sub-{{ section.id }}" style="max-width:1240px;margin:0 auto;padding:40px 28px 18px;display:grid;grid-template-columns:1.02fr 0.98fr;gap:54px;align-items:start;">

    <!-- GALLERY -->
    <div class="wk-gallery" style="position:sticky;top:96px;">
      <div class="wk-hero-img" style="position:relative;aspect-ratio:1/1;border-radius:18px;overflow:hidden;background:radial-gradient(120% 92% at 50% 16%, #ECDBCC 0%, #D8BFB4 52%, #C2A099 100%);">
        <div class="wk-hero-track" data-wk-hero-track>
          {%- for i in (1..10) -%}
            {%- assign gik = 'gallery_' | append: i | append: '_image' -%}
            {%- assign gimg = section.settings[gik] -%}
            {%- if gimg -%}{%- assign wk_full = gimg | image_url: width: 1200 -%}{%- assign wk_galt = gimg.alt | default: 'Womankind Hormonal Support Gummies' -%}
            {%- else -%}{%- assign gfname = 'wk-buybox-' | append: i | append: '.jpg' -%}{%- case i -%}{%- when 1, 2, 4, 5, 6, 7 -%}{%- assign gfname = 'wk-meno-hrt-buybox-' | append: i | append: '.jpg' -%}{%- endcase -%}{%- assign wk_full = gfname | asset_url -%}{%- assign wk_galt = 'Womankind Hormonal Support Gummies' -%}{%- endif -%}
            <img class="wk-hero-slide" src="{{ wk_full }}" alt="{{ wk_galt }}" width="1200" height="1200" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" draggable="false">
          {%- endfor -%}
        </div>
        <span data-wk-badge>{% render 'wk-clinicians-badge', text: section.settings.badge, image: section.settings.badge_image %}</span>
      </div>

      <div style="display:flex;align-items:center;gap:10px;margin-top:14px;">
        <button type="button" class="wk-thumb-arrow" data-wk-thumb-prev aria-label="Previous image">&lsaquo;</button>
        <div class="wk-thumbs" data-wk-thumb-track>
          {%- for i in (1..10) -%}
            {%- assign gik = 'gallery_' | append: i | append: '_image' -%}
            {%- assign gimg = section.settings[gik] -%}
            {%- if gimg -%}{%- assign tsrc = gimg | image_url: width: 240 -%}{%- assign tfull = gimg | image_url: width: 1200 -%}{%- assign talt = gimg.alt | default: 'Womankind Hormonal Support Gummies' -%}
            {%- else -%}{%- assign gfname = 'wk-buybox-' | append: i | append: '.jpg' -%}{%- case i -%}{%- when 1, 2, 4, 5, 6, 7 -%}{%- assign gfname = 'wk-meno-hrt-buybox-' | append: i | append: '.jpg' -%}{%- endcase -%}{%- assign tsrc = gfname | asset_img_url: '240x240' -%}{%- assign tfull = gfname | asset_url -%}{%- assign talt = 'Womankind Hormonal Support Gummies' -%}{%- endif -%}
            <button type="button" data-wk-thumb data-wk-full="{{ tfull }}" aria-label="View image {{ i }}" style="cursor:pointer;padding:0;aspect-ratio:1/1;background:#D8C2BA;border-radius:9px;overflow:hidden;{% if forloop.first %}border:2px solid #6B3D42;{% else %}border:2px solid transparent;{% endif %}display:flex;align-items:center;justify-content:center;">
              <img src="{{ tsrc }}" alt="{{ talt }}" width="240" height="240" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
            </button>
          {%- endfor -%}
        </div>
        <button type="button" class="wk-thumb-arrow" data-wk-thumb-next aria-label="Next image">&rsaquo;</button>
      </div>
    </div>

    <!-- BUY BOX -->
    <div>
      <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#C9653F;font-weight:600;margin-bottom:14px;">{{ section.settings.eyebrow }}</div>
      <style>.wk-root h1.wk-herosub-title{font-size:clamp(26px, 3vw, 30px) !important;line-height:1.12 !important;}</style>
      <h1 class="wk-herosub-title" style="font-family:'Fraunces',serif;font-weight:400;margin:0 0 14px;color:#6B3D42;letter-spacing:-0.01em;">{{ section.settings.heading }}</h1>

      {%- assign oke_product = wk_product | default: all_products['hormonal-support-gummies'] -%}
      {%- comment -%} spacing sits on a wrapper: Okendo's widget styles its own element, which swallowed the margin {%- endcomment -%}
      <div style="padding-bottom:16px;"><div data-oke-star-rating data-oke-reviews-product-id="shopify-{{ oke_product.id }}">{{ oke_product.metafields.okendo.StarRatingSnippet }}</div></div>

      <p style="font-size:15px;line-height:1.6;color:#4a3a30;margin:0 0 18px;max-width:30em;">{{ section.settings.description }}</p>

      {%- if section.settings.bridge_line != blank -%}
        <p class="wk-bridge">{{ section.settings.bridge_line }}</p>
      {%- endif -%}
      {%- if section.settings.founder_line != blank -%}
        <div class="wk-founder">
          {%- if section.settings.founder_image -%}
            <img src="{{ section.settings.founder_image | image_url: width: 120 }}" alt="Dr. Katie Chen" width="120" height="120" loading="lazy">
          {%- else -%}
            <img src="{{ 'wk-katie-avatar.jpg' | asset_url }}" alt="Dr. Katie Chen" width="120" height="120" loading="lazy">
          {%- endif -%}
          <p>{{ section.settings.founder_line }}</p>
        </div>
      {%- endif -%}

      <div style="display:flex;flex-direction:column;gap:11px;margin-bottom:22px;">
        {%- for i in (1..4) -%}{%- assign bk = 'benefit_' | append: i -%}{%- assign bt = section.settings[bk] -%}{%- if bt != blank -%}<div style="display:flex;align-items:flex-start;gap:11px;font-size:14.5px;color:#3A2A20;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span><span>{{ bt }}</span></div>{%- endif -%}{%- endfor -%}
      </div>

      <!-- FLAVOR -->
      <style>
        @media(max-width:749px){
          .wk-sale-badge{margin-left:0 !important;font-size:11.5px !important;padding:8px 15px !important;gap:6px !important;letter-spacing:0.03em !important;box-shadow:0 3px 10px rgba(201,101,63,0.35) !important;}
          .wk-sale-badge > span{font-size:13px !important;}
        }
      </style>
      <div style="font-size:11.5px;letter-spacing:0.22em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-bottom:10px;">{{ section.settings.flavor_label }}</div>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:26px;flex-wrap:wrap;">
        <button data-wk="flavor" data-wk-val="cranberry" style="position:relative;cursor:pointer;font-family:inherit;background:#F5E6D8;border:1.5px solid #6B3D42;color:#6B3D42;border-radius:999px;padding:9px 18px;font-size:13px;letter-spacing:0.04em;">{{ section.settings.flavor_pill }}<span data-wk-ring="flavor:cranberry" style="box-shadow:0 0 0 2px #6B3D42;position:absolute;inset:-1.5px;border-radius:999px;pointer-events:none;"></span></button>
        {%- if section.settings.sale_badge != blank -%}
          <div class="wk-sale-badge" style="margin-left:auto;display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#E2A24C,#C9653F);color:#FFF7EE;border:1.5px solid rgba(251,241,230,0.7);border-radius:999px;padding:10px 20px;font-size:13.5px;font-weight:800;letter-spacing:0.04em;text-transform:uppercase;line-height:1.1;box-shadow:0 4px 14px rgba(201,101,63,0.42);white-space:nowrap;"><span style="font-size:16px;line-height:1;">&#9728;</span>{{ section.settings.sale_badge }}</div>
        {%- endif -%}
      </div>

      <!-- BUNDLE PICKER (1 / 2 / 3 bottles, subscribe & save) + GIFTS UNLOCKED LADDER -->
      {%- comment -%}
        Server-rendered at the default bundle so nothing flashes before the script runs.
        The script then re-prices every bundle against its LIVE selling-plan discount (what checkout charges)
        and unlocks the gifts whose bottle count the bundle reaches. A bundle with no matching plan
        sells one-time at the automatic-discount price, with no gifts.
      {%- endcomment -%}
      {%- assign wk_price = wk_variant.price | default: 6485 -%}
      {%- assign wk_def = section.settings.default_tier | default: '1' -%}
      {%- assign wk_def_n = wk_def | plus: 0 -%}
      <div class="wk-bl-label">{{ section.settings.plans_label }}</div>
      <div class="wk-bundles" role="radiogroup" aria-label="{{ section.settings.plans_label | escape }}">
        {%- for tm in (1..3) -%}
          {%- assign tp = 'tier_' | append: tm | append: '_' -%}
          {%- assign t_name = tp | append: 'name' -%}{%- assign t_badge = tp | append: 'badge' -%}{%- assign t_sub = tp | append: 'sub_pct' -%}
          {%- assign t_keep = 100 | minus: section.settings[t_sub] -%}
          {%- assign t_per = wk_price | times: t_keep | divided_by: 100.0 | round -%}
          {%- assign t_total = t_per | times: tm -%}
          {%- assign t_full = wk_price | times: tm -%}
          {%- assign t_day = t_per | divided_by: 30.0 | round -%}
          {%- assign tk = tm | append: '' -%}
          <div class="wk-bundle{% if tk == wk_def %} is-sel{% endif %}" data-wk="supply" data-wk-val="{{ tm }}" data-wk-plan="{{ tm }}" role="radio" aria-checked="{% if tk == wk_def %}true{% else %}false{% endif %}" tabindex="0">
            {%- if section.settings[t_badge] != blank -%}<span class="wk-bundle-badge{% if tm == 3 %} wk-bundle-badge--dark{% endif %}">{{ section.settings[t_badge] }}</span>{%- endif -%}
            <span class="wk-bundle-name">{{ section.settings[t_name] }}</span>
            <span class="wk-bundle-price"><s class="wk-bundle-was" data-wk-compare="{{ tm }}">{{ t_full | money_without_trailing_zeros }}</s><span class="wk-bundle-now" data-wk-total="{{ tm }}">{{ t_total | money_without_trailing_zeros }}</span></span>
            <span class="wk-bundle-per"><span data-wk-perday="{{ tm }}">{{ t_day | money }}</span>/day</span>
            <span class="wk-bundle-off" data-wk-save="{{ tm }}">{{ section.settings[t_sub] }}% off</span>
          </div>
        {%- endfor -%}
      </div>

      {%- assign has_gift = false -%}
      {%- for i in (1..4) -%}{%- assign gt = 'gift_' | append: i | append: '_title' -%}{%- if section.settings[gt] != blank -%}{%- assign has_gift = true -%}{%- endif -%}{%- endfor -%}
      {%- assign wk_gift_order = '4,1,2,3' | split: ',' -%}
      {%- if has_gift -%}
        <div class="wk-gl" data-wk-gl>
          <div class="wk-gl-h">{{ section.settings.gifts_heading }}</div>
          <div class="wk-gl-track">
            {%- comment -%}
              Like Everyday Dose: every 1-bottle gift shares one "Starter kit" panel, each later gift gets its own panel
              tagged with its bottle count (gift 4, free shipping, leads its level). Panels are joined by bars that fill as they unlock.
            {%- endcomment -%}
            {%- assign wk_kit_n = 0 -%}
            {%- for istr in wk_gift_order -%}
              {%- assign gt = 'gift_' | append: istr | append: '_title' -%}
              {%- assign gu = 'gift_' | append: istr | append: '_unlock' -%}
              {%- assign g_unlock = section.settings[gu] | default: '1' | plus: 0 -%}
              {%- if section.settings[gt] != blank and g_unlock == 1 -%}{%- assign wk_kit_n = wk_kit_n | plus: 1 -%}{%- endif -%}
            {%- endfor -%}
            {%- assign wk_first_grp = true -%}
            {%- for lvl in (1..3) -%}
              {%- if lvl == 1 and wk_kit_n > 0 -%}
                <div class="wk-gl-grp wk-gl-grp--kit{% if wk_def_n >= 1 %} is-on{% endif %}" data-wk-gl-step="1" data-wk-gl-n="{{ wk_kit_n }}" style="flex-grow:{{ wk_kit_n }};">
                  <span class="wk-gl-tag">{{ section.settings.gift_starter_tag }}</span>
                  <div class="wk-gl-items">
                {%- assign wk_first_grp = false -%}
              {%- endif -%}
              {%- for istr in wk_gift_order -%}
                {%- assign gt = 'gift_' | append: istr | append: '_title' -%}
                {%- if section.settings[gt] == blank -%}{%- continue -%}{%- endif -%}
                {%- assign gu = 'gift_' | append: istr | append: '_unlock' -%}
                {%- assign g_unlock = section.settings[gu] | default: '1' | plus: 0 -%}
                {%- if g_unlock != lvl -%}{%- continue -%}{%- endif -%}
                {%- assign gi = 'gift_' | append: istr | append: '_image' -%}
                {%- assign gpk = 'gift_' | append: istr | append: '_product' -%}
                {%- assign gv = 'gift_' | append: istr | append: '_value' -%}
                {%- assign gp = section.settings[gpk] -%}
                {%- assign g_was = '' -%}
                {%- if gp != blank and gp.price > 0 -%}{%- assign g_was = gp.price | money_without_trailing_zeros -%}
                {%- elsif istr == '4' and section.settings[gv] != blank -%}
                  {%- comment -%} shipping costs the same number in every market (4.95 $/£/€), so show it in the visitor's currency {%- endcomment -%}
                  {%- assign g_ship = section.settings[gv] | remove: '$' | remove: '£' | remove: '€' | replace: ',', '.' | strip | times: 100 | round -%}
                  {%- if g_ship > 0 -%}{%- assign g_was = g_ship | money_without_trailing_zeros -%}{%- endif -%}
                {%- elsif section.settings[gv] != blank -%}{%- assign g_was = section.settings[gv] | remove: ' value' | strip -%}{%- endif -%}
                {%- if lvl > 1 -%}
                  {%- unless wk_first_grp -%}<span class="wk-gl-link{% if lvl <= wk_def_n %} is-on{% endif %}" data-wk-gl-link="{{ lvl }}" aria-hidden="true"></span>{%- endunless -%}
                  {%- assign wk_first_grp = false -%}
                  <div class="wk-gl-grp{% if lvl <= wk_def_n %} is-on{% endif %}" data-wk-gl-step="{{ lvl }}" data-wk-gl-n="1">
                    <span class="wk-gl-tag">{{ section.settings.gift_tier_tag | replace: '[n]', lvl }}</span>
                    <div class="wk-gl-items">
                {%- endif -%}
                      <div class="wk-gl-item">
                        <span class="wk-gl-art">
                          {%- if section.settings[gi] -%}
                            <img src="{{ section.settings[gi] | image_url: width: 200 }}" alt="" width="200" height="200" loading="lazy">
                          {%- elsif istr == '4' -%}
                            <span class="wk-gl-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 6.5h12v9h-12z"/><path d="M13.5 9.5h4.2l3.3 3.4v2.6h-7.5"/><circle cx="6" cy="17.2" r="1.8"/><circle cx="17.2" cy="17.2" r="1.8"/></svg></span>
                          {%- else -%}
                            {%- assign gfb = 'wk-gift-' | append: istr | append: '.png' -%}
                            <img src="{{ gfb | asset_url }}" alt="" width="200" height="200" loading="lazy">
                          {%- endif -%}
                        </span>
                        <span class="wk-gl-t">{{ section.settings[gt] }}</span>
                        <span class="wk-gl-free">{%- if g_was != blank -%}<s>{{ g_was }}</s>{%- endif -%}{{ section.settings.gift_free_label }}</span>
                      </div>
                {%- if lvl > 1 -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
              {%- if lvl == 1 and wk_kit_n > 0 -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <!-- ADD TO CART -->
      {%- if wk_product != blank -%}
        <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" enctype="multipart/form-data" data-wk-form>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          {%- comment -%}
            items[] notation so the free-gift products can be added in the same request.
            The gift lines deliberately carry NO selling plan, so they stay out of the
            subscription contract and never recur. Each is disabled until the selected
            bundle is on a plan AND reaches the gift's bottle count — FormData omits
            disabled inputs, which is what drops locked gifts (leaving a gap in the
            indices, which Shopify accepts).

            Order matters: Shopify lists cart lines in REVERSE of the order they are sent,
            so the gummies go LAST here to appear FIRST in the cart, drawer and checkout.
          {%- endcomment -%}
          {%- assign gidx = -1 -%}
          {%- for i in (1..3) -%}
            {%- assign gvk = 'gift_' | append: i | append: '_variant' -%}
            {%- assign gv = section.settings[gvk] -%}
            {%- assign gt = 'gift_' | append: i | append: '_title' -%}
            {%- if gv != blank and section.settings[gt] != blank -%}
              {%- assign gu = 'gift_' | append: i | append: '_unlock' -%}
              {%- assign g_unlock = section.settings[gu] | default: '1' -%}
              {%- assign gidx = gidx | plus: 1 -%}
              {%- comment -%} disabled until the script confirms the bundle's plan — a gift must never ship without a subscription {%- endcomment -%}
              <input type="hidden" name="items[{{ gidx }}][id]" value="{{ gv }}" data-wk-gift="{{ g_unlock }}" disabled>
              <input type="hidden" name="items[{{ gidx }}][quantity]" value="1" data-wk-gift="{{ g_unlock }}" disabled>
            {%- endif -%}
          {%- endfor -%}
          {%- assign midx = gidx | plus: 1 -%}
          <input type="hidden" name="items[{{ midx }}][id]" value="{{ wk_variant.id }}">
          <input type="hidden" name="items[{{ midx }}][quantity]" value="{{ wk_def }}" data-wk-qty>
          {%- comment -%} starts empty + disabled: the script fills in the tier's plan, so a page whose script never runs sells one-time at full price rather than on the wrong plan {%- endcomment -%}
          <input type="hidden" name="items[{{ midx }}][selling_plan]" value="" data-wk-selling-plan disabled>
          {%- assign wk_def_sub = 'tier_' | append: wk_def | append: '_sub_pct' -%}
          {%- if section.settings.save_line != blank -%}
            <div class="wk-saveline" data-wk-saveline>{{ section.settings.save_line | replace: '[pct]', section.settings[wk_def_sub] }}</div>
          {%- endif -%}
          {%- assign wk_def_keep = 100 | minus: section.settings[wk_def_sub] -%}
          {%- assign wk_def_total = wk_price | times: wk_def_keep | divided_by: 100.0 | round | times: wk_def_n -%}
          {%- assign wk_def_full = wk_price | times: wk_def_n -%}
          <button type="submit" class="wk-atc"{% unless wk_variant.available %} disabled{% endunless %}>
            {%- if wk_variant.available -%}
              <span class="wk-atc-label">{{ section.settings.atc_label }}</span>
              <span class="wk-atc-price"><span class="wk-atc-was" data-wk-atc-was>{{ wk_def_full | money_without_trailing_zeros }}</span><span class="wk-atc-now" data-wk-atc-now>{{ wk_def_total | money_without_trailing_zeros }}</span><svg class="wk-atc-arrow" viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 7h23"/><path d="M18 1l6 6-6 6"/></svg></span>
            {%- else -%}
              <span class="wk-atc-label">Sold out</span>
            {%- endif -%}
          </button>
          {%- if section.settings.atc_guarantee != blank -%}
            <div class="wk-atc-gtee"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 3.5v5.5c0 5-3.4 9.3-8 11-4.6-1.7-8-6-8-11V5.5L12 2z"/><path d="M9 12l2 2 4-4"/></svg>{{ section.settings.atc_guarantee }}</div>
          {%- endif -%}
        </form>
      {%- else -%}
        <button style="width:100%;cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:18px;font-size:15px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:12px;">Select a product</button>
      {%- endif -%}

      {%- comment -%} pages listed in batch_pages get the "Next batch ships on" module instead of the urgency bar {%- endcomment -%}
      {%- assign wk_batch = false -%}
      {%- assign wk_batch_pages = section.settings.batch_pages | remove: ' ' | split: ',' -%}
      {%- if wk_batch_pages contains '*' -%}{%- assign wk_batch = true -%}
      {%- elsif page and wk_batch_pages contains page.handle -%}{%- assign wk_batch = true -%}{%- endif -%}

      {%- if wk_batch -%}
        {%- render 'wk-batch-ships',
          id: section.id,
          title: section.settings.batch_title,
          note: section.settings.batch_note,
          pct: section.settings.batch_pct,
          sold: section.settings.batch_sold,
          reserved: section.settings.batch_reserved,
          later: section.settings.batch_later
        -%}
      {%- elsif section.settings.urgency_heading != blank -%}
        <div class="wk-urg">
          <div class="wk-urg-h">{{ section.settings.urgency_heading }}</div>
          {%- if section.settings.urgency_text != blank -%}<div class="wk-urg-t">{{ section.settings.urgency_text }}</div>{%- endif -%}
          <div class="wk-urg-bar">
            <div class="wk-urg-fill" style="width:{{ section.settings.urgency_pct }}%;"></div>
          </div>
          <div class="wk-urg-row">
            <span class="wk-urg-sold">{{ section.settings.urgency_pct }}% sold</span>
            <span class="wk-urg-cd">{{ section.settings.urgency_countdown_label }} <span data-wk-countdown>00:00:00</span></span>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.reason_why != blank -%}
        <div style="text-align:center;margin:14px 0 0;font-size:13px;line-height:1.5;color:#6B3D42;font-weight:600;">{{ section.settings.reason_why }}</div>
      {%- endif -%}

      {%- if section.settings.trust_heading != blank -%}
        <div class="wk-trust">
          <span class="wk-trust-av">
            {%- for i in (1..section.settings.trust_count) -%}
              {%- assign tk = 'trust_' | append: i | append: '_image' -%}
              {%- assign timg = section.settings[tk] -%}
              {%- if timg -%}
                <img src="{{ timg | image_url: width: 160 }}" alt="" width="160" height="160" loading="lazy">
              {%- else -%}
                {%- comment -%} same customer photos as the homepage testimonials {%- endcomment -%}
                {%- assign tfb = 'wk-testimonial-' | append: i | append: '.jpg' -%}
                <img src="{{ tfb | asset_img_url: '160x160' }}" alt="" width="160" height="160" loading="lazy">
              {%- endif -%}
            {%- endfor -%}
            <span class="wk-trust-chk">&check;</span>
          </span>
          <span style="display:block;">
            <span class="wk-trust-h">{{ section.settings.trust_heading }}</span>
            {%- if section.settings.trust_text != blank -%}<span class="wk-trust-d">{{ section.settings.trust_text }}</span>{%- endif -%}
          </span>
        </div>
      {%- endif -%}
      {%- if section.settings.trust_line != blank -%}<div class="wk-trust-line" style="text-align:center;margin:12px 0 0;font-size:11.5px;letter-spacing:0.02em;color:#7a6258;font-weight:600;line-height:1.45;">{{ section.settings.trust_line }}</div>{%- endif -%}

      <!-- HOW TO USE / SHIPPING TABS -->
      <style>
        #wk-{{ section.id }}-tabs { margin-top:30px; }
        #wk-{{ section.id }}-tabs [data-wk-xpanel="use"].is-active,
        #wk-{{ section.id }}-tabs [data-wk-xpanel="ship"].is-active { display:block; }
        #wk-{{ section.id }}-tabs .wk-xpanel.is-active { grid-template-columns:1fr; gap:30px; }
        #wk-{{ section.id }}-tabs .wk-xt-simple { max-width:none; color:#F5E6D8; }
        #wk-{{ section.id }}-tabs .wk-xt-simple ul { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr; gap:14px; }
        #wk-{{ section.id }}-tabs .wk-xt-simple li { position:relative; padding-left:20px; font-size:15px; line-height:1.5; color:rgba(245,230,216,0.9); }
        #wk-{{ section.id }}-tabs .wk-xt-simple li::before { content:'•'; position:absolute; left:0; color:#C9653F; }
        #wk-{{ section.id }}-tabs .wk-xt-simple p { margin:0 0 14px; font-size:15px; line-height:1.6; color:rgba(245,230,216,0.9); }
        #wk-{{ section.id }}-tabs .wk-xt-simple p:last-child { margin-bottom:0; }
        #wk-{{ section.id }}-tabs .wk-xt-simple ul:last-child { margin-bottom:0; }
      </style>
      <div id="wk-{{ section.id }}-tabs">
        <div class="wk-xt">
          <div class="wk-xt-tabs" role="tablist">
            <button class="wk-xtab is-active" data-wk-xtab="use" role="tab" aria-selected="true" type="button">{{ section.settings.tab2_label }}</button>
            <button class="wk-xtab" data-wk-xtab="ship" role="tab" aria-selected="false" type="button">{{ section.settings.tab3_label }}</button>
          </div>
          <div class="wk-xt-body">
            <div class="wk-xpanel is-active" data-wk-xpanel="use" role="tabpanel">
              <div class="wk-xt-simple">{{ section.settings.use_content }}</div>
            </div>
            <div class="wk-xpanel" data-wk-xpanel="ship" role="tabpanel">
              <div class="wk-xt-simple">{{ section.settings.ship_content }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


<script>
(function(){
  function wkInit(){
  // womankind-2 pages wrap everything in .wk-root (and this script also drives the carousels there);
  // the homepage layout has no .wk-root, so fall back to this section or the buy box never initialises
  var root = document.querySelector('.wk-root') || document.getElementById('wk-sub-{{ section.id }}');
  if (!root || root.dataset.wkInit) return;
  root.dataset.wkInit = '1';
  var RING = '0 0 0 2px #6B3D42', NONE = '0 0 0 0 transparent';
  var state = { flavor:'cranberry', supply:'{{ section.settings.default_tier | default: '1' }}' };

  function applySelection(group){
    var val = state[group];
    root.querySelectorAll('[data-wk-ring]').forEach(function(el){
      var parts = el.getAttribute('data-wk-ring').split(':');
      if (parts[0] !== group) return;
      el.style.boxShadow = (parts[1] === val) ? RING : NONE;
    });
    if (group === 'supply') {
      root.querySelectorAll('[data-wk-plan]').forEach(function(card){
        var on = card.getAttribute('data-wk-plan') === val;
        card.classList.toggle('is-sel', on);
        card.setAttribute('aria-checked', on ? 'true' : 'false');
      });
    }
  }

  // --- bundles (1 / 2 / 3 bottles), each on its own subscribe & save plan, with gifts unlocked by bottle count ---
  var BOTTLE = {{ wk_variant.price | default: 6485 }};   // cents, live variant price (already in the market's presentment currency)
  // every selling plan on the product with its LIVE % discount and (Kaching config) delivery interval in months
  var SELLING_PLANS = [
    {%- assign wk_sp_first = true -%}
    {%- for grp in wk_product.selling_plan_groups -%}{%- for sp in grp.selling_plans -%}
      {%- unless wk_sp_first %},{% endunless %}{%- assign wk_adj = sp.price_adjustments.first -%}{ id: {{ sp.id }}, pct: {% if wk_adj and wk_adj.value_type == 'percentage' %}{{ wk_adj.value }}{% else %}0{% endif %}, opts: {{ sp.options | map: 'value' | json }} }{%- assign wk_sp_first = false -%}
    {%- endfor -%}{%- endfor -%}
  ];
  //   sub = the bundle's selling-plan % · one = the automatic one-time discount, used only if the bundle has no plan
  var TIERS = {
    '1': { m: 1, sub: {{ section.settings.tier_1_sub_pct }}, one: {{ section.settings.tier_1_one_pct }}, f: {{ section.settings.tier_1_freq | default: 1 }} },
    '2': { m: 2, sub: {{ section.settings.tier_2_sub_pct }}, one: {{ section.settings.tier_2_one_pct }}, f: {{ section.settings.tier_2_freq | default: 1 }} },
    '3': { m: 3, sub: {{ section.settings.tier_3_sub_pct }}, one: {{ section.settings.tier_3_one_pct }}, f: {{ section.settings.tier_3_freq | default: 1 }} }
  };
  var DESIGN = {{ request.design_mode }};
  var SAVE_LINE = {{ section.settings.save_line | json }};
  var GL_MORE = {{ section.settings.gifts_more | json }};
  var GL_ALL = {{ section.settings.gifts_all | json }};
  var GL_NONE = {{ section.settings.gifts_none | json }};

  function wkFreq(sp){
    for (var i = 0; i < sp.opts.length; i++) {
      try { var c = JSON.parse(sp.opts[i]); if (c && c.delivery && c.delivery.interval === 'MONTH') return c.delivery.frequency; } catch(e){}
    }
    return null;
  }
  // Each bundle's plan = the one whose live discount equals the bundle's % AND (when known) ships every f months.
  // Never matched by name — a wrong plan means a wrong price at checkout.
  var PLANS = {};
  Object.keys(TIERS).forEach(function(k){
    var t = TIERS[k];
    for (var i = 0; i < SELLING_PLANS.length; i++) {
      var sp = SELLING_PLANS[i], f = wkFreq(sp);
      if (sp.pct === t.sub && (f === null || f === t.f)) { PLANS[k] = sp; break; }
    }
    if (!PLANS[k] && window.console) console.warn('[wk-hero-meno-hrt-gb] no every-' + t.f + '-month selling plan at ' + t.sub + '% for ' + t.m + ' bottles - that bundle sells one-time, without gifts');
  });
  // the theme editor previews every bundle as a subscription, priced from the setting
  function isSub(k){ return !!PLANS[k] || DESIGN; }

  var WK_CUR = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD';
  var WK_NF; try { WK_NF = new Intl.NumberFormat('en', { style:'currency', currency:WK_CUR, currencyDisplay:'narrowSymbol' }); } catch(e){ try { WK_NF = new Intl.NumberFormat('en', { style:'currency', currency:WK_CUR }); } catch(_){ WK_NF = null; } }
  function wkMoney(cents){ var v=(cents||0)/100; return WK_NF ? WK_NF.format(v).replace(/[.,]00(?=\D*$)/, '') : '$' + v.toFixed(2).replace(/\.00$/, ''); }
  function wkPerDay(cents){ var v=(cents||0)/100/30; return WK_NF ? WK_NF.format(v) : '$' + v.toFixed(2); }   // one bottle = 30 days

  // Shopify rounds the selling-plan price per bottle but floors an automatic discount — mirror both exactly.
  function wkQuote(k){
    var t = TIERS[k];
    var per = isSub(k)
      ? Math.round(BOTTLE * (1 - (PLANS[k] ? PLANS[k].pct : t.sub) / 100))
      : BOTTLE - Math.floor(BOTTLE * t.one / 100);
    var full = BOTTLE * t.m, total = per * t.m;
    return { full: full, total: total, per: per, save: Math.round((1 - total / full) * 100) };
  }

  function applyPricing(){
    Object.keys(TIERS).forEach(function(k){
      var q = wkQuote(k);
      root.querySelectorAll('[data-wk-total="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.total); });
      root.querySelectorAll('[data-wk-perday="'+k+'"]').forEach(function(e){ e.textContent = wkPerDay(q.per); });
      root.querySelectorAll('[data-wk-compare="'+k+'"]').forEach(function(e){ e.textContent = wkMoney(q.full); e.style.display = q.save > 0 ? '' : 'none'; });
      root.querySelectorAll('[data-wk-save="'+k+'"]').forEach(function(e){ e.textContent = q.save + '% off'; e.style.visibility = q.save > 0 ? '' : 'hidden'; });
    });
    var q = wkQuote(state.supply);
    root.querySelectorAll('[data-wk-atc-now]').forEach(function(e){ e.textContent = wkMoney(q.total); });
    root.querySelectorAll('[data-wk-atc-was]').forEach(function(e){ e.textContent = wkMoney(q.full); e.style.display = q.save > 0 ? '' : 'none'; });
    root.querySelectorAll('[data-wk-saveline]').forEach(function(e){
      e.textContent = SAVE_LINE.replace('[pct]', q.save);
      e.style.display = isSub(state.supply) ? '' : 'none';
    });
  }

  // a gift is unlocked when the bundle is a subscription and has at least the gift's bottle count
  function unlocked(n){ return isSub(state.supply) && TIERS[state.supply].m >= n; }
  var glPrev = null;
  function applyGifts(){
    // panels = the starter kit + one per later gift; data-wk-gl-n = how many gifts sit in that panel
    var grps = root.querySelectorAll('[data-wk-gl-step]'), next = null, atNext = 0;
    grps.forEach(function(g){
      var n = +g.getAttribute('data-wk-gl-step'), c = +g.getAttribute('data-wk-gl-n') || 1, on = unlocked(n);
      if (on && glPrev && !glPrev[n]) { g.classList.remove('is-pop'); void g.offsetWidth; g.classList.add('is-pop'); }
      g.classList.toggle('is-on', on);
      if (!on) { if (next === null || n < next) { next = n; atNext = c; } else if (n === next) atNext += c; }
    });
    root.querySelectorAll('[data-wk-gl-link]').forEach(function(l){ l.classList.toggle('is-on', unlocked(+l.getAttribute('data-wk-gl-link'))); });
    var msg = root.querySelector('[data-wk-gl-msg]');
    if (msg) {
      var txt = !isSub(state.supply) ? GL_NONE : (next === null ? GL_ALL : GL_MORE.replace('[n]', next).replace('[count]', atNext).replace('[gifts]', atNext === 1 ? 'gift' : 'gifts').replace('bottles', next === 1 ? 'bottle' : 'bottles'));
      msg.innerHTML = txt.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      msg.style.display = txt ? '' : 'none';
    }
    glPrev = {}; [1, 2, 3].forEach(function(n){ glPrev[n] = unlocked(n); });
  }

  // the bundle's plan + its unlocked gifts; without a plan the bottles go alone at the one-time price
  function applyCart(){
    var k = state.supply, plan = PLANS[k];
    root.querySelectorAll('[data-wk-qty]').forEach(function(i){ i.value = TIERS[k].m; });
    root.querySelectorAll('[data-wk-selling-plan]').forEach(function(i){ i.value = plan ? plan.id : ''; i.disabled = !plan; });
    root.querySelectorAll('[data-wk-gift]').forEach(function(i){ i.disabled = !(plan && TIERS[k].m >= +i.getAttribute('data-wk-gift')); });
  }

  function applySupply(){ applyCart(); applyPricing(); applyGifts(); }

  root.querySelectorAll('[data-wk]').forEach(function(el){
    function pick(){
      var g = el.getAttribute('data-wk');
      state[g] = el.getAttribute('data-wk-val');
      applySelection(g);
      if (g === 'supply') applySupply();
    }
    el.addEventListener('click', pick);
    el.addEventListener('keydown', function(e){ if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); pick(); } });
  });
  applySelection('supply');
  applySupply();

  // Countdown to the end of the viewer's own day. `end` is recomputed every tick from a fresh
  // local Date, so it rolls over to the next midnight on its own and follows the visitor's timezone.
  var wkCd = root.querySelector('[data-wk-countdown]');
  if (wkCd) {
    function wkPad(n){ return (n < 10 ? '0' : '') + n; }
    function wkTick(){
      var now = new Date();
      var end = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0, 0);
      var ms = end - now; if (ms < 0) ms = 0;
      wkCd.textContent = wkPad(Math.floor(ms / 3600000)) + ':' +
                         wkPad(Math.floor(ms % 3600000 / 60000)) + ':' +
                         wkPad(Math.floor(ms % 60000 / 1000));
    }
    wkTick();
    setInterval(wkTick, 1000);
  }

  function bindAccordion(btnAttr, panelAttr){
    root.querySelectorAll('['+btnAttr+']').forEach(function(btn){
      btn.addEventListener('click', function(){
        var id = btn.getAttribute(btnAttr);
        var panel = root.querySelector('['+panelAttr+'="'+id+'"]');
        var isOpen = panel && panel.style.display !== 'none';
        root.querySelectorAll('['+panelAttr+']').forEach(function(p){ p.style.display = 'none'; });
        if (!isOpen && panel) panel.style.display = 'block';
      });
    });
  }
  bindAccordion('data-wk-faq', 'data-wk-faq-panel');

  var track = root.querySelector('[data-wk-track]');
  if (track) {
    var prevBtn = root.querySelector('[data-wk-prev]');
    var nextBtn = root.querySelector('[data-wk-next]');
    var bar = root.querySelector('[data-wk-bar]');
    function cardStep() {
      var card = track.querySelector('[data-wk-card]');
      return card ? card.getBoundingClientRect().width + 22 : track.clientWidth;
    }
    if (prevBtn) prevBtn.addEventListener('click', function(){ track.scrollBy({ left: -cardStep(), behavior: 'smooth' }); });
    if (nextBtn) nextBtn.addEventListener('click', function(){ track.scrollBy({ left: cardStep(), behavior: 'smooth' }); });
    function updateBar() {
      if (!bar) return;
      var max = track.scrollWidth - track.clientWidth;
      var ratio = max > 0 ? track.scrollLeft / max : 0;
      bar.style.width = (33 + ratio * 67) + '%';
    }
    track.addEventListener('scroll', updateBar, { passive: true });
    window.addEventListener('resize', updateBar);
    updateBar();
  }

  var eg = root.querySelector('.wk-experts-grid');
  var dotsWrap = root.querySelector('.wk-experts-dots');
  if (eg && dotsWrap) {
    var dots = dotsWrap.querySelectorAll('span');
    var cards = eg.children;
    function egStep() {
      return (cards.length > 1)
        ? (cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left)
        : eg.clientWidth;
    }
    function egUpdate() {
      var step = egStep() || eg.clientWidth;
      var idx = Math.round(eg.scrollLeft / step);
      idx = Math.max(0, Math.min(dots.length - 1, idx));
      for (var i = 0; i < dots.length; i++) dots[i].classList.toggle('is-active', i === idx);
    }
    eg.addEventListener('scroll', egUpdate, { passive: true });
    window.addEventListener('resize', egUpdate);
    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        if (!cards[i]) return;
        var target = eg.scrollLeft + (cards[i].getBoundingClientRect().left - eg.getBoundingClientRect().left);
        eg.scrollTo({ left: target, behavior: 'smooth' });
      });
    });
    egUpdate();
  }

  var ingTrack = root.querySelector('[data-wk-ing-track]');
  if (ingTrack) {
    var ingPrev = root.querySelector('[data-wk-ing-prev]');
    var ingNext = root.querySelector('[data-wk-ing-next]');
    var ingBar = root.querySelector('[data-wk-ing-bar]');
    function ingStep() {
      var c = ingTrack.querySelector('[data-wk-ing-card]');
      return c ? c.getBoundingClientRect().width + 18 : ingTrack.clientWidth;
    }
    if (ingPrev) ingPrev.addEventListener('click', function () { ingTrack.scrollBy({ left: -ingStep(), behavior: 'smooth' }); });
    if (ingNext) ingNext.addEventListener('click', function () { ingTrack.scrollBy({ left: ingStep(), behavior: 'smooth' }); });
    function ingBarUpdate() {
      if (!ingBar) return;
      var max = ingTrack.scrollWidth - ingTrack.clientWidth;
      var ratio = max > 0 ? ingTrack.scrollLeft / max : 0;
      ingBar.style.width = (33 + ratio * 67) + '%';
    }
    ingTrack.addEventListener('scroll', ingBarUpdate, { passive: true });
    window.addEventListener('resize', ingBarUpdate);
    ingBarUpdate();
  }

  var sfOverlay = root.querySelector('[data-wk-suppfacts-overlay]');
  if (sfOverlay) {
    var sfDialog = sfOverlay.querySelector('[data-wk-suppfacts-dialog]');
    function sfOpen() { sfOverlay.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    function sfClose() { sfOverlay.style.display = 'none'; document.body.style.overflow = ''; }
    root.querySelectorAll('[data-wk-suppfacts-open]').forEach(function (btn) { btn.addEventListener('click', sfOpen); });
    root.querySelectorAll('[data-wk-suppfacts-close]').forEach(function (btn) { btn.addEventListener('click', sfClose); });
    sfOverlay.addEventListener('click', function (e) { if (sfDialog && !sfDialog.contains(e.target)) sfClose(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && sfOverlay.style.display === 'flex') sfClose(); });
  }

  var thumbTrack = root.querySelector('[data-wk-thumb-track]');
  if (thumbTrack) {
    var thumbPrev = root.querySelector('[data-wk-thumb-prev]');
    var thumbNext = root.querySelector('[data-wk-thumb-next]');
    function thumbStep() {
      var c = thumbTrack.querySelector('button');
      return c ? c.getBoundingClientRect().width + 10 : thumbTrack.clientWidth;
    }
    if (thumbPrev) thumbPrev.addEventListener('click', function () { thumbTrack.scrollBy({ left: -thumbStep() * 2, behavior: 'smooth' }); });
    if (thumbNext) thumbNext.addEventListener('click', function () { thumbTrack.scrollBy({ left: thumbStep() * 2, behavior: 'smooth' }); });
  }

  var heroTrack = root.querySelector('[data-wk-hero-track]');
  var heroBadge = root.querySelector('[data-wk-badge]');
  var heroThumbs = root.querySelectorAll('[data-wk-thumb]');
  var heroSlides = root.querySelectorAll('.wk-hero-slide');
  var heroIdx = 0;

  function heroMark(idx) {
    if (idx === heroIdx || !heroThumbs.length) return;
    heroIdx = idx;
    heroThumbs.forEach(function (b, i) { b.style.borderColor = (i === idx) ? '#6B3D42' : 'transparent'; });
    if (heroBadge) heroBadge.style.display = (idx === 0) ? '' : 'none';
    var btn = heroThumbs[idx];
    if (btn && thumbTrack && thumbTrack.scrollTo) {
      thumbTrack.scrollTo({ left: btn.offsetLeft - (thumbTrack.clientWidth - btn.offsetWidth) / 2, behavior: 'smooth' });
    }
  }

  function heroGo(idx, smooth) {
    if (!heroTrack || !heroSlides.length) return;
    if (idx < 0) idx = 0;
    if (idx > heroSlides.length - 1) idx = heroSlides.length - 1;
    heroTrack.scrollTo({ left: idx * heroTrack.clientWidth, behavior: smooth === false ? 'auto' : 'smooth' });
    heroMark(idx);
  }

  if (heroTrack) {
    // the browser drives the gesture; we just read back where it landed
    var heroTick = null;
    heroTrack.addEventListener('scroll', function () {
      if (heroTick) return;
      heroTick = requestAnimationFrame(function () {
        heroTick = null;
        var w = heroTrack.clientWidth;
        if (w) heroMark(Math.round(heroTrack.scrollLeft / w));
      });
    }, { passive: true });

    // keep the current slide framed if the viewport changes
    var heroRz;
    window.addEventListener('resize', function () {
      clearTimeout(heroRz);
      heroRz = setTimeout(function () { heroGo(heroIdx, false); }, 150);
    });
  }

  heroThumbs.forEach(function (btn, idx) {
    btn.addEventListener('click', function () { heroGo(idx); });
  });

  var xtabs = root.querySelectorAll('[data-wk-xtab]');
  if (xtabs.length) {
    xtabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-wk-xtab');
        xtabs.forEach(function (b) {
          var on = b.getAttribute('data-wk-xtab') === id;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        root.querySelectorAll('[data-wk-xpanel]').forEach(function (p) {
          p.classList.toggle('is-active', p.getAttribute('data-wk-xpanel') === id);
        });
      });
    });
  }
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', wkInit); } else { wkInit(); }
})();
</script>

