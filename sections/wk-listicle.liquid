{%- comment -%}
  Womankind — solution-aware listicle (focus: hot flashes).
  "7 things a hot-flash formula needs before it's worth your money."
  Narrated first-person by Sarah Ellison, WHNP. Self-contained: brand fonts via
  wk-fonts, scoped reset under #wk-{{ section.id }}, minimal 'womankind' layout.
  Layout mirrors the wireframe: lead editorial image, each reason a two-column
  image+text block (alternating sides), lifestyle image, offer image.
  Copy is hardcoded (avoids the 500-char schema-default limit). CTAs -> wk_pdp.
  Image slots are editable image_pickers; blank shows a branded placeholder.
{%- endcomment -%}
{%- assign wk_pdp = section.settings.cta_url | default: 'https://trywomankind.com/products/hormonal-support-gummies' -%}

{% render 'wk-fonts' %}

<style>
  #wk-{{ section.id }} * { box-sizing:border-box; }
  #wk-{{ section.id }} { background:#F5E6D8; color:#3A2A20; font-family:'Hanken Grotesk',sans-serif; overflow-x:clip; -webkit-font-smoothing:antialiased; }
  #wk-{{ section.id }} ::selection { background:#C9653F; color:#F5E6D8; }
  #wk-{{ section.id }} img { max-width:100%; display:block; }
  #wk-{{ section.id }} p { margin:0; }

  #wk-{{ section.id }} .lst-sec { padding:70px 28px; }
  #wk-{{ section.id }} .lst-wrap { max-width:720px; margin:0 auto; }
  #wk-{{ section.id }} .lst-wide { max-width:1000px; margin:0 auto; }

  #wk-{{ section.id }} .lst-lede p { font-size:17px; line-height:1.75; color:#4a3a30; margin:0 0 20px; }
  #wk-{{ section.id }} .lst-h2 { font-family:'Fraunces',serif; font-weight:400; font-size:31px; line-height:1.2; color:#6B3D42; margin:0 0 22px; }

  /* image placeholder */
  #wk-{{ section.id }} .lst-imgbox { position:relative; background:linear-gradient(150deg,#D8C2BA,#C9A89F); overflow:hidden; display:flex; align-items:center; justify-content:center; }
  #wk-{{ section.id }} .lst-imgbox img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  #wk-{{ section.id }} .lst-ph { position:relative; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; color:#6B3D42; opacity:0.8; font-weight:700; text-align:center; padding:0 14px; }
  #wk-{{ section.id }} .lst-ph small { display:block; opacity:0.7; letter-spacing:0.06em; font-weight:600; margin-top:5px; }

  /* lead / full-width images */
  #wk-{{ section.id }} .lst-lead-img { aspect-ratio:16/8; border-radius:16px; margin:0 auto; max-width:840px; }

  /* reason two-column blocks */
  #wk-{{ section.id }} .lst-reason { display:grid; grid-template-columns:0.82fr 1.18fr; gap:0; background:#FBF1E6; border:1px solid rgba(107,61,66,0.14); border-radius:16px; overflow:hidden; margin:0 0 26px; align-items:stretch; }
  #wk-{{ section.id }} .lst-reason.rev { grid-template-columns:1.18fr 0.82fr; }
  #wk-{{ section.id }} .lst-reason .lst-imgbox { min-height:100%; }
  #wk-{{ section.id }} .lst-reason.rev .lst-imgbox { order:2; }
  #wk-{{ section.id }} .lst-reason-body { padding:34px 34px; }
  #wk-{{ section.id }} .lst-cardhead { display:flex; gap:16px; align-items:flex-start; margin:0 0 18px; }
  #wk-{{ section.id }} .lst-num { flex:0 0 auto; width:46px; height:46px; border-radius:50%; background:#6B3D42; color:#E2A24C; font-family:'Fraunces',serif; font-size:21px; display:flex; align-items:center; justify-content:center; }
  #wk-{{ section.id }} .lst-reason-body h3 { font-family:'Fraunces',serif; font-weight:500; font-size:22px; line-height:1.25; color:#3A2A20; margin:5px 0 0; }
  #wk-{{ section.id }} .lst-reason-body p { font-size:15.5px; line-height:1.7; color:#4a3a30; margin:0 0 15px; }
  #wk-{{ section.id }} .lst-lbl { font-weight:700; color:#6B3D42; }
  #wk-{{ section.id }} .lst-pass { background:#F0E4D2; border-left:3px solid #C9653F; border-radius:0 12px 12px 0; padding:16px 20px; margin:18px 0 0; }
  #wk-{{ section.id }} .lst-pass p { margin:0; font-size:15px; color:#3A2A20; }
  #wk-{{ section.id }} .lst-pass .lst-lbl { color:#C9653F; }

  /* split (image + content) generic block */
  #wk-{{ section.id }} .lst-split { display:grid; grid-template-columns:1fr 1fr; gap:0; border-radius:16px; overflow:hidden; align-items:stretch; }
  #wk-{{ section.id }} .lst-split .lst-imgbox { min-height:360px; }

  /* comparison table */
  #wk-{{ section.id }} .lst-table { width:100%; border-collapse:collapse; background:#FBF1E6; border:1px solid rgba(107,61,66,0.16); border-radius:16px; overflow:hidden; }
  #wk-{{ section.id }} .lst-table th, #wk-{{ section.id }} .lst-table td { text-align:left; padding:16px 18px; font-size:14px; line-height:1.5; border-bottom:1px solid rgba(107,61,66,0.12); vertical-align:top; }
  #wk-{{ section.id }} .lst-table thead th { background:#6B3D42; color:#F5E6D8; font-family:'Fraunces',serif; font-weight:500; font-size:15px; }
  #wk-{{ section.id }} .lst-table thead th:last-child { color:#E2A24C; }
  #wk-{{ section.id }} .lst-table td:first-child { font-weight:600; color:#3A2A20; }
  #wk-{{ section.id }} .lst-table td:nth-child(2) { color:#8a7365; }
  #wk-{{ section.id }} .lst-table td:last-child { color:#6B3D42; font-weight:600; }
  #wk-{{ section.id }} .lst-tablescroll { overflow-x:auto; }

  /* bands */
  #wk-{{ section.id }} .lst-band { background:#6B3D42; color:#F5E6D8; }
  #wk-{{ section.id }} .lst-band .lst-h2 { color:#F5E6D8; }
  #wk-{{ section.id }} .lst-band p { color:rgba(245,230,216,0.9); }
  #wk-{{ section.id }} .lst-band .lst-emph { color:#E2A24C; }

  /* CTA */
  #wk-{{ section.id }} .lst-cta { display:inline-flex; align-items:center; gap:10px; background:#C9653F; color:#F5E6D8; text-decoration:none; border-radius:999px; padding:18px 44px; font-size:14px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; }
  #wk-{{ section.id }} .lst-cta-sub { font-size:12.5px; color:#8a7365; margin:14px 0 0; letter-spacing:0.02em; }

  /* sticky sale bar */
  #wk-{{ section.id }}-bar { position:sticky; top:0; z-index:50; background:#6B3D42; color:#F5E6D8; text-align:center; padding:11px 18px; font-size:13px; letter-spacing:0.03em; display:flex; align-items:center; justify-content:center; gap:14px; flex-wrap:wrap; }
  #wk-{{ section.id }}-bar a { color:#E2A24C; text-decoration:underline; text-underline-offset:2px; font-weight:600; white-space:nowrap; }

  /* offer card */
  #wk-{{ section.id }} .lst-offer { background:#FBF1E6; border:1px solid rgba(107,61,66,0.16); border-radius:18px; overflow:hidden; display:grid; grid-template-columns:1fr 1fr; align-items:stretch; }
  #wk-{{ section.id }} .lst-offer .lst-imgbox { min-height:340px; }
  #wk-{{ section.id }} .lst-offer-body { padding:44px 40px; }

  /* objection Q&A */
  #wk-{{ section.id }} .lst-obj { margin:0 0 24px; }
  #wk-{{ section.id }} .lst-obj h4 { font-family:'Fraunces',serif; font-weight:500; font-size:19px; color:#6B3D42; margin:0 0 8px; }
  #wk-{{ section.id }} .lst-obj p { font-size:15.5px; line-height:1.7; color:#4a3a30; margin:0; }

  #wk-{{ section.id }} .lst-legal { font-size:11.5px; line-height:1.6; color:#9a8578; }
  #wk-{{ section.id }} .lst-legal p { margin:0 0 10px; }

  @media (max-width:749px){
    #wk-{{ section.id }} .lst-sec { padding:52px 20px; }
    #wk-{{ section.id }} .lst-h1 { font-size:32px !important; }
    #wk-{{ section.id }} .lst-h2 { font-size:26px; }
    #wk-{{ section.id }} .lst-reason, #wk-{{ section.id }} .lst-reason.rev, #wk-{{ section.id }} .lst-split, #wk-{{ section.id }} .lst-offer { grid-template-columns:1fr !important; }
    #wk-{{ section.id }} .lst-reason .lst-imgbox, #wk-{{ section.id }} .lst-reason.rev .lst-imgbox { order:0 !important; min-height:230px; aspect-ratio:16/10; }
    #wk-{{ section.id }} .lst-reason-body { padding:26px 22px; }
    #wk-{{ section.id }} .lst-reason-body h3 { font-size:20px; }
    #wk-{{ section.id }} .lst-split .lst-imgbox, #wk-{{ section.id }} .lst-offer .lst-imgbox { min-height:0; aspect-ratio:16/10; }
    #wk-{{ section.id }} .lst-offer-body { padding:30px 24px; }
    #wk-{{ section.id }} .lst-table { min-width:560px; }
  }
</style>

<div id="wk-{{ section.id }}">

  {%- if section.settings.sale_bar_on -%}
  <div id="wk-{{ section.id }}-bar">
    <span>{{ section.settings.sale_bar_text }}</span>
    <a href="{{ wk_pdp }}">Shop the offer &rarr;</a>
  </div>
  {%- endif -%}

  <!-- HERO -->
  <section class="lst-sec" style="padding-bottom:22px;">
    <div class="lst-wrap">
      <div style="display:flex;align-items:center;gap:14px;margin:0 0 26px;">
        <div style="width:54px;height:54px;border-radius:50%;overflow:hidden;background:#C9A89F;flex:0 0 auto;"><img src="{{ 'wk-adv2-byline.jpg' | asset_url }}" alt="Sarah Ellison, WHNP" width="54" height="54" style="width:100%;height:100%;object-fit:cover;"></div>
        <div>
          <div style="font-size:14px;font-weight:600;color:#3A2A20;">By Sarah Ellison, WHNP</div>
          <div style="font-size:12px;color:#8a7365;line-height:1.4;">Women's Health Nurse Practitioner · 25 Years in Women's Health · 5 min read</div>
        </div>
      </div>

      <h1 class="lst-h1" style="font-family:'Fraunces',serif;font-weight:400;font-size:42px;line-height:1.14;color:#6B3D42;margin:0 0 8px;">7 things a hot-flash formula needs before it's worth your money.</h1>
      <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:26px;line-height:1.2;color:#C9653F;margin:0 0 26px;">Most gummies fail 6 of them.</p>

      <p style="font-size:19px;line-height:1.65;color:#3A2A20;font-weight:600;margin:0;">You've tried everything and you're still flushing at 3am. You're not the problem. The formulas are. Here's the checklist that exposes them all — and the one formula that finally passes it.</p>
    </div>
  </section>

  <!-- LEAD EDITORIAL IMAGE -->
  <section class="lst-sec" style="padding-top:0;padding-bottom:20px;">
    <div class="lst-imgbox lst-lead-img">
      {%- if section.settings.hero_image -%}<img src="{{ section.settings.hero_image | image_url: width: 1680 }}" alt="{{ section.settings.hero_image.alt }}" loading="eager">{%- else -%}<span class="lst-ph">Editorial · lead image<small>woman, warm morning light</small></span>{%- endif -%}
    </div>
  </section>

  <!-- LEDE -->
  <section class="lst-sec" style="padding-top:24px;padding-bottom:20px;">
    <div class="lst-wrap lst-lede">
      <p>Let me guess how you got here.</p>
      <p>It's late. You're in bed — or you're standing in the kitchen with the freezer door open, holding your wrists against the cold, waiting for your face to stop burning. You've been let down so many times that you almost didn't click. Another bottle. Another promise. Another $30 flushed down the same drain as your estrogen.</p>
      <p>So let me start with the thing nobody has told you, the thing I've watched women wait years to hear:</p>
      <p style="font-family:'Fraunces',serif;font-size:30px;line-height:1.2;color:#6B3D42;font-weight:500;margin:8px 0 24px;">It was never you.</p>
      <p>Not the gummies that did nothing. Not the "clinical" pills that were quietly under-dosed. Not the gadgets. You didn't fail the products. The products failed you — most of them on purpose.</p>
      <p>I'm a women's health nurse practitioner. I've spent 25 years in this field, and I've watched this industry sell sugar pills with pretty labels to women at the most vulnerable moment of their lives. And I've sat in exam rooms with women who quietly told me another one didn't work — and watched them blame themselves for it.</p>
      <p>I've also been the woman flushing in my own clinic, fanning myself with a clipboard in front of a patient, sleeping alone while my husband took the spare room because the sheets were soaked through every night.</p>
      <p>So I read everything. I checked every label. And I built the checklist I'm about to give you.</p>
      <p style="font-size:18px;color:#3A2A20;font-weight:700;">Seven things. Most menopause formulas fail six of them. One passes all seven.</p>
      <p>Print it. Screenshot it. Take it down the pharmacy aisle with you. Because once you see what the industry is doing to you, you'll never look at another pretty bottle the same way.</p>
    </div>
  </section>

  <!-- THE 7 REASONS (two-column, alternating) -->
  <section class="lst-sec" style="padding-top:20px;">
    <div class="lst-wide">

      <!-- 1 -->
      <div class="lst-reason">
        <div class="lst-imgbox">{%- if section.settings.reason1_image -%}<img src="{{ section.settings.reason1_image | image_url: width: 900 }}" alt="" loading="lazy">{%- else -%}<span class="lst-ph">Reason 1<small>label close-up / doses</small></span>{%- endif -%}</div>
        <div class="lst-reason-body">
          <div class="lst-cardhead"><div class="lst-num">1</div><h3>Full researched doses — printed on the label. No "proprietary blend" hide-and-seek.</h3></div>
          <p><span class="lst-lbl">What most brands do:</span> List "black cohosh" with no amount and no standardization, then hide everything inside a "proprietary blend" — which is just a legal way to sell you a quarter-dose at full price.</p>
          <p><span class="lst-lbl">Why it fails — and why this one should make you angry:</span> The studies showing black cohosh actually calms hot flashes used specific doses at specific standardization. If a label won't tell you what's inside, assume it's not enough to work — because if it were, they'd be screaming it from the bottle. You spent months swallowing hope that was engineered to fail before you opened the lid. <strong>You weren't resistant to the herbs. You were being under-dosed.</strong></p>
          <p><span class="lst-lbl">What to demand:</span> Every milligram printed. Black cohosh standardized to 5% triterpene glycosides. Red clover at 40% isoflavones.</p>
          <div class="lst-pass"><p><span class="lst-lbl">&#10003; Womankind passes:</span> 100mg black cohosh at 5% triterpenes (more than 2× the dose of the most-studied clinical brand), 100mg red clover at 40% isoflavones, 100mg dong quai at 1% ligustilide. All on the label. Go check — the transparency is the tell.</p></div>
        </div>
      </div>

      <!-- 2 -->
      <div class="lst-reason rev">
        <div class="lst-imgbox">{%- if section.settings.reason2_image -%}<img src="{{ section.settings.reason2_image | image_url: width: 900 }}" alt="" loading="lazy">{%- else -%}<span class="lst-ph">Reason 2<small>gummies / no sugar</small></span>{%- endif -%}</div>
        <div class="lst-reason-body">
          <div class="lst-cardhead"><div class="lst-num">2</div><h3>Zero sugar. Not "low sugar." ZERO.</h3></div>
          <p><span class="lst-lbl">What most brands do:</span> Load gummies with 2–4g of sugar per serving, then call it a wellness product.</p>
          <p><span class="lst-lbl">Why it fails:</span> This is the one that made me genuinely furious. Sugar feeds the exact gut bacteria that throw your estrogen out of balance — and unstable estrogen is what fires the flush in the first place. Every sweet little gummy you've been dutifully taking was quietly <em>feeding the fire it claimed to put out.</em> You were paying to make it worse — and then blaming yourself when it did.</p>
          <p><span class="lst-lbl">What to demand:</span> Zero grams of sugar. Not 2g. Not "naturally sweetened." Zero.</p>
          <div class="lst-pass"><p><span class="lst-lbl">&#10003; Womankind passes:</span> 0g sugar. Sweetened with stevia and monk fruit — no glucose spike, nothing feeding the imbalance behind the flush.</p></div>
        </div>
      </div>

      <!-- 3 -->
      <div class="lst-reason">
        <div class="lst-imgbox">{%- if section.settings.reason3_image -%}<img src="{{ section.settings.reason3_image | image_url: width: 900 }}" alt="" loading="lazy">{%- else -%}<span class="lst-ph">Reason 3<small>gut / estrobolome</small></span>{%- endif -%}</div>
        <div class="lst-reason-body">
          <div class="lst-cardhead"><div class="lst-num">3</div><h3>The estrobolome layer. This is the one 95% of formulas skip.</h3></div>
          <p><span class="lst-lbl">What most brands do:</span> Throw two botanicals in a bottle and call it a menopause formula.</p>
          <p><span class="lst-lbl">Why it fails:</span> A hot flash isn't a heat event. It starts in your brain's thermostat — the hypothalamus — which goes haywire as estrogen swings through perimenopause. And here's the part almost nobody tells you: your gut houses a community of bacteria called the <strong>estrobolome</strong> whose job is to recycle and steady your estrogen. When it's out of balance, the thermostat misfires constantly — by day and by night. Botanicals alone are trying to calm a hormone signal they can't even reach. It's like fixing the siren without touching the fire.</p>
          <p><span class="lst-lbl">What to demand:</span> A formula that supports the gut-hormone axis — not just the flush.</p>
          <div class="lst-pass"><p><span class="lst-lbl">&#10003; Womankind passes:</span> A Menopause Support Probiotic Blend — <strong>10 billion CFU across six named strains</strong> (<em>B. breve, B. lactis, B. longum, L. rhamnosus, L. gasseri, L. reuteri</em>) — the bacterial families most closely tied to estrogen metabolism. This is the layer that separates "fewer flushes this week" from "steady for the long run."</p></div>
        </div>
      </div>

      <!-- 4 -->
      <div class="lst-reason rev">
        <div class="lst-imgbox">{%- if section.settings.reason4_image -%}<img src="{{ section.settings.reason4_image | image_url: width: 900 }}" alt="" loading="lazy">{%- else -%}<span class="lst-ph">Reason 4<small>supplement facts panel</small></span>{%- endif -%}</div>
        <div class="lst-reason-body">
          <div class="lst-cardhead"><div class="lst-num">4</div><h3>Real strain names, real CFU counts. Not "probiotic blend" with no numbers.</h3></div>
          <p><span class="lst-lbl">What most brands do:</span> Print "probiotic blend" on the label and hope you don't ask questions.</p>
          <p><span class="lst-lbl">Why it fails:</span> A probiotic without a named strain or a CFU count isn't an ingredient — it's a costume. Some gummies contain a few million CFU, thousands of times below anything therapeutic. You were taking a fairy dusting and hoping it rebuilt a system. It can't. It was never enough.</p>
          <p><span class="lst-lbl">What to demand:</span> Named strains. A CFU count in the billions. On the label.</p>
          <div class="lst-pass"><p><span class="lst-lbl">&#10003; Womankind passes:</span> Six named strains. 10 billion CFU per serving. Nothing hidden, nothing vague.</p></div>
        </div>
      </div>

      <!-- 5 -->
      <div class="lst-reason">
        <div class="lst-imgbox">{%- if section.settings.reason5_image -%}<img src="{{ section.settings.reason5_image | image_url: width: 900 }}" alt="" loading="lazy">{%- else -%}<span class="lst-ph">Reason 5<small>Dr. Katie Chen</small></span>{%- endif -%}</div>
        <div class="lst-reason-body">
          <div class="lst-cardhead"><div class="lst-num">5</div><h3>Built by a credentialed clinician — not a marketing team.</h3></div>
          <p><span class="lst-lbl">What most brands do:</span> Hire an influencer, take pretty photos, and sell you a feeling.</p>
          <p><span class="lst-lbl">Why it fails:</span> Perimenopause is not a vibe. It's the most medically dismissed transition in women's health — most clinicians get five minutes of training on it, which is exactly why so many of you have been told your labs are "normal" and offered an antidepressant for a hormonal cascade. You don't need another brand ambassador with a ring light. You need someone with real credentials who got angry enough to solve it.</p>
          <p><span class="lst-lbl">What to demand:</span> A clinician behind the formula — and their name on it.</p>
          <div class="lst-pass"><p><span class="lst-lbl">&#10003; Womankind passes:</span> Formulated by <strong>Dr. Katie Chen, board-certified OB/GYN with Menopause Society certification (MSCP)</strong> — a doctor who spent years watching her patients get dismissed with "normal" labs, walked to the shelf to find something honest to recommend, found nothing, and built the formula herself. This isn't a marketing story. It's a doctor refusing to lose another patient to the shrug.</p></div>
        </div>
      </div>

      <!-- 6 -->
      <div class="lst-reason rev">
        <div class="lst-imgbox">{%- if section.settings.reason6_image -%}<img src="{{ section.settings.reason6_image | image_url: width: 900 }}" alt="" loading="lazy">{%- else -%}<span class="lst-ph">Reason 6<small>90-day guarantee</small></span>{%- endif -%}</div>
        <div class="lst-reason-body">
          <div class="lst-cardhead"><div class="lst-num">6</div><h3>A guarantee that matches the biology. 30 days is a setup.</h3></div>
          <p><span class="lst-lbl">What most brands do:</span> Offer a 30-day guarantee on a product whose mechanism takes longer than 30 days.</p>
          <p><span class="lst-lbl">Why it fails:</span> The gut-hormone axis doesn't reset in two weeks. The estrobolome needs time to rebalance, and black cohosh's full effect lands around week 8. A 30-day guarantee is engineered to have you quit right before the shift happens — the brand keeps your money and you keep believing <em>you</em> failed. That's not confidence. That's math designed against you.</p>
          <p><span class="lst-lbl">What to demand:</span> A guarantee that covers the time your body actually needs.</p>
          <div class="lst-pass"><p><span class="lst-lbl">&#10003; Womankind passes:</span> <strong>90 days. Full refund. No returns.</strong> If your flashes haven't changed, email them and keep the bottles. That guarantee is the only reason a skeptic like me tried it in the first place — and it's the tell of a brand that knows its formula works.</p></div>
        </div>
      </div>

      <!-- 7 -->
      <div class="lst-reason">
        <div class="lst-imgbox">{%- if section.settings.reason7_image -%}<img src="{{ section.settings.reason7_image | image_url: width: 900 }}" alt="" loading="lazy">{%- else -%}<span class="lst-ph">Reason 7<small>third-party tested</small></span>{%- endif -%}</div>
        <div class="lst-reason-body">
          <div class="lst-cardhead"><div class="lst-num">7</div><h3>Third-party tested. Because you shouldn't have to take anyone's word for it.</h3></div>
          <p><span class="lst-lbl">What most brands do:</span> Self-certify. "Trust us" isn't a quality program.</p>
          <p><span class="lst-lbl">Why it fails:</span> The supplement industry is full of products that don't contain what the label claims — you've probably already swallowed one of them. Independent testing is the difference between "we say it's clean" and "someone else proved it."</p>
          <p><span class="lst-lbl">What to demand:</span> Third-party testing. Made in the USA. Vegan. No artificial sweeteners.</p>
          <div class="lst-pass"><p><span class="lst-lbl">&#10003; Womankind passes:</span> Third-party tested, made in the USA, vegan, zero sugar, zero artificial sweeteners.</p></div>
        </div>
      </div>

    </div>
  </section>

  <!-- VERDICT TABLE -->
  <section class="lst-sec" style="background:#EFDFD0;">
    <div class="lst-wide">
      <h2 class="lst-h2" style="text-align:center;">The verdict, side by side</h2>
      <div class="lst-tablescroll">
        <table class="lst-table">
          <thead><tr><th></th><th>The gummy you're holding now</th><th>Womankind</th></tr></thead>
          <tbody>
            <tr><td>Researched doses, printed on the label</td><td>Probably not — check for "proprietary blend"</td><td>&#10003; Every milligram named</td></tr>
            <tr><td>Zero sugar</td><td>2–4g per serving is typical</td><td>&#10003; 0g — stevia + monk fruit</td></tr>
            <tr><td>Estrobolome support</td><td>Almost certainly missing</td><td>&#10003; 10B CFU, 6 named strains</td></tr>
            <tr><td>Clinician-formulated</td><td>An influencer, maybe</td><td>&#10003; OB/GYN + MSCP founder</td></tr>
            <tr><td>Guarantee that matches the biology</td><td>30 days, if anything</td><td>&#10003; 90 days, full refund, no returns</td></tr>
