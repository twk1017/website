            <button type="button" data-adv-faq="{{ i }}" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" style="width:100%;cursor:pointer;font-family:inherit;background:none;border:none;text-align:left;padding:22px 0;display:flex;align-items:center;justify-content:space-between;gap:16px;">
