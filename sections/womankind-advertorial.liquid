      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 0 44px;color:#6B3D42;">{{ section.settings.faq_heading }}</h2>
      <div>
        {%- for i in (1..7) -%}
          {%- assign qk = 'faq' | append: i | append: '_q' -%}
          {%- assign ak = 'faq' | append: i | append: '_a' -%}
