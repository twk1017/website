<script>
  (function(){
    function init(){
      var root = document.getElementById('wk-{{ section.id }}');
      if (!root || root.dataset.advInit) return;
      root.dataset.advInit = '1';

      // ---- Offer buy-box: tier + subscription pricing (mirrors the store buy-box) ----
      var RING = '0 0 0 2px #6B3D42', NONE = '0 0 0 0 transparent';
      var state = { supply: '3' };
      var BOTTLE = {{ wk_variant.price | default: 4200 }};
      var SELLING_PLAN = {{ wk_selling_plan.id | default: 'null' }};
      var TIERS = { '1': { m:1, off:0 }, '3': { m:3, off:0.30 }, '6': { m:6, off:0.40 } };
      var SUB_OFF = 0.25;
      var refillEl = root.querySelector('[data-adv-refill]');
      function money(c){ return '$' + (c/100).toFixed(2).replace(/\.00$/, ''); }
      function refillOn(){ return !!(refillEl && refillEl.getAttribute('aria-checked') === 'true'); }
      function quote(tier, on){
        var t = TIERS[tier], full = BOTTLE * t.m;
        var afterTier = Math.round(full * (1 - t.off));
        var total = on ? Math.round(afterTier * (1 - SUB_OFF)) : afterTier;
        return { full: full, total: total, save: Math.round((1 - total/full) * 100) };
      }
      function applyRings(){
        root.querySelectorAll('[data-adv-ring]').forEach(function(el){
          el.style.boxShadow = (el.getAttribute('data-adv-ring') === state.supply) ? RING : NONE;
        });
      }
      function applyPricing(){
        var on = refillOn();
        ['1','3','6'].forEach(function(k){
          var q = quote(k, on);
          root.querySelectorAll('[data-adv-total="'+k+'"]').forEach(function(e){ e.textContent = money(q.total); });
          root.querySelectorAll('[data-adv-compare="'+k+'"]').forEach(function(e){ e.textContent = money(q.full); e.style.visibility = q.save > 0 ? 'visible' : 'hidden'; });
          root.querySelectorAll('[data-adv-save="'+k+'"]').forEach(function(e){ e.textContent = 'Save ' + q.save + '%'; e.style.visibility = q.save > 0 ? 'visible' : 'hidden'; });
        });
        root.querySelectorAll('[data-adv-atc-total]').forEach(function(e){ e.textContent = money(quote(state.supply, on).total); });
      }
      function applyCart(){
        var sub = refillOn() && SELLING_PLAN;
        root.querySelectorAll('[data-adv-qty]').forEach(function(i){ i.value = state.supply; });
        root.querySelectorAll('[data-adv-selling-plan]').forEach(function(i){ i.disabled = !sub; });
      }
      root.querySelectorAll('[data-adv="supply"]').forEach(function(el){
        el.addEventListener('click', function(){ state.supply = el.getAttribute('data-adv-val'); applyRings(); applyCart(); applyPricing(); });
      });
      if (refillEl){
        var box = refillEl.querySelector('[data-adv-refill-box]');
        var chk = refillEl.querySelector('[data-adv-refill-check]');
        function toggleRefill(){
          var on = refillEl.getAttribute('aria-checked') === 'true';
          refillEl.setAttribute('aria-checked', on ? 'false' : 'true');
          if (box) box.style.background = on ? 'transparent' : '#6B3D42';
          if (chk) chk.style.display = on ? 'none' : 'block';
          applyPricing(); applyCart();
        }
        refillEl.addEventListener('click', toggleRefill);
        refillEl.addEventListener('keydown', function(e){ if (e.key === ' ' || e.key === 'Enter'){ e.preventDefault(); toggleRefill(); } });
      }
      applyRings(); applyCart(); applyPricing();

      // ---- Offer gallery: thumbnail swaps main image ----
      var heroImg = root.querySelector('[data-adv-hero-img]');
      var thumbs = root.querySelectorAll('[data-adv-thumb]');
      thumbs.forEach(function(btn){
        btn.addEventListener('click', function(){
          var full = btn.getAttribute('data-adv-full');
          if (heroImg && full) heroImg.src = full;
          thumbs.forEach(function(b){ b.style.borderColor = 'transparent'; });
          btn.style.borderColor = '#6B3D42';
        });
      });

      // ---- FAQ accordion (single open) ----
      var faqBtns = root.querySelectorAll('[data-adv-faq]');
      faqBtns.forEach(function(btn){
        btn.addEventListener('click', function(){
          var id = btn.getAttribute('data-adv-faq');
          var panel = root.querySelector('[data-adv-faq-panel="'+id+'"]');
          var isOpen = panel && panel.classList.contains('is-open');
          root.querySelectorAll('[data-adv-faq-panel]').forEach(function(p){ p.classList.remove('is-open'); });
          faqBtns.forEach(function(b){
            b.setAttribute('aria-expanded','false');
            var ic = b.querySelector('[data-adv-faq-icon]'); if (ic) ic.textContent = '+';
          });
          if (!isOpen && panel){
            panel.classList.add('is-open');
            btn.setAttribute('aria-expanded','true');
            var ic = btn.querySelector('[data-adv-faq-icon]'); if (ic) ic.textContent = '–';
          }
        });
      });
    }
    if (document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', init); } else { init(); }
  })();
</script>

