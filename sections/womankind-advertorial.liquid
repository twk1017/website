{%- comment -%}
  Womankind — long-form advertorial page (focus: hot flashes & night sweats).
  Ported from the Claude Design standalone export; copy rewritten as a hot-flash advertorial.
  All narrative copy is theme-editable via schema settings (defaults preserve the written copy).
  Self-contained: brand fonts via wk-fonts, scoped reset under #wk-{{ section.id }}, minimal
  'womankind' layout. The offer buy-box is a real add-to-cart form wired to the Product setting.
{%- endcomment -%}
{%- assign wk_product = section.settings.product -%}
{%- if wk_product != blank -%}{%- assign wk_variant = wk_product.selected_or_first_available_variant -%}{%- assign wk_selling_plan = wk_product.selling_plan_groups.first.selling_plans.first -%}{%- endif -%}
{%- assign wk_star = '<span style="color:#C9653F;">*</span>' -%}

{% render 'wk-fonts' %}

<style>
  #wk-{{ section.id }} * { box-sizing:border-box; }
  #wk-{{ section.id }} { background:#F5E6D8; color:#3A2A20; font-family:'Hanken Grotesk',sans-serif; overflow-x:clip; }
  #wk-{{ section.id }} ::selection { background:#C9653F; color:#F5E6D8; }
  #wk-{{ section.id }} img { max-width:100%; display:block; }
  #wk-{{ section.id }} .adv-ph { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; color:#6B3D42; text-align:center; }
  #wk-{{ section.id }} [data-adv-faq-panel] { display:none; }
  #wk-{{ section.id }} [data-adv-faq-panel].is-open { display:block; }

  @media (max-width:749px){
    #wk-{{ section.id }} .adv-h1 { font-size:33px !important; }
    #wk-{{ section.id }} .adv-h2 { font-size:29px !important; }
    #wk-{{ section.id }} .adv-grid3 { grid-template-columns:1fr !important; }
    #wk-{{ section.id }} .adv-grid4 { grid-template-columns:1fr 1fr !important; }
    #wk-{{ section.id }} .adv-prob { grid-template-columns:1fr !important; }
    #wk-{{ section.id }} .adv-prob .adv-prob-img { min-height:200px !important; }
    #wk-{{ section.id }} .adv-offer { grid-template-columns:1fr !important; }
    #wk-{{ section.id }} .adv-sec { padding-left:20px !important; padding-right:20px !important; }
    #wk-{{ section.id }} .adv-lede { font-size:17px !important; }
  }
</style>

<div id="wk-{{ section.id }}">

  <!-- ANNOUNCEMENT BAR -->
  <div style="background:#3A2A20;color:#F5E6D8;text-align:center;padding:9px 16px;font-size:12.5px;letter-spacing:0.06em;font-weight:500;display:flex;align-items:center;justify-content:center;gap:26px;flex-wrap:wrap;">
    <span>{{ section.settings.bar_1 }}</span>
    <span style="opacity:0.4;">·</span>
    <span>{{ section.settings.bar_2 }}</span>
    <span style="opacity:0.4;">·</span>
    <span>{{ section.settings.bar_3 }}</span>
  </div>

  <!-- HEADER -->
  <header style="position:sticky;top:0;z-index:40;background:#6B3D42;color:#F5E6D8;">
    <div style="max-width:1240px;margin:0 auto;padding:0 28px;height:70px;display:flex;align-items:center;justify-content:space-between;gap:24px;">
      <span style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(245,230,216,0.7);font-weight:600;flex:1;">{{ section.settings.kicker }}</span>
      <a href="#offer" style="font-family:'Cormorant Garamond',serif;font-size:33px;line-height:1;color:#F5E6D8;text-decoration:none;letter-spacing:0.01em;flex:0 0 auto;">womankind</a>
      <div style="flex:1;display:flex;justify-content:flex-end;">
        <a href="#offer" style="background:#C9653F;color:#F5E6D8;text-decoration:none;border-radius:999px;padding:11px 26px;font-size:12px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;">{{ section.settings.header_cta }}</a>
      </div>
    </div>
  </header>

  <!-- ARTICLE HERO -->
  <article style="background:#F5E6D8;">
    <div class="adv-sec" style="max-width:760px;margin:0 auto;padding:56px 28px 0;">
      <div style="font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;margin-bottom:18px;">{{ section.settings.hero_eyebrow }}</div>
      <h1 class="adv-h1" style="font-family:'Fraunces',serif;font-weight:400;font-size:46px;line-height:1.08;letter-spacing:-0.01em;margin:0 0 24px;color:#6B3D42;">{{ section.settings.hero_h1_lead }} <span style="font-style:italic;color:#C9653F;">{{ section.settings.hero_h1_accent }}</span> {{ section.settings.hero_h1_tail }}</h1>

      <!-- byline -->
      <div style="display:flex;align-items:center;gap:16px;padding:20px 0;border-top:1px solid rgba(107,61,66,0.18);border-bottom:1px solid rgba(107,61,66,0.18);">
        <div style="width:52px;height:52px;border-radius:50%;overflow:hidden;background:#C9A89F;flex:0 0 auto;display:flex;align-items:center;justify-content:center;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:#6B3D42;">{%- if section.settings.byline_image -%}<img src="{{ section.settings.byline_image | image_url: width: 120 }}" alt="{{ section.settings.byline_name }}" width="52" height="52" style="width:100%;height:100%;object-fit:cover;">{%- else -%}photo{%- endif -%}</div>
        <div style="flex:1;">
          <div style="font-family:'Fraunces',serif;font-size:16px;color:#6B3D42;">{{ section.settings.byline_name }}</div>
          <div style="font-size:12.5px;color:#7a6258;">{{ section.settings.byline_sub }}</div>
        </div>
        <div style="font-size:12.5px;color:#7a6258;letter-spacing:0.04em;flex:0 0 auto;">{{ section.settings.read_time }}</div>
      </div>
    </div>

    <!-- hero image -->
    <div class="adv-sec" style="max-width:1000px;margin:34px auto 0;padding:0 28px;">
      <div style="aspect-ratio:16/9;background:linear-gradient(150deg,#D8C2BA,#C9A89F);border-radius:16px;overflow:hidden;">
        {%- if section.settings.hero_image -%}
          <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" alt="{{ section.settings.hero_image.alt | default: 'Womankind' }}" width="1600" height="900" loading="eager" style="width:100%;height:100%;object-fit:cover;">
        {%- else -%}
          <div class="adv-ph" style="height:100%;"><span style="font-size:11px;letter-spacing:0.22em;text-transform:uppercase;font-weight:600;">Editorial · lead image</span><span style="font-size:11px;opacity:0.72;">woman, mid-40s · cool morning light</span><span style="font-size:10px;letter-spacing:0.2em;text-transform:uppercase;opacity:0.55;">1600 × 900</span></div>
        {%- endif -%}
      </div>
    </div>

    <!-- LEDE -->
    <div class="adv-sec" style="max-width:720px;margin:0 auto;padding:44px 28px 0;">
      <p class="adv-lede" style="font-size:19px;line-height:1.7;color:#3A2A20;margin:0 0 22px;font-weight:500;">{{ section.settings.hero_p1 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.hero_p2 }}</p>
      <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 28px;">{{ section.settings.hero_p3 }}{{ wk_star }}</p>
      <a href="#offer" style="display:inline-flex;align-items:center;gap:10px;background:#C9653F;color:#F5E6D8;text-decoration:none;border-radius:999px;padding:16px 38px;font-size:13px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;">{{ section.settings.hero_cta }}</a>
    </div>
  </article>

  <!-- WHY IT FAILED -->
  <section class="adv-sec" style="background:#EFDFD0;padding:74px 28px;margin-top:64px;">
    <div style="max-width:900px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:12px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;">{{ section.settings.fail_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 auto 18px;color:#6B3D42;max-width:16ch;">{{ section.settings.fail_heading }}</h2>
      <p style="max-width:640px;margin:0 auto 52px;text-align:center;font-size:16px;line-height:1.7;color:#5a4636;">{{ section.settings.fail_intro }}</p>

      <div style="display:flex;flex-direction:column;gap:24px;">
        {%- for i in (1..4) -%}
          {%- assign pe = 'prob' | append: i | append: '_eyebrow' -%}
          {%- assign pt = 'prob' | append: i | append: '_title' -%}
          {%- assign pb = 'prob' | append: i | append: '_body' -%}
          {%- assign pim = 'prob' | append: i | append: '_image' -%}
          {%- assign pbh = 'prob' | append: i | append: '_hint' -%}
          {%- assign p_img = section.settings[pim] -%}
          {%- assign img_left = false -%}{%- if i == 1 or i == 3 -%}{%- assign img_left = true -%}{%- endif -%}
          {%- if img_left -%}{%- assign cols = '0.9fr 1.1fr' -%}{%- else -%}{%- assign cols = '1.1fr 0.9fr' -%}{%- endif -%}
          {%- capture img_cell -%}<div class="adv-prob-img" style="background:#C9A89F;min-height:230px;overflow:hidden;">{%- if p_img -%}<img src="{{ p_img | image_url: width: 700 }}" alt="" width="700" height="500" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- else -%}<div class="adv-ph" style="height:100%;min-height:230px;"><span style="font-size:10px;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;">Image</span><span style="font-size:10px;opacity:0.7;">{{ section.settings[pbh] }}</span></div>{%- endif -%}</div>{%- endcapture -%}
          {%- capture txt_cell -%}<div style="padding:34px;"><div style="font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#C9653F;font-weight:700;margin-bottom:10px;">{{ section.settings[pe] }}</div><h3 style="font-family:'Fraunces',serif;font-weight:500;font-size:22px;line-height:1.2;margin:0 0 12px;color:#6B3D42;">{{ section.settings[pt] }}</h3><p style="font-size:15px;line-height:1.65;color:#4a3a30;margin:0;">{{ section.settings[pb] }}</p></div>{%- endcapture -%}
          <div class="adv-prob" style="background:#FBF1E6;border:1px solid rgba(107,61,66,0.14);border-radius:16px;overflow:hidden;display:grid;grid-template-columns:{{ cols }};">
            {%- if img_left -%}{{ img_cell }}{{ txt_cell }}{%- else -%}{{ txt_cell }}{{ img_cell }}{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="adv-sec" style="background:#F5E6D8;padding:74px 28px;">
    <div style="max-width:1140px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:12px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;">{{ section.settings.comp_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 auto 16px;color:#6B3D42;max-width:22ch;">{{ section.settings.comp_heading }}</h2>
      <p style="max-width:620px;margin:0 auto 48px;text-align:center;font-size:16px;line-height:1.7;color:#5a4636;">{{ section.settings.comp_intro }}</p>

      <div style="overflow-x:auto;">
        <div style="min-width:820px;display:grid;grid-template-columns:1.1fr 1fr 1fr 1fr 1.1fr;background:#FBF1E6;border:1px solid rgba(107,61,66,0.16);border-radius:16px;overflow:hidden;">
          <div style="background:#3A2A20;color:rgba(245,230,216,0.65);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;font-weight:600;padding:18px;"></div>
          <div style="background:#3A2A20;color:#F5E6D8;font-family:'Fraunces',serif;font-size:15px;padding:18px;border-left:1px solid rgba(245,230,216,0.12);">{{ section.settings.comp_col1 }}</div>
          <div style="background:#3A2A20;color:#F5E6D8;font-family:'Fraunces',serif;font-size:15px;padding:18px;border-left:1px solid rgba(245,230,216,0.12);">{{ section.settings.comp_col2 }}</div>
          <div style="background:#3A2A20;color:#F5E6D8;font-family:'Fraunces',serif;font-size:15px;padding:18px;border-left:1px solid rgba(245,230,216,0.12);">{{ section.settings.comp_col3 }}</div>
          <div style="background:#6B3D42;color:#E2A24C;font-family:'Cormorant Garamond',serif;font-size:24px;padding:16px 18px;border-left:1px solid rgba(245,230,216,0.12);display:flex;align-items:center;">womankind</div>

          {%- for r in (1..4) -%}
            {%- assign lblk = 'comp_row' | append: r | append: '_label' -%}
            {%- assign c1k = 'comp_row' | append: r | append: '_c1' -%}
            {%- assign c2k = 'comp_row' | append: r | append: '_c2' -%}
            {%- assign c3k = 'comp_row' | append: r | append: '_c3' -%}
            {%- assign wink = 'comp_row' | append: r | append: '_win' -%}
            {%- if forloop.last -%}{%- assign tick = '<span style="color:#C9653F;font-weight:700;">✓</span> ' -%}{%- else -%}{%- assign tick = '' -%}{%- endif -%}
            <div style="padding:18px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#A07E81;font-weight:600;border-top:1px solid rgba(107,61,66,0.12);">{{ section.settings[lblk] }}</div>
            <div style="padding:18px;font-size:13.5px;line-height:1.5;color:#7a6258;border-top:1px solid rgba(107,61,66,0.12);border-left:1px solid rgba(107,61,66,0.12);">{{ tick }}{{ section.settings[c1k] }}</div>
            <div style="padding:18px;font-size:13.5px;line-height:1.5;color:#7a6258;border-top:1px solid rgba(107,61,66,0.12);border-left:1px solid rgba(107,61,66,0.12);">{{ tick }}{{ section.settings[c2k] }}</div>
            <div style="padding:18px;font-size:13.5px;line-height:1.5;color:#7a6258;border-top:1px solid rgba(107,61,66,0.12);border-left:1px solid rgba(107,61,66,0.12);">{{ tick }}{{ section.settings[c3k] }}</div>
            <div style="padding:18px;font-size:13.5px;line-height:1.5;color:#3A2A20;background:rgba(107,61,66,0.05);border-top:1px solid rgba(107,61,66,0.12);border-left:1px solid rgba(107,61,66,0.12);">{{ section.settings[wink] }}</div>
          {%- endfor -%}
        </div>
      </div>
      <p style="font-size:12px;color:#9a8578;margin:16px 0 0;text-align:center;">{{ section.settings.comp_note }}</p>
    </div>
  </section>

  <!-- DISCOVERY STORY -->
  <section class="adv-sec" style="background:#EFDFD0;padding:74px 28px;">
    <div style="max-width:900px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:12px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;">{{ section.settings.disc_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 auto 40px;color:#6B3D42;max-width:20ch;">{{ section.settings.disc_heading }}</h2>
      <div style="aspect-ratio:16/8;background:linear-gradient(150deg,#D8C2BA,#C9A89F);border-radius:16px;overflow:hidden;margin-bottom:40px;">{%- if section.settings.discovery_image -%}<img src="{{ section.settings.discovery_image | image_url: width: 1440 }}" alt="" width="1440" height="720" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- else -%}<div class="adv-ph" style="height:100%;"><span style="font-size:11px;letter-spacing:0.2em;text-transform:uppercase;font-weight:600;">Image · botanicals</span><span style="font-size:10px;opacity:0.7;">ingredients flat-lay</span></div>{%- endif -%}</div>
      <div style="max-width:700px;margin:0 auto;">
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.disc_p1 }}</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.disc_p2 }}</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0 0 20px;">{{ section.settings.disc_p3 }}{{ wk_star }}</p>
        <p style="font-size:17px;line-height:1.75;color:#4a3a30;margin:0;">{{ section.settings.disc_p4 }}{{ wk_star }}</p>
      </div>
    </div>
  </section>

  <!-- WHY DIFFERENT — 3 PILLARS -->
  <section class="adv-sec" style="background:#F5E6D8;padding:74px 28px;">
    <div style="max-width:1140px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:12px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;">{{ section.settings.pillars_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 auto 16px;color:#6B3D42;max-width:20ch;">{{ section.settings.pillars_heading }}</h2>
      <p style="max-width:620px;margin:0 auto 50px;text-align:center;font-size:16px;line-height:1.7;color:#5a4636;">{{ section.settings.pillars_intro }}</p>
      <div class="adv-grid3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
        {%- for i in (1..3) -%}
          {%- assign pk = 'pillar' | append: i | append: '_image' -%}
          {%- assign pe = 'pillar' | append: i | append: '_eyebrow' -%}
          {%- assign pt = 'pillar' | append: i | append: '_title' -%}
          {%- assign pb = 'pillar' | append: i | append: '_body' -%}
          {%- assign pl1 = 'pillar' | append: i | append: '_line1' -%}
          {%- assign pl2 = 'pillar' | append: i | append: '_line2' -%}
          {%- assign pimg = section.settings[pk] -%}
          <div style="background:#FBF1E6;border:1px solid rgba(107,61,66,0.14);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;">
            <div style="aspect-ratio:4/3;background:#C9A89F;overflow:hidden;">{%- if pimg -%}<img src="{{ pimg | image_url: width: 600 }}" alt="" width="600" height="450" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- else -%}<div class="adv-ph" style="height:100%;"><span style="font-size:10px;letter-spacing:0.16em;text-transform:uppercase;font-weight:600;">Image</span></div>{%- endif -%}</div>
            <div style="padding:26px 24px;">
              <div style="font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#C9653F;font-weight:700;margin-bottom:8px;">{{ section.settings[pe] }}</div>
              <h3 style="font-family:'Fraunces',serif;font-weight:500;font-size:20px;line-height:1.2;margin:0 0 10px;color:#6B3D42;">{{ section.settings[pt] }}</h3>
              <p style="font-size:14px;line-height:1.6;color:#4a3a30;margin:0 0 18px;">{{ section.settings[pb] }}{{ wk_star }}</p>
              <div style="display:flex;flex-direction:column;gap:9px;">
                <div style="display:flex;gap:9px;font-size:13px;color:#4a3a30;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span>{{ section.settings[pl1] }}</div>
                <div style="display:flex;gap:9px;font-size:13px;color:#4a3a30;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span>{{ section.settings[pl2] }}</div>
                <div style="display:flex;gap:9px;font-size:13px;color:#4a3a30;"><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span>{{ section.settings.pillars_line3 }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- BOTTOM LINE BAND -->
  <section class="adv-sec" style="background:#3A2A20;color:#F5E6D8;padding:64px 28px;">
    <div style="max-width:760px;margin:0 auto;text-align:center;">
      <div style="font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#E2A24C;font-weight:700;margin-bottom:16px;">{{ section.settings.band1_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:32px;line-height:1.15;margin:0 0 18px;">{{ section.settings.band1_heading }}</h2>
      <p style="font-size:16px;line-height:1.7;color:rgba(245,230,216,0.82);margin:0 0 30px;">{{ section.settings.band1_body }}</p>
      <a href="#offer" style="display:inline-block;background:#C9653F;color:#F5E6D8;text-decoration:none;border-radius:999px;padding:16px 42px;font-size:13px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;">{{ section.settings.band1_cta }}</a>
    </div>
  </section>

  <!-- 30 DAY TRANSFORMATION -->
  <section class="adv-sec" style="background:#EFDFD0;padding:74px 28px;">
    <div style="max-width:1080px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:12px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:#C9653F;font-weight:700;">{{ section.settings.tl_eyebrow }}</div>
      <h2 class="adv-h2" style="font-family:'Fraunces',serif;font-weight:400;font-size:36px;text-align:center;margin:0 auto 16px;color:#6B3D42;">{{ section.settings.tl_heading }}</h2>
      <p style="max-width:620px;margin:0 auto 50px;text-align:center;font-size:16px;line-height:1.7;color:#5a4636;">{{ section.settings.tl_intro }}{{ wk_star }}</p>
      <div class="adv-grid4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:18px;">
        {%- for i in (1..4) -%}
          {%- assign tll = 'tl' | append: i | append: '_label' -%}
          {%- assign tlb = 'tl' | append: i | append: '_body' -%}
          {%- if forloop.last -%}
            <div style="background:#6B3D42;color:#F5E6D8;border-radius:14px;padding:26px 22px;">
              <div style="font-family:'Fraunces',serif;font-size:15px;color:#E2A24C;margin-bottom:8px;">{{ section.settings[tll] }}</div>
              <div style="width:36px;height:2px;background:rgba(226,162,76,0.5);margin-bottom:16px;"></div>
              <p style="font-size:14px;line-height:1.6;color:rgba(245,230,216,0.9);margin:0;">{{ section.settings[tlb] }}<span style="color:#E2A24C;">*</span></p>
            </div>
          {%- else -%}
            <div style="background:#FBF1E6;border:1px solid rgba(107,61,66,0.14);border-radius:14px;padding:26px 22px;">
