  <!-- FOOTER -->
  {% render 'wk-fonts' %}
  <footer style="background:#6B3D42;color:#F5E6D8;font-family:'Hanken Grotesk',sans-serif;-webkit-font-smoothing:antialiased;padding:64px 28px 36px;">
    <div style="max-width:1180px;margin:0 auto;">
      <div style="text-align:center;font-family:'Cormorant Garamond',serif;font-size:46px;line-height:1;margin-bottom:8px;">{{ section.settings.wordmark }}</div>
      <div style="text-align:center;font-family:'Fraunces',serif;font-style:italic;font-size:15px;color:rgba(245,230,216,0.7);margin-bottom:48px;">{{ section.settings.tagline }}</div>
      <div style="display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:40px;padding-bottom:40px;border-bottom:1px solid rgba(245,230,216,0.16);">
        <div>
          <div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#E2A24C;font-weight:600;margin-bottom:14px;">{{ section.settings.news_heading }}</div>
          <p style="font-size:13px;color:rgba(245,230,216,0.75);margin:0 0 16px;line-height:1.5;">{{ section.settings.news_text }}</p>
          {%- form 'customer' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div style="display:flex;gap:10px;max-width:340px;">
              <input type="email" name="contact[email]" required placeholder="{{ section.settings.news_placeholder }}" style="flex:1;font-family:inherit;border:1px solid rgba(245,230,216,0.3);background:rgba(245,230,216,0.06);border-radius:999px;padding:12px 18px;font-size:13px;color:#F5E6D8;">
              <button type="submit" style="cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:12px 22px;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;flex:0 0 auto;">{{ section.settings.news_button }}</button>
            </div>
            {%- if form.posted_successfully? -%}<p style="font-size:12px;color:#E2A24C;margin:10px 0 0;">Thanks — you're on the list.</p>{%- endif -%}
          {%- endform -%}
        </div>
        <div>
          <div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#E2A24C;font-weight:600;margin-bottom:16px;">{{ section.settings.col2_heading }}</div>
          <div style="display:flex;flex-direction:column;gap:11px;font-size:13px;color:rgba(245,230,216,0.8);">
            {%- for i in (1..4) -%}
              {%- assign lk = 'policy' | append: i | append: '_label' -%}
              {%- assign uk = 'policy' | append: i | append: '_url' -%}
              {%- assign lv = section.settings[lk] -%}
              {%- if lv != blank -%}<a href="{{ section.settings[uk] | default: '#' }}" style="color:rgba(245,230,216,0.8);text-decoration:none;">{{ lv }}</a>{%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <div>
          <div style="font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#E2A24C;font-weight:600;margin-bottom:16px;">{{ section.settings.col3_heading }}</div>
          <div style="display:flex;flex-direction:column;gap:11px;font-size:13px;color:rgba(245,230,216,0.8);">
            {%- for i in (1..3) -%}
              {%- assign ck = 'contact' | append: i -%}
              {%- assign cv = section.settings[ck] -%}
              {%- if cv != blank -%}<span>{{ cv }}</span>{%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
      <p style="font-size:11px;line-height:1.6;color:rgba(245,230,216,0.55);margin:24px 0 0;max-width:90ch;">{{ section.settings.disclaimer }}</p>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-top:20px;font-size:12px;color:rgba(245,230,216,0.55);">
        <span>{{ section.settings.copyright }}</span>
        <span style="display:inline-flex;align-items:center;gap:7px;letter-spacing:0.14em;text-transform:uppercase;font-weight:600;color:rgba(245,230,216,0.7);"><span aria-hidden="true" style="color:#E2A24C;">★</span> Made in USA</span>
      </div>
    </div>
  </footer>

{% schema %}
{
  "name": "WK - Footer",
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "womankind" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "for perimenopause & beyond" },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "news_heading", "label": "Heading", "default": "Let's stay connected" },
    { "type": "text", "id": "news_text", "label": "Text", "default": "Be first to know about new products and special savings." },
    { "type": "text", "id": "news_placeholder", "label": "Placeholder", "default": "Your email" },
    { "type": "text", "id": "news_button", "label": "Button", "default": "Sign up" },
    { "type": "header", "content": "Policies column" },
    { "type": "text", "id": "col2_heading", "label": "Heading", "default": "Policies" },
    { "type": "text", "id": "policy1_label", "label": "Link 1", "default": "Privacy policy" },
    { "type": "url", "id": "policy1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "policy2_label", "label": "Link 2", "default": "Refund policy" },
    { "type": "url", "id": "policy2_url", "label": "Link 2 URL" },
    { "type": "text", "id": "policy3_label", "label": "Link 3", "default": "Terms of service" },
    { "type": "url", "id": "policy3_url", "label": "Link 3 URL" },
    { "type": "text", "id": "policy4_label", "label": "Link 4", "default": "Manage subscription" },
    { "type": "url", "id": "policy4_url", "label": "Link 4 URL" },
    { "type": "header", "content": "Contact column" },
    { "type": "text", "id": "col3_heading", "label": "Heading", "default": "Contact us" },
    { "type": "text", "id": "contact1", "label": "Line 1", "default": "support@womankind.shop" },
    { "type": "text", "id": "contact2", "label": "Line 2", "default": "Copenhagen, Denmark" },
    { "type": "text", "id": "contact3", "label": "Line 3", "default": "+45 00 00 00 00" },
    { "type": "header", "content": "Legal" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Consult your healthcare provider before beginning any supplement, particularly if you are pregnant, nursing, or taking medication." },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2026 Womankind. All rights reserved." },
    { "type": "text", "id": "bottom1", "label": "Bottom link 1", "default": "Privacy" },
    { "type": "text", "id": "bottom2", "label": "Bottom link 2", "default": "Terms" },
    { "type": "text", "id": "bottom3", "label": "Bottom link 3", "default": "Accessibility" }
  ]
}
{% endschema %}
