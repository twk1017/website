  <!-- HEADER -->
  <style>
    .wkh-cb{position:absolute;opacity:0;pointer-events:none;width:0;height:0;}
    .wkh-burger{display:none;}
    .wkh-burger span{display:block;width:24px;height:2px;background:#6B3D42;border-radius:2px;}
    .wkh-overlay{display:none;}
    .wkh-drawer{position:fixed;top:0;left:0;height:100%;width:80%;max-width:330px;background:#F5E6D8;z-index:80;transform:translateX(-100%);transition:transform .3s ease;padding:78px 32px 32px;box-shadow:2px 0 26px rgba(58,42,32,0.2);display:flex;flex-direction:column;gap:28px;}
    .wkh-drawer a{font-family:'Hanken Grotesk',sans-serif;font-size:19px;letter-spacing:0.14em;text-transform:uppercase;color:#6B3D42;text-decoration:none;font-weight:500;}
    .wkh-drawer-close{position:absolute;top:24px;right:26px;cursor:pointer;font-size:30px;line-height:1;color:#6B3D42;}
    .wkh-cb:checked ~ .wkh-drawer{transform:translateX(0);}
    .wkh-cb:checked ~ .wkh-overlay{display:block;position:fixed;inset:0;background:rgba(58,42,32,0.44);z-index:70;}
    @media(max-width:989px){
      .wkh-inner{display:grid !important;grid-template-columns:1fr auto 1fr !important;}
      .wkh-links{display:none !important;}
      .wkh-burger{display:flex !important;flex-direction:column;justify-content:center;gap:5px;cursor:pointer;flex:0 0 auto;width:26px;height:26px;}
      .wkh-right{justify-content:flex-end !important;}
    }
  </style>
  <input type="checkbox" id="wkh-cb-{{ section.id }}" class="wkh-cb" aria-hidden="true">
  <header style="position:sticky;top:0;z-index:40;background:#F5E6D8;border-bottom:1px solid rgba(107,61,66,0.16);">
    <div class="wkh-inner" style="max-width:1240px;margin:0 auto;padding:0 28px;height:74px;display:flex;align-items:center;justify-content:space-between;gap:24px;">
      <div class="wkh-nav" role="navigation" style="display:flex;align-items:center;gap:26px;flex:1;font-size:13.5px;letter-spacing:0.16em;text-transform:uppercase;color:#6B3D42;font-weight:500;">
        <label class="wkh-burger" for="wkh-cb-{{ section.id }}" aria-label="Open menu"><span></span><span></span><span></span></label>
        <span class="wkh-links" style="display:flex;align-items:center;gap:26px;">
          {% if section.settings.nav_1_label != blank %}<a href="{{ section.settings.nav_1_link | default: 'https://trywomankind.com/pages/pdp2' }}" style="cursor:pointer;color:inherit;text-decoration:none;">{{ section.settings.nav_1_label }}</a>{% endif %}
          {% if section.settings.nav_4_label != blank %}<a href="{{ section.settings.nav_4_link | default: '#' }}" style="cursor:pointer;color:inherit;text-decoration:none;">{{ section.settings.nav_4_label }}</a>{% endif %}
        </span>
      </div>
      <a href="{{ section.settings.logo_link | default: '#' }}" style="font-family:'Cormorant Garamond',serif;font-size:34px;line-height:1;color:#6B3D42;text-decoration:none;letter-spacing:0.01em;flex:0 0 auto;">{{ section.settings.logo_text }}</a>
      <div class="wkh-right" style="display:flex;align-items:center;gap:22px;flex:1;justify-content:flex-end;font-size:13.5px;letter-spacing:0.16em;text-transform:uppercase;color:#6B3D42;font-weight:500;">
        <a href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit;cursor:pointer;display:inline-flex;align-items:center;gap:7px;">{{ section.settings.cart_label }} <span style="background:#6B3D42;color:#F5E6D8;border-radius:999px;min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;letter-spacing:0;">{{ cart.item_count }}</span></a>
      </div>
    </div>
  </header>
  <label class="wkh-overlay" for="wkh-cb-{{ section.id }}" aria-hidden="true"></label>
  <aside class="wkh-drawer" role="dialog" aria-label="Menu">
    <label class="wkh-drawer-close" for="wkh-cb-{{ section.id }}" aria-label="Close menu">&times;</label>
    {% if section.settings.nav_1_label != blank %}<a href="{{ section.settings.nav_1_link | default: 'https://trywomankind.com/pages/pdp2' }}">{{ section.settings.nav_1_label }}</a>{% endif %}
    {% if section.settings.nav_4_label != blank %}<a href="{{ section.settings.nav_4_link | default: '#' }}">{{ section.settings.nav_4_label }}</a>{% endif %}
  </aside>

{% schema %}
{
  "name": "WK - Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "womankind" },
    { "type": "url", "id": "logo_link", "label": "Logo link" },
    { "type": "header", "content": "Nav links" },
    { "type": "text", "id": "nav_1_label", "label": "Link 1 label", "default": "Shop" },
    { "type": "url", "id": "nav_1_link", "label": "Link 1 URL" },
    { "type": "text", "id": "nav_2_label", "label": "Link 2 label", "default": "The science" },
    { "type": "url", "id": "nav_2_link", "label": "Link 2 URL" },
    { "type": "text", "id": "nav_3_label", "label": "Link 3 label", "default": "Our story" },
    { "type": "url", "id": "nav_3_link", "label": "Link 3 URL" },
    { "type": "text", "id": "nav_4_label", "label": "Link 4 label", "default": "Contact us" },
    { "type": "url", "id": "nav_4_link", "label": "Link 4 URL" },
    { "type": "header", "content": "Utility (right side)" },
    { "type": "text", "id": "utility_1", "label": "Utility 1", "default": "Search" },
    { "type": "text", "id": "utility_2", "label": "Utility 2", "default": "Account" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "Cart" }
  ]
}
{% endschema %}
