  <!-- HEADER -->
  <header style="position:sticky;top:0;z-index:40;background:#F5E6D8;border-bottom:1px solid rgba(107,61,66,0.16);">
    <div style="max-width:1240px;margin:0 auto;padding:0 28px;height:74px;display:flex;align-items:center;justify-content:space-between;gap:24px;">
      <nav style="display:flex;align-items:center;gap:26px;flex:1;font-size:13.5px;letter-spacing:0.16em;text-transform:uppercase;color:#6B3D42;font-weight:500;">
        {% if section.settings.nav_1_label != blank %}<a href="{{ section.settings.nav_1_link | default: '#' }}" style="cursor:pointer;color:inherit;text-decoration:none;">{{ section.settings.nav_1_label }}</a>{% endif %}
        {% if section.settings.nav_4_label != blank %}<a href="{{ section.settings.nav_4_link | default: '#' }}" style="cursor:pointer;color:inherit;text-decoration:none;">{{ section.settings.nav_4_label }}</a>{% endif %}
      </nav>
      <a href="{{ section.settings.logo_link | default: '#' }}" style="font-family:'Cormorant Garamond',serif;font-size:34px;line-height:1;color:#6B3D42;text-decoration:none;letter-spacing:0.01em;flex:0 0 auto;">{{ section.settings.logo_text }}</a>
      <div style="display:flex;align-items:center;gap:22px;flex:1;justify-content:flex-end;font-size:13.5px;letter-spacing:0.16em;text-transform:uppercase;color:#6B3D42;font-weight:500;">
        <a href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit;cursor:pointer;display:inline-flex;align-items:center;gap:7px;">{{ section.settings.cart_label }} <span style="background:#6B3D42;color:#F5E6D8;border-radius:999px;min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;letter-spacing:0;">{{ cart.item_count }}</span></a>
      </div>
    </div>
  </header>

{% schema %}
{
  "name": "WK - Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "womankind" },
    { "type": "url", "id": "logo_link", "label": "Logo link" },
    { "type": "header", "content": "Nav links" },
    { "type": "text", "id": "nav_1_label", "label": "Link 1 label", "default": "Shop" },
    { "type": "url", "id": "nav_1_link", "label": "Link 1 URL" },
    { "type": "text", "id": "nav_2_label", "label": "Link 2 label", "default": "The science" },
    { "type": "url", "id": "nav_2_link", "label": "Link 2 URL" },
    { "type": "text", "id": "nav_3_label", "label": "Link 3 label", "default": "Our story" },
    { "type": "url", "id": "nav_3_link", "label": "Link 3 URL" },
    { "type": "text", "id": "nav_4_label", "label": "Link 4 label", "default": "Contact us" },
    { "type": "url", "id": "nav_4_link", "label": "Link 4 URL" },
    { "type": "header", "content": "Utility (right side)" },
    { "type": "text", "id": "utility_1", "label": "Utility 1", "default": "Search" },
    { "type": "text", "id": "utility_2", "label": "Utility 2", "default": "Account" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "Cart" }
  ]
}
{% endschema %}
