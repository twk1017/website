      <nav style="display:flex;align-items:center;gap:26px;flex:1;font-size:13.5px;letter-spacing:0.16em;text-transform:uppercase;color:#6B3D42;font-weight:500;">
        <span style="cursor:pointer;">Shop</span>
        <span style="cursor:pointer;">The science</span>
        <span style="cursor:pointer;">Our story</span>
        <span style="cursor:pointer;">Journal</span>
      </nav>
      <a href="#" style="font-family:'Cormorant Garamond',serif;font-size:34px;line-height:1;color:#6B3D42;text-decoration:none;letter-spacing:0.01em;flex:0 0 auto;">womankind</a>
      <div style="display:flex;align-items:center;gap:22px;flex:1;justify-content:flex-end;font-size:13.5px;letter-spacing:0.16em;text-transform:uppercase;color:#6B3D42;font-weight:500;">
        <span style="cursor:pointer;">Search</span>
        <span style="cursor:pointer;">Account</span>
        <span style="cursor:pointer;display:inline-flex;align-items:center;gap:7px;">Bag <span style="background:#6B3D42;color:#F5E6D8;border-radius:999px;min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;letter-spacing:0;">0</span></span>
