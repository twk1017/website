  <!-- BENEFITS ACCORDION -->
  <style>
    #wk-{{ section.id }}-ben .wk-acc-body { display:none; }
    #wk-{{ section.id }}-ben .wk-acc.is-open .wk-acc-body { display:block; }
    #wk-{{ section.id }}-ben .wk-acc.is-open { border-color:rgba(107,61,66,0.4); }
  </style>
  <section id="wk-{{ section.id }}-ben" style="background:#EFDFD0;padding:80px 28px;">
    <div style="max-width:1080px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:46px;">
        <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:38px;margin:0 0 12px;color:#6B3D42;">{{ section.settings.heading_lead }} <span style="font-style:italic;color:#C9653F;">{{ section.settings.heading_emph }}</span></h2>
        <p style="font-size:14.5px;color:#5a4636;margin:0;">{{ section.settings.subheading }}</p>
      </div>
      <div style="display:grid;grid-template-columns:1fr 0.8fr;gap:48px;align-items:center;">
        <div style="display:flex;flex-direction:column;gap:11px;">
          {%- for i in (1..5) -%}
            {%- assign tk = 'b' | append: i | append: '_title' -%}
            {%- assign title = section.settings[tk] -%}
            {%- if title != blank -%}
            {%- assign dk = 'b' | append: i | append: '_body' -%}
            <button type="button" class="wk-acc{% if forloop.first %} is-open{% endif %}" data-wk-acc style="cursor:pointer;font-family:inherit;text-align:left;background:#FBF1E6;border:1px solid rgba(107,61,66,0.16);border-radius:12px;padding:18px 22px;transition:border-color .2s ease;">
              <div style="display:flex;align-items:center;gap:13px;"><span style="width:34px;height:34px;border-radius:8px;background:#6B3D42;color:#E2A24C;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;">{%- case i -%}{%- when 1 -%}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>{%- when 2 -%}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg>{%- when 3 -%}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12C12 8 9.5 5 5 5c0 4.5 2.5 7 7 7z"/><path d="M12 14c0-3 2.5-6 7-6 0 4-2.5 6-7 6z"/></svg>{%- when 4 -%}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>{%- when 5 -%}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>{%- endcase -%}</span><span style="font-family:'Fraunces',serif;font-size:18px;color:#6B3D42;">{{ title }}</span></div>
              <div class="wk-acc-body"><p style="font-size:13.5px;line-height:1.55;color:#4a3a30;margin:13px 0 0;">{{ section.settings[dk] }}</p></div>
            </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.image -%}
          {%- assign bsrc = section.settings.image | image_url: width: 700 -%}
          <img src="{{ bsrc }}" alt="{{ section.settings.image.alt | default: 'Womankind gummy' }}" width="700" height="920" loading="lazy" style="width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;border-radius:16px;display:block;">
        {%- else -%}
          <div style="aspect-ratio:3/4;background:radial-gradient(circle at 50% 40%,#D8C2BA,#C9A89F);border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#6B3D42;"><span style="font-size:11px;letter-spacing:0.2em;text-transform:uppercase;font-weight:600;">Gummy · hero</span><span style="font-size:11px;opacity:0.72;">single gummy render</span><span style="font-size:10px;letter-spacing:0.18em;text-transform:uppercase;opacity:0.55;">700 × 920</span></div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <script>
    (function(){
      var root = document.getElementById('wk-{{ section.id }}-ben');
      if (!root) return;
      var accs = root.querySelectorAll('[data-wk-acc]');
      accs.forEach(function(btn){
        btn.addEventListener('click', function(){
          var open = btn.classList.contains('is-open');
          accs.forEach(function(b){ b.classList.remove('is-open'); });
          if (!open) btn.classList.add('is-open');
        });
      });
    })();
  </script>

{% schema %}
{
  "name": "Home · Benefits accordion",
  "settings": [
    { "type": "text", "id": "heading_lead", "label": "Heading", "default": "The balance your body's" },
    { "type": "text", "id": "heading_emph", "label": "Heading (italic)", "default": "been missing" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "One daily ritual that supports mood, sleep, digestion and balance — together." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "header", "content": "Benefit 1" },
    { "type": "text", "id": "b1_title", "label": "Title", "default": "Steady energy" },
    { "type": "textarea", "id": "b1_body", "label": "Body", "default": "Supports smoother, more consistent energy through the day — without the crash.*" },
    { "type": "header", "content": "Benefit 2" },
    { "type": "text", "id": "b2_title", "label": "Title", "default": "Steady mood" },
    { "type": "textarea", "id": "b2_body", "label": "Body", "default": "Ashwagandha supports a calmer stress response, so the little things stay little.*" },
    { "type": "header", "content": "Benefit 3" },
    { "type": "text", "id": "b3_title", "label": "Title", "default": "Calm digestion" },
    { "type": "textarea", "id": "b3_body", "label": "Body", "default": "A probiotic blend supports the estrobolome — the gut bacteria that metabolise estrogen.*" },
    { "type": "header", "content": "Benefit 4" },
    { "type": "text", "id": "b4_title", "label": "Title", "default": "Deeper sleep" },
    { "type": "textarea", "id": "b4_body", "label": "Body", "default": "Fewer 2am wake-ups and cooler nights as the actives reach steady state.*" },
    { "type": "header", "content": "Benefit 5" },
    { "type": "text", "id": "b5_title", "label": "Title", "default": "Hormonal balance" },
    { "type": "textarea", "id": "b5_body", "label": "Body", "default": "Standardised botanicals ease hot flashes and support balance through the whole transition.*" }
  ]
}
{% endschema %}
