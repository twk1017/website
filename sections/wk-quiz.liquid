<!-- WK - QUIZ (Q1-Q8 + reflections + scorecard + honest timeline + offer buy box) -->
{%- assign uid = section.id -%}
{%- assign wk_product = section.settings.product -%}
{%- if wk_product != blank -%}{%- assign wk_variant = wk_product.selected_or_first_available_variant -%}{%- endif -%}
{%- capture wk_pdp_url -%}{%- render 'wk-localized-url', url: wk_product.url, fallback: '/products/hormonal-support-gummies' -%}{%- endcapture -%}
{%- comment -%} offer reveal image — same source order as the gummies-3 buy box {%- endcomment -%}
{%- assign wk_offer_img = '' -%}
{%- if section.settings.offer_image -%}{%- assign wk_offer_img = section.settings.offer_image | image_url: width: 900 -%}
{%- elsif wk_product.featured_image -%}{%- assign wk_offer_img = wk_product.featured_image | image_url: width: 900 -%}
{%- else -%}{%- assign wk_offer_img = 'wk-buybox-1.jpg' | asset_url -%}{%- endif -%}
{%- assign oke_product = wk_product | default: all_products['hormonal-support-gummies'] -%}
<style>
  #wkq-{{ uid }}{--plum:#6B3D42;--terra:#C9653F;--gold:#E2A24C;--cream:#FBF1E6;--blush:#E9D6CE;--body:#4a3a30;--line:rgba(107,61,66,0.16);}
  #wkq-{{ uid }}{background:var(--cream);min-height:100vh;display:flex;flex-direction:column;font-family:'Hanken Grotesk',sans-serif;color:var(--body);}
  #wkq-{{ uid }} *{box-sizing:border-box;}
  #wkq-{{ uid }} .wkq-frame{display:contents;}

  /* top bar + progress */
  #wkq-{{ uid }} .wkq-top{position:sticky;top:0;z-index:5;background:var(--cream);}
  #wkq-{{ uid }} .wkq-bar-inner{max-width:640px;margin:0 auto;padding:20px 24px 16px;display:flex;align-items:center;justify-content:center;position:relative;}
  #wkq-{{ uid }} .wkq-logo{font-family:'Cormorant Garamond','Fraunces',serif;font-size:30px;line-height:1;color:var(--plum);letter-spacing:0.01em;}
  #wkq-{{ uid }} .wkq-back{position:absolute;left:24px;top:50%;transform:translateY(-50%);border:none;background:none;cursor:pointer;color:var(--plum);font-size:22px;line-height:1;opacity:0;pointer-events:none;transition:opacity .2s ease;padding:6px;}
  #wkq-{{ uid }} .wkq-back.show{opacity:0.7;pointer-events:auto;}
  #wkq-{{ uid }} .wkq-progress{height:4px;background:var(--blush);}
  #wkq-{{ uid }} .wkq-progress-fill{height:100%;width:0;background:var(--plum);border-radius:0 4px 4px 0;transition:width .45s cubic-bezier(.4,0,.2,1);}

  /* stage */
  #wkq-{{ uid }} .wkq-stage{flex:1;width:100%;max-width:640px;margin:0 auto;padding:40px 24px 150px;}
  #wkq-{{ uid }} .wkq-screen{animation:wkq-fade .4s ease;}
  @keyframes wkq-fade{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}

  #wkq-{{ uid }} .wkq-eyebrow{font-size:13px;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;color:var(--terra);margin-bottom:14px;}
  #wkq-{{ uid }} .wkq-title{font-family:'Fraunces',serif;font-weight:600;font-size:33px;line-height:1.12;color:var(--plum);letter-spacing:-0.01em;margin:0 0 14px;}
  #wkq-{{ uid }} .wkq-sub{font-size:18px;line-height:1.45;color:rgba(74,58,48,0.66);margin:0 0 26px;}
  #wkq-{{ uid }} .wkq-note{display:flex;gap:12px;background:var(--blush);border-radius:16px;padding:18px 20px;font-size:15.5px;line-height:1.5;color:var(--plum);margin:0 0 26px;}
  #wkq-{{ uid }} .wkq-note b{font-weight:700;}
  #wkq-{{ uid }} .wkq-note .wkq-spark{flex:0 0 auto;color:var(--terra);font-size:16px;line-height:1.5;}

  /* options */
  #wkq-{{ uid }} .wkq-opts{display:flex;flex-direction:column;gap:12px;}
  #wkq-{{ uid }} .wkq-opt{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;text-align:left;cursor:pointer;background:#FFFDFA;border:1.5px solid var(--line);border-radius:16px;padding:20px 22px;font-family:inherit;font-size:18px;font-weight:600;color:var(--plum);line-height:1.3;transition:border-color .18s ease,box-shadow .18s ease,transform .08s ease,background .18s ease;}
  #wkq-{{ uid }} .wkq-opt:hover{border-color:rgba(107,61,66,0.4);box-shadow:0 6px 18px rgba(107,61,66,0.08);}
  #wkq-{{ uid }} .wkq-opt:active{transform:scale(.995);}
  #wkq-{{ uid }} .wkq-opt.sel{border-color:var(--plum);border-width:2px;background:#F5E6D8;}
  #wkq-{{ uid }} .wkq-radio{flex:0 0 auto;width:24px;height:24px;border-radius:50%;border:2px solid rgba(107,61,66,0.35);display:inline-flex;align-items:center;justify-content:center;transition:border-color .18s ease,background .18s ease;}
  #wkq-{{ uid }} .wkq-opt.multi .wkq-radio{border-radius:7px;}
  #wkq-{{ uid }} .wkq-opt.sel .wkq-radio{border-color:var(--plum);background:var(--plum);}
  #wkq-{{ uid }} .wkq-radio svg{opacity:0;transition:opacity .18s ease;}
  #wkq-{{ uid }} .wkq-opt.sel .wkq-radio svg{opacity:1;}
  #wkq-{{ uid }} .wkq-choose{font-size:14px;color:rgba(74,58,48,0.6);margin:16px 0 0;}
  #wkq-{{ uid }} .wkq-err{font-size:14px;font-weight:600;color:#B23B2E;margin:12px 0 0;display:none;}
  #wkq-{{ uid }} .wkq-err.show{display:block;}

  /* reflection */
  #wkq-{{ uid }} .wkq-hl{background:var(--gold);color:var(--plum);border-radius:6px;padding:1px 8px;box-decoration-break:clone;-webkit-box-decoration-break:clone;font-weight:600;}
  #wkq-{{ uid }} .wkq-lead{font-size:19px;line-height:1.55;color:rgba(74,58,48,0.72);margin:0 0 28px;}
  #wkq-{{ uid }} .wkq-points{display:flex;flex-direction:column;gap:20px;margin:0 0 8px;}
  #wkq-{{ uid }} .wkq-point{display:flex;gap:14px;}
  #wkq-{{ uid }} .wkq-pnum{flex:0 0 auto;width:30px;height:30px;border-radius:50%;background:var(--plum);color:var(--cream);font-size:14px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;}
  #wkq-{{ uid }} .wkq-ph{font-size:12.5px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:var(--terra);display:block;margin-bottom:3px;}
  #wkq-{{ uid }} .wkq-pb{font-size:16.5px;line-height:1.5;color:var(--body);}

  /* scorecard */
  #wkq-{{ uid }} .wkq-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:6px 0 26px;}
  #wkq-{{ uid }} .wkq-card{position:relative;background:#FFFDFA;border:1.5px solid var(--line);border-radius:18px;padding:24px 18px 20px;text-align:center;}
  #wkq-{{ uid }} .wkq-card.weak{border-color:var(--plum);border-width:2px;background:#F5E6D8;}
  #wkq-{{ uid }} .wkq-badge{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--plum);color:var(--cream);font-size:10.5px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;padding:5px 12px;border-radius:999px;white-space:nowrap;}
  #wkq-{{ uid }} .wkq-card-name{font-size:13px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:var(--terra);margin:12px 0 4px;}
  #wkq-{{ uid }} .wkq-card-tier{font-size:14px;font-weight:700;color:var(--plum);margin-bottom:8px;}
  #wkq-{{ uid }} .wkq-card-desc{font-size:12.5px;line-height:1.42;color:rgba(74,58,48,0.7);}
  #wkq-{{ uid }} .wkq-why{background:var(--blush);border-radius:16px;padding:20px 22px;}
  #wkq-{{ uid }} .wkq-why-h{font-size:12.5px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:var(--terra);margin-bottom:8px;}
  #wkq-{{ uid }} .wkq-why-b{font-size:16.5px;line-height:1.5;color:var(--plum);}

  /* honest timeline */
  #wkq-{{ uid }} .wkq-tl{display:flex;flex-direction:column;margin:6px 0 8px;}
  #wkq-{{ uid }} .wkq-tl-item{display:flex;gap:16px;padding-bottom:22px;}
  #wkq-{{ uid }} .wkq-tl-item:last-child{padding-bottom:0;}
  #wkq-{{ uid }} .wkq-tl-rail{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;}
  #wkq-{{ uid }} .wkq-tl-dot{width:14px;height:14px;border-radius:50%;background:var(--plum);margin-top:6px;}
  #wkq-{{ uid }} .wkq-tl-line{width:2px;flex:1;background:var(--blush);margin-top:6px;}
  #wkq-{{ uid }} .wkq-tl-item:last-child .wkq-tl-line{display:none;}
  #wkq-{{ uid }} .wkq-tl-card{flex:1;background:#FFFDFA;border:1.5px solid var(--line);border-radius:14px;padding:16px 18px;}
  #wkq-{{ uid }} .wkq-tl-card.hi{border-color:var(--plum);border-width:2px;background:#F5E6D8;}
  #wkq-{{ uid }} .wkq-tl-when{font-size:12px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;color:var(--terra);margin-bottom:4px;}
  #wkq-{{ uid }} .wkq-tl-body{font-size:15.5px;line-height:1.5;color:var(--body);}
  #wkq-{{ uid }} .wkq-tl-badge{display:inline-block;background:var(--plum);color:var(--cream);font-size:11px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;padding:5px 12px;border-radius:999px;margin-bottom:11px;}
  #wkq-{{ uid }} .wkq-tl-title{font-family:'Fraunces',serif;font-weight:600;font-size:20px;line-height:1.15;color:var(--plum);margin:0 0 11px;}
  #wkq-{{ uid }} .wkq-tl-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;}
  #wkq-{{ uid }} .wkq-tl-bullet{position:relative;padding-left:18px;font-size:14.5px;line-height:1.5;color:var(--body);}
  #wkq-{{ uid }} .wkq-tl-bullet::before{content:'';position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;background:var(--terra);}
  #wkq-{{ uid }} .wkq-tl-guar{margin-top:14px;padding-top:14px;border-top:1px solid rgba(107,61,66,0.2);font-size:15px;font-weight:700;line-height:1.45;color:var(--plum);}
  #wkq-{{ uid }} .wkq-fine{font-size:11px;line-height:1.45;color:#9b8578;margin:18px 0 0;}

  /* offer buy box */
  #wkq-{{ uid }} .wkq-hero{position:relative;width:100%;aspect-ratio:1/1;border-radius:18px;overflow:hidden;margin:0 0 20px;background:radial-gradient(120% 92% at 50% 16%, #ECDBCC 0%, #D8BFB4 52%, #C2A099 100%);}
  #wkq-{{ uid }} .wkq-hero > img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
  #wkq-{{ uid }} .wkq-hero-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(107,61,66,0.5);font-weight:700;}
  #wkq-{{ uid }} .wkq-hero-track{position:absolute;inset:0;display:flex;width:100%;height:100%;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
  #wkq-{{ uid }} .wkq-hero-track::-webkit-scrollbar{display:none;}
  #wkq-{{ uid }} .wkq-hero-slide{flex:0 0 100%;width:100%;height:100%;scroll-snap-align:center;}
  #wkq-{{ uid }} .wkq-hero-slide img{width:100%;height:100%;object-fit:cover;display:block;}
  #wkq-{{ uid }} .wkq-hero-dots{position:absolute;left:0;right:0;bottom:12px;z-index:2;display:flex;justify-content:center;gap:7px;pointer-events:auto;}
  #wkq-{{ uid }} .wkq-hero-dot{width:7px;height:7px;padding:0;border:none;border-radius:50%;cursor:pointer;background:rgba(255,255,255,0.55);box-shadow:0 1px 3px rgba(43,24,26,0.28);transition:background .2s ease,transform .2s ease;}
  #wkq-{{ uid }} .wkq-hero-dot.on{background:#fff;transform:scale(1.25);}
  #wkq-{{ uid }} .wkq-rating{display:flex;align-items:center;gap:9px;margin:0 0 16px;font-size:13.5px;color:#7a6258;font-weight:600;}
  #wkq-{{ uid }} .wkq-rating .stars{color:var(--gold);letter-spacing:2px;font-size:15px;}
  #wkq-{{ uid }} .wkq-odesc{font-size:15px;line-height:1.55;color:var(--body);margin:0 0 18px;}
  #wkq-{{ uid }} .wkq-bens{display:flex;flex-direction:column;gap:10px;margin:0 0 24px;}
  #wkq-{{ uid }} .wkq-ben{display:flex;align-items:flex-start;gap:11px;font-size:14.5px;line-height:1.45;color:#3A2A20;}
  #wkq-{{ uid }} .wkq-ben .ck{flex:0 0 auto;color:var(--terra);font-weight:800;line-height:1.4;}
  #wkq-{{ uid }} .wkq-plans{display:flex;flex-direction:column;gap:16px;margin:8px 0 0;}
  #wkq-{{ uid }} .wkq-plan{position:relative;display:flex;align-items:center;gap:12px;width:100%;text-align:left;cursor:pointer;background:#FFFDFA;border:1.5px solid var(--line);border-radius:14px;padding:16px 18px;font-family:inherit;transition:border-color .18s ease,background .18s ease;}
  #wkq-{{ uid }} .wkq-plan.sel{border-color:var(--plum);border-width:2px;background:#F5E6D8;}
  #wkq-{{ uid }} .wkq-plan-l{flex:1;min-width:0;}
  #wkq-{{ uid }} .wkq-plan-name{display:block;font-size:15.5px;font-weight:700;color:var(--plum);}
  #wkq-{{ uid }} .wkq-plan-sub{display:block;font-size:12.5px;color:#7a6258;margin-top:3px;}
  #wkq-{{ uid }} .wkq-plan-sub .save{color:var(--terra);font-weight:600;}
  #wkq-{{ uid }} .wkq-plan-r{flex:0 0 auto;text-align:right;}
  #wkq-{{ uid }} .wkq-strike{display:block;font-size:13px;text-decoration:line-through;color:#8f6266;line-height:1.2;}
  #wkq-{{ uid }} .wkq-price{display:block;font-size:19px;font-weight:700;color:var(--terra);line-height:1.15;}
  #wkq-{{ uid }} .wkq-plan-radio{flex:0 0 auto;width:22px;height:22px;border-radius:50%;border:2px solid rgba(107,61,66,0.35);display:inline-flex;align-items:center;justify-content:center;}
  #wkq-{{ uid }} .wkq-plan.sel .wkq-plan-radio{border-color:var(--plum);background:var(--plum);}
  #wkq-{{ uid }} .wkq-plan-radio svg{opacity:0;}
  #wkq-{{ uid }} .wkq-plan.sel .wkq-plan-radio svg{opacity:1;}
  #wkq-{{ uid }} .wkq-badge2{position:absolute;top:-10px;left:16px;background:var(--terra);color:var(--cream);font-size:10px;letter-spacing:0.16em;text-transform:uppercase;font-weight:700;padding:3px 10px;border-radius:999px;}
  #wkq-{{ uid }} .wkq-refill{display:flex;align-items:center;gap:14px;border:1.5px dashed rgba(107,61,66,0.45);border-radius:12px;padding:14px 16px;cursor:pointer;margin:16px 0 0;}
  #wkq-{{ uid }} .wkq-refill-box{width:24px;height:24px;flex:0 0 auto;border:1.5px solid var(--plum);border-radius:6px;display:flex;align-items:center;justify-content:center;background:var(--plum);}
  #wkq-{{ uid }} .wkq-refill[aria-checked="false"] .wkq-refill-box{background:transparent;}
  #wkq-{{ uid }} .wkq-refill[aria-checked="false"] .wkq-refill-box svg{opacity:0;}
  #wkq-{{ uid }} .wkq-refill-t{display:block;font-size:15px;font-weight:700;color:var(--plum);}
  #wkq-{{ uid }} .wkq-refill-s{display:block;font-size:12.5px;color:#7a6258;margin-top:2px;}
  #wkq-{{ uid }} .wkq-atc-wrap{margin:0;}
  #wkq-{{ uid }} .wkq-atc{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin-top:16px;cursor:pointer;border:none;font-family:inherit;background:var(--terra);color:var(--cream);font-size:16px;font-weight:800;letter-spacing:0.04em;text-transform:uppercase;padding:20px;border-radius:999px;text-decoration:none;box-shadow:0 5px 0 #97432a,0 10px 20px rgba(201,101,63,0.3);transition:transform .1s ease,box-shadow .1s ease;}
  #wkq-{{ uid }} .wkq-atc:active{transform:translateY(3px);box-shadow:0 2px 0 #97432a,0 5px 12px rgba(201,101,63,0.3);}
  #wkq-{{ uid }} .wkq-atc-total{opacity:0.9;font-weight:700;}
  #wkq-{{ uid }} .wkq-guar{display:flex;align-items:center;gap:14px;margin:16px 0 0;padding:15px 18px;background:rgba(201,101,63,0.08);border:1.5px solid rgba(201,101,63,0.32);border-radius:12px;}
  #wkq-{{ uid }} .wkq-guar-badge{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;background:var(--terra);color:var(--cream);font-size:13px;font-weight:700;flex:0 0 auto;line-height:1;}
  #wkq-{{ uid }} .wkq-guar-t{display:block;font-size:14.5px;color:var(--plum);font-weight:700;line-height:1.25;}
  #wkq-{{ uid }} .wkq-guar-s{display:block;font-size:12.5px;color:var(--body);line-height:1.4;margin-top:3px;}
  #wkq-{{ uid }} .wkq-trust{text-align:center;margin:12px 0 0;font-size:11.5px;letter-spacing:0.02em;color:#7a6258;font-weight:600;}

  /* extra selling blocks (offer step only) */
  #wkq-{{ uid }}.wkq-offermode .wkq-footer{display:none;}
  #wkq-{{ uid }}.wkq-offermode .wkq-stage{padding-bottom:24px;}
  #wkq-{{ uid }} .wkq-extras{width:100%;max-width:640px;margin:0 auto;padding:8px 24px 60px;}
  #wkq-{{ uid }} .wkq-ex-eyebrow{font-size:12px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:var(--terra);margin-bottom:10px;text-align:center;}
  #wkq-{{ uid }} .wkq-ex-h{font-family:'Fraunces',serif;font-weight:500;font-size:27px;line-height:1.12;color:var(--plum);text-align:center;margin:0 0 12px;}
  #wkq-{{ uid }} .wkq-ex-sub{font-size:14.5px;line-height:1.55;color:var(--body);text-align:center;max-width:48ch;margin:0 auto 26px;}
  #wkq-{{ uid }} .wkq-ex-reviews{padding:34px 0 12px;border-top:1px solid var(--line);}
  #wkq-{{ uid }} .wkq-ex-ing{padding:38px 0 0;border-top:1px solid var(--line);margin-top:34px;}
  #wkq-{{ uid }} .wkq-ex-finalcta{padding:38px 0 0;border-top:1px solid var(--line);margin-top:34px;text-align:center;}
  #wkq-{{ uid }} .wkq-ex-finalcta .wkq-guar{text-align:left;}
  #wkq-{{ uid }} .wkq-ing-grid{display:grid;grid-template-columns:1fr;gap:14px;}
  #wkq-{{ uid }} .wkq-ing-card{position:relative;overflow:hidden;text-align:left;cursor:pointer;background:#FFFCF8;border:1px solid rgba(107,61,66,0.11);border-radius:16px;min-height:104px;padding:20px 46% 20px 20px;width:100%;display:block;box-shadow:0 6px 20px rgba(107,61,66,0.05);transition:box-shadow .18s ease,transform .18s ease;font-family:inherit;color:inherit;}
  #wkq-{{ uid }} .wkq-ing-card:hover{box-shadow:0 12px 30px rgba(107,61,66,0.12);transform:translateY(-2px);}
  #wkq-{{ uid }} .wkq-ing-card:focus-visible{outline:2px solid var(--terra);outline-offset:2px;}
  #wkq-{{ uid }} .wkq-ing-card-top{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;margin-bottom:7px;}
  #wkq-{{ uid }} .wkq-ing-card-name{font-family:'Fraunces',serif;font-weight:500;font-size:16.5px;line-height:1.15;margin:0;color:var(--plum);}
  #wkq-{{ uid }} .wkq-ing-card-dose{font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--terra);font-weight:700;}
  #wkq-{{ uid }} .wkq-ing-card-role{font-size:13px;line-height:1.4;color:#7a6258;margin:0;}
  #wkq-{{ uid }} .wkq-ing-card-img{position:absolute;top:0;right:0;bottom:0;width:42%;height:100%;object-fit:cover;display:block;}
  #wkq-{{ uid }} .wkq-ing-plus{position:absolute;bottom:12px;right:12px;z-index:2;width:32px;height:32px;border-radius:50%;background:var(--plum);color:var(--cream);display:inline-flex;align-items:center;justify-content:center;font-size:19px;line-height:1;box-shadow:0 3px 10px rgba(43,24,26,0.28);pointer-events:none;}
  #wkq-{{ uid }} .wkq-ex-suppfacts{text-align:center;margin-top:26px;}
  #wkq-{{ uid }} .wkq-ex-outline{cursor:pointer;font-family:inherit;display:inline-block;background:none;border:1.5px solid var(--plum);color:var(--plum);border-radius:999px;padding:14px 34px;font-size:12.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;}
  /* ingredient + supplement-facts modals */
  #wkq-{{ uid }} .wkq-ingm-overlay{display:none;position:fixed;inset:0;z-index:9998;background:rgba(43,24,26,0.66);align-items:center;justify-content:center;padding:20px;}
  #wkq-{{ uid }} .wkq-ingm-overlay.open{display:flex;}
  #wkq-{{ uid }} .wkq-ingm-box{position:relative;background:#FFFCF8;border-radius:18px;max-width:480px;width:100%;max-height:90vh;overflow:hidden;box-shadow:0 24px 70px rgba(0,0,0,0.35);}
  #wkq-{{ uid }} .wkq-ingm-x{cursor:pointer;font-family:inherit;position:absolute;top:12px;right:12px;width:36px;height:36px;border-radius:50%;border:none;background:rgba(107,61,66,0.9);color:var(--cream);font-size:19px;line-height:1;display:inline-flex;align-items:center;justify-content:center;z-index:3;}
  #wkq-{{ uid }} .wkq-ingm-track{display:flex;transition:transform .32s cubic-bezier(0.4,0,0.2,1);}
  #wkq-{{ uid }} .wkq-ingm-slide{flex:0 0 100%;width:100%;}
  #wkq-{{ uid }} .wkq-ingm-img{width:100%;height:200px;object-fit:cover;display:block;}
  #wkq-{{ uid }} .wkq-ingm-body{padding:24px 26px 28px;max-height:calc(90vh - 200px);overflow:auto;}
  #wkq-{{ uid }} .wkq-ingm-name{font-family:'Fraunces',serif;font-weight:500;font-size:23px;line-height:1.1;margin:0;color:var(--plum);}
  #wkq-{{ uid }} .wkq-ingm-desc{font-size:15px;line-height:1.62;color:var(--body);margin:0;}
  #wkq-{{ uid }} .wkq-ingm-nav{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 18px;border-top:1px solid var(--line);}
  #wkq-{{ uid }} .wkq-ingm-arrow{cursor:pointer;font-family:inherit;width:40px;height:40px;border-radius:50%;border:none;background:var(--plum);color:var(--cream);font-size:17px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;}
  #wkq-{{ uid }} .wkq-ingm-count{font-size:11.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--plum);font-weight:600;}
  #wkq-{{ uid }} .wkq-suppfacts-box{position:relative;background:#fff;border-radius:16px;max-width:540px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 24px 70px rgba(0,0,0,0.35);}
  #wkq-{{ uid }} .wkq-suppfacts-img{display:block;width:100%;height:auto;border-radius:16px;}
  /* experts */
  #wkq-{{ uid }} .wkq-ex-experts{padding:38px 0 0;border-top:1px solid var(--line);margin-top:34px;}
  #wkq-{{ uid }} .wkq-exp-track{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding:4px 2px 10px;scrollbar-width:none;}
  #wkq-{{ uid }} .wkq-exp-track::-webkit-scrollbar{display:none;}
  #wkq-{{ uid }} .wkq-exp-card{scroll-snap-align:center;flex:0 0 82%;background:#FFFCF8;border:1px solid rgba(107,61,66,0.11);border-radius:16px;padding:18px 20px 20px;box-shadow:0 6px 20px rgba(107,61,66,0.05);}
  #wkq-{{ uid }} .wkq-exp-img{width:64px;height:64px;border-radius:50%;object-fit:cover;display:block;margin-bottom:14px;}
  #wkq-{{ uid }} .wkq-exp-name{font-family:'Fraunces',serif;font-style:italic;font-weight:400;font-size:20px;margin:0 0 5px;color:#3A2A20;}
  #wkq-{{ uid }} .wkq-exp-cred{font-size:10px;letter-spacing:0.13em;text-transform:uppercase;color:var(--terra);font-weight:700;line-height:1.4;margin-bottom:12px;}
  #wkq-{{ uid }} .wkq-exp-quote{font-size:13.5px;line-height:1.55;color:var(--body);margin:0;}

  /* end placeholder */
  #wkq-{{ uid }} .wkq-end{text-align:center;padding:30px 0;}
  #wkq-{{ uid }} .wkq-end .wkq-title{margin-bottom:12px;}

  /* loader (computing your results) */
  #wkq-{{ uid }} .wkq-loader{display:flex;flex-direction:column;align-items:center;text-align:center;}
  #wkq-{{ uid }} .wkq-load-ring{margin:8px 0 2px;}
  #wkq-{{ uid }} .wkq-load-title{margin:6px 0 8px;}
  #wkq-{{ uid }} .wkq-load-bar{width:100%;max-width:300px;height:8px;background:var(--blush);border-radius:999px;overflow:hidden;margin:0 0 28px;}
  #wkq-{{ uid }} .wkq-load-bar-fill{height:100%;width:0;background:var(--plum);border-radius:999px;}
  #wkq-{{ uid }} .wkq-load-checks{width:100%;display:flex;flex-direction:column;gap:12px;margin:0 0 30px;}
  #wkq-{{ uid }} .wkq-load-check{display:flex;align-items:center;gap:14px;text-align:left;background:#FFFDFA;border:1.5px solid var(--line);border-radius:14px;padding:16px 18px;font-size:16px;font-weight:600;color:var(--plum);opacity:0.45;transition:opacity .35s ease,border-color .35s ease;}
  #wkq-{{ uid }} .wkq-load-check.done{opacity:1;border-color:rgba(107,61,66,0.28);}
  #wkq-{{ uid }} .wkq-load-box{width:26px;height:26px;flex:0 0 auto;border-radius:50%;border:2px solid rgba(107,61,66,0.3);display:flex;align-items:center;justify-content:center;background:transparent;transition:background .35s ease,border-color .35s ease;}
  #wkq-{{ uid }} .wkq-load-check.done .wkq-load-box{background:var(--terra);border-color:var(--terra);}
  #wkq-{{ uid }} .wkq-load-box svg{opacity:0;transition:opacity .35s ease;}
  #wkq-{{ uid }} .wkq-load-check.done .wkq-load-box svg{opacity:1;}

  /* testimonial carousel */
  #wkq-{{ uid }} .wkq-tst{width:100%;overflow:hidden;}
  #wkq-{{ uid }} .wkq-tst-track{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding:4px 2px 10px;scrollbar-width:none;}
  #wkq-{{ uid }} .wkq-tst-track::-webkit-scrollbar{display:none;}
  #wkq-{{ uid }} .wkq-tst-card{scroll-snap-align:center;flex:0 0 84%;background:#FFFDFA;border:1.5px solid var(--line);border-radius:16px;padding:18px 20px;text-align:left;box-shadow:0 8px 22px rgba(107,61,66,0.08);}
  #wkq-{{ uid }} .wkq-tst-stars{font-size:14px;letter-spacing:2px;margin-bottom:8px;color:var(--gold);}
  #wkq-{{ uid }} .wkq-tst-stars .off{color:rgba(107,61,66,0.2);}
  #wkq-{{ uid }} .wkq-tst-q{font-size:15px;line-height:1.5;color:var(--body);margin-bottom:10px;}
  #wkq-{{ uid }} .wkq-tst-n{font-size:12.5px;font-weight:700;color:var(--plum);}
  #wkq-{{ uid }} .wkq-tst-n span{color:#7a6258;font-weight:600;}
  #wkq-{{ uid }} .wkq-tst-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px;}
  #wkq-{{ uid }} .wkq-tst-tags span{font-size:10px;letter-spacing:0.07em;text-transform:uppercase;font-weight:700;color:var(--plum);border:1px solid var(--line);border-radius:999px;padding:5px 11px;}

  /* sticky CTA */
  #wkq-{{ uid }} .wkq-footer{position:fixed;bottom:0;left:0;right:0;z-index:6;background:linear-gradient(180deg,rgba(251,241,230,0) 0%,var(--cream) 34%);padding:22px 24px 26px;}
  #wkq-{{ uid }} .wkq-cta{display:block;width:100%;max-width:592px;margin:0 auto;cursor:pointer;border:none;font-family:inherit;background:var(--plum);color:var(--gold);font-size:18px;font-weight:800;letter-spacing:0.03em;text-transform:uppercase;padding:22px;border-radius:999px;box-shadow:0 6px 0 #4a2a2e,0 12px 22px rgba(107,61,66,0.28);transition:transform .1s ease,box-shadow .1s ease;}
  #wkq-{{ uid }} .wkq-cta:active{transform:translateY(3px);box-shadow:0 3px 0 #4a2a2e,0 6px 14px rgba(107,61,66,0.28);}
  #wkq-{{ uid }} .wkq-cta.hidden{display:none;}

  @media(max-width:600px){
    #wkq-{{ uid }} .wkq-title{font-size:28px;}
    #wkq-{{ uid }} .wkq-sub{font-size:16.5px;}
    #wkq-{{ uid }} .wkq-opt{font-size:16.5px;padding:18px 18px;}
    #wkq-{{ uid }} .wkq-stage{padding:32px 20px 150px;}
    #wkq-{{ uid }} .wkq-card{padding:22px 12px 18px;}
  }

  /* desktop frame — the phone-width funnel sits in an elevated card */
  @media(min-width:900px){
    #wkq-{{ uid }}{background:#E6D3C6;align-items:center;justify-content:flex-start;padding:52px 24px;}
    #wkq-{{ uid }} .wkq-frame{display:flex;flex-direction:column;width:100%;max-width:680px;min-height:600px;background:var(--cream);border:1px solid rgba(107,61,66,0.12);border-radius:24px;box-shadow:0 26px 64px rgba(74,42,46,0.18);overflow:hidden;}
    #wkq-{{ uid }} .wkq-top{position:static;background:none;}
    #wkq-{{ uid }} .wkq-bar-inner{max-width:none;padding:22px 40px 16px;}
    #wkq-{{ uid }} .wkq-back{left:40px;}
    #wkq-{{ uid }} .wkq-stage{flex:1 1 auto;max-width:none;padding:40px 48px 8px;}
    #wkq-{{ uid }} .wkq-footer{position:static;background:none;padding:24px 48px 40px;}
    #wkq-{{ uid }} .wkq-cta{max-width:none;}
  }
</style>

<section id="wkq-{{ uid }}" class="wkq">
  <div class="wkq-frame">
    <div class="wkq-top">
      <div class="wkq-bar-inner">
        <button class="wkq-back" type="button" aria-label="Back" data-wkq-back>&larr;</button>
        <span class="wkq-logo">{{ section.settings.logo_text | default: 'womankind' }}</span>
      </div>
      <div class="wkq-progress"><div class="wkq-progress-fill" data-wkq-fill></div></div>
    </div>

    <div class="wkq-stage" data-wkq-stage></div>

    <div class="wkq-footer">
      <button class="wkq-cta hidden" type="button" data-wkq-cta></button>
    </div>

    {%- comment -%} live Okendo star rating — the JS moves this into the offer's rating slot {%- endcomment -%}
    <div data-wkq-oke-holder hidden><div data-wkq-oke-star class="wkq-rating"><div data-oke-star-rating data-oke-reviews-product-id="shopify-{{ oke_product.id }}">{{ oke_product.metafields.okendo.StarRatingSnippet }}</div></div></div>

    {%- comment -%} extra selling blocks — revealed by the JS only on the offer step {%- endcomment -%}
    <div class="wkq-extras" data-wkq-extras hidden>

      {%- assign oke_product = wk_product | default: all_products['hormonal-support-gummies'] -%}
      <div class="wkq-ex-reviews">
        <div class="wkq-ex-eyebrow">Reviews</div>
        <h2 class="wkq-ex-h">{{ section.settings.reviews_heading | default: 'What women are saying' }}</h2>
        <div data-oke-widget data-oke-reviews-product-id="shopify-{{ oke_product.id }}">{{ oke_product.metafields.okendo.ReviewsWidgetSnippet }}</div>
      </div>

      {%- comment -%} INGREDIENT DEEP DIVE (ported from wk-ingredients-3) {%- endcomment -%}
      {%- assign ing_defaults = 'wk-ing-ashwagandha.jpg,wk-ing-black-cohosh.jpg,wk-ing-red-clover.jpg,wk-ing-chasteberry.jpg,wk-ing-dong-quai.jpg,wk-ing-cranberry.jpg,wk-ing-vitamins.jpg,wk-ing-probiotic.jpg' | split: ',' -%}
      <div id="wkq-ing-{{ uid }}" class="wkq-ex-ing">
        <div class="wkq-ex-ing-head">
          <div class="wkq-ex-eyebrow">{{ section.settings.ing_eyebrow | default: "What's inside, and why" }}</div>
          <h2 class="wkq-ex-h">{{ section.settings.ing_heading | default: 'Every ingredient, chosen for a reason' }}</h2>
          <p class="wkq-ex-sub">{{ section.settings.ing_subhead | default: 'No proprietary blends. No fairy dust. Every active in Womankind is clearly named, fully dosed, and chosen for the specific role it plays through perimenopause — grounded in published research, not marketing fluff.' }}</p>
        </div>
        <div class="wkq-ing-grid">
          {%- assign vis = 0 -%}
          {%- for i in (1..8) -%}
            {%- assign nk = 'ing' | append: i | append: '_name' -%}
            {%- assign name = section.settings[nk] -%}
            {%- if name != blank -%}
              {%- assign rk = 'ing' | append: i | append: '_role' -%}
              {%- assign dk = 'ing' | append: i | append: '_dose' -%}
              {%- assign ik = 'ing' | append: i | append: '_image' -%}
              {%- assign img = section.settings[ik] -%}
              {%- if img -%}{%- assign src = img | image_url: width: 320 -%}{%- else -%}{%- assign fname = ing_defaults[forloop.index0] -%}{%- assign src = fname | asset_url -%}{%- endif -%}
              <div class="wkq-ing-card" role="button" tabindex="0" data-wkq-ing-open="{{ vis }}" aria-label="Learn more about {{ name | escape }}">
                <div class="wkq-ing-card-top">
                  <h3 class="wkq-ing-card-name">{{ name }}</h3>
                  {%- if section.settings[dk] != blank -%}<span class="wkq-ing-card-dose">{{ section.settings[dk] }}</span>{%- endif -%}
                </div>
                <p class="wkq-ing-card-role">{{ section.settings[rk] }}</p>
                <img src="{{ src }}" alt="{{ name | escape }}" width="200" height="200" loading="lazy" class="wkq-ing-card-img">
                <span class="wkq-ing-plus" aria-hidden="true">+</span>
              </div>
              {%- assign vis = vis | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="wkq-ex-suppfacts">
          <button type="button" data-wkq-suppfacts-open class="wkq-ex-outline">{{ section.settings.supp_button_label | default: 'See full supplement facts' }}</button>
        </div>

        <div data-wkq-ingm-overlay class="wkq-ingm-overlay" role="dialog" aria-modal="true" aria-label="Ingredient details">
          <div class="wkq-ingm-box">
            <button type="button" data-wkq-ingm-close aria-label="Close" class="wkq-ingm-x">&times;</button>
            <div style="overflow:hidden;">
              <div class="wkq-ingm-track" data-wkq-ingm-track>
                {%- assign vis = 0 -%}
                {%- for i in (1..8) -%}
                  {%- assign nk = 'ing' | append: i | append: '_name' -%}
                  {%- assign name = section.settings[nk] -%}
                  {%- if name != blank -%}
                    {%- assign dk = 'ing' | append: i | append: '_dose' -%}
                    {%- assign dsk = 'ing' | append: i | append: '_desc' -%}
                    {%- assign ik = 'ing' | append: i | append: '_image' -%}
                    {%- assign img = section.settings[ik] -%}
                    {%- if img -%}{%- assign msrc = img | image_url: width: 640 -%}{%- else -%}{%- assign fname = ing_defaults[forloop.index0] -%}{%- assign msrc = fname | asset_url -%}{%- endif -%}
                    <div class="wkq-ingm-slide">
                      <img src="{{ msrc }}" alt="{{ name | escape }}" width="520" height="240" loading="lazy" class="wkq-ingm-img">
                      <div class="wkq-ingm-body">
                        <div class="wkq-ing-card-top">
                          <h3 class="wkq-ingm-name">{{ name }}</h3>
                          {%- if section.settings[dk] != blank -%}<span class="wkq-ing-card-dose">{{ section.settings[dk] }}</span>{%- endif -%}
                        </div>
                        <p class="wkq-ingm-desc">{{ section.settings[dsk] }}</p>
                      </div>
                    </div>
                    {%- assign vis = vis | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="wkq-ingm-nav">
              <button type="button" data-wkq-ingm-prev aria-label="Previous ingredient" class="wkq-ingm-arrow">&lsaquo;</button>
              <span data-wkq-ingm-count class="wkq-ingm-count">1 / 1</span>
              <button type="button" data-wkq-ingm-next aria-label="Next ingredient" class="wkq-ingm-arrow">&rsaquo;</button>
            </div>
          </div>
        </div>

        {%- if section.settings.supp_facts_image -%}{%- assign supp_src = section.settings.supp_facts_image | image_url: width: 700 -%}{%- else -%}{%- assign supp_src = 'wk-supplement-facts.jpg' | asset_url -%}{%- endif -%}
        <div data-wkq-suppfacts-overlay class="wkq-ingm-overlay" role="dialog" aria-modal="true" aria-label="Supplement facts">
          <div data-wkq-suppfacts-dialog class="wkq-suppfacts-box">
            <button type="button" data-wkq-suppfacts-close aria-label="Close" class="wkq-ingm-x">&times;</button>
            <img src="{{ supp_src }}" alt="Womankind supplement facts panel" width="692" height="705" loading="lazy" class="wkq-suppfacts-img">
          </div>
        </div>
      </div>

      {%- comment -%} RECOMMENDED BY EXPERTS (ported from wk-experts-3) {%- endcomment -%}
      {%- assign exp_defaults = 'wk-expert-delgado.jpg,wk-expert-lin.jpg,wk-expert-raman.jpg' | split: ',' -%}
      <div class="wkq-ex-experts">
        <div class="wkq-ex-eyebrow">Expert-backed</div>
        <h2 class="wkq-ex-h">{{ section.settings.experts_heading | default: 'Recommended by women’s health experts' }}</h2>
        <div class="wkq-exp-track">
          {%- for i in (1..3) -%}
            {%- assign nk = 'exp' | append: i | append: '_name' -%}
            {%- assign name = section.settings[nk] -%}
            {%- if name != blank -%}
              {%- assign ik = 'exp' | append: i | append: '_image' -%}
              {%- assign ck = 'exp' | append: i | append: '_credential' -%}
              {%- assign qk = 'exp' | append: i | append: '_quote' -%}
              {%- assign img = section.settings[ik] -%}
              {%- if img -%}{%- assign src = img | image_url: width: 400 -%}{%- else -%}{%- assign fname = exp_defaults[forloop.index0] -%}{%- assign src = fname | asset_url -%}{%- endif -%}
              <div class="wkq-exp-card">
                <img src="{{ src }}" alt="{{ name | escape }}, {{ section.settings[ck] }}" width="400" height="400" loading="lazy" class="wkq-exp-img">
                <h3 class="wkq-exp-name">{{ name }}</h3>
                <div class="wkq-exp-cred">{{ section.settings[ck] }}</div>
                <p class="wkq-exp-quote">{{ section.settings[qk] }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} final add-to-cart — mirrors the offer buy box's selected plan {%- endcomment -%}
      <div class="wkq-ex-finalcta">
        <div class="wkq-ex-eyebrow">Ready when you are</div>
        <h2 class="wkq-ex-h">Start your routine today.</h2>
        <button type="button" class="wkq-atc" data-wkq-atc-bottom>Get my routine <span class="wkq-atc-total">— <span data-atc-total-bottom></span></span></button>
        <div class="wkq-guar"><span class="wkq-guar-badge">90</span><span><span class="wkq-guar-t">90-day money-back guarantee</span><span class="wkq-guar-s">Love it, or get your money back.</span></span></div>
        <div class="wkq-trust">Hormone-free · Third-party tested · Made in Europe</div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var root = document.getElementById('wkq-{{ uid }}');
  if(!root) return;
  var TOTAL_Q = {{ section.settings.total_questions | default: 8 }};

  var CHECK = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#FBF1E6" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

  /* ---- reviews (from the homepage) ---- */
  var TESTIMONIALS = [
    { stars:5, quote:'I didn’t expect much after years of things that did nothing. Three weeks in, the 2am wake-ups eased and I finally feel steady in my own body again.', name:'Margaret R., 48', tags:['Better sleep','Mood balance'] },
    { stars:5, quote:'I’m a sceptic — I’ve wasted money on a lot of these. This is the first one where I can actually feel the difference. Cooler nights, fewer flushes.', name:'Grace L., 47', tags:['Hot flashes','Night sweats'] },
    { stars:5, quote:'A doctor told me my labs were normal and it was probably stress. This is the first thing that took the early changes seriously. I feel more like me.', name:'Renée J., 50', tags:['Hormonal balance','Steady energy'] },
    { stars:5, quote:'The little things stay little now. My family noticed I was more even before I said a word about taking anything.', name:'Gabriela R., 43', tags:['Mood balance','Stress response'] }
  ];

  /* ---- offer buy box (mirrors the gummies-3 pricing engine) ---- */
  var CART_ADD_URL = {{ routes.cart_add_url | json }};
  var PDP_URL = {{ wk_pdp_url | strip | json }};
  {%- if wk_product != blank and wk_variant != blank -%}
  var VARIANT_ID = {{ wk_variant.id }}, VARIANT_AVAIL = {{ wk_variant.available }}, BOTTLE = {{ wk_variant.price }};
  {%- else -%}
  var VARIANT_ID = null, VARIANT_AVAIL = false, BOTTLE = 4985;
  {%- endif -%}
  var SELLING_PLANS = [
    {%- assign wk_sp_first = true -%}
    {%- for grp in wk_product.selling_plan_groups -%}{%- for sp in grp.selling_plans -%}
      {%- unless wk_sp_first %},{% endunless %}{ id: {{ sp.id }}, name: {{ sp.name | json }} }{%- assign wk_sp_first = false -%}
    {%- endfor -%}{%- endfor -%}
  ];
  var PLAN_OVERRIDES = { '1': {{ section.settings.plan_1_id | default: 'null' }}, '3': {{ section.settings.plan_3_id | default: 'null' }}, '5': {{ section.settings.plan_5_id | default: 'null' }} };

  /* ---- offer reveal content (ported from the gummies-3 buy box) ---- */
  var OFFER_IMG = {{ wk_offer_img | json }};
  /* full buy-box gallery — same source as the gummies-3 PDP: gallery_N image settings,
     else the assets/wk-buybox-N.jpg files. Sized 800px for a fast, sharp 1:1 render. */
  var OFFER_IMGS = [
    {%- assign wk_img_first = true -%}
    {%- for i in (1..8) -%}
      {%- assign gik = 'gallery_' | append: i | append: '_image' -%}
      {%- assign gimg = section.settings[gik] -%}
      {%- if gimg -%}{%- assign gsrc = gimg | image_url: width: 800 -%}
      {%- else -%}{%- assign gfname = 'wk-buybox-' | append: i | append: '.jpg' -%}{%- assign gsrc = gfname | asset_url -%}{%- endif -%}
      {%- unless wk_img_first %},{% endunless %}{{ gsrc | json }}{%- assign wk_img_first = false -%}
    {%- endfor -%}
  ];
  var OFFER_DESC = {{ section.settings.offer_desc | default: 'Two zero-sugar gummies a day for hot flashes, night sweats, disrupted sleep, mood changes, and the energy dips that can make you feel unlike yourself.' | json }};
  var OFFER_BENEFITS = [
    {{ section.settings.benefit_1 | default: 'Fewer, milder hot flashes and night sweats' | json }},
    {{ section.settings.benefit_2 | default: 'Deeper sleep and fewer 2am wake-ups' | json }},
    {{ section.settings.benefit_3 | default: 'Steadier mood, stress response, and daytime energy' | json }},
    {{ section.settings.benefit_4 | default: '8 research-backed botanicals in fully disclosed doses — zero hormones, zero sugar' | json }}
  ];
  var TIERS = { '1':{m:1,off:0}, '3':{m:3,off:1/3}, '5':{m:5,off:0.40} };
  var SUB_OFF = 0.25;
  function wkMoney(c){ return '$' + (c/100).toFixed(2).replace(/\.00$/,''); }
  function wkPerDay(c){ return '$' + (c/100/30).toFixed(2); }
  function wkQuote(tier,on){
    var t=TIERS[tier], full=BOTTLE*t.m;
    var perUnit = on ? Math.round(BOTTLE*(1-t.off)*(1-SUB_OFF)) : Math.round(BOTTLE*(1-t.off));
    var total=perUnit*t.m;
    return { full:full, total:total, perMo:perUnit, save:Math.round((1-total/full)*100) };
  }
  function wkParseInterval(name){
    name=(name||'').toLowerCase();
    if(/quarter/.test(name)) return 3;
    var m=name.match(/(\d+)\s*-?\s*month/); if(m) return parseInt(m[1],10);
    if(/month/.test(name)) return 1;
