      { when:'Month 3+', title:'Feeling like yourself again', hi:true, bullets:[
        PAYOFF[s.weak.k] || PAYOFF.T,
        'Steadier energy, calmer moods, and more patience for the people and things you care about.',
        'You feel at home in your own body again.'
      ], guar:'By day 90 you’ll know. If you don’t feel the difference, <span class="wkq-hl">it’s free</span> — that’s the whole guarantee.' }
    ];
    var h = '<div class="wkq-screen"><div class="wkq-eyebrow">Your first 3 months</div>';
    h += '<h1 class="wkq-title">Here’s the honest timeline.</h1>';
    h += '<p class="wkq-sub">Your '+esc(weak)+' won’t change in a day — but it does change. Here’s exactly what happens, and when.</p>';
    h += '<div class="wkq-tl">';
    items.forEach(function(it){
      var b = '';
      it.bullets.forEach(function(x){ b += '<li class="wkq-tl-bullet">'+esc(x)+'</li>'; });
      h += '<div class="wkq-tl-item"><div class="wkq-tl-rail"><div class="wkq-tl-dot"></div><div class="wkq-tl-line"></div></div>'
         + '<div class="wkq-tl-card'+(it.hi?' hi':'')+'"><span class="wkq-tl-badge">'+esc(it.when)+'</span>'
         + '<div class="wkq-tl-title">'+esc(it.title)+'</div><ul class="wkq-tl-list">'+b+'</ul>'
         + (it.guar ? '<div class="wkq-tl-guar">'+it.guar+'</div>' : '') + '</div></div>';
    });
    h += '</div>';
    h += '</div>';
    stage.innerHTML = h;
    cta.textContent = 'Show me what to do';
    cta.classList.remove('hidden');
    cta.onclick = next;
  }

  function renderOffer(){
    cta.classList.add('hidden');
    var s = computeScores();
    var oState = { tier:'3', on:true };
    var meta = { '5':{name:'5-month supply', badge:'Best value'}, '3':{name:'3-month supply', badge:'Most popular'}, '1':{name:'1-month supply', badge:'' } };

    function planCard(tier){
      var m = meta[tier];
      return '<button type="button" class="wkq-plan'+(oState.tier===tier?' sel':'')+'" data-tier="'+tier+'">'
        + (m.badge ? '<span class="wkq-badge2">'+esc(m.badge)+'</span>' : '')
        + '<span class="wkq-plan-l"><span class="wkq-plan-name">'+esc(m.name)+'</span>'
        + '<span class="wkq-plan-sub"><span data-permo></span>/month · <span data-perday></span>/day<span data-savew> · <span data-save class="save"></span></span></span></span>'
        + '<span class="wkq-plan-r"><span data-compare class="wkq-strike"></span><span data-total class="wkq-price"></span></span>'
        + '<span class="wkq-plan-radio">'+CHECK+'</span></button>';
    }

    var h = '<div class="wkq-screen">';
    if(OFFER_IMGS.length > 1){
      var slides = '', dots = '';
      OFFER_IMGS.forEach(function(u, idx){
        slides += '<div class="wkq-hero-slide"><img src="'+esc(u)+'" alt="Womankind Hormonal Support Gummies"'+(idx===0?'':' loading="lazy"')+'></div>';
        dots += '<button type="button" class="wkq-hero-dot'+(idx===0?' on':'')+'" data-gi="'+idx+'" aria-label="Image '+(idx+1)+'"></button>';
      });
      h += '<div class="wkq-hero"><div class="wkq-hero-track" data-hero-track>'+slides+'</div><div class="wkq-hero-dots">'+dots+'</div></div>';
    } else if(OFFER_IMGS.length === 1){
      h += '<div class="wkq-hero"><img src="'+esc(OFFER_IMGS[0])+'" alt="Womankind Hormonal Support Gummies"></div>';
    } else {
      h += '<div class="wkq-hero"><span class="wkq-hero-ph">Product image</span></div>';
    }
    h += '<div class="wkq-eyebrow">Your match</div>';
    h += '<h1 class="wkq-title">Built for your '+esc(s.weak.name.toLowerCase())+'.</h1>';
    h += '<div data-wkq-rating-slot></div>';
    h += '<p class="wkq-odesc">'+esc(OFFER_DESC)+'</p>';
    var bens = '';
    OFFER_BENEFITS.forEach(function(b){ if(b) bens += '<div class="wkq-ben"><span class="ck">&check;</span><span>'+esc(b)+'</span></div>'; });
    h += '<div class="wkq-bens">'+bens+'</div>';
    h += '<p style="font-size:15px;line-height:1.5;color:var(--body);margin:0 0 14px;">Your timeline showed the real shift lands around <b style="color:var(--plum);">month 3</b> — that’s the <b style="color:var(--plum);">3-month supply</b>, so we’ve set you up there. Change it anytime below.</p>';
    h += '<div class="wkq-plans">'+planCard('5')+planCard('3')+planCard('1')+'</div>';
    h += '<div class="wkq-refill" data-refill role="checkbox" aria-checked="true" tabindex="0"><span class="wkq-refill-box">'+CHECK+'</span>'
       + '<span><span class="wkq-refill-t">Auto-refill &amp; save 25%</span><span class="wkq-refill-s">Delivered on your schedule. Pause, skip, or cancel anytime.</span></span></div>';
    if(VARIANT_ID && VARIANT_AVAIL){
      h += '<form method="post" action="'+CART_ADD_URL+'" class="wkq-atc-wrap">'
         + '<input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓">'
         + '<input type="hidden" name="id" value="'+VARIANT_ID+'">'
         + '<input type="hidden" name="quantity" value="3" data-qty>'
         + '<input type="hidden" name="selling_plan" value="" data-plan disabled>'
         + '<button type="submit" class="wkq-atc">Get my routine <span class="wkq-atc-total">— <span data-atc-total></span></span></button></form>';
    } else {
      h += '<a class="wkq-atc" href="'+PDP_URL+'">Get my routine</a>';
    }
    h += '<div class="wkq-guar"><span class="wkq-guar-badge">90</span><span><span class="wkq-guar-t">90-day money-back guarantee</span><span class="wkq-guar-s">Love it, or get your money back.</span></span></div>';
    h += '<div class="wkq-trust">Hormone-free · Third-party tested · Made in Europe</div>';
    h += '</div>';
    stage.innerHTML = h;

    // drop the live Okendo star rating into the rating slot under the title
    var okeSlot = stage.querySelector('[data-wkq-rating-slot]');
    var okeStar = root.querySelector('[data-wkq-oke-star]');
    if(okeSlot && okeStar) okeSlot.appendChild(okeStar);

    // hero gallery: sync dots to swipe + jump on dot tap
    var heroTrack = stage.querySelector('[data-hero-track]');
    if(heroTrack){
      heroTrack.addEventListener('scroll', function(){
        var idx = Math.round(heroTrack.scrollLeft / heroTrack.clientWidth);
        stage.querySelectorAll('.wkq-hero-dot').forEach(function(d, di){ d.classList.toggle('on', di===idx); });
      }, { passive:true });
      stage.querySelectorAll('.wkq-hero-dot').forEach(function(d){
        d.addEventListener('click', function(){
          var gi = parseInt(d.getAttribute('data-gi'), 10) || 0;
          heroTrack.scrollTo({ left: gi*heroTrack.clientWidth, behavior:'smooth' });
        });
      });
    }

    var refill = stage.querySelector('[data-refill]');
    function paint(){
      ['5','3','1'].forEach(function(k){
        var card = stage.querySelector('.wkq-plan[data-tier="'+k+'"]'); if(!card) return;
        var q = wkQuote(k, oState.on);
        card.querySelector('[data-permo]').textContent  = wkMoney(q.perMo);
        card.querySelector('[data-perday]').textContent = wkPerDay(q.perMo);
        card.querySelector('[data-total]').textContent  = wkMoney(q.total);
        var cmp = card.querySelector('[data-compare]'); cmp.textContent = wkMoney(q.full); cmp.style.display = q.save>0 ? 'block' : 'none';
        card.querySelector('[data-save]').textContent = 'Save ' + q.save + '%';
        card.querySelector('[data-savew]').style.display = q.save>0 ? '' : 'none';
        card.classList.toggle('sel', oState.tier===k);
      });
      var q = wkQuote(oState.tier, oState.on);
      var at = stage.querySelector('[data-atc-total]'); if(at) at.textContent = wkMoney(q.total);
      var atb = extras ? extras.querySelector('[data-atc-total-bottom]') : null; if(atb) atb.textContent = wkMoney(q.total);
      var qty = stage.querySelector('[data-qty]'); if(qty) qty.value = oState.tier;
      var planId = planForTier(oState.tier), sub = oState.on && planId;
      var pl = stage.querySelector('[data-plan]'); if(pl){ if(planId) pl.value = planId; pl.disabled = !sub; }
      if(refill) refill.setAttribute('aria-checked', oState.on ? 'true' : 'false');
    }
    stage.querySelectorAll('.wkq-plan').forEach(function(b){ b.addEventListener('click', function(){ oState.tier = b.getAttribute('data-tier'); paint(); }); });
    if(refill){
      function tog(){ oState.on = !oState.on; paint(); }
      refill.addEventListener('click', tog);
      refill.addEventListener('keydown', function(e){ if(e.key===' '||e.key==='Enter'){ e.preventDefault(); tog(); } });
    }
    paint();
  }

  function next(){ if(i < STEPS.length-1){ i++; render(); } }
  function prev(){ if(i > 0){ i--; render(); } }

  back.addEventListener('click', prev);
  render();
})();
</script>

<script>
/* ingredient deep-dive modal + supplement-facts lightbox (offer extras) */
(function(){
  var root = document.getElementById('wkq-ing-{{ uid }}');
  if(!root) return;
  var overlay = root.querySelector('[data-wkq-ingm-overlay]');
  var track   = root.querySelector('[data-wkq-ingm-track]');
  var count   = root.querySelector('[data-wkq-ingm-count]');
  var prev    = root.querySelector('[data-wkq-ingm-prev]');
  var next    = root.querySelector('[data-wkq-ingm-next]');
  var slides  = track ? track.querySelectorAll('.wkq-ingm-slide') : [];
  var total   = slides.length, cur = 0;
  function draw(){
    if(!track) return;
    track.style.transform = 'translateX(' + (-cur*100) + '%)';
    if(count) count.textContent = (cur+1) + ' / ' + total;
    if(prev) prev.style.visibility = cur===0 ? 'hidden' : 'visible';
    if(next) next.style.visibility = cur===total-1 ? 'hidden' : 'visible';
  }
  function openM(idx){ cur = Math.max(0, Math.min(idx, total-1)); if(overlay) overlay.classList.add('open'); document.body.style.overflow='hidden'; draw(); }
  function closeM(){ if(overlay) overlay.classList.remove('open'); document.body.style.overflow=''; }
  root.querySelectorAll('[data-wkq-ing-open]').forEach(function(btn){
    var gi = function(){ return parseInt(btn.getAttribute('data-wkq-ing-open'),10) || 0; };
    btn.addEventListener('click', function(){ openM(gi()); });
    btn.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); openM(gi()); } });
  });
  if(prev) prev.addEventListener('click', function(){ if(cur>0){ cur--; draw(); } });
  if(next) next.addEventListener('click', function(){ if(cur<total-1){ cur++; draw(); } });
  if(overlay){
    overlay.addEventListener('click', function(e){ if(e.target===overlay) closeM(); });
    var xb = root.querySelector('[data-wkq-ingm-close]'); if(xb) xb.addEventListener('click', closeM);
  }
  document.addEventListener('keydown', function(e){
    if(!overlay || !overlay.classList.contains('open')) return;
    if(e.key==='Escape') closeM();
    else if(e.key==='ArrowLeft' && cur>0){ cur--; draw(); }
    else if(e.key==='ArrowRight' && cur<total-1){ cur++; draw(); }
  });
  var sOv = root.querySelector('[data-wkq-suppfacts-overlay]');
  var sOpen = root.querySelector('[data-wkq-suppfacts-open]');
  if(sOpen && sOv){
    sOpen.addEventListener('click', function(){ sOv.classList.add('open'); document.body.style.overflow='hidden'; });
    function sc(){ sOv.classList.remove('open'); document.body.style.overflow=''; }
    var sClose = root.querySelector('[data-wkq-suppfacts-close]'); if(sClose) sClose.addEventListener('click', sc);
    sOv.addEventListener('click', function(e){ if(e.target===sOv) sc(); });
    document.addEventListener('keydown', function(e){ if(e.key==='Escape' && sOv.classList.contains('open')) sc(); });
  }
})();
</script>

