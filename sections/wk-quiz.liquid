  /* ---- scoring model (4 pillars) ---- */
  var PILLARS = [
    { k:'R', name:'Sleep',       desc:'The 3am wake-ups and nights that never quite restore you.' },
    { k:'T', name:'Temperature', desc:'Hot flashes and night sweats. The part that steals your sleep.' },
    { k:'M', name:'Mood',        desc:'Irritability and low-level anxiety. Felt by everyone around you too.' },
    { k:'E', name:'Energy',      desc:'Afternoon crashes and brain fog. The tax on everything else.' }
  ];
  var SCORES = {
    pattern: { sleep:{R:3}, heat:{T:3}, mood:{M:3}, energy:{E:3} },
    sleep:   { threeam:{R:3}, racing:{M:2,R:1}, sweats:{T:3}, unrefreshed:{E:2,R:1} },
    flashes: { often:{T:3}, weekly:{T:2}, rare:{T:1}, never:{} },
    moodq:   { edge:{M:3}, anxious:{M:3}, flat:{M:2,E:1}, steady:{} },
    energyq: { wall:{E:3}, foggy:{E:2,M:1}, morning:{E:2,R:1}, ok:{} },
    evening: { wine:{T:1,R:1}, caffeine:{R:1}, scroll:{R:1,M:1}, stress:{M:2,T:1}, none:{} }
  };
  var GOAL_ECHO = { cool:'cool, unbroken nights', steady:'a calm, steady mood', energy:'real energy back', clear:'a clear head', me:'feeling like yourself again' };

  function computeScores(){
    var pts = { R:0, T:0, M:0, E:0 };
    Object.keys(SCORES).forEach(function(qid){
      var a = answers[qid]; if(a==null) return;
      var vals = Array.isArray(a) ? a : [a];
      vals.forEach(function(v){
        var d = SCORES[qid][v] || {};
        Object.keys(d).forEach(function(k){ pts[k] += d[k]; });
      });
    });
    var max = Math.max(pts.R, pts.T, pts.M, pts.E, 1);
    var list = PILLARS.map(function(p){
      var pct = Math.max(Math.round(pts[p.k] / max * 100), 20);
      return { k:p.k, name:p.name, desc:p.desc, pct:pct, raw:pts[p.k] };
    });
    var weakIdx = 0, best = -1;
    list.forEach(function(o,idx){ if(o.raw > best){ best = o.raw; weakIdx = idx; } });
    list[weakIdx].weak = true;
    return { list:list, weak:list[weakIdx] };
  }
  function tierLabel(pct){ return pct>=85 ? 'Needs the most support' : (pct>=40 ? 'Some strain' : 'In good shape'); }
  function ring(pct, weak){
    var r=32, c=2*Math.PI*r, off=c*(1-pct/100), col = weak ? '#C9653F' : '#E2A24C';
    return '<svg width="80" height="80" viewBox="0 0 80 80" aria-hidden="true">'
      + '<circle cx="40" cy="40" r="'+r+'" fill="none" stroke="#E9D6CE" stroke-width="7"/>'
      + '<circle cx="40" cy="40" r="'+r+'" fill="none" stroke="'+col+'" stroke-width="7" stroke-linecap="round" stroke-dasharray="'+c.toFixed(1)+'" stroke-dashoffset="'+off.toFixed(1)+'" transform="rotate(-90 40 40)"/>'
      + '<text x="40" y="46" text-anchor="middle" font-family="Fraunces,serif" font-weight="600" font-size="19" fill="#6B3D42">'+pct+'%</text></svg>';
  }

  var stage = root.querySelector('[data-wkq-stage]');
  var fill  = root.querySelector('[data-wkq-fill]');
  var back  = root.querySelector('[data-wkq-back]');
  var cta   = root.querySelector('[data-wkq-cta]');
  var extras = root.querySelector('[data-wkq-extras]');

  // final CTA at the bottom of the offer extras re-uses the buy box's selected plan
  var bottomAtc = extras ? extras.querySelector('[data-wkq-atc-bottom]') : null;
  if(bottomAtc){
    bottomAtc.addEventListener('click', function(){
      var main = stage.querySelector('.wkq-atc-wrap [type="submit"]') || stage.querySelector('a.wkq-atc');
      if(main) main.click();
    });
  }

  var i = 0;
  var answers = {};

  function esc(s){ var d=document.createElement('div'); d.textContent=s; return d.innerHTML; }

  function lastQ(){
    var n = 0;
    for(var k=0;k<=i && k<STEPS.length;k++){ if(STEPS[k].kind==='q') n = STEPS[k].q; }
    return n;
  }
  function setProgress(){
    var step = STEPS[i];
    var frac = Math.min(lastQ() / TOTAL_Q, 1);
    if(step && (step.kind==='score' || step.kind==='timeline' || step.kind==='offer')) frac = 1;
    fill.style.width = (frac*100) + '%';
  }

  function render(){
    var step = STEPS[i];
    back.classList.toggle('show', i>0);
    setProgress();
    if(extras) extras.hidden = (step.kind !== 'offer');
    root.classList.toggle('wkq-offermode', step.kind === 'offer');
    // park the live Okendo star node back in its holder before the stage is rewritten
    var okeHolder = root.querySelector('[data-wkq-oke-holder]');
    var okeStar = root.querySelector('[data-wkq-oke-star]');
    if(okeHolder && okeStar && okeStar.parentNode !== okeHolder) okeHolder.appendChild(okeStar);
    if(step.kind==='q')             renderQuestion(step);
    else if(step.kind==='reflect')  renderReflect(step);
    else if(step.kind==='loader')   renderLoader(step);
    else if(step.kind==='score')    renderScore();
    else if(step.kind==='timeline') renderTimeline();
    else                            renderOffer();
    window.scrollTo(0,0);
  }

  function renderQuestion(step){
    var multi = !!step.multi;
    var sel = multi ? (answers[step.id] || []) : answers[step.id];
    var h = '<div class="wkq-screen">';
    h += '<div class="wkq-eyebrow">'+esc(step.eyebrow)+'</div>';
    h += '<h1 class="wkq-title">'+esc(step.title)+'</h1>';
    if(step.sub)  h += '<p class="wkq-sub">'+esc(step.sub)+'</p>';
    if(step.note) h += '<div class="wkq-note"><span class="wkq-spark">&#10022;</span><span>'+step.note.replace('60 seconds','<b>60 seconds</b>')+'</span></div>';
    h += '<div class="wkq-opts">';
    step.options.forEach(function(o){
      var on = multi ? (sel.indexOf(o.v)>-1 ? ' sel' : '') : (sel===o.v ? ' sel' : '');
      h += '<button type="button" class="wkq-opt'+(multi?' multi':'')+on+'" data-v="'+esc(o.v)+'">'
         +   '<span>'+esc(o.label)+'</span><span class="wkq-radio">'+CHECK+'</span></button>';
    });
    h += '</div>';
    if(multi) h += '<p class="wkq-choose">Choose as many as apply.</p><p class="wkq-err" data-err>Pick at least one to continue.</p>';
    h += '</div>';
    stage.innerHTML = h;

    var btns = stage.querySelectorAll('.wkq-opt');
    if(multi){
      if(!answers[step.id]) answers[step.id] = [];
      btns.forEach(function(btn){
        btn.addEventListener('click', function(){
          var v = btn.getAttribute('data-v');
          var arr = answers[step.id];
          if(step.exclusive && v===step.exclusive){
            answers[step.id] = [v];
          } else {
            var idx = arr.indexOf(v);
            if(idx>-1){ arr.splice(idx,1); }
            else {
              arr.push(v);
              if(step.exclusive){ var ei = arr.indexOf(step.exclusive); if(ei>-1) arr.splice(ei,1); }
            }
          }
          var cur = answers[step.id];
          btns.forEach(function(b){ b.classList.toggle('sel', cur.indexOf(b.getAttribute('data-v'))>-1); });
          var e = stage.querySelector('[data-err]'); if(e) e.classList.remove('show');
        });
      });
      cta.textContent = 'Continue';
      cta.classList.remove('hidden');
      cta.onclick = function(){
        if((answers[step.id]||[]).length===0){ var e=stage.querySelector('[data-err]'); if(e) e.classList.add('show'); return; }
        next();
      };
    } else {
      cta.classList.add('hidden');
      btns.forEach(function(btn){
        btn.addEventListener('click', function(){
          answers[step.id] = btn.getAttribute('data-v');
          btns.forEach(function(b){ b.classList.remove('sel'); });
          btn.classList.add('sel');
          setTimeout(next, 280);
        });
      });
    }
  }

  function pickReflect(step){
    if(!step.variantsByTried) return step;
    var t = answers.tried || [];
    var key = 'default';
    if(t.indexOf('nothing')>-1) key = 'nothing';
    else if(t.indexOf('hrt')>-1) key = 'hrt';
    var v = step.variantsByTried[key] || {};
    var out = {}; for(var a in step){ out[a] = step[a]; } for(var b in v){ out[b] = v[b]; }
    return out;
  }
  function renderReflect(step){
    step = pickReflect(step);
    var h = '<div class="wkq-screen">';
    h += '<div class="wkq-eyebrow">'+esc(step.eyebrow)+'</div>';
    h += '<h1 class="wkq-title">'+esc(step.title)+'</h1>';
    var leadPre = step.leadPre;
    if(step.leadPreByPattern && answers.pattern && step.leadPreByPattern[answers.pattern]) leadPre = step.leadPreByPattern[answers.pattern];
    h += '<p class="wkq-lead">'+esc(leadPre)+'<span class="wkq-hl">'+esc(step.leadHl)+'</span>'+esc(step.leadPost)+'</p>';
    h += '<div class="wkq-points">';
    step.points.forEach(function(p,idx){
      h += '<div class="wkq-point"><span class="wkq-pnum">'+(idx+1)+'</span>'
         +   '<div><span class="wkq-ph">'+esc(p.h)+'</span><span class="wkq-pb">'+esc(p.b)+'</span></div></div>';
    });
    h += '</div></div>';
    stage.innerHTML = h;
    cta.textContent = step.cta || 'Continue';
    cta.classList.remove('hidden');
    cta.onclick = next;
  }

  function stars(n){ var s=''; for(var k=0;k<5;k++){ s += '<span'+(k<n?'':' class="off"')+'>&#9733;</span>'; } return s; }
  function ringShell(){
    var C = 2*Math.PI*34;
    return '<svg width="120" height="120" viewBox="0 0 120 120" aria-hidden="true">'
      + '<circle cx="60" cy="60" r="34" fill="none" stroke="#E9D6CE" stroke-width="8"/>'
      + '<circle data-ringfg cx="60" cy="60" r="34" fill="none" stroke="#6B3D42" stroke-width="8" stroke-linecap="round" stroke-dasharray="'+C.toFixed(1)+'" stroke-dashoffset="'+C.toFixed(1)+'" transform="rotate(-90 60 60)"/>'
      + '<text data-ringtext x="60" y="67" text-anchor="middle" font-family="Hanken Grotesk,sans-serif" font-weight="800" font-size="22" fill="#6B3D42">0%</text></svg>';
  }
  function renderLoader(step){
    cta.classList.add('hidden');
    var checks = step.checks || [];
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var h = '<div class="wkq-screen wkq-loader">';
    h += '<div class="wkq-load-ring">'+ringShell()+'</div>';
    h += '<h1 class="wkq-title wkq-load-title">'+esc(step.headline || 'Building your results.')+'</h1>';
    h += '<div class="wkq-load-bar"><div class="wkq-load-bar-fill" data-loadbar></div></div>';
    h += '<div class="wkq-load-checks">';
    checks.forEach(function(c,idx){
      h += '<div class="wkq-load-check" data-check="'+idx+'"><span class="wkq-load-box">'+CHECK+'</span><span>'+esc(c)+'</span></div>';
    });
    h += '</div>';
    h += '<div class="wkq-tst"><div class="wkq-tst-track" data-tst-track>';
    TESTIMONIALS.forEach(function(t){
      var tg = (t.tags && t.tags.length) ? '<div class="wkq-tst-tags">'+t.tags.map(function(x){ return '<span>'+esc(x)+'</span>'; }).join('')+'</div>' : '';
      h += '<div class="wkq-tst-card"><div class="wkq-tst-stars">'+stars(t.stars)+'</div>'
         + '<div class="wkq-tst-q">'+esc(t.quote)+'</div>'
         + '<div class="wkq-tst-n">'+esc(t.name)+' · <span>Verified buyer</span></div>'+tg+'</div>';
    });
    h += '</div></div>';
    h += '</div>';
    stage.innerHTML = h;

    var ringFg = stage.querySelector('[data-ringfg]');
    var ringTx = stage.querySelector('[data-ringtext]');
    var bar    = stage.querySelector('[data-loadbar]');
    var checkEls = stage.querySelectorAll('.wkq-load-check');
    var C = 2*Math.PI*34, D = 6000;

    function finish(){ if(ringFg && ringFg.isConnected) next(); }
    if(reduce){
      if(ringFg) ringFg.style.strokeDashoffset = '0';
      if(ringTx) ringTx.textContent = '100%';
      if(bar) bar.style.width = '100%';
      checkEls.forEach(function(el){ el.classList.add('done'); });
      setTimeout(finish, 1000);
    } else {
      var start = null;
      function frame(ts){
        if(!ringFg || !ringFg.isConnected) return;
        if(start===null) start = ts;
        var p = Math.min((ts-start)/D, 1);
        ringFg.style.strokeDashoffset = (C*(1-p)).toFixed(1);
        if(ringTx) ringTx.textContent = Math.round(p*100) + '%';
        if(bar) bar.style.width = (p*100) + '%';
        checkEls.forEach(function(el,idx){
          if(p >= ((idx+1)/checkEls.length)*0.9) el.classList.add('done');
        });
        if(p < 1) requestAnimationFrame(frame);
        else setTimeout(finish, 450);
      }
      requestAnimationFrame(frame);

      var track = stage.querySelector('[data-tst-track]');
      if(track && track.children.length > 1){
        var ti = 0;
        var iv = setInterval(function(){
          if(!track.isConnected){ clearInterval(iv); return; }
          ti = (ti+1) % track.children.length;
          var card = track.children[ti];
          track.scrollTo({ left: card.offsetLeft - (track.clientWidth - card.clientWidth)/2, behavior:'smooth' });
        }, 2200);
      }
    }
  }

  function renderScore(){
    var s = computeScores();
    var h = '<div class="wkq-screen">';
    h += '<div class="wkq-eyebrow">Your results</div>';
    h += '<h1 class="wkq-title">Here’s where your hormones need the most support.</h1>';
    h += '<p class="wkq-sub">Four systems shift in perimenopause. Yours point to one clear priority.</p>';
    h += '<div class="wkq-grid">';
    s.list.forEach(function(o){
      h += '<div class="wkq-card'+(o.weak?' weak':'')+'">'
         +   (o.weak ? '<span class="wkq-badge">Weakest link</span>' : '')
         +   ring(o.pct, o.weak)
         +   '<div class="wkq-card-name">'+esc(o.name)+'</div>'
         +   '<div class="wkq-card-tier">'+esc(tierLabel(o.pct))+'</div>'
         +   '<div class="wkq-card-desc">'+esc(o.desc)+'</div></div>';
    });
    h += '</div>';
    var WHY_TAIL = {
      R:' is the first domino — steady your nights, and mood, energy and temperature all get easier to shift.',
      T:' is what steals your sleep — settle the flashes and night sweats, and the rest starts to follow.',
      M:' runs under everything else — steady it, and the days stop feeling like a fight on every front.',
      E:' is the tax on everything else — get it back, and every other symptom feels more manageable.'
    };
    var whyTail = WHY_TAIL[s.weak.k] || ' is where to start — steady it, and the others start to settle too.';
    // one lifestyle trigger they picked that actually feeds the weak pillar
    var TRIGGER_PHRASE = { wine:'your evening glass of wine', caffeine:'afternoon caffeine', scroll:'screens right up to bedtime', stress:'stress that doesn’t switch off' };
    var trig = '';
    (answers.evening || []).forEach(function(v){ if(!trig && SCORES.evening[v] && SCORES.evening[v][s.weak.k]) trig = TRIGGER_PHRASE[v] || ''; });
    var whyBody = '<span class="wkq-hl">'+esc(s.weak.name)+'</span>'+esc(whyTail);
    if(trig) whyBody += ' One thing likely feeding it: '+esc(trig)+'.';
    h += '<div class="wkq-why"><div class="wkq-why-h">Why this matters</div>'
       +   '<div class="wkq-why-b">'+whyBody+'</div></div>';
    // echo their stated goal (display only — not part of the score)
