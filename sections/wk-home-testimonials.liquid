  <!-- TESTIMONIALS -->
  <section style="background:#EFDFD0;padding:80px 28px;">
    <div style="max-width:1140px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:46px;">
        <div style="color:#E2A24C;font-size:18px;letter-spacing:4px;margin-bottom:14px;">★★★★★</div>
        <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:38px;margin:0 0 12px;color:#6B3D42;">{{ section.settings.heading_lead }} <span style="font-style:italic;color:#C9653F;">{{ section.settings.heading_emph }}</span></h2>
        <p style="font-size:14.5px;color:#5a4636;margin:0;">{{ section.settings.subheading }}</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;">
        {%- for i in (1..3) -%}
          {%- assign qk = 't' | append: i | append: '_quote' -%}
          {%- assign quote = section.settings[qk] -%}
          {%- if quote != blank -%}
          {%- assign sk = 't' | append: i | append: '_score' -%}
          {%- assign nk = 't' | append: i | append: '_name' -%}
          {%- assign g1 = 't' | append: i | append: '_tag1' -%}
          {%- assign g2 = 't' | append: i | append: '_tag2' -%}
          <div style="background:#FBF1E6;border:1px solid rgba(107,61,66,0.14);border-radius:14px;padding:28px 26px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;"><span style="color:#C9653F;font-size:13px;letter-spacing:2px;">★★★★★</span><span style="font-size:12px;color:#7a6258;font-weight:600;">{{ section.settings[sk] }}</span></div>
            <p style="font-size:14.5px;line-height:1.6;color:#3A2A20;margin:0 0 20px;">{{ quote }}</p>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid rgba(107,61,66,0.14);padding-top:16px;">
              <span style="font-family:'Fraunces',serif;font-size:15px;color:#6B3D42;">{{ section.settings[nk] }}</span>
              <span style="font-size:10.5px;letter-spacing:0.08em;text-transform:uppercase;color:#C9653F;font-weight:600;display:inline-flex;align-items:center;gap:5px;">✓ Verified</span>
            </div>
            <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap;">
              {%- if section.settings[g1] != blank -%}<span style="font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#6B3D42;border:1px solid rgba(107,61,66,0.3);border-radius:999px;padding:4px 10px;">{{ section.settings[g1] }}</span>{%- endif -%}
              {%- if section.settings[g2] != blank -%}<span style="font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#6B3D42;border:1px solid rgba(107,61,66,0.3);border-radius:999px;padding:4px 10px;">{{ section.settings[g2] }}</span>{%- endif -%}
            </div>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

{% schema %}
{
  "name": "Home · Testimonials",
  "settings": [
    { "type": "text", "id": "heading_lead", "label": "Heading", "default": "The shift women 40+" },
    { "type": "text", "id": "heading_emph", "label": "Heading (italic)", "default": "actually notice" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Trusted by women who wanted to be taken seriously, not managed." },
    { "type": "header", "content": "Card 1" },
    { "type": "textarea", "id": "t1_quote", "label": "Quote", "default": "\"I honestly didn't expect much, but the 2am wake-ups eased within weeks. I feel steadier, calmer, more like myself again.\"" },
    { "type": "text", "id": "t1_score", "label": "Score", "default": "4.9/5.0" },
    { "type": "text", "id": "t1_name", "label": "Name", "default": "Margaret R., 47" },
    { "type": "text", "id": "t1_tag1", "label": "Tag 1", "default": "Better sleep" },
    { "type": "text", "id": "t1_tag2", "label": "Tag 2", "default": "Calm" },
    { "type": "header", "content": "Card 2" },
    { "type": "textarea", "id": "t2_quote", "label": "Quote", "default": "\"By the end of the first month the bloating had calmed and my mood felt even. Finally something that takes the early signs seriously.\"" },
    { "type": "text", "id": "t2_score", "label": "Score", "default": "5.0/5.0" },
    { "type": "text", "id": "t2_name", "label": "Name", "default": "Dana M., 51" },
    { "type": "text", "id": "t2_tag1", "label": "Tag 1", "default": "Less bloat" },
    { "type": "text", "id": "t2_tag2", "label": "Tag 2", "default": "Steady mood" },
    { "type": "header", "content": "Card 3" },
    { "type": "textarea", "id": "t3_quote", "label": "Quote", "default": "\"I'd wasted money on a lot of supplements, so I was skeptical. This is the first one where I can feel the difference — steadier energy, clearer days.\"" },
    { "type": "text", "id": "t3_score", "label": "Score", "default": "4.8/5.0" },
    { "type": "text", "id": "t3_name", "label": "Name", "default": "Elena S., 46" },
    { "type": "text", "id": "t3_tag1", "label": "Tag 1", "default": "Steady energy" },
    { "type": "text", "id": "t3_tag2", "label": "Tag 2", "default": "Clear focus" }
  ]
}
{% endschema %}
