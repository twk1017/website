  <!-- MEET THE TEAM -->
  {%- if section.settings.image -%}{%- assign wk_team_src = section.settings.image | image_url: width: 1024 -%}{%- else -%}{%- assign wk_team_src = 'wk-team.jpg' | asset_url -%}{%- endif -%}
  <section style="background:#D8C2BA;padding:0;">
    <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;align-items:stretch;">
      <div class="wk-team-photo" style="height:100%;min-height:520px;">
        <img src="{{ wk_team_src }}" alt="{{ section.settings.image.alt | default: 'The women who founded and formulate Womankind' }}" width="1024" height="1024" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;">
      </div>
      <div style="padding:72px 56px;display:flex;flex-direction:column;justify-content:center;">
        <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#C9653F;font-weight:600;margin-bottom:16px;">{{ section.settings.eyebrow }}</div>
        <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:38px;line-height:1.1;margin:0 0 20px;color:#6B3D42;">{{ section.settings.heading }}</h2>
        <p style="font-size:15px;line-height:1.65;color:#4a3a30;margin:0 0 18px;max-width:48ch;">{{ section.settings.body_1 }}</p>
        <p style="font-size:15px;line-height:1.65;color:#4a3a30;margin:0 0 32px;max-width:48ch;">{{ section.settings.body_2 }}</p>
        <a href="{{ section.settings.cta_link | default: '#' }}" style="align-self:flex-start;background:#C9653F;color:#F5E6D8;text-decoration:none;border-radius:999px;padding:15px 34px;font-size:13px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;">{{ section.settings.cta_label }}</a>
      </div>
    </div>
  </section>

{% schema %}
{
  "name": "WK - Meet the team",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Team photo", "info": "Defaults to wk-team.jpg if empty." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The women behind Womankind" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Founded by a doctor who was done being dismissed." },
    { "type": "inline_richtext", "id": "body_1", "label": "Paragraph 1", "default": "Womankind started with Dr. Katie Chen — a board-certified OB/GYN who spent years watching women in their forties get brushed aside, their labs called \"normal\" and their symptoms written off as stress. She built the formula she'd wanted for her own patients and couldn't find on any shelf." },
    { "type": "inline_richtext", "id": "body_2", "label": "Paragraph 2", "default": "Around her is a team of women — operators, formulators, and builders — who hold the standard she set: every active named and dosed, nothing oversold, and made to meet you years before the word menopause feels like yours." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start with a 3-month supply" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ]
}
{% endschema %}
