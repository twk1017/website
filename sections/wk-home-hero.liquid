  <!-- HERO — original 2-column on desktop; merged centered (image between checks & CTA) on mobile -->
  <style>
    #wk-{{ section.id }}-hero { padding:0; }
    #wk-{{ section.id }}-hero .wk-h-inner { max-width:1240px; margin:0 auto; padding:64px 28px 70px; display:grid; grid-template-columns:1.05fr 0.95fr; column-gap:40px; align-items:center; }
    #wk-{{ section.id }}-hero .wk-h-rate { display:inline-flex; align-items:center; gap:10px; margin-bottom:22px; }
    #wk-{{ section.id }}-hero .wk-h-title { font-family:'Fraunces',serif; font-weight:400; font-size:54px; line-height:1.02; letter-spacing:-0.01em; margin:0 0 26px; color:#F5E6D8; }
    #wk-{{ section.id }}-hero .wk-h-checks { display:grid; grid-template-columns:1fr 1fr; gap:13px 26px; max-width:480px; margin:0 0 32px; }
    #wk-{{ section.id }}-hero .wk-h-checks > span { display:inline-flex; align-items:center; gap:10px; font-size:14.5px; color:#F5E6D8; }
    #wk-{{ section.id }}-hero .wk-h-cta { display:inline-flex; align-items:center; justify-content:center; gap:12px; background:#C9653F; color:#F5E6D8; text-decoration:none; border-radius:999px; padding:18px 48px; font-size:14px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; }
    #wk-{{ section.id }}-hero .wk-h-arrow { display:none; }
    #wk-{{ section.id }}-hero .wk-h-guar { display:flex; align-items:center; gap:9px; margin-top:18px; font-size:12.5px; color:rgba(245,230,216,0.78); }
    #wk-{{ section.id }}-hero .wk-h-media { position:relative; }
    #wk-{{ section.id }}-hero .wk-h-glow { display:none; }
    #wk-{{ section.id }}-hero .wk-h-media img { position:relative; z-index:1; width:100%; height:auto; aspect-ratio:1/1; object-fit:cover; border-radius:14px; display:block; }
    #wk-{{ section.id }}-hero .wk-h-ph { position:relative; z-index:1; aspect-ratio:1/1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; color:#E2A24C; border:1px dashed rgba(245,230,216,0.25); border-radius:14px; background:radial-gradient(circle at 50% 45%,rgba(201,168,159,0.35),transparent 65%); }

    @media (max-width:749px){
      /* Full-bleed immersive hero: product photo as background, content overlaid */
      #wk-{{ section.id }}-hero .wk-h-inner { position:relative; display:flex; flex-direction:column; align-items:center; text-align:center; max-width:none; min-height:620px; min-height:max(620px, 86svh); padding:38px 24px 30px; column-gap:0; overflow:hidden; }
      #wk-{{ section.id }}-hero .wk-h-inner::before { content:''; position:absolute; inset:0; z-index:1; pointer-events:none; background:linear-gradient(180deg, rgba(58,42,32,0.88) 0%, rgba(87,47,52,0.42) 26%, rgba(87,47,52,0.18) 48%, rgba(58,42,32,0.62) 74%, rgba(58,42,32,0.93) 100%); }
      #wk-{{ section.id }}-hero .wk-h-left { display:contents; }
      #wk-{{ section.id }}-hero .wk-h-rate,
      #wk-{{ section.id }}-hero .wk-h-title,
      #wk-{{ section.id }}-hero .wk-h-checks,
      #wk-{{ section.id }}-hero .wk-h-cta,
      #wk-{{ section.id }}-hero .wk-h-guar { position:relative; z-index:2; }
      #wk-{{ section.id }}-hero .wk-h-rate { order:1; margin-bottom:14px; }
      #wk-{{ section.id }}-hero .wk-h-title { order:2; font-size:39px; line-height:1.0; margin:0; max-width:13ch; text-shadow:0 2px 22px rgba(58,42,32,0.6); }
      #wk-{{ section.id }}-hero .wk-h-checks { order:3; margin-top:auto; margin-bottom:18px; display:flex; flex-wrap:wrap; justify-content:center; gap:8px 18px; max-width:520px; }
      #wk-{{ section.id }}-hero .wk-h-checks > span { font-size:13.5px; color:#F5E6D8; text-shadow:0 1px 12px rgba(58,42,32,0.7); }
      #wk-{{ section.id }}-hero .wk-h-media { position:absolute; inset:0; z-index:0; width:100%; height:100%; max-width:none; margin:0; }
      #wk-{{ section.id }}-hero .wk-h-glow { display:none; }
      #wk-{{ section.id }}-hero .wk-h-media img { width:100%; height:100%; aspect-ratio:auto; object-fit:cover; object-position:center 46%; border-radius:0; max-height:none; filter:none; }
      #wk-{{ section.id }}-hero .wk-h-ph { width:100%; height:100%; max-width:none; margin:0; border-radius:0; }
      #wk-{{ section.id }}-hero .wk-h-cta { order:5; width:100%; box-shadow:0 14px 30px rgba(58,42,32,0.5); }
      #wk-{{ section.id }}-hero .wk-h-arrow { display:inline; font-size:16px; line-height:1; }
      #wk-{{ section.id }}-hero .wk-h-guar { order:6; justify-content:center; margin-top:14px; }
    }
  </style>
  <section id="wk-{{ section.id }}-hero" style="background:linear-gradient(160deg,#6B3D42 0%,#572f34 60%,#3A2A20 100%);color:#F5E6D8;overflow:hidden;">
    <div class="wk-h-inner">
      <div class="wk-h-left">
        <div class="wk-h-rate"><span style="color:#E2A24C;font-size:15px;letter-spacing:2px;">★★★★★</span><span style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(245,230,216,0.8);font-weight:500;">{{ section.settings.rating_text }}</span></div>
        <h1 class="wk-h-title">{{ section.settings.heading_lead }} <span style="font-style:italic;color:#E2A24C;">{{ section.settings.heading_emph }}</span></h1>
        <div class="wk-h-checks">
          {%- for i in (1..4) -%}
            {%- assign ck = 'check' | append: i -%}
            {%- assign cv = section.settings[ck] -%}
            {%- if cv != blank -%}<span><span style="color:#C9653F;font-weight:700;flex:0 0 auto;">✓</span>{{ cv }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
        <a href="{{ section.settings.cta_url | default: '#' }}" class="wk-h-cta">{{ section.settings.cta_label }} <span class="wk-h-arrow">&rarr;</span></a>
        <div class="wk-h-guar"><span style="color:#E2A24C;">♡</span>{{ section.settings.guarantee_text }}</div>
      </div>
      <div class="wk-h-media">
        <div class="wk-h-glow" aria-hidden="true"></div>
        {%- if section.settings.image -%}{%- assign hero_src = section.settings.image | image_url: width: 1100 -%}{%- assign hero_alt = section.settings.image.alt | default: 'Womankind' -%}
        {%- else -%}{%- assign hero_src = 'wk-buybox-1.jpg' | asset_url -%}{%- assign hero_alt = 'Womankind' -%}{%- endif -%}
        <img src="{{ hero_src }}" alt="{{ hero_alt }}" width="1100" height="1100" loading="eager">
      </div>
    </div>
  </section>

{% schema %}
{
  "name": "Home · Hero",
  "settings": [
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Trusted by 12,000+ women" },
    { "type": "text", "id": "heading_lead", "label": "Heading", "default": "The balance women 40+" },
    { "type": "text", "id": "heading_emph", "label": "Heading (italic emphasis)", "default": "actually feel" },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "check1", "label": "Check 1", "default": "Clinically-backed ingredients" },
    { "type": "text", "id": "check2", "label": "Check 2", "default": "8-in-1 daily formula" },
    { "type": "text", "id": "check3", "label": "Check 3", "default": "Gut–hormone support" },
    { "type": "text", "id": "check4", "label": "Check 4", "default": "Hormone-free & sugar-free" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Womankind" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "90-day money-back guarantee" }
  ]
}
{% endschema %}
