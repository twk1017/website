  <!-- WHY TRUST -->
  <section style="background:#EFDFD0;padding:80px 28px;">
    <div style="max-width:1080px;margin:0 auto;background:#6B3D42;color:#F5E6D8;border-radius:18px;padding:54px 52px;">
      <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:34px;text-align:center;margin:0 0 38px;">{{ section.settings.heading }}</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          {%- for i in (1..4) -%}
            {%- assign ck = 'check' | append: i -%}
            {%- assign cv = section.settings[ck] -%}
            {%- if cv != blank -%}<div style="display:flex;align-items:center;gap:10px;font-size:13.5px;"><span style="color:#E2A24C;flex:0 0 auto;">✓</span>{{ cv }}</div>{%- endif -%}
          {%- endfor -%}
          {%- if section.settings.check_highlight != blank -%}
          <div style="grid-column:1 / -1;display:flex;align-items:center;gap:10px;font-size:13.5px;background:rgba(245,230,216,0.08);border:1px solid rgba(245,230,216,0.18);border-radius:10px;padding:13px 16px;margin-top:4px;"><span style="color:#E2A24C;flex:0 0 auto;">✓</span>{{ section.settings.check_highlight }}</div>
          {%- endif -%}
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          {%- for i in (1..4) -%}
            {%- assign bk = 'badge' | append: i -%}
            {%- assign bv = section.settings[bk] -%}
            {%- if bv != blank -%}
            <div style="border:1px solid rgba(245,230,216,0.18);border-radius:12px;padding:18px 16px;display:flex;flex-direction:column;gap:10px;"><span style="width:34px;height:34px;border-radius:8px;border:1.5px solid #E2A24C;display:inline-flex;align-items:center;justify-content:center;color:#E2A24C;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6z"/></svg></span><span style="font-size:12.5px;line-height:1.3;">{{ bv }}</span></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

{% schema %}
{
  "name": "Home · Why trust",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why women trust Womankind" },
    { "type": "header", "content": "Checklist" },
    { "type": "text", "id": "check1", "label": "Check 1", "default": "No hidden fillers" },
    { "type": "text", "id": "check2", "label": "Check 2", "default": "Made in the USA" },
    { "type": "text", "id": "check3", "label": "Check 3", "default": "Third-party tested" },
    { "type": "text", "id": "check4", "label": "Check 4", "default": "Non-GMO certified" },
    { "type": "text", "id": "check_highlight", "label": "Highlighted check", "default": "Science-backed formula, women's-health reviewed" },
    { "type": "header", "content": "Badges" },
    { "type": "text", "id": "badge1", "label": "Badge 1", "default": "Clinically-backed formula" },
    { "type": "text", "id": "badge2", "label": "Badge 2", "default": "GMP-certified facility" },
    { "type": "text", "id": "badge3", "label": "Badge 3", "default": "Gut–hormone delivery" },
    { "type": "text", "id": "badge4", "label": "Badge 4", "default": "Women's-health focused" }
  ]
}
{% endschema %}
