  <!-- HOW BALANCED SUPPORT CAN FEEL OVER TIME (illustrative symptom-comfort timeline) -->
  <section style="background:#F5E6D8;padding:80px 28px;">
    <div style="max-width:1080px;margin:0 auto;">
      <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:38px;text-align:center;margin:0 0 46px;color:#6B3D42;">{{ section.settings.heading }}</h2>
      <div style="display:grid;grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:center;">
        <div>
          <div style="background:#FBF1E6;border:1px solid rgba(107,61,66,0.14);border-radius:16px;padding:30px 28px;">
            <svg viewBox="0 0 460 280" style="width:100%;height:auto;display:block;">
              <!-- axes -->
              <line x1="50" y1="20" x2="50" y2="240" stroke="rgba(107,61,66,0.25)" stroke-width="1.5"></line>
              <line x1="50" y1="240" x2="440" y2="240" stroke="rgba(107,61,66,0.25)" stroke-width="1.5"></line>
              <!-- y-axis meaning -->
              <text x="16" y="132" transform="rotate(-90 16 132)" text-anchor="middle" font-family="Hanken Grotesk" font-size="10" fill="#7a6258">Everyday comfort</text>
              <text x="30" y="40" font-family="Hanken Grotesk" font-size="11" fill="#7a6258">High</text>
              <text x="32" y="236" font-family="Hanken Grotesk" font-size="11" fill="#7a6258">Low</text>
              <!-- x-axis: weeks of consistent use -->
              <text x="50" y="258" font-family="Hanken Grotesk" font-size="11" fill="#7a6258">Week 1</text>
              <text x="146" y="258" font-family="Hanken Grotesk" font-size="11" fill="#7a6258">Week 3</text>
              <text x="256" y="258" font-family="Hanken Grotesk" font-size="11" fill="#7a6258">Week 6</text>
              <text x="378" y="258" font-family="Hanken Grotesk" font-size="11" fill="#7a6258">Month 3+</text>
              <!-- filled area under the comfort line -->
              <path d="M60 172 L160 130 L270 94 L380 74 L430 70 L430 240 L60 240 Z" fill="rgba(201,101,63,0.12)"></path>
              <!-- comfort line: builds over the first weeks, then steadies -->
              <polyline points="60,172 160,130 270,94 380,74 430,70" fill="none" stroke="#6B3D42" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></polyline>
              <!-- milestone markers -->
              <circle cx="60" cy="172" r="3.6" fill="#E2A24C"></circle>
              <circle cx="160" cy="130" r="3.6" fill="#E2A24C"></circle>
              <circle cx="270" cy="94" r="3.6" fill="#E2A24C"></circle>
              <circle cx="380" cy="74" r="3.6" fill="#E2A24C"></circle>
              <text x="232" y="56" font-family="Fraunces" font-size="13" fill="#6B3D42" font-style="italic">With consistent use</text>
            </svg>
          </div>
          <p style="font-size:11px;line-height:1.5;color:#9a8576;margin:12px 4px 0;font-style:italic;">{{ section.settings.illustrative_note }}</p>
        </div>
        <div>
          {%- if section.settings.body1 != blank -%}<p style="font-size:14.5px;line-height:1.65;color:#4a3a30;margin:0 0 16px;">{{ section.settings.body1 }}</p>{%- endif -%}
          {%- if section.settings.body2 != blank -%}<p style="font-size:14.5px;line-height:1.65;color:#4a3a30;margin:0 0 22px;">{{ section.settings.body2 }}</p>{%- endif -%}
          {%- if section.settings.body3 != blank -%}<p style="font-size:14.5px;line-height:1.65;color:#4a3a30;margin:0 0 22px;">{{ section.settings.body3 }}</p>{%- endif -%}
          <div style="display:flex;gap:9px;flex-wrap:wrap;margin-bottom:26px;">
            {%- for i in (1..4) -%}
              {%- assign gk = 'tag' | append: i -%}
              {%- assign gv = section.settings[gk] -%}
              {%- if gv != blank -%}<span style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#6B3D42;border:1px solid rgba(107,61,66,0.3);border-radius:999px;padding:7px 15px;">{{ gv }}</span>{%- endif -%}
            {%- endfor -%}
          </div>
          <a href="{{ section.settings.cta_url | default: '#' }}" style="display:inline-block;background:#C9653F;color:#F5E6D8;text-decoration:none;border-radius:999px;padding:15px 38px;font-size:13px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;">{{ section.settings.cta_label }}</a>
        </div>
      </div>
    </div>
  </section>

{% schema %}
{
  "name": "Home · Chart",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the first three months feel like" },
    { "type": "textarea", "id": "body1", "label": "Paragraph 1", "default": "Perimenopause doesn't arrive all at once — hot flashes, sleep, mood and energy wobble for years before menopause itself." },
    { "type": "inline_richtext", "id": "body2", "label": "Paragraph 2", "default": "<strong>Womankind smooths out the day-to-day</strong> — easing the symptoms that pull you off balance, so you feel more like yourself through the whole transition. Most women feel the first shift within two weeks.*" },
    { "type": "inline_richtext", "id": "body3", "label": "Paragraph 3", "default": "" },
    { "type": "textarea", "id": "illustrative_note", "label": "Chart disclaimer", "default": "Illustrative — based on customer-reported experience over a typical routine, not a clinical measurement. Individual results vary.*" },
    { "type": "text", "id": "tag1", "label": "Tag 1", "default": "Hot flashes" },
    { "type": "text", "id": "tag2", "label": "Tag 2", "default": "Sleep" },
    { "type": "text", "id": "tag3", "label": "Tag 3", "default": "Mood" },
    { "type": "text", "id": "tag4", "label": "Tag 4", "default": "Energy" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Try Womankind risk-free" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ]
}
{% endschema %}
