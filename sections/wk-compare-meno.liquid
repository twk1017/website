{%- comment -%} Menopause landing page (page.gummies-meno) {%- endcomment -%}
  <!-- COMPARISON (gummies-3) -->
  <section id="wk-compare-{{ section.id }}" style="background:#6B3D42;padding:88px 28px;">
    <style>
      #wk-compare-{{ section.id }} .wk-cmp-table { width:100%; border-collapse:collapse; }
      #wk-compare-{{ section.id }} .wk-cmp-table th,
      #wk-compare-{{ section.id }} .wk-cmp-table td { padding:15px 18px; text-align:left; vertical-align:middle; }
      #wk-compare-{{ section.id }} .wk-cmp-feat { font-size:14.5px; font-weight:500; color:#6B3D42; }
      #wk-compare-{{ section.id }} .wk-cmp-wk { text-align:left; background:rgba(107,61,66,0.055); font-size:13.5px; line-height:1.4; color:#3A2A20; font-weight:500; }
      #wk-compare-{{ section.id }} .wk-cmp-comp { text-align:left; font-size:13.5px; line-height:1.4; color:#8a7568; }
      #wk-compare-{{ section.id }} .wk-cmp-line { display:flex; gap:8px; align-items:flex-start; }
      #wk-compare-{{ section.id }} .wk-cmp-table thead th { border-bottom:1px solid rgba(107,61,66,0.14); }
      #wk-compare-{{ section.id }} .wk-cmp-table tbody tr { border-bottom:1px solid rgba(107,61,66,0.10); }
      #wk-compare-{{ section.id }} .wk-cmp-table tbody tr:last-child { border-bottom:none; }
      #wk-compare-{{ section.id }} .wk-cmp-check { flex:0 0 auto; color:#C9653F; font-size:16px; font-weight:700; line-height:1.2; }
      @media (max-width:600px){
        #wk-compare-{{ section.id }} .wk-cmp-table th,
        #wk-compare-{{ section.id }} .wk-cmp-table td { padding:12px 9px; }
        #wk-compare-{{ section.id }} .wk-cmp-feat { font-size:13px; }
        #wk-compare-{{ section.id }} .wk-cmp-wk,
        #wk-compare-{{ section.id }} .wk-cmp-comp { font-size:12px; }
        #wk-compare-{{ section.id }} .wk-cmp-line { gap:5px; }
        #wk-compare-{{ section.id }} .wk-cmp-check { font-size:14px; }
      }
    </style>
    <div style="max-width:760px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:40px;">
        <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#E2A24C;font-weight:600;margin-bottom:14px;">{{ section.settings.eyebrow }}</div>
        <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:38px;line-height:1.1;margin:0 auto 16px;max-width:20ch;color:#F5E6D8;">{{ section.settings.heading }}</h2>
        <p style="font-size:15px;line-height:1.6;color:rgba(245,230,216,0.82);max-width:56ch;margin:0 auto;">{{ section.settings.intro }}</p>
      </div>

      <div style="background:#FFFCF8;border:1px solid rgba(0,0,0,0.06);border-radius:16px;overflow:hidden;box-shadow:0 14px 40px rgba(0,0,0,0.22);">
        <table class="wk-cmp-table">
          <thead>
            <tr>
              <th></th>
              <th class="wk-cmp-wk" style="background:#6B3D42;color:#F5E6D8;font-family:'Fraunces',serif;font-weight:500;font-size:16px;text-align:center;">Womankind</th>
              <th style="text-align:left;font-size:12px;letter-spacing:0.04em;text-transform:uppercase;color:#8a7568;font-weight:600;">Typical menopause gummy</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="wk-cmp-feat">Fewer, milder hot flashes</td><td class="wk-cmp-wk"><span class="wk-cmp-line"><span class="wk-cmp-check">&check;</span><span>Built for them — 6 botanicals at researched doses</span></span></td><td class="wk-cmp-comp">Token doses hidden in a blend</td></tr>
            <tr><td class="wk-cmp-feat">Night sweats &amp; the 3am wake-up</td><td class="wk-cmp-wk"><span class="wk-cmp-line"><span class="wk-cmp-check">&check;</span><span>Aimed at the sleep they steal</span></span></td><td class="wk-cmp-comp">Nothing for the cause</td></tr>
            <tr><td class="wk-cmp-feat">The root of the flush</td><td class="wk-cmp-wk"><span class="wk-cmp-line"><span class="wk-cmp-check">&check;</span><span>Gut-hormone support — 10B CFU probiotic</span></span></td><td class="wk-cmp-comp">Skipped entirely</td></tr>
            <tr><td class="wk-cmp-feat">Sugar</td><td class="wk-cmp-wk"><span class="wk-cmp-line"><span class="wk-cmp-check">&check;</span><span>Zero — stevia + monk fruit</span></span></td><td class="wk-cmp-comp">2–4g per serving, feeding the imbalance</td></tr>
            <tr><td class="wk-cmp-feat">Botanical doses</td><td class="wk-cmp-wk"><span class="wk-cmp-line"><span class="wk-cmp-check">&check;</span><span>Every milligram printed</span></span></td><td class="wk-cmp-comp">“Proprietary blend” — amounts hidden</td></tr>
            <tr><td class="wk-cmp-feat">Hormones</td><td class="wk-cmp-wk"><span class="wk-cmp-line"><span class="wk-cmp-check">&check;</span><span>Zero added — works with your body</span></span></td><td class="wk-cmp-comp">Not always clear</td></tr>
            <tr><td class="wk-cmp-feat">The guarantee</td><td class="wk-cmp-wk"><span class="wk-cmp-line"><span class="wk-cmp-check">&check;</span><span>90 days — long enough for the root to shift</span></span></td><td class="wk-cmp-comp">30 days — expires before it works</td></tr>
            <tr><td class="wk-cmp-feat">Third-party tested</td><td class="wk-cmp-wk"><span class="wk-cmp-line"><span class="wk-cmp-check">&check;</span><span>Every batch</span></span></td><td class="wk-cmp-comp">Not always disclosed</td></tr>
          </tbody>
        </table>
      </div>

      {%- if section.settings.closing != blank -%}
      <p style="text-align:center;font-size:15px;line-height:1.6;color:rgba(245,230,216,0.85);max-width:54ch;margin:34px auto 0;">{{ section.settings.closing }}</p>
      {%- endif -%}

      <div style="text-align:center;margin:30px 0 0;">
        <button type="button" data-wk-compare-cta style="cursor:pointer;font-family:inherit;background:#C9653F;color:#F5E6D8;border:none;border-radius:999px;padding:17px 44px;font-size:14px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;">{{ section.settings.cta_label }}</button>
        <div style="margin:14px 0 0;font-size:12.5px;color:#F5E6D8;font-weight:600;display:flex;align-items:center;justify-content:center;gap:7px;"><span style="color:#E2A24C;">&check;</span>{{ section.settings.guarantee_text }}</div>
      </div>
    </div>
    <script>
      (function(){
        var root = document.getElementById('wk-compare-{{ section.id }}');
        if(!root) return;
        var cta = root.querySelector('[data-wk-compare-cta]');
        if(cta) cta.addEventListener('click', function(){ window.scrollTo({ top:0, behavior:'smooth' }); });
      })();
    </script>

{% schema %}
{
  "name": "WK Compare (meno)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Not your typical menopause gummy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More than candy with a menopause label" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Most menopause gummies were built to sell, not to help. Sugar that feeds the flush, token doses behind vague blends, and nothing aimed at the root of the problem. Womankind is built differently — for fewer hot flashes, drier nights, and the sleep they steal." },
    { "type": "textarea", "id": "closing", "label": "Closing line" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Feel like yourself again" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "90 days to feel it—or it’s free." }
  ]
}
{% endschema %}
