{%- comment -%} Menopause landing page (page.gummies-meno) {%- endcomment -%}
  <!-- RECOMMENDED BY EXPERTS (gummies-3) -->
  {%- assign exp_defaults = 'wk-expert-delgado.jpg,wk-expert-lin.jpg,wk-expert-raman.jpg' | split: ',' -%}
  <section style="background:#EFDFD0;padding:84px 28px;">
    <div style="max-width:1240px;margin:0 auto;">
      <div style="text-align:center;margin:0 auto 42px;max-width:760px;">
        {%- if section.settings.heading_lead != blank -%}<div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#6B3D42;font-weight:600;margin-bottom:14px;">{{ section.settings.heading_lead }}</div>{%- endif -%}
        <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:40px;line-height:1.12;margin:0 auto;max-width:22ch;color:#6B3D42;text-wrap:balance;">{{ section.settings.heading_emph }}</h2>
        {%- if section.settings.subheading != blank -%}<p style="font-size:14.5px;line-height:1.6;color:#5a4636;max-width:52ch;margin:14px auto 0;text-wrap:pretty;">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>

      <div class="wk-experts-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;">
        {%- for i in (1..3) -%}
          {%- assign nk = 'exp' | append: i | append: '_name' -%}
          {%- assign name = section.settings[nk] -%}
          {%- if name != blank -%}
            {%- assign ik = 'exp' | append: i | append: '_image' -%}
            {%- assign ck = 'exp' | append: i | append: '_credential' -%}
            {%- assign qk = 'exp' | append: i | append: '_quote' -%}
            {%- assign img = section.settings[ik] -%}
            {%- if img -%}{%- assign src = img | image_url: width: 512 -%}{%- else -%}{%- assign fname = exp_defaults[forloop.index0] -%}{%- assign src = fname | asset_url -%}{%- endif -%}
            <div>
              <img src="{{ src }}" alt="{{ name }}, {{ section.settings[ck] }}" width="512" height="512" loading="lazy" style="width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;border-radius:12px;display:block;margin-bottom:18px;">
              <h3 style="font-family:'Fraunces',serif;font-style:italic;font-weight:400;font-size:21px;margin:0 0 6px;color:#3A2A20;">{{ name }}</h3>
              <div style="font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:#C9653F;font-weight:700;line-height:1.4;margin-bottom:14px;">{{ section.settings[ck] }}</div>
              <div style="font-family:'Fraunces',serif;font-size:30px;line-height:0;color:#C9A89F;height:14px;">“</div>
              <p style="font-size:13.5px;line-height:1.55;color:#4a3a30;margin:6px 0 0;">{{ section.settings[qk] }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="wk-experts-dots" aria-hidden="true">
        {%- for i in (1..3) -%}{%- assign nk = 'exp' | append: i | append: '_name' -%}{%- if section.settings[nk] != blank -%}<span></span>{%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

{% schema %}
{
  "name": "WK - Experts (meno)",
  "settings": [
    { "type": "text", "id": "heading_lead", "label": "Eyebrow", "default": "Recommended by" },
    { "type": "text", "id": "heading_emph", "label": "Heading", "default": "The clinicians who treat hot flashes & night sweats" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Not influencers. Not affiliates. Clinicians who can tell the difference between a real formula and a pretty label." },
    { "type": "header", "content": "Expert 1" },
    { "type": "image_picker", "id": "exp1_image", "label": "Photo" },
    { "type": "text", "id": "exp1_name", "label": "Name", "default": "Carmen Delgado" },
    { "type": "text", "id": "exp1_credential", "label": "Credential", "default": "MSN, NP · Menopause & Women’s Health Nurse Practitioner" },
    { "type": "textarea", "id": "exp1_quote", "label": "Quote", "default": "“I’ve spent years watching women be told to just live with it. Hot flashes that hijack your day. Night sweats that steal your sleep. That’s not something you have to accept — and it’s not something a sugar-filled gummy will fix. Most formulas fail because they’re under-dosed and aimed at the surface. Womankind goes after the system that drives the flush.”" },
    { "type": "header", "content": "Expert 2" },
    { "type": "image_picker", "id": "exp2_image", "label": "Photo" },
    { "type": "text", "id": "exp2_name", "label": "Name", "default": "Dr. Wei Lin" },
    { "type": "text", "id": "exp2_credential", "label": "Credential", "default": "PhD · Pharmacognosist" },
    { "type": "textarea", "id": "exp2_quote", "label": "Quote", "default": "“The difference between a supplement that works and one that doesn’t is almost always the dose — and most menopause formulas hide theirs behind a ‘proprietary blend.’ Black cohosh at the researched dose is one of the most studied botanicals for hot flashes and night sweats. Womankind prints every milligram. Because a flush doesn’t respond to a mystery dose.”" },
    { "type": "header", "content": "Expert 3" },
    { "type": "image_picker", "id": "exp3_image", "label": "Photo" },
    { "type": "text", "id": "exp3_name", "label": "Name", "default": "Priya Raman" },
    { "type": "text", "id": "exp3_credential", "label": "Credential", "default": "PharmD · Clinical Pharmacist" },
    { "type": "textarea", "id": "exp3_quote", "label": "Quote", "default": "“Women bring me cabinets full of supplements that did nothing for their hot flashes — and most can’t tell me what’s in any of them. If a label won’t disclose the dose, assume it’s too low to work. Womankind puts every active and every milligram on the label, in the doses the research used. That’s the only kind of formula worth taking — especially at 3am.”" }
  ]
}
{% endschema %}
